---
import '../styles/global.css'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
import WebVitals from '../components/WebVitals.astro'
import AmbientBlobs from '../components/AmbientBlobs.astro'
import LanguageSuggestModal from '../components/LanguageSuggestModal.astro'
import WhatsappFab from '../components/WhatsappFab.astro'
import { DEFAULT_LOCALE, alternateUrls, getDictionary, getLocaleFromUrl, translatedAlternates } from '../i18n'

interface Props {
  title: string
  description?: string
  /** URL absoluta o ruta de la imagen para Open Graph / Twitter (1200×630 ideal) */
  image?: string
  /** 'website' (default) o 'article' para páginas de contenido */
  type?: 'website' | 'article'
  /** Evita la indexación de la página (p. ej. páginas vivas o utilitarias) */
  noindex?: boolean
  /** Fecha de publicación (solo para type="article"): emite article:published_time */
  publishedTime?: Date
}

const site = Astro.site ?? new URL('https://codebymike.tech')
const locale = getLocaleFromUrl(Astro.url.pathname)
const t = getDictionary(locale)
const {
  title,
  description = t.meta.defaultDescription,
  image = '/og-default.png',
  type = 'website',
  noindex = false,
  publishedTime,
} = Astro.props

// El canónico se calcula sobre la ruta SIN prefijo de idioma con el prefijo
// del locale actual reaplicado: evita que una URL con locale mal formado
// (mayúsculas, slashes de más) produzca un canónico distinto al real.
const canonicalPath = alternateUrls(Astro.url.pathname)[locale]
const canonical = new URL(canonicalPath, site).href
const ogImage = new URL(image, site).href
const OG_LOCALE = { es: 'es_CO', en: 'en_US' } as const
// Solo se anuncian los idiomas en los que esta página EXISTE. Emitir
// hreflang="en" hacia una URL sin traducir manda al buscador (y al usuario) a
// una redirección al español, o antes a un 404 directo.
const alt = translatedAlternates(Astro.url.pathname)
const rssHref = locale === DEFAULT_LOCALE ? '/rss.xml' : '/en/rss.xml'

const websiteJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'CodeByMike',
  url: site.href,
  inLanguage: locale,
})
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {alt.es && <link rel="alternate" hreflang="es" href={new URL(alt.es, site).href} />}
    {alt.en && <link rel="alternate" hreflang="en" href={new URL(alt.en, site).href} />}
    {alt.es && <link rel="alternate" hreflang="x-default" href={new URL(alt.es, site).href} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#07070a" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={locale === 'en' ? 'Engineering notes — CodeByMike' : 'Notas de ingeniería — CodeByMike'}
      href={rssHref}
    />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="CodeByMike" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {alt[locale === 'en' ? 'es' : 'en'] && (
      <meta property="og:locale:alternate" content={OG_LOCALE[locale === 'en' ? 'es' : 'en']} />
    )}
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {type === 'article' && <meta property="article:author" content="Mike" />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline type="application/ld+json" set:html={websiteJsonLd} />
    <slot name="head" />
  </head>
  <body class="grain">
    <AmbientBlobs />
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
    <LanguageSuggestModal />
    <WhatsappFab />
    <WebVitals />
  </body>
</html>

