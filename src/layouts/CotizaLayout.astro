---
import '../styles/global.css'

// Vista de Cotiza para quien entró con el PIN (RF-220). Sin sidebar, sin la
// paleta de búsqueda y sin la caja del asistente: esas piezas recorren todo el
// panel y enseñarían que existe lo que el PIN no abre. Con sesión admin, las
// páginas de Cotiza usan AdminLayout como cualquier otra del panel.

interface Props {
  title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Cotiza</title>
  </head>
  <body class="grain bg-ink-950 text-ink-50 min-h-screen">
    <header class="sticky top-0 z-30 border-b border-white/5 bg-ink-950/80 backdrop-blur-xl">
      <div class="mx-auto max-w-5xl px-4 md:px-8 py-4 flex items-center justify-between gap-3">
        <div class="min-w-0">
          <a href="/admin/cotiza" class="font-mono text-[11px] tracking-[.22em] uppercase text-ink-200 hover:text-cyan transition-colors">
            Code<span class="text-cyan">By</span>Mike · Cotiza
          </a>
          <h1 class="mt-0.5 text-lg md:text-2xl font-medium tracking-tight truncate">{title}</h1>
        </div>
        <form method="post" action="/api/cotiza/salir">
          <button
            type="submit"
            class="h-8 px-3 text-[12px] font-medium rounded-full bg-white/[.03] text-ink-50 border border-white/10 hover:bg-white/[.06] transition-all"
          >
            Salir
          </button>
        </form>
      </div>
    </header>
    <main class="mx-auto max-w-5xl px-4 md:px-8 pt-6 pb-12">
      <slot />
    </main>
  </body>
</html>
