---
// Página sin datos vivos: se genera en el build, no por request.
export const prerender = true

import { getNotes, noteSlug } from '../../../lib/notes'

// Mismo enumerado que la ruta en español, pero sobre el catálogo EN INGLÉS:
// los slugs se traducen, así que las dos listas no coinciden.
export async function getStaticPaths() {
  const notes = await getNotes('en')
  return notes.map((note) => ({ params: { slug: noteSlug(note) } }))
}

// Cascarón de ruta: la implementación real vive en src/pages/notes/[slug].astro.
// El slug aquí es el del artículo EN INGLÉS (los slugs se traducen); la página
// busca la nota dentro del idioma de la URL. Ver docs/plan-i18n-en.md §8.
import Note from '../../notes/[slug].astro'
---

<Note />
