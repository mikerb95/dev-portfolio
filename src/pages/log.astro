---
// Página sin datos vivos en el servidor: se genera en el build y los datos de
// GitHub los pide el navegador (/api/github/activity, cacheado en la CDN).
export const prerender = true

import BaseLayout from '../layouts/BaseLayout.astro'
import RelojSesiones from '../components/log/RelojSesiones.astro'
import BitacoraCommits from '../components/log/BitacoraCommits.astro'
import { getDictionary, getLocaleFromUrl, localizedHref } from '../i18n'
import { jsonEnScript } from '../lib/json-script'

const locale = getLocaleFromUrl(Astro.url.pathname)
const t = getDictionary(locale)
const l = t.log
const L = (path: string) => localizedHref(path, locale)
---

<BaseLayout title={l.title} description={l.description} image="/og-log.png" noindex>
  <div class="max-w-[1280px] mx-auto px-6 md:px-12 lg:px-20 pt-32 pb-24" data-locale={locale}>

    <a href={L('/')} class="inline-flex items-center gap-2 text-[11px] font-mono uppercase tracking-[.2em] text-ink-300 hover:text-cyan transition-colors mb-12">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
      {t.common.back}
    </a>

    <header class="lg-hero mb-10">
      <div>
        <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-6" data-hero-sigue>
          <span class="text-cyan">/log</span>
          <span class="h-px flex-1 bg-gradient-to-r from-white/15 to-transparent max-w-[80px]"></span>
          <span class="flex items-center gap-2" id="feed-status">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan pulse-dot"></span>
            <span id="feed-status-text">{l.loadingStatus}</span>
          </span>
        </div>
        <h1 class="text-[42px] sm:text-5xl xl:text-[56px] font-medium tracking-[-.035em] leading-[1] mb-0">
          <span data-hero-linea class="block text-ink-50 lg-balance">{l.h1}</span>{' '}
          <span data-hero-linea class="block text-cyan lg-balance">{l.h1Linea2}</span>
        </h1>
      </div>
      <p class="text-[15.5px] text-ink-100 max-w-xl leading-relaxed" data-hero-sigue>
        {l.intro}
      </p>
    </header>

    <div class="mb-24" data-hero-pieza>
      <RelojSesiones locale={locale} />
    </div>

    <BitacoraCommits locale={locale} />

    <noscript>
      <p class="mt-6 text-[12px] font-mono text-ink-300">{l.loadError}</p>
    </noscript>
  </div>

  <script
    id="log-i18n"
    type="application/json"
    set:html={jsonEnScript({
      oneCommit: l.oneCommit,
      nCommits: l.nCommits,
      today: l.today,
      noActivity: l.noActivity,
      connectError: l.connectError,
      loadError: l.loadError,
      motion: l.motion,
    })}
  />
</BaseLayout>

<script>
  // Mismo lenguaje que las demás páginas con motion (Lenis + GSAP, montaje
  // común en src/lib/motion/landing.ts) más el reloj y la bitácora.
  import { montarLanding } from '../lib/motion/landing'
  import { montarLog } from '../lib/motion/log'

  const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  montarLog({ reducido })
  montarLanding()
</script>

<style>
  .lg-hero { display: grid; gap: 28px; grid-template-columns: minmax(0, 1fr); align-items: end; }
  .lg-balance { text-wrap: balance; }
  @media (min-width: 1024px) {
    .lg-hero { grid-template-columns: minmax(0, 1fr) minmax(0, 400px); gap: 56px; }
  }
</style>
