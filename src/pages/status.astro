---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getDictionary, getLocaleFromUrl, interpolate, localizedHref } from '../i18n'
import { db } from '../db'
import { monitors, monitorChecks, monitorDaily, monitorIncidents } from '../db/schema'
import { and, desc, eq, gte, isNotNull, sql } from 'drizzle-orm'
import { computeSloFromCounts, formatMinutes, budgetHealth } from '../lib/slo'
import { recentLatency } from '../lib/latency'
import { safeQuery } from '../lib/safe-query'
import { crearRastreador } from '../lib/fallback/rastreador'
import { sondearEnVivo } from '../lib/fallback/sondeo-vivo'
import { DEPENDEN_DE_LA_BASE } from '../data/respaldo-monitores'
import {
  aggregateChecks,
  mergeHists,
  parseHist,
  quantileFromHist,
  startOfDayUTC,
  type CheckRow,
  type Hist,
} from '../lib/monitor-rollup'

// Página de status pública. Expone SOLO datos operativos agregados de los
// monitores activos (nombre, uptime, latencia); nunca URLs internas, errores
// crudos ni configuración. El filtrado ocurre aquí, en el servidor.

const locale = getLocaleFromUrl(Astro.url.pathname)
const t = getDictionary(locale)
const st = t.status
const L = (path: string) => localizedHref(path, locale)

const OBJECTIVE = 99.5
const WINDOW_DAYS = 90
const SLO_DAYS = 30
const DAY_MS = 86_400_000

const now = Date.now()
const since = new Date(now - WINDOW_DAYS * DAY_MS)

// Toda consulta de esta página es fail-open: sin base, /status renderiza su
// marco y explica que no hay datos, en vez de devolver un 404 como hizo en
// producción con la cuota de Turso agotada (ago 2026). Una página de estado que
// se cae cuando algo va mal es justo la que no sirve.
const rastreador = crearRastreador()

const monsBase = await rastreador.q(
  () =>
    db
      .select({
        id: monitors.id,
        name: monitors.name,
        lastStatus: monitors.lastStatus,
        lastCheckedAt: monitors.lastCheckedAt,
        lastResponseMs: monitors.lastResponseMs,
        sslExpiresAt: monitors.sslExpiresAt,
      })
      .from(monitors)
      .where(and(eq(monitors.active, true), eq(monitors.paused, false)))
      .orderBy(monitors.name),
  [] as Pick<
    typeof monitors.$inferSelect,
    'id' | 'name' | 'lastStatus' | 'lastCheckedAt' | 'lastResponseMs' | 'sslExpiresAt'
  >[],
  'status/monitores',
)

// Sin la tabla de monitores, la página no se resigna a estar vacía: MIDE. Se
// sondean en el momento los endpoints públicos declarados en
// src/data/respaldo-monitores.ts, y lo que se pinta es esa medición real y
// recién tomada. Lo único que se pierde es el historial, y la página lo dice.
const modoRespaldo = rastreador.degradado
const mons = modoRespaldo ? await sondearEnVivo() : monsBase

// Resumen diario precalculado por `/api/cron/monitor-rollup`: monitores × días,
// unas 720 filas. La versión anterior agregaba `monitor_checks` aquí mismo, y
// eso son ~200.000 filas leídas POR VISITA. Con el cache de 300s del CDN por
// delante casi nunca se notaba; la primera prueba de carga sin CDN agotó la
// cuota de lecturas de Turso (ago 2026).
//
// El día EN CURSO no tiene fila todavía (el cron solo cierra días completos),
// así que se agrega en vivo. Es un solo día: ~2.300 filas, y el índice `at` lo
// resuelve sin escanear la tabla.
const hoyInicio = startOfDayUTC(now)

// H-05 (ago 2026): estas cinco consultas no dependen entre sí (solo
// `latencyByMonitor` depende de los ids de `mons`, ya resueltos arriba), pero
// se esperaban en serie, sumando sus latencias de red una tras otra - la
// prueba de estrés de k6 marcó /status como la ruta más cara de las cuatro
// del sitio público. Todas pasan por `safeQuery` (nunca rechazan, devuelven
// el fallback si fallan), así que correrlas con Promise.all no cambia el
// comportamiento fail-open, solo el tiempo total de la página.
const [cerrados, checksHoy, latencyByMonitor, incidentsRaw, activeIncidentsRaw] = await Promise.all([
  safeQuery(
    () =>
      db
        .select({
          monitorId: monitorDaily.monitorId,
          day: monitorDaily.day,
          total: monitorDaily.total,
          ok: monitorDaily.ok,
          sumMs: monitorDaily.sumMs,
          latencyHist: monitorDaily.latencyHist,
        })
        .from(monitorDaily)
        .where(gte(monitorDaily.day, since.toISOString().slice(0, 10))),
    [] as { monitorId: number; day: string; total: number; ok: number; sumMs: number; latencyHist: string }[],
    'status/resumen-diario',
  ),
  safeQuery(
    () =>
      db
        .select({
          monitorId: monitorChecks.monitorId,
          at: monitorChecks.at,
          ok: monitorChecks.ok,
          responseMs: monitorChecks.responseMs,
        })
        .from(monitorChecks)
        .where(gte(monitorChecks.at, new Date(hoyInicio))),
    [] as { monitorId: number; at: Date; ok: boolean; responseMs: number | null }[],
    'status/checks-de-hoy',
  ),
  // Serie de latencia reciente por monitor para la mini-gráfica tipo EKG. En
  // modo respaldo no se pide: los ids sondeados en vivo no existen en la
  // tabla, así que la consulta solo gastaría un viaje para volver vacía.
  modoRespaldo
    ? Promise.resolve(new Map<number, { t: number; ms: number; ok: boolean }[]>())
    : safeQuery(
        () => recentLatency(mons.map((m) => m.id)),
        new Map<number, { t: number; ms: number; ok: boolean }[]>(),
        'status/latencia-reciente',
      ),
  safeQuery(
    () =>
      db
        .select({
          monitorId: monitorIncidents.monitorId,
          startedAt: monitorIncidents.startedAt,
          durationSec: monitorIncidents.durationSec,
        })
        .from(monitorIncidents)
        .where(and(isNotNull(monitorIncidents.resolvedAt), gte(monitorIncidents.startedAt, since)))
        .orderBy(desc(monitorIncidents.startedAt))
        .limit(10),
    [] as { monitorId: number; startedAt: Date; durationSec: number | null }[],
    'status/incidentes-resueltos',
  ),
  safeQuery(
    () =>
      db
        .select({
          monitorId: monitorIncidents.monitorId,
          startedAt: monitorIncidents.startedAt,
        })
        .from(monitorIncidents)
        .where(sql`${monitorIncidents.resolvedAt} is null`)
        .orderBy(desc(monitorIncidents.startedAt)),
    [] as { monitorId: number; startedAt: Date }[],
    'status/incidentes-activos',
  ),
])

const aggHoy = aggregateChecks(
  checksHoy.map<CheckRow>((r) => ({
    monitorId: r.monitorId,
    at: r.at.getTime(),
    ok: Boolean(r.ok),
    responseMs: r.responseMs,
  })),
)

type Bucket = { day: string; total: number; ok: number; sumMs: number; hist: Hist }
const byMonitor = new Map<number, Map<string, Bucket>>()
const guardar = (monitorId: number, bucket: Bucket) => {
  const map = byMonitor.get(monitorId) ?? new Map<string, Bucket>()
  map.set(bucket.day, bucket)
  byMonitor.set(monitorId, map)
}
for (const row of cerrados) {
  guardar(row.monitorId, {
    day: row.day,
    total: row.total,
    ok: row.ok,
    sumMs: row.sumMs,
    hist: parseHist(row.latencyHist),
  })
}
// Después de los cerrados: si el cron ya hubiera escrito el día de hoy, la
// versión en vivo es la más fresca y debe ganar.
for (const agg of aggHoy) {
  guardar(agg.monitorId, { day: agg.day, total: agg.total, ok: agg.ok, sumMs: agg.sumMs, hist: agg.hist })
}

// Últimos 90 días como claves ISO (UTC), del más antiguo al más reciente.
const days: string[] = []
for (let i = WINDOW_DAYS - 1; i >= 0; i--) {
  days.push(new Date(now - i * DAY_MS).toISOString().slice(0, 10))
}
const sloCutoff = new Date(now - SLO_DAYS * DAY_MS).toISOString().slice(0, 10)

// p95 de latencia (30d) por monitor, desde los histogramas diarios ya cargados.
// La media esconde la cola; el p95 es lo que de verdad sienten los usuarios lentos.
//
// Antes salía de una window function con nearest-rank sobre `monitor_checks`:
// exacta, pero obliga a ordenar la partición entera de 30 días en cada visita.
// El histograma da un p95 aproximado (el error está acotado por el ancho del
// cubo donde cae, ver lib/monitor-rollup.ts) sin leer una sola fila más de las
// que la página ya necesitaba. Para un número que se pinta redondeado a
// milisegundos en una tarjeta de estado, esa precisión sobra.

const cards = mons.map((m) => {
  const buckets = byMonitor.get(m.id) ?? new Map<string, Bucket>()
  const latency = (latencyByMonitor.get(m.id) ?? []).map((p) => p.ms)

  const bars = days.map((day) => {
    const b = buckets.get(day)
    if (!b || b.total === 0) return { day, pct: null as number | null }
    return { day, pct: Math.round((b.ok / b.total) * 1000) / 10 }
  })

  let ok30 = 0, total30 = 0, sumMs30 = 0
  let ok90 = 0, total90 = 0
  const hists30: Hist[] = []
  for (const [day, b] of buckets) {
    ok90 += b.ok
    total90 += b.total
    if (day >= sloCutoff) {
      ok30 += b.ok
      total30 += b.total
      sumMs30 += b.sumMs
      hists30.push(b.hist)
    }
  }
  const p95Ms30 = quantileFromHist(mergeHists(hists30), 0.95)

  const slo = computeSloFromCounts(ok30, total30, OBJECTIVE, SLO_DAYS)
  return {
    ...m,
    bars,
    latency,
    slo,
    health: budgetHealth(slo),
    uptime90: total90 > 0 ? Math.round((ok90 / total90) * 1000) / 10 : null,
    avgMs30: total30 > 0 ? Math.round(sumMs30 / total30) : null,
    p95Ms30,
    ok30,
    total30,
  }
})

// Uptime agregado global (30d): un solo número ancla para el encabezado.
const globalOk30 = cards.reduce((s, c) => s + c.ok30, 0)
const globalTotal30 = cards.reduce((s, c) => s + c.total30, 0)
const globalUptime30 = globalTotal30 > 0
  ? Math.round((globalOk30 / globalTotal30) * 1000) / 10
  : null

// Incidentes resueltos recientes: nombre, inicio y duración. Sin causa ni
// mensajes de error (pueden contener detalle interno).
const publicIds = new Set(mons.map((m) => m.id))
const nameById = new Map(mons.map((m) => [m.id, m.name]))
const incidents = (
  await safeQuery(
    () =>
      db
        .select({
          monitorId: monitorIncidents.monitorId,
          startedAt: monitorIncidents.startedAt,
          durationSec: monitorIncidents.durationSec,
        })
        .from(monitorIncidents)
        .where(and(isNotNull(monitorIncidents.resolvedAt), gte(monitorIncidents.startedAt, since)))
        .orderBy(desc(monitorIncidents.startedAt))
        .limit(10),
    [] as { monitorId: number; startedAt: Date; durationSec: number | null }[],
    'status/incidentes-resueltos',
  )
).filter((i) => publicIds.has(i.monitorId))

// Incidentes ACTIVOS (sin resolver): lo primero que busca alguien al entrar.
const activeIncidents = (
  await safeQuery(
    () =>
      db
        .select({
          monitorId: monitorIncidents.monitorId,
          startedAt: monitorIncidents.startedAt,
        })
        .from(monitorIncidents)
        .where(sql`${monitorIncidents.resolvedAt} is null`)
        .orderBy(desc(monitorIncidents.startedAt)),
    [] as { monitorId: number; startedAt: Date }[],
    'status/incidentes-activos',
  )
).filter((i) => publicIds.has(i.monitorId))

const overall = cards.some((c) => c.lastStatus === 'down')
  ? 'down'
  : cards.some((c) => c.lastStatus === 'degraded')
    ? 'degraded'
    : 'up'

const overallLabel = st.overallLabel[overall]

const fmtDate = new Intl.DateTimeFormat(locale === 'en' ? 'en-US' : 'es-CO', {
  day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit',
  timeZone: 'America/Bogota',
})

function ago(d: Date | null): string {
  if (!d) return '-'
  const min = Math.round((now - d.getTime()) / 60_000)
  if (min < 1) return st.agoJustNow
  if (min < 60) return interpolate(st.agoMinutes, { n: min })
  const h = Math.floor(min / 60)
  return h < 24 ? interpolate(st.agoHours, { n: h }) : interpolate(st.agoDaysShort, { n: Math.floor(h / 24) })
}

function barColor(pct: number | null): string {
  if (pct === null) return 'bg-ink-600'
  if (pct >= OBJECTIVE) return 'bg-lime'
  if (pct >= 95) return 'bg-ember/70'
  return 'bg-ember'
}

// Badge de certificado TLS: días hasta la expiración, con color de alerta.
function sslInfo(d: Date | null): { label: string; cls: string } | null {
  if (!d) return null
  const days = Math.round((d.getTime() - now) / DAY_MS)
  const label = days < 0 ? st.sslExpired : interpolate(st.sslDays, { n: days })
  if (days < 0) return { label, cls: 'text-ember border-ember/40 bg-ember/15' }
  if (days <= 14) return { label, cls: 'text-ember border-ember/30 bg-ember/10' }
  if (days <= 30) return { label, cls: 'text-ember/80 border-ember/20 bg-ember/5' }
  return { label, cls: 'text-lime/80 border-lime/20 bg-lime/5' }
}

// Color del trazo EKG según el estado actual del monitor.
const ekgColor: Record<string, string> = {
  up: 'text-lime',
  degraded: 'text-ember',
  down: 'text-ember',
  unknown: 'text-ink-400',
}

const statusBadge = {
  up: { label: st.statusBadge.up, cls: 'text-lime border-lime/30 bg-lime/10', dot: 'bg-lime' },
  degraded: { label: st.statusBadge.degraded, cls: 'text-ember border-ember/30 bg-ember/10', dot: 'bg-ember' },
  down: { label: st.statusBadge.down, cls: 'text-ember border-ember/40 bg-ember/15', dot: 'bg-ember' },
  unknown: { label: st.statusBadge.unknown, cls: 'text-ink-200 border-white/10 bg-white/5', dot: 'bg-ink-400' },
} as const

const healthLabel = st.healthLabel
---

<BaseLayout title={st.title} description={st.description} image="/og-status.png">
  <div class="max-w-[1280px] mx-auto px-6 md:px-12 lg:px-20 pt-32 pb-24">

    <!-- Back -->
    <a href={L('/')} class="inline-flex items-center gap-2 text-[11px] font-mono uppercase tracking-[.2em] text-ink-300 hover:text-cyan transition-colors mb-12">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
      {t.common.back}
    </a>

    <header class="mb-12">
      <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-6">
        <span class="text-cyan">/status</span>
        <span class="h-px flex-1 bg-gradient-to-r from-white/15 to-transparent max-w-[80px]"></span>
        <span>{st.eyebrow}</span>
      </div>
      <h1 class="text-5xl md:text-6xl font-medium tracking-[-.035em] text-mask leading-[.95] mb-8">
        {st.h1Line1}<br/>{st.h1Line2}
      </h1>
      <p class="text-[16px] text-ink-100 max-w-xl leading-relaxed">
        {st.intro}
      </p>
    </header>

    {modoRespaldo && (
      <div class="rounded-2xl border border-cyan/25 bg-cyan/[.06] p-5 mb-4">
        <div class="flex items-center gap-2.5 mb-2">
          <span class="w-2 h-2 rounded-full bg-cyan pulse-dot" aria-hidden="true"></span>
          <span class="text-[13px] font-medium text-cyan">{st.fallbackTitle}</span>
        </div>
        <p class="text-[13px] text-ink-200 leading-relaxed max-w-3xl">{st.fallbackBody}</p>
      </div>
    )}

    <!-- Banner de estado global + uptime agregado -->
    <div class={`rounded-2xl glass p-5 mb-4 flex items-center gap-4 ${overall === 'up' ? 'border-lime/20' : 'border-ember/30'}`}>
      <span class={`w-2.5 h-2.5 rounded-full pulse-dot ${overall === 'up' ? 'bg-lime' : 'bg-ember'}`}></span>
      <span class="text-[15px] font-medium">{overallLabel}</span>
      <div class="ml-auto text-right">
        <div class={`font-mono text-[22px] leading-none tracking-tight ${globalUptime30 !== null && globalUptime30 >= OBJECTIVE ? 'text-lime' : 'text-ember'}`}>
          {globalUptime30 === null ? '-' : `${globalUptime30}%`}
        </div>
        <div class="text-[10px] font-mono uppercase tracking-[.15em] text-ink-300 mt-1">
          {st.uptimeAggregated} · {SLO_DAYS}d
        </div>
      </div>
    </div>

    {activeIncidents.length > 0 && (
      <div class="rounded-2xl border border-ember/40 bg-ember/10 p-5 mb-4">
        <div class="flex items-center gap-3 mb-3">
          <span class="w-2 h-2 rounded-full bg-ember pulse-dot"></span>
          <span class="text-[13px] font-medium text-ember">
            {activeIncidents.length === 1 ? st.activeIncident : interpolate(st.activeIncidents, { n: activeIncidents.length })}
          </span>
        </div>
        <div class="space-y-1.5">
          {activeIncidents.map((i) => (
            <div class="flex flex-wrap items-center gap-x-3 text-[13px]">
              <span class="font-medium">{nameById.get(i.monitorId)}</span>
              <span class="font-mono text-[11px] text-ember">{st.inProgress} · {ago(i.startedAt)}</span>
            </div>
          ))}
        </div>
      </div>
    )}

    <div class="mb-12 flex justify-end">
      <span class="text-[11px] font-mono text-ink-300">
        {interpolate(st.sloObjective, { pct: OBJECTIVE, days: SLO_DAYS })}
      </span>
    </div>

    {cards.length === 0 && (
      <div class="rounded-2xl glass p-12 text-center">
        <p class="text-[13px] font-mono text-ink-300">{st.noMonitors}</p>
      </div>
    )}

    <!-- Monitores -->
    <div class="space-y-4 mb-20">
      {cards.map((c) => {
        const badge = statusBadge[c.lastStatus ?? 'unknown']
        return (
          <div class="rounded-2xl glass p-6 lift" data-card-id={c.id}>
            <div class="flex flex-wrap items-center gap-3 mb-5">
              <span class={`status-dot w-1.5 h-1.5 rounded-full ${badge.dot} ${c.lastStatus === 'up' ? '' : 'pulse-dot'}`}></span>
              <h2 class="text-[15px] font-medium">{c.name}</h2>
              <span class={`status-label text-[10px] font-mono uppercase tracking-[.15em] px-2.5 py-1 rounded-full border ${badge.cls}`}>
                {badge.label}
              </span>
              {(() => {
                const ssl = sslInfo(c.sslExpiresAt)
                return ssl && (
                  <span class={`text-[10px] font-mono uppercase tracking-[.15em] px-2.5 py-1 rounded-full border ${ssl.cls}`} title={st.sslTitle}>
                    {ssl.label}
                  </span>
                )
              })()}
              <span class="last-checked ml-auto text-[11px] font-mono text-ink-300" data-checked-at={c.lastCheckedAt ? c.lastCheckedAt.getTime() : ''}>
                {interpolate(st.lastChecked, { ago: ago(c.lastCheckedAt) })}
              </span>
            </div>

            {modoRespaldo && DEPENDEN_DE_LA_BASE.has(c.id) && c.lastStatus !== 'up' && (
              <p class="text-[11.5px] text-ink-300 leading-relaxed mb-4">{st.fallbackDependsOnDb}</p>
            )}

            <!-- Latencia en vivo (osciloscopio / EKG) -->
            <div class="mb-5">
              <div class="flex items-center justify-between mb-1.5">
                <span class="text-[10px] font-mono uppercase tracking-[.15em] text-ink-300">{st.liveLatency}</span>
                <span class="ekg-now font-mono text-[11px] text-ink-100 tabular-nums" data-monitor-id={c.id}>
                  {c.lastResponseMs != null ? `${c.lastResponseMs} ms` : '-'}
                </span>
              </div>
              <div class={`ekg relative h-14 rounded-lg overflow-hidden bg-black/30 ring-1 ring-white/5 ${ekgColor[c.lastStatus ?? 'unknown']}`}
                   data-monitor-id={c.id}
                   data-status={c.lastStatus ?? 'unknown'}
                   data-series={JSON.stringify(c.latency)}>
                <svg class="w-full h-full block" viewBox="0 0 300 56" preserveAspectRatio="none" aria-hidden="true">
                  <line x1="0" y1="28" x2="300" y2="28" stroke="currentColor" stroke-width="0.5" stroke-dasharray="2 4" opacity="0.15"></line>
                  <path class="ekg-glow" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round" stroke-linecap="round" opacity="0.35" vector-effect="non-scaling-stroke"></path>
                  <path class="ekg-trace" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke"></path>
                </svg>
                <span class="ekg-cursor absolute right-0 -translate-y-1/2 w-1.5 h-1.5 rounded-full bg-current shadow-[0_0_8px_currentColor]" style="top:50%"></span>
                <span class="ekg-empty absolute inset-0 hidden items-center justify-center text-[10px] font-mono text-ink-400">{st.noDataYet}</span>
                <span class="ekg-hover-line absolute top-0 bottom-0 w-px bg-white/25 hidden pointer-events-none"></span>
                <span class="ekg-hover-dot absolute w-2 h-2 -translate-x-1/2 -translate-y-1/2 rounded-full bg-current ring-2 ring-black/60 hidden pointer-events-none"></span>
                <span class="ekg-tooltip absolute hidden top-1 -translate-x-1/2 px-2 py-1 rounded-md bg-black/85 ring-1 ring-white/10 text-[10px] font-mono text-ink-50 whitespace-nowrap pointer-events-none z-10"></span>
              </div>
            </div>

            <!-- 90 días de uptime diario -->
            <div class="flex items-end gap-[2px] h-9 mb-2">
              {c.bars.map((b) => (
                <div
                  class={`flex-1 rounded-[2px] ${barColor(b.pct)} ${b.pct === null ? 'h-2 self-center' : 'h-full'} opacity-90 hover:opacity-100`}
                  title={`${b.day} · ${b.pct === null ? st.noDataYet : `${b.pct}% uptime`}`}
                ></div>
              ))}
            </div>
            <div class="flex justify-between text-[10px] font-mono text-ink-300 mb-5">
              <span>{interpolate(st.daysAgo, { n: WINDOW_DAYS })}</span>
              <span>{st.today}</span>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-[13px]">
              <div>
                <div class="text-[10px] font-mono uppercase tracking-[.15em] text-ink-300 mb-1">{interpolate(st.uptimeShort, { n: SLO_DAYS })}</div>
                <div class={`font-mono ${c.slo.meetsObjective ? 'text-lime' : 'text-ember'}`}>
                  {c.slo.sliPct === null ? '-' : `${c.slo.sliPct}%`}
                </div>
              </div>
              <div>
                <div class="text-[10px] font-mono uppercase tracking-[.15em] text-ink-300 mb-1">{interpolate(st.uptimeShort, { n: WINDOW_DAYS })}</div>
                <div class="font-mono text-ink-50">{c.uptime90 === null ? '-' : `${c.uptime90}%`}</div>
              </div>
              <div>
                <div class="text-[10px] font-mono uppercase tracking-[.15em] text-ink-300 mb-1">{st.latencyAvgP95}</div>
                <div class="font-mono text-ink-50">
                  {c.avgMs30 === null ? '-' : `${c.avgMs30}`}
                  <span class="text-ink-300"> · {c.p95Ms30 === null ? '-' : `${c.p95Ms30}`} ms</span>
                </div>
              </div>
              <div>
                <div class="text-[10px] font-mono uppercase tracking-[.15em] text-ink-300 mb-1">{st.errorBudget}</div>
                <div class="font-mono text-ink-50">
                  {c.slo.budgetRemainingPct === null
                    ? '-'
                    : `${c.slo.budgetRemainingPct}% (${formatMinutes(c.slo.remainingMinutes)})`}
                  <span class="text-ink-300"> · {healthLabel[c.health]}</span>
                </div>
              </div>
            </div>
          </div>
        )
      })}
    </div>

    <!-- Incidentes recientes -->
    <section class="mb-20">
      <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-ink-400"></span>
        <span>{interpolate(st.resolvedIncidents, { n: WINDOW_DAYS })}</span>
      </div>
      {incidents.length === 0 ? (
        <div class="rounded-2xl glass p-8">
          <p class="text-[13px] font-mono text-ink-200">{st.noIncidents}</p>
        </div>
      ) : (
        <div class="rounded-2xl glass divide-y divide-white/5">
          {incidents.map((i) => (
            <div class="p-5 flex flex-wrap items-center gap-3 text-[13px]">
              <span class="font-medium">{nameById.get(i.monitorId)}</span>
              <span class="text-ink-300 font-mono text-[11px]">{fmtDate.format(i.startedAt)}</span>
              <span class="ml-auto font-mono text-[11px] text-ember">
                {interpolate(st.downFor, { duration: i.durationSec != null ? formatMinutes(i.durationSec / 60) : st.unknownDuration })}
              </span>
            </div>
          ))}
        </div>
      )}
    </section>

    <!-- Enlace a Security Operations -->
    <a
      href={L('/security')}
      class="mb-20 rounded-2xl glass p-6 lift flex flex-wrap items-center gap-4 group"
    >
      <span class="w-2 h-2 rounded-full bg-cyan pulse-dot shrink-0"></span>
      <div class="min-w-0">
        <h3 class="text-[14px] font-medium text-ink-50">{st.securityCard.title}</h3>
        <p class="text-[12px] text-ink-300 mt-0.5">
          {st.securityCard.body}
        </p>
      </div>
      <span class="ml-auto text-[13px] text-cyan group-hover:underline shrink-0">{st.securityCard.cta}</span>
    </a>

    <!-- Metodología -->
    <section class="rounded-2xl glass p-8">
      <div class="text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-4">{st.methodology.heading}</div>
      <div class="grid md:grid-cols-3 gap-6 text-[13px] text-ink-100 leading-relaxed">
        <p>
          {st.methodology.p1}
        </p>
        <p>
          {st.methodology.p2Pre} <span class="text-ink-50">{st.methodology.sloWord}</span>{' '}
          {interpolate(st.methodology.p2Mid, { pct: OBJECTIVE, days: SLO_DAYS })}{' '}
          <span class="text-ink-50">{st.methodology.budgetWord}</span>{' '}
          {st.methodology.p2Mid2}{' '}
          <span class="text-ink-50">{st.methodology.p95Word}</span>{' '}
          {st.methodology.p2End}
        </p>
        <p>
          {st.methodology.p3}
        </p>
      </div>
    </section>

  </div>

  <style>
    /* Barrido tipo osciloscopio: da sensación de "vivo" entre repintados. */
    .ekg::after {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: linear-gradient(90deg, transparent 0%, currentColor 50%, transparent 100%);
      opacity: 0.06;
      width: 40%;
      animation: ekg-sweep 3.5s linear infinite;
    }
    @keyframes ekg-sweep {
      0% { transform: translateX(-60%); }
      100% { transform: translateX(300%); }
    }
    .ekg-trace, .ekg-glow { transition: d 0.6s ease; }
    .ekg-cursor { transition: top 0.6s ease; }
    @media (prefers-reduced-motion: reduce) {
      .ekg::after { animation: none; }
      .ekg-trace, .ekg-glow, .ekg-cursor { transition: none; }
    }
  </style>

  <script define:vars={{ statusBadge, ekgColor, agoStrings: { justNow: st.agoJustNow, minutes: st.agoMinutes, hours: st.agoHours, days: st.agoDaysShort }, lastCheckedTpl: st.lastChecked }}>
    const W = 300, H = 56, PAD = 6
    const seriesByEl = new WeakMap()

    function pathFor(series) {
      if (!series || series.length < 2) return null
      let min = Infinity, max = -Infinity
      for (const v of series) { if (v < min) min = v; if (v > max) max = v }
      const range = Math.max(max - min, 1)
      const n = series.length
      const dx = W / (n - 1)
      let d = '', lastY = H / 2
      for (let i = 0; i < n; i++) {
        const x = i * dx
        const y = PAD + (H - 2 * PAD) * (1 - (series[i] - min) / range)
        d += (i ? 'L' : 'M') + x.toFixed(1) + ' ' + y.toFixed(1) + ' '
        lastY = y
      }
      return { d: d.trim(), lastY }
    }

    function draw(el, series) {
      const trace = el.querySelector('.ekg-trace')
      const glow = el.querySelector('.ekg-glow')
      const cursor = el.querySelector('.ekg-cursor')
      const empty = el.querySelector('.ekg-empty')
      const p = pathFor(series)
      if (!p) {
        trace?.setAttribute('d', '')
        glow?.setAttribute('d', '')
        if (empty) empty.style.display = 'flex'
        return
      }
      if (empty) empty.style.display = 'none'
      trace?.setAttribute('d', p.d)
      glow?.setAttribute('d', p.d)
      if (cursor) cursor.style.top = ((p.lastY / H) * 100).toFixed(2) + '%'
      seriesByEl.set(el, series)

      // Etiqueta de latencia actual (último punto).
      const id = el.getAttribute('data-monitor-id')
      const now = document.querySelector(`.ekg-now[data-monitor-id="${id}"]`)
      if (now) now.textContent = series[series.length - 1] + ' ms'
    }

    // Tooltip al pasar el mouse: muestra la latencia exacta del punto bajo el cursor.
    function pointAt(series, fraction) {
      let min = Infinity, max = -Infinity
      for (const v of series) { if (v < min) min = v; if (v > max) max = v }
      const range = Math.max(max - min, 1)
      const n = series.length
      const idx = Math.min(n - 1, Math.max(0, Math.round(fraction * (n - 1))))
      const x = (idx * (W / (n - 1))) / W
      const y = (PAD + (H - 2 * PAD) * (1 - (series[idx] - min) / range)) / H
      return { idx, x, y, value: series[idx] }
    }

    function bindHover(el) {
      const line = el.querySelector('.ekg-hover-line')
      const dot = el.querySelector('.ekg-hover-dot')
      const tip = el.querySelector('.ekg-tooltip')
      if (!line || !dot || !tip) return

      el.addEventListener('mousemove', (e) => {
        const series = seriesByEl.get(el)
        if (!series || series.length < 2) return
        const rect = el.getBoundingClientRect()
        const fraction = Math.min(1, Math.max(0, (e.clientX - rect.left) / rect.width))
        const p = pointAt(series, fraction)

        line.style.left = (p.x * 100).toFixed(2) + '%'
        dot.style.left = (p.x * 100).toFixed(2) + '%'
        dot.style.top = (p.y * 100).toFixed(2) + '%'
        tip.textContent = `${p.value} ms`
        // Fija la burbuja cerca del borde superior y evita que se salga por los costados.
        const tipLeftPct = Math.min(92, Math.max(8, p.x * 100))
        tip.style.left = tipLeftPct + '%'

        line.classList.remove('hidden')
        dot.classList.remove('hidden')
        tip.classList.remove('hidden')
      })

      el.addEventListener('mouseleave', () => {
        line.classList.add('hidden')
        dot.classList.add('hidden')
        tip.classList.add('hidden')
      })
    }

    function drawAll(seriesById) {
      document.querySelectorAll('.ekg').forEach((el) => {
        const id = el.getAttribute('data-monitor-id')
        let series = seriesById ? seriesById[id] : null
        if (!series) {
          try { series = JSON.parse(el.getAttribute('data-series') || '[]') } catch { series = [] }
        }
        draw(el, series)
      })
    }

    function ago(ms) {
      if (!ms) return '-'
      const min = Math.round((Date.now() - ms) / 60_000)
      if (min < 1) return agoStrings.justNow
      if (min < 60) return agoStrings.minutes.replace('{n}', min)
      const h = Math.floor(min / 60)
      return h < 24 ? agoStrings.hours.replace('{n}', h) : agoStrings.days.replace('{n}', Math.floor(h / 24))
    }

    // Refresca badge de estado, "último check" y color del EKG sin recargar.
    function applyStatus(statusById) {
      if (!statusById) return
      document.querySelectorAll('[data-card-id]').forEach((card) => {
        const id = card.getAttribute('data-card-id')
        const s = statusById[id]
        if (!s) return

        const info = statusBadge[s.status] ?? statusBadge.unknown
        const dot = card.querySelector('.status-dot')
        if (dot) {
          dot.className = `status-dot w-1.5 h-1.5 rounded-full ${info.dot} ${s.status === 'up' ? '' : 'pulse-dot'}`
        }
        const label = card.querySelector('.status-label')
        if (label) {
          label.className = `status-label text-[10px] font-mono uppercase tracking-[.15em] px-2.5 py-1 rounded-full border ${info.cls}`
          label.textContent = info.label
        }
        const checked = card.querySelector('.last-checked')
        if (checked) {
          checked.textContent = lastCheckedTpl.replace('{ago}', ago(s.checkedAt))
          checked.setAttribute('data-checked-at', s.checkedAt ?? '')
        }

        const ekg = card.querySelector('.ekg')
        if (ekg) {
          const color = ekgColor[s.status] ?? ekgColor.unknown
          ekg.className = ekg.className.replace(/text-\S+/, color)
        }
      })
    }

    // Refresca los "hace X min" cada 30s aunque no haya nuevo poll de datos.
    function tickAgo() {
      document.querySelectorAll('.last-checked').forEach((el) => {
        const at = Number(el.getAttribute('data-checked-at'))
        if (at) el.textContent = lastCheckedTpl.replace('{ago}', ago(at))
      })
    }

    // Dibujo inicial con los datos incrustados por el servidor.
    document.querySelectorAll('.ekg').forEach(bindHover)
    drawAll(null)

    // Poll cada 30s: trae latencia + estado frescos y repinta la card completa.
    async function refresh() {
      try {
        const res = await fetch('/api/status/latency', { headers: { Accept: 'application/json' } })
        if (!res.ok) return
        const { series, status } = await res.json()
        const byId = {}
        for (const id in series) byId[id] = (series[id] || []).map((p) => p.ms)
        drawAll(byId)
        applyStatus(status)
      } catch { /* red intermitente: reintenta en el próximo tick */ }
    }
    // Los polls solo corren con la pestaña visible. Una pestaña olvidada en
    // segundo plano hacía 2.880 peticiones al día por sí sola, y cada una
    // llegaba al origen cuando el CDN revalidaba. Con esto, una pestaña de
    // fondo cuesta cero y el primer refresh al volver repinta al instante.
    let refreshTimer = null
    function startPolling() {
      if (refreshTimer) return
      refresh()
      refreshTimer = setInterval(refresh, 30_000)
    }
    function stopPolling() {
      if (!refreshTimer) return
      clearInterval(refreshTimer)
      refreshTimer = null
    }
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stopPolling()
      else startPolling()
    })
    if (!document.hidden) startPolling()

    // El "hace X min" sí sigue corriendo: es aritmética local, no pega a la red.
    setInterval(tickAgo, 30_000)
  </script>
</BaseLayout>
