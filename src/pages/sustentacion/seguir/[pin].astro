---
// Vista de seguidor: lo que ve el público en su celular durante la sustentación.
//
// Tres elementos y nada más: número de beat, título corto y dato destacado.
// No replica la presentación, la acompaña. Por eso no hay grafos, ni gráficas,
// ni animaciones: en una pantalla de seis pulgadas y con mala luz, cualquier
// adorno compite con lo único que importa.
//
// El estado inicial se pinta EN EL SERVIDOR. Es lo que garantiza que la
// pantalla nunca esté en blanco: aunque el JavaScript no cargue, aunque el bus
// no conecte, aunque la red se caiga justo después, el beat actual ya está en
// el HTML.
import { getSesionPorPin, toBeatSnapshot } from '../../../lib/sustentacion/bus'
import { busCredentials } from '../../../lib/present/store'

const pin = String(Astro.params.pin ?? '')

// Redis caído lanza en vez de devolver null. Sin capturarlo, esta página daría
// un 500 sin estilos delante del jurado en vez de un "PIN no encontrado": son
// causas distintas, pero el peor caso para quien mira el celular es idéntico,
// no hay sesión que mostrar.
let sesion: Awaited<ReturnType<typeof getSesionPorPin>> = null
try {
  sesion = await getSesionPorPin(pin)
} catch {
  sesion = null
}

if (!sesion) {
  return new Response('PIN no encontrado', { status: 404 })
}

const inicial = toBeatSnapshot(sesion)
const bus = busCredentials()

// El PIN es corto y es lo único que separa a cualquiera de esta vista. No hay
// nada sensible detrás (un índice y un título), pero tampoco hay motivo para
// que la CDN guarde copia de un estado que cambia cada minuto.
Astro.response.headers.set('Cache-Control', 'no-store')
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow')
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#000000" />
    <title>Sustentación · {inicial.pin}</title>
    <style>
      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        min-height: 100%;
        background: #000;
        color: #fff;
        font-family: system-ui, -apple-system, sans-serif;
        /* Ni rebote ni zoom accidental: esto se mira, no se manipula. */
        overscroll-behavior: none;
        -webkit-text-size-adjust: 100%;
      }
      main {
        min-height: 100svh;
        padding: max(1.5rem, env(safe-area-inset-top)) 1.5rem max(1.5rem, env(safe-area-inset-bottom));
        display: grid;
        grid-template-rows: auto 1fr auto;
        gap: 1.5rem;
      }
      .beat {
        font-variant-numeric: tabular-nums;
        font-size: clamp(1.1rem, 4vw, 1.6rem);
        font-weight: 700;
        letter-spacing: 0.08em;
        color: #7d8a9c;
      }
      .centro {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: clamp(1.5rem, 6vw, 2.5rem);
        min-width: 0;
      }
      .titulo {
        margin: 0;
        font-size: clamp(2.4rem, 11vw, 5rem);
        line-height: 1.05;
        font-weight: 700;
        letter-spacing: -0.02em;
        overflow-wrap: break-word;
      }
      .dato {
        margin: 0;
        font-size: clamp(1.6rem, 7vw, 3rem);
        line-height: 1.15;
        font-weight: 600;
        color: #4ade80;
        overflow-wrap: break-word;
      }
      .dato:empty {
        display: none;
      }
      .pie {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 0.95rem;
        color: #4b5563;
      }
      .punto {
        width: 0.6rem;
        height: 0.6rem;
        border-radius: 50%;
        background: #4b5563;
        flex: none;
      }
      /* El indicador solo se nota cuando algo va mal. Sin parpadeos. */
      [data-estado='en-vivo'] .punto {
        background: #4ade80;
      }
      [data-estado='reintentando'] .punto,
      [data-estado='conectando'] .punto {
        background: #f59e0b;
      }
      [data-estado='terminada'] .punto {
        background: #6b7280;
      }
      [data-estado='en-vivo'] .aviso {
        /* En vivo no hace falta decir nada: el PIN basta. */
        visibility: hidden;
      }
    </style>
  </head>
  <body>
    <main data-estado="conectando">
      <div class="beat" id="beat">BEAT {inicial.beat}</div>

      <div class="centro">
        <h1 class="titulo" id="titulo">{inicial.titulo}</h1>
        <p class="dato" id="dato">{inicial.dato ?? ''}</p>
      </div>

      <div class="pie">
        <span class="punto" aria-hidden="true"></span>
        <span class="aviso" id="aviso">Conectando…</span>
        <span style="margin-left:auto; letter-spacing:0.1em">PIN {inicial.pin.toUpperCase()}</span>
      </div>
    </main>

    <script type="application/json" id="cfg" set:html={JSON.stringify({ sessionId: inicial.sessionId, bus })} />

    <script>
      import { seguirSustentacion } from '../../../lib/sustentacion/seguir'

      const cfg = JSON.parse(document.getElementById('cfg')!.textContent!)

      const $main = document.querySelector('main')!
      const $beat = document.getElementById('beat')!
      const $titulo = document.getElementById('titulo')!
      const $dato = document.getElementById('dato')!
      const $aviso = document.getElementById('aviso')!

      const AVISOS = {
        conectando: 'Conectando…',
        'en-vivo': 'En vivo',
        reintentando: 'Sin conexión · reintentando',
        terminada: 'Presentación finalizada',
      }

      seguirSustentacion({
        sessionId: cfg.sessionId,
        bus: cfg.bus,
        onSnapshot: (s) => {
          // Solo se ESCRIBE lo que llega. Nunca se limpia nada: si un campo
          // viniera vacío, se prefiere el valor anterior a un hueco.
          $beat.textContent = `BEAT ${s.beat}`
          if (s.titulo) $titulo.textContent = s.titulo
          $dato.textContent = s.dato ?? ''
        },
        onEstado: (e) => {
          $main.dataset.estado = e
          $aviso.textContent = AVISOS[e] ?? ''
        },
      })
    </script>
  </body>
</html>
