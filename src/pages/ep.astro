---
// Página informativa sobre la etapa productiva SENA (ficha 3114731), en /ep: fechas de
// inicio/fin, bitácoras mensuales y visitas de seguimiento. No sensible, pero
// sin valor de indexación pública ni enlace en el nav.
export const prerender = true

import BaseLayout from '../layouts/BaseLayout.astro'

const inicio = '2026-09-09'
const fin = '2027-03-08'

const bitacoras = [
  { n: 1, desde: '09-sep-2026', hasta: '08-oct-2026' },
  { n: 2, desde: '09-oct-2026', hasta: '08-nov-2026' },
  { n: 3, desde: '09-nov-2026', hasta: '08-dic-2026' },
  { n: 4, desde: '09-dic-2026', hasta: '08-ene-2027' },
  { n: 5, desde: '09-ene-2027', hasta: '08-feb-2027' },
  { n: 6, desde: '09-feb-2027', hasta: '08-mar-2027' },
]

const recursos = [
  {
    label: 'Visita 1 (GFPI-F-023)',
    href: 'https://seantoma.github.io/manual-aprendiz-sena/Formatos/Visita%201%20GFPI-F023.xlsx',
  },
  {
    label: 'Visita 2 (GFPI-F-023)',
    href: 'https://seantoma.github.io/manual-aprendiz-sena/Formatos/Visita%202%20GFPI-F023.xlsx',
  },
  {
    label: 'Visita 3 (GFPI-F-023)',
    href: 'https://seantoma.github.io/manual-aprendiz-sena/Formatos/Visita%203%20GFPI-F023.xlsx',
  },
  {
    label: 'Visita extraordinaria (GFPI-F-023)',
    href: 'https://seantoma.github.io/manual-aprendiz-sena/Formatos/Visita%20Extraordinaria%20GFPI-F023.xlsx',
  },
  {
    label: 'Bitácora (GFPI-F-147)',
    href: 'https://seantoma.github.io/manual-aprendiz-sena/Formatos/BITACORAS%20GFPI-F-147V4.xlsx',
  },
  {
    label: 'Selección de alternativa (GFPI-F-165)',
    href: 'https://seantoma.github.io/manual-aprendiz-sena/Formatos/GFPI-F-165V4_Seleccion_Alternativa.xlsx',
  },
  {
    label: 'Carta de intención',
    href: 'https://seantoma.github.io/manual-aprendiz-sena/Formatos/FORMATO_CARTA_DE_INTENCI%C3%93N_PARA_LA_REALIZACI%C3%93N_DE_PRACTICA_LABORAL.docx',
  },
  {
    label: 'Acta de certificación (GOR-F-084)',
    href: 'https://seantoma.github.io/manual-aprendiz-sena/Formatos/Formato%20acta%20certificacion%20aprendices%20GOR-F%20084v2.docx',
  },
]

const recursosExternos = [
  {
    label: 'Agendar cita con el instructor (Outlook Bookings)',
    href: 'https://outlook.office.com/book/ReservasEtapaProductivaCSF@sena.edu.co/',
  },
  {
    label: 'Manual del aprendiz - recursos y formatos EP',
    href: 'https://seantoma.github.io/manual-aprendiz-sena/recursos_etapa_productiva.html',
  },
  {
    label: 'Plataforma de Ejecución (SENA)',
    href: 'https://ejecucionformacion.sena.edu.co/etapa-productiva',
  },
  {
    label: 'Blog CSF - Etapa productiva',
    href: 'https://serviciosfinancierosena.blogspot.com/p/etapa-productiva.html',
  },
  {
    label: 'Canal de YouTube (tutoriales de diligenciamiento)',
    href: 'https://www.youtube.com/channel/UCH2WKGaNZ3KgfLfCLiV73vw/videos',
  },
]

// Links de descarga por hito del calculador, tomados del mismo array `recursos`
// para no duplicar URLs: si un formato cambia de nombre solo se edita arriba.
const docLinks = {
  f165: recursos.find((r) => r.label.startsWith('Selección de alternativa'))!,
  f023_1: recursos.find((r) => r.label === 'Visita 1 (GFPI-F-023)')!,
  f023_2: recursos.find((r) => r.label === 'Visita 2 (GFPI-F-023)')!,
  f023_3: recursos.find((r) => r.label === 'Visita 3 (GFPI-F-023)')!,
  f147: recursos.find((r) => r.label.startsWith('Bitácora'))!,
}

const visitas = [
  {
    n: 1,
    cuando: 'Primer mes de etapa productiva',
    detalle: 'Entre el 09-sep-2026 y el 08-oct-2026.',
  },
  {
    n: 2,
    cuando: 'Primera semana de diciembre',
    detalle: 'Entre el 01-dic-2026 y el 07-dic-2026, o apenas los instructores retomen labores si están en vacaciones.',
  },
  {
    n: 3,
    cuando: 'Tercer trimestre de la etapa',
    detalle: 'Aprox. 3 meses después de la visita 2, hacia el cierre de la etapa productiva (08-mar-2027).',
  },
]
---

<BaseLayout
  title="Etapa productiva SENA - Ficha 3114731"
  description="Fechas de inicio/fin, bitácoras mensuales y visitas de seguimiento de la etapa productiva."
  image="/og-default.png"
  noindex={true}
>
  <div class="max-w-[720px] mx-auto px-6 md:px-12 pt-32 pb-24">

    <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-6">
      <span class="text-cyan">/ep</span>
      <span class="h-px flex-1 bg-gradient-to-r from-white/15 to-transparent max-w-[80px]"></span>
      <span>Etapa productiva SENA</span>
    </div>

    <h1 class="font-sans text-4xl md:text-5xl font-medium tracking-[-.03em] text-mask leading-[1.05] mb-4">
      Ficha 3114731
    </h1>
    <p class="text-[15px] text-ink-100 leading-relaxed max-w-lg mb-10">
      Seguimiento de la etapa productiva: fecha de inicio y fin, bitácoras mensuales
      y visitas de seguimiento.
    </p>

    <div class="rounded-2xl glass border-accent p-6 mb-8">
      <div class="flex items-center gap-2 mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-cyan"></span>
        <span class="text-[11px] font-mono uppercase tracking-wider text-ink-100">Qué es la etapa productiva</span>
      </div>
      <p class="text-[13px] text-ink-100 leading-relaxed mb-3">
        Es la fase final de la formación titulada del SENA: el aprendiz aplica
        lo aprendido en la etapa lectiva resolviendo problemas en un contexto
        real (o simulado, si no hay alternativa disponible). Es requisito para
        certificarse y tiene un plazo máximo de 24 meses desde el fin de la
        etapa lectiva para iniciarse.
      </p>
      <p class="text-[13px] text-ink-100 leading-relaxed mb-3">
        Modalidades posibles: contrato de aprendizaje, vínculo laboral,
        pasantía, proyecto productivo, creación de unidad productiva o
        monitoría (para tecnólogos, en el propio centro de formación). El
        contrato de aprendizaje y el vínculo laboral tienen remuneración
        obligatoria por ley; otras modalidades pueden ser sin remuneración.
      </p>
      <p class="text-[13px] text-ink-100 leading-relaxed">
        El plan de trabajo se registra en el formato GFPI-F-023 (actividades,
        plazos y evidencias) al inicio. La evaluación final combina factores
        actitudinales y técnicos, además del cumplimiento de bitácoras y
        visitas de seguimiento.
      </p>
    </div>

    <div class="rounded-2xl glass border-accent p-6 mb-8">
      <div class="flex items-center gap-2 mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-cyan"></span>
        <span class="text-[11px] font-mono uppercase tracking-wider text-ink-100">Duración</span>
      </div>
      <div class="grid grid-cols-2 gap-4 text-[13px]">
        <div>
          <div class="text-[10px] font-mono uppercase tracking-wider text-ink-300 mb-1">Inicio</div>
          <div class="text-ink-100">{inicio} · 09-sep-2026</div>
        </div>
        <div>
          <div class="text-[10px] font-mono uppercase tracking-wider text-ink-300 mb-1">Fin</div>
          <div class="text-ink-100">{fin} · 08-mar-2027</div>
        </div>
      </div>
      <p class="text-[12px] text-ink-300 mt-3">6 meses de etapa productiva.</p>
    </div>

    <div class="rounded-2xl glass border-accent p-6 mb-8">
      <div class="flex items-center gap-2 mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-cyan"></span>
        <span class="text-[11px] font-mono uppercase tracking-wider text-ink-100">Bitácoras (6, periodicidad mensual)</span>
      </div>
      <div class="space-y-2">
        {bitacoras.map((b) => (
          <div class="flex items-center justify-between text-[13px] rounded-lg bg-white/[.03] border border-white/10 px-3 py-2.5">
            <span class="text-ink-100">Bitácora {b.n}</span>
            <span class="text-ink-300 font-mono text-[12px]">{b.desde} → {b.hasta}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="rounded-2xl glass border-accent p-6">
      <div class="flex items-center gap-2 mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-cyan"></span>
        <span class="text-[11px] font-mono uppercase tracking-wider text-ink-100">Visitas de seguimiento (3, cada 3 meses)</span>
      </div>
      <div class="space-y-3">
        {visitas.map((v) => (
          <div class="rounded-lg bg-white/[.03] border border-white/10 px-3 py-2.5">
            <div class="flex items-center justify-between text-[13px] mb-1">
              <span class="text-ink-100">Visita {v.n}</span>
              <span class="text-cyan font-mono text-[12px]">{v.cuando}</span>
            </div>
            <p class="text-[12px] text-ink-300 leading-relaxed">{v.detalle}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="rounded-2xl glass border-accent p-6 mt-8" id="calc" data-doc-links={JSON.stringify(docLinks)}>
      <div class="flex items-center gap-2 mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-cyan"></span>
        <span class="text-[11px] font-mono uppercase tracking-wider text-ink-100">Calculadora de cronograma</span>
      </div>
      <p class="text-[12px] text-ink-300 leading-relaxed mb-4">
        Proyecta bitácoras, visitas y cierre a partir de tu fecha de inicio real.
        Útil para verificar el cronograma de arriba o simular otra ficha.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4">
        <label class="grid gap-1.5">
          <span class="text-[10px] font-mono uppercase tracking-wider text-ink-300">Tipo de programa</span>
          <select
            id="calc-tipo"
            class="h-11 px-3 rounded-lg bg-white/[.03] border border-white/10 text-[13px] text-ink-100 focus:border-cyan/40 outline-none"
          >
            <option value="tecnico">Técnico · 6 meses</option>
            <option value="tecnologo">Tecnólogo · 9 meses</option>
          </select>
        </label>
        <label class="grid gap-1.5">
          <span class="text-[10px] font-mono uppercase tracking-wider text-ink-300">Fecha de inicio</span>
          <input
            id="calc-inicio"
            type="date"
            class="h-11 px-3 rounded-lg bg-white/[.03] border border-white/10 text-[13px] text-ink-100 focus:border-cyan/40 outline-none [color-scheme:dark]"
          />
        </label>
      </div>

      <button
        id="calc-generar"
        type="button"
        class="w-full h-11 rounded-full bg-cyan text-ink-950 text-[13px] font-medium hover:brightness-110 transition-all"
      >
        Generar cronograma
      </button>
      <p id="calc-error" class="text-[12px] text-ember mt-2 hidden">Selecciona una fecha de inicio.</p>

      <div id="calc-resultados" class="mt-6 hidden">
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-4">
          <div class="rounded-lg bg-white/[.03] border border-white/10 px-3 py-2.5 text-center">
            <div id="calc-sum-duracion" class="text-[15px] text-ink-50 font-medium"></div>
            <div class="text-[10px] font-mono uppercase text-ink-300 mt-1">Duración</div>
          </div>
          <div class="rounded-lg bg-white/[.03] border border-white/10 px-3 py-2.5 text-center">
            <div id="calc-sum-bitacoras" class="text-[15px] text-ink-50 font-medium"></div>
            <div class="text-[10px] font-mono uppercase text-ink-300 mt-1">Bitácoras</div>
          </div>
          <div class="rounded-lg bg-white/[.03] border border-white/10 px-3 py-2.5 text-center">
            <div class="text-[15px] text-ink-50 font-medium">3</div>
            <div class="text-[10px] font-mono uppercase text-ink-300 mt-1">Visitas</div>
          </div>
          <div class="rounded-lg bg-white/[.03] border border-white/10 px-3 py-2.5 text-center">
            <div id="calc-sum-cierre" class="text-[13px] text-ink-50 font-medium"></div>
            <div class="text-[10px] font-mono uppercase text-ink-300 mt-1">Cierre</div>
          </div>
        </div>

        <div id="calc-next" class="flex items-center gap-3 rounded-lg bg-lime/10 border border-lime/30 px-3 py-2.5 mb-2">
          <span class="w-2 h-2 rounded-full bg-lime shrink-0"></span>
          <span class="text-[12px] text-ink-100"><strong class="text-lime font-medium">Próximo hito:</strong> <span id="calc-next-text"></span></span>
        </div>
        <p id="calc-progreso" class="text-[11px] font-mono text-ink-300 mb-4"></p>

        <div class="flex flex-wrap gap-2 mb-4" role="tablist" aria-label="Filtrar hitos">
          <button type="button" data-filter="all" class="calc-chip text-[11px] font-mono uppercase px-3 py-1.5 rounded-full border border-cyan/40 bg-cyan/10 text-cyan">Todos</button>
          <button type="button" data-filter="visita" class="calc-chip text-[11px] font-mono uppercase px-3 py-1.5 rounded-full border border-white/10 text-ink-200">Visitas</button>
          <button type="button" data-filter="bitacora" class="calc-chip text-[11px] font-mono uppercase px-3 py-1.5 rounded-full border border-white/10 text-ink-200">Bitácoras</button>
          <button type="button" data-filter="inicio" class="calc-chip text-[11px] font-mono uppercase px-3 py-1.5 rounded-full border border-white/10 text-ink-200">Inicio / cierre</button>
        </div>

        <div id="calc-timeline" class="space-y-2"></div>

        <div class="flex flex-wrap gap-2 mt-4 pt-4 border-t border-white/10">
          <a
            href="https://outlook.office.com/book/ReservasEtapaProductivaCSF@sena.edu.co/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[12px] font-mono text-lime border border-lime/30 bg-lime/10 rounded-full px-3 py-1.5 hover:brightness-110 transition-all"
          >
            Agendar visita
          </a>
          <button id="calc-print" type="button" class="text-[12px] font-mono text-ink-200 border border-white/10 rounded-full px-3 py-1.5 hover:bg-white/[.06] transition-colors">
            Imprimir / PDF
          </button>
          <button id="calc-ics" type="button" class="text-[12px] font-mono text-cyan border border-cyan/30 bg-cyan/10 rounded-full px-3 py-1.5 hover:brightness-110 transition-all">
            Exportar a calendario (.ics)
          </button>
          <button id="calc-share" type="button" class="text-[12px] font-mono text-ink-200 border border-white/10 rounded-full px-3 py-1.5 hover:bg-white/[.06] transition-colors">
            Copiar link para compartir
          </button>
        </div>
        <p id="calc-toast" class="text-[11px] text-lime mt-2 hidden"></p>

        <div class="mt-4 pt-4 border-t border-white/10">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-[10px] font-mono uppercase tracking-wider text-ink-300">Recordatorio por email (solo admin)</span>
          </div>
          <p class="text-[11px] text-ink-300 leading-relaxed mb-2">
            Activa un cron diario que te avisa por correo cuando falten pocos días para un hito.
            Solo funciona con sesión de administrador; no recolecta el email de nadie más.
          </p>
          <div class="flex flex-wrap items-center gap-2">
            <button id="calc-remind-on" type="button" class="text-[12px] font-mono text-lime border border-lime/30 bg-lime/10 rounded-full px-3 py-1.5 hover:brightness-110 transition-all">
              Avisarme de esta simulación
            </button>
            <button id="calc-remind-off" type="button" class="text-[12px] font-mono text-ink-200 border border-white/10 rounded-full px-3 py-1.5 hover:bg-white/[.06] transition-colors hidden">
              Desactivar recordatorio
            </button>
            <span id="calc-remind-status" class="text-[11px] text-ink-300"></span>
          </div>
        </div>
      </div>
    </div>

    <div class="rounded-2xl glass border-accent p-6 mt-8">
      <div class="flex items-center gap-2 mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-cyan"></span>
        <span class="text-[11px] font-mono uppercase tracking-wider text-ink-100">Formatos descargables</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
        {recursos.map((r) => (
          <a
            href={r.href}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between gap-3 text-[13px] rounded-lg bg-white/[.03] border border-white/10 px-3 py-2.5 hover:bg-white/[.06] transition-colors"
          >
            <span class="text-ink-100">{r.label}</span>
            <span class="text-cyan font-mono text-[11px]">↓</span>
          </a>
        ))}
      </div>
    </div>

    <div class="rounded-2xl glass border-accent p-6 mt-8">
      <div class="flex items-center gap-2 mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-cyan"></span>
        <span class="text-[11px] font-mono uppercase tracking-wider text-ink-100">Recursos externos</span>
      </div>
      <div class="space-y-2">
        {recursosExternos.map((r) => (
          <a
            href={r.href}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between gap-3 text-[13px] rounded-lg bg-white/[.03] border border-white/10 px-3 py-2.5 hover:bg-white/[.06] transition-colors"
          >
            <span class="text-ink-100">{r.label}</span>
            <span class="text-cyan font-mono text-[11px]">↗</span>
          </a>
        ))}
      </div>
    </div>

  </div>
</BaseLayout>

<script>
  // Calculadora de cronograma: la proyección de hitos vive en
  // src/lib/sena-ep.ts (módulo puro isomorfo) para que este script y el cron
  // de recordatorios (api/cron/sena-recordatorio) no dupliquen la fórmula.
  // Los enlaces de descarga salen de `data-doc-links`, generado en el
  // frontmatter a partir del mismo array que ya usa la card de formatos.

  import { computeHitos, type Hito as HitoBase, type TipoPrograma, type DocKey } from '../lib/sena-ep'

  type Estado = 'past' | 'next' | 'future'
  type DocLink = { label: string; href: string }
  type Hito = HitoBase & { estado: Estado }

  const root = document.getElementById('calc')
  if (root) {
    const docLinks = JSON.parse(root.dataset.docLinks ?? '{}') as Record<DocKey, DocLink>

    const tipoEl = document.getElementById('calc-tipo') as HTMLSelectElement
    const inicioEl = document.getElementById('calc-inicio') as HTMLInputElement
    const errorEl = document.getElementById('calc-error')!
    const resultadosEl = document.getElementById('calc-resultados')!
    const timelineEl = document.getElementById('calc-timeline')!
    const nextTextEl = document.getElementById('calc-next-text')!
    const toastEl = document.getElementById('calc-toast')!
    const progresoEl = document.getElementById('calc-progreso')!

    // Los últimos hitos calculados quedan aquí para que exportar/compartir no
    // tengan que recalcular ni leer el DOM.
    let hitosActuales: Hito[] = []
    let checklistKeyActual = ''
    let toastTimer: ReturnType<typeof setTimeout> | undefined

    function mostrarToast(mensaje: string) {
      toastEl.textContent = mensaje
      toastEl.classList.remove('hidden')
      clearTimeout(toastTimer)
      toastTimer = setTimeout(() => toastEl.classList.add('hidden'), 3200)
    }

    const startOfDay = (d: Date) => {
      const x = new Date(d)
      x.setHours(0, 0, 0, 0)
      return x
    }
    const addDays = (d: Date, n: number) => {
      const x = new Date(d)
      x.setDate(x.getDate() + n)
      return x
    }
    const fmtCorto = (d: Date) =>
      d.toLocaleDateString('es-CO', { day: '2-digit', month: 'short', year: 'numeric' })
    const fmtLargo = (d: Date) =>
      d.toLocaleDateString('es-CO', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })
    const diasEntre = (a: Date, b: Date) => Math.round((startOfDay(b).getTime() - startOfDay(a).getTime()) / 86400000)
    const claveHito = (h: HitoBase) => `${h.titulo}|${h.fecha.toISOString().slice(0, 10)}`

    // Checklist "entregado" por hito, persistido en localStorage por
    // combinación tipo+inicio (cada simulación tiene su propio progreso).
    function leerChecklist(key: string): Set<string> {
      try {
        return new Set(JSON.parse(localStorage.getItem(key) ?? '[]'))
      } catch {
        return new Set()
      }
    }
    function actualizarProgreso() {
      const set = leerChecklist(checklistKeyActual)
      const total = hitosActuales.length
      const hechos = hitosActuales.filter((h) => set.has(claveHito(h))).length
      progresoEl.textContent = total > 0 ? `${hechos}/${total} hitos marcados como entregados` : ''
    }

    function calcular() {
      const valor = inicioEl.value
      if (!valor) {
        errorEl.classList.remove('hidden')
        return
      }
      errorEl.classList.add('hidden')

      const tipo = tipoEl.value as TipoPrograma
      const hoy = startOfDay(new Date())

      let hitosBase: HitoBase[]
      try {
        hitosBase = computeHitos(tipo, valor)
      } catch {
        errorEl.textContent = 'Fecha de inicio inválida.'
        errorEl.classList.remove('hidden')
        return
      }

      let indiceProximo = hitosBase.findIndex((h) => startOfDay(h.fecha) >= hoy)
      if (indiceProximo === -1) indiceProximo = hitosBase.length - 1

      const hitosConEstado: Hito[] = hitosBase.map((h, i) => ({
        ...h,
        estado: startOfDay(h.fecha) < hoy ? 'past' : i === indiceProximo ? 'next' : 'future',
      }))

      const fechaCierre = hitosBase[hitosBase.length - 1].fecha
      const meses = hitosBase.filter((h) => h.categoria === 'bitacora').length

      document.getElementById('calc-sum-duracion')!.textContent = `${meses} meses`
      document.getElementById('calc-sum-bitacoras')!.textContent = String(meses)
      document.getElementById('calc-sum-cierre')!.textContent = fmtCorto(fechaCierre)

      const proximo = hitosConEstado[indiceProximo]
      const delta = diasEntre(hoy, proximo.fecha)
      const cuando = delta === 0 ? 'hoy' : delta > 0 ? `en ${delta} día${delta === 1 ? '' : 's'}` : 'ya venció'
      nextTextEl.textContent = `${proximo.titulo} · ${fmtCorto(proximo.fecha)} (${cuando})`

      const colorPorEstado: Record<Estado, string> = {
        past: 'text-ink-300',
        next: 'text-lime',
        future: 'text-cyan',
      }
      const labelPorEstado: Record<Estado, string> = {
        past: 'Pasado',
        next: 'Próximo',
        future: 'Pendiente',
      }

      checklistKeyActual = `sena-ep-checklist:${tipo}:${valor}`
      const checklist = leerChecklist(checklistKeyActual)

      timelineEl.innerHTML = ''
      for (const h of hitosConEstado) {
        const doc = docLinks[h.docKey]
        const key = claveHito(h)
        const entregado = checklist.has(key)

        const item = document.createElement('div')
        item.className =
          'calc-item rounded-lg border px-3 py-2.5 ' +
          (h.estado === 'next'
            ? 'bg-lime/[.06] border-lime/30'
            : h.estado === 'past'
              ? 'bg-white/[.02] border-white/10 opacity-70'
              : 'bg-white/[.03] border-white/10')
        item.dataset.categoria = h.categoria

        item.innerHTML = `
          <div class="flex items-center justify-between text-[13px] mb-1 gap-2">
            <span class="calc-title text-ink-100${entregado ? ' line-through text-ink-300' : ''}">${h.titulo}</span>
            <span class="${colorPorEstado[h.estado]} font-mono text-[11px] uppercase shrink-0">${labelPorEstado[h.estado]}</span>
          </div>
          <div class="text-cyan font-mono text-[11px] mb-1.5">${fmtLargo(h.fecha)}</div>
          <p class="text-[12px] text-ink-300 leading-relaxed mb-2">${h.detalle}</p>
          <div class="flex items-center justify-between gap-3">
            <a href="${doc.href}" target="_blank" rel="noopener noreferrer" class="text-cyan font-mono text-[11px] hover:underline">${doc.label} ↓</a>
            <label class="flex items-center gap-1.5 cursor-pointer select-none">
              <input type="checkbox" data-key="${key}" class="calc-check w-3.5 h-3.5 rounded border-white/20 bg-white/5 accent-cyan" ${entregado ? 'checked' : ''} />
              <span class="text-[10px] font-mono uppercase text-ink-300">Entregado</span>
            </label>
          </div>
        `
        timelineEl.appendChild(item)
      }

      timelineEl.querySelectorAll<HTMLInputElement>('.calc-check').forEach((cb) => {
        cb.addEventListener('change', () => {
          const set = leerChecklist(checklistKeyActual)
          const k = cb.dataset.key!
          if (cb.checked) set.add(k)
          else set.delete(k)
          localStorage.setItem(checklistKeyActual, JSON.stringify([...set]))
          const titulo = cb.closest('.calc-item')?.querySelector('.calc-title')
          titulo?.classList.toggle('line-through', cb.checked)
          titulo?.classList.toggle('text-ink-300', cb.checked)
          actualizarProgreso()
        })
      })

      document.querySelectorAll<HTMLButtonElement>('.calc-chip').forEach((chip) => {
        chip.classList.toggle('active', chip.dataset.filter === 'all')
      })
      applyFiltro('all')

      hitosActuales = hitosConEstado
      actualizarProgreso()

      // El estado mínimo para reconstruir el cronograma cabe en la URL: así un
      // link compartido no necesita backend ni base de datos.
      const params = new URLSearchParams({ tipo, inicio: valor })
      history.replaceState(null, '', `?${params.toString()}`)

      resultadosEl.classList.remove('hidden')
      resultadosEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' })
      actualizarEstadoRecordatorio()
    }

    function applyFiltro(filtro: string) {
      document.querySelectorAll<HTMLDivElement>('#calc-timeline > div').forEach((item) => {
        item.classList.toggle('hidden', filtro !== 'all' && item.dataset.categoria !== filtro)
      })
    }

    // RFC 5545 escapa coma, punto y coma y salto de línea con backslash.
    const escapeIcs = (s: string) => s.replace(/([,;])/g, '\\$1').replace(/\n/g, '\\n')
    const fechaIcs = (d: Date) => {
      const y = d.getFullYear()
      const m = String(d.getMonth() + 1).padStart(2, '0')
      const day = String(d.getDate()).padStart(2, '0')
      return `${y}${m}${day}`
    }

    function exportarIcs() {
      if (hitosActuales.length === 0) return

      const dtstamp = fechaIcs(new Date()) + 'T000000Z'
      const eventos = hitosActuales.map((h, i) => {
        const inicio = fechaIcs(h.fecha)
        const fin = fechaIcs(addDays(h.fecha, 1))
        return [
          'BEGIN:VEVENT',
          `UID:ep-3114731-${i}@codebymike.tech`,
          `DTSTAMP:${dtstamp}`,
          `DTSTART;VALUE=DATE:${inicio}`,
          `DTEND;VALUE=DATE:${fin}`,
          `SUMMARY:${escapeIcs(h.titulo)}`,
          `DESCRIPTION:${escapeIcs(h.detalle)}`,
          'END:VEVENT',
        ].join('\r\n')
      })

      const ics = [
        'BEGIN:VCALENDAR',
        'VERSION:2.0',
        'PRODID:-//CodeByMike//Etapa Productiva SENA//ES',
        'CALSCALE:GREGORIAN',
        ...eventos,
        'END:VCALENDAR',
      ].join('\r\n')

      const blob = new Blob([ics], { type: 'text/calendar;charset=utf-8' })
      const url = URL.createObjectURL(blob)
      const a = document.createElement('a')
      a.href = url
      a.download = 'etapa-productiva-3114731.ics'
      document.body.appendChild(a)
      a.click()
      a.remove()
      URL.revokeObjectURL(url)
      mostrarToast(`${hitosActuales.length} hitos exportados al calendario`)
    }

    async function compartir() {
      const params = new URLSearchParams({ tipo: tipoEl.value, inicio: inicioEl.value })
      const url = `${location.origin}${location.pathname}?${params.toString()}`
      try {
        await navigator.clipboard.writeText(url)
        mostrarToast('Link copiado al portapapeles')
      } catch {
        mostrarToast(url)
      }
    }

    // Recordatorio por email: personal, solo admin. La suscripción activa
    // (si hay) vive en Turso vía /api/admin/sena-recordatorio; el middleware
    // exige sesión admin en ese endpoint, así que un visitante sin sesión solo
    // ve el 401 al intentar activarlo.
    const remindOnBtn = document.getElementById('calc-remind-on') as HTMLButtonElement
    const remindOffBtn = document.getElementById('calc-remind-off') as HTMLButtonElement
    const remindStatusEl = document.getElementById('calc-remind-status')!

    interface RecordatorioActivo {
      tipo: TipoPrograma
      inicio: string
    }

    async function actualizarEstadoRecordatorio() {
      try {
        const res = await fetch('/api/admin/sena-recordatorio')
        if (!res.ok) {
          remindStatusEl.textContent = res.status === 401 ? 'Inicia sesión de admin para activarlo.' : ''
          remindOnBtn.classList.remove('hidden')
          remindOffBtn.classList.add('hidden')
          return
        }
        const sub = (await res.json()) as RecordatorioActivo | null
        const coincide = sub && sub.tipo === tipoEl.value && sub.inicio === inicioEl.value
        remindOnBtn.classList.toggle('hidden', Boolean(sub))
        remindOffBtn.classList.toggle('hidden', !sub)
        remindStatusEl.textContent = sub
          ? coincide
            ? 'Activo para esta simulación.'
            : `Activo para otra simulación (${sub.tipo}, inicio ${sub.inicio}).`
          : ''
      } catch {
        remindStatusEl.textContent = ''
      }
    }

    async function activarRecordatorio() {
      const res = await fetch('/api/admin/sena-recordatorio', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ tipo: tipoEl.value, inicio: inicioEl.value }),
      })
      if (res.status === 401) {
        mostrarToast('Necesitas sesión de admin - inicia sesión primero')
        return
      }
      if (!res.ok) {
        mostrarToast('No se pudo activar el recordatorio')
        return
      }
      mostrarToast('Recordatorio activado')
      actualizarEstadoRecordatorio()
    }

    async function desactivarRecordatorio() {
      const res = await fetch('/api/admin/sena-recordatorio', { method: 'DELETE' })
      if (res.ok) mostrarToast('Recordatorio desactivado')
      actualizarEstadoRecordatorio()
    }

    document.getElementById('calc-generar')?.addEventListener('click', calcular)
    document.getElementById('calc-print')?.addEventListener('click', () => window.print())
    document.getElementById('calc-ics')?.addEventListener('click', exportarIcs)
    document.getElementById('calc-share')?.addEventListener('click', compartir)
    remindOnBtn?.addEventListener('click', activarRecordatorio)
    remindOffBtn?.addEventListener('click', desactivarRecordatorio)

    document.querySelectorAll<HTMLButtonElement>('.calc-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        document.querySelectorAll<HTMLButtonElement>('.calc-chip').forEach((c) => {
          c.classList.remove('bg-cyan/10', 'border-cyan/40', 'text-cyan')
          c.classList.add('border-white/10', 'text-ink-200')
        })
        chip.classList.remove('border-white/10', 'text-ink-200')
        chip.classList.add('bg-cyan/10', 'border-cyan/40', 'text-cyan')
        applyFiltro(chip.dataset.filter ?? 'all')
      })
    })

    // Un link compartido trae tipo+inicio en la query string: precargar y
    // calcular de una vez para que quien lo reciba no tenga que hacer nada.
    const urlParams = new URLSearchParams(location.search)
    const tipoParam = urlParams.get('tipo')
    const inicioParam = urlParams.get('inicio')
    if (inicioParam) {
      if (tipoParam === 'tecnico' || tipoParam === 'tecnologo') tipoEl.value = tipoParam
      inicioEl.value = inicioParam
      calcular()
    }
  }
</script>
