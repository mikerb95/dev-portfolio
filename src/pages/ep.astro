---
// Página de la etapa productiva SENA (ficha 3114731), en /ep: el cronograma
// real de la ficha, una calculadora para proyectar otra, y los formatos
// oficiales. No sensible, pero sin valor de indexación pública ni enlace en
// el nav.
export const prerender = true

import BaseLayout from '../layouts/BaseLayout.astro'
import { diaInhabil, habilAnterior } from '../lib/festivos-co'

const INICIO_ISO = '2026-09-09'
const FIN_ISO = '2027-03-08'
const MESES = 6

const fecha = (iso: string) => new Date(`${iso}T00:00:00`)
const inicioD = fecha(INICIO_ISO)
const finD = fecha(FIN_ISO)

const addDays = (x: Date, n: number) => {
  const y = new Date(x)
  y.setDate(y.getDate() + n)
  return y
}
const addMonths = (x: Date, n: number) => {
  const y = new Date(x)
  y.setMonth(y.getMonth() + n)
  return y
}

// Formateo propio en vez de toLocaleDateString: esta salida entra en el HTML
// prerenderizado y no debe depender del ICU del runtime que corra el build.
const MES_CORTO = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic']
const fCorto = (x: Date) => `${String(x.getDate()).padStart(2, '0')}-${MES_CORTO[x.getMonth()]}`
const DIA_CORTO = ['dom', 'lun', 'mar', 'mié', 'jue', 'vie', 'sáb']
const fLargo = (x: Date) => `${fCorto(x)}-${x.getFullYear()}`

// Posición de una fecha dentro de la línea de tiempo, en % del ancho total.
const spanMs = finD.getTime() - inicioD.getTime()
const pctDe = (x: Date) => ((x.getTime() - inicioD.getTime()) / spanMs) * 100
const clamp = (n: number) => Math.min(100, Math.max(0, n))
const banda = (desde: Date, hasta: Date) => {
  const izq = clamp(pctDe(desde))
  return { left: izq, width: Math.max(1.5, clamp(pctDe(hasta)) - izq) }
}

// Las seis ventanas de bitácora se derivan de la fecha de inicio en vez de
// escribirse a mano: una por mes, cerrando el día antes de que abra la
// siguiente. Cambiar INICIO_ISO recoloca la tabla y la línea de tiempo.
const bitacoras = Array.from({ length: MESES }, (_, i) => {
  const desde = addMonths(inicioD, i)
  const hasta = addDays(addMonths(inicioD, i + 1), -1)
  // El cierre de la ventana es la fecha que importa: si cae en fin de semana o
  // festivo no hay a quién entregarle, y el aviso propone el hábil anterior.
  const inhabil = diaInhabil(hasta)
  return {
    n: i + 1,
    desde,
    hasta,
    inhabil,
    sugerido: inhabil ? habilAnterior(hasta) : null,
    ...banda(desde, hasta),
  }
})

const visitas = [
  {
    n: 1,
    titulo: 'Concertación',
    desde: inicioD,
    hasta: addDays(addMonths(inicioD, 1), -1),
    detalle: 'El instructor valida el plan de trabajo con la empresa dentro del primer mes.',
  },
  {
    n: 2,
    titulo: 'Seguimiento',
    desde: fecha('2026-12-01'),
    hasta: fecha('2026-12-07'),
    detalle: 'Primera semana de diciembre, o apenas los instructores retomen labores si están en vacaciones.',
  },
  {
    n: 3,
    titulo: 'Final y cierre',
    desde: fecha('2027-03-01'),
    hasta: finD,
    detalle: 'Evaluación final, paz y salvo y cierre, unos tres meses después de la visita 2.',
  },
].map((v) => ({ ...v, ...banda(v.desde, v.hasta) }))

// Marcas de mes de la regla superior. El primer mes empieza antes del inicio
// de la etapa (09-sep), así que su marca se pega al borde izquierdo.
const marcasMes: { label: string; left: number }[] = []
const cursorMes = new Date(inicioD.getFullYear(), inicioD.getMonth(), 1)
while (cursorMes <= finD) {
  marcasMes.push({
    label: cursorMes.getMonth() === 0 ? `${MES_CORTO[0]} ${cursorMes.getFullYear()}` : MES_CORTO[cursorMes.getMonth()],
    left: clamp(pctDe(cursorMes)),
  })
  cursorMes.setMonth(cursorMes.getMonth() + 1)
}

const contexto = [
  {
    titulo: 'Qué es',
    cuerpo:
      'La fase final de la formación titulada: el aprendiz aplica lo aprendido resolviendo problemas en un contexto real (o simulado, si no hay alternativa disponible). Es requisito para certificarse.',
  },
  {
    titulo: 'Alternativas vigentes',
    cuerpo:
      'Contrato de aprendizaje, contrato de vínculo formativo, proyecto productivo, vínculo laboral, monitoría y prácticas en la economía popular o campesina. Las dos primeras formas de vínculo tienen remuneración obligatoria por ley; las demás pueden ser sin remuneración.',
  },
  {
    titulo: 'Plazo',
    cuerpo:
      'La planeación se presenta a más tardar en la finalización por fecha del grupo-ficha. Pasada esa fecha sin planeación presentada, el Acuerdo 0009 de 2024 lo cuenta como deserción.',
  },
  {
    titulo: 'Evaluación',
    cuerpo:
      'El plan de trabajo se registra al inicio en el GFPI-F-023 (actividades, plazos y evidencias). La evaluación final combina factores actitudinales y técnicos, más el cumplimiento de bitácoras y visitas.',
  },
]

const recursos = [
  {
    label: 'Visita 1 (GFPI-F-023)',
    href: 'https://seantoma.github.io/manual-aprendiz-sena/Formatos/Visita%201%20GFPI-F023.xlsx',
  },
  {
    label: 'Visita 2 (GFPI-F-023)',
    href: 'https://seantoma.github.io/manual-aprendiz-sena/Formatos/Visita%202%20GFPI-F023.xlsx',
  },
  {
    label: 'Visita 3 (GFPI-F-023)',
    href: 'https://seantoma.github.io/manual-aprendiz-sena/Formatos/Visita%203%20GFPI-F023.xlsx',
  },
  {
    label: 'Visita extraordinaria (GFPI-F-023)',
    href: 'https://seantoma.github.io/manual-aprendiz-sena/Formatos/Visita%20Extraordinaria%20GFPI-F023.xlsx',
  },
  {
    label: 'Bitácora (GFPI-F-147)',
    href: 'https://seantoma.github.io/manual-aprendiz-sena/Formatos/BITACORAS%20GFPI-F-147V4.xlsx',
  },
  {
    label: 'Selección de alternativa (GFPI-F-165)',
    href: 'https://seantoma.github.io/manual-aprendiz-sena/Formatos/GFPI-F-165V4_Seleccion_Alternativa.xlsx',
  },
  {
    label: 'Carta de intención',
    href: 'https://seantoma.github.io/manual-aprendiz-sena/Formatos/FORMATO_CARTA_DE_INTENCI%C3%93N_PARA_LA_REALIZACI%C3%93N_DE_PRACTICA_LABORAL.docx',
  },
  {
    label: 'Acta de certificación (GOR-F-084)',
    href: 'https://seantoma.github.io/manual-aprendiz-sena/Formatos/Formato%20acta%20certificacion%20aprendices%20GOR-F%20084v2.docx',
  },
]

const recursosExternos = [
  {
    label: 'Reglamento del Aprendiz vigente (Acuerdo 0009 de 2024)',
    href: 'https://normograma.sena.edu.co/compilacion/docs/acuerdo_sena_0009_2024.htm',
  },
  {
    label: 'Diseño curricular ADSO (código 228118)',
    href: 'https://zajuna.sena.edu.co/pdfs/titulada/tecgnologias/analisis_desarrollo_software.pdf',
  },
  {
    label: 'Manual del aprendiz - recursos y formatos EP',
    href: 'https://seantoma.github.io/manual-aprendiz-sena/recursos_etapa_productiva.html',
  },
  {
    label: 'Plataforma de Ejecución (SENA)',
    href: 'https://ejecucionformacion.sena.edu.co/etapa-productiva',
  },
  {
    label: 'Blog CSF - Etapa productiva',
    href: 'https://serviciosfinancierosena.blogspot.com/p/etapa-productiva.html',
  },
  {
    label: 'Tutoriales de diligenciamiento (YouTube)',
    href: 'https://www.youtube.com/channel/UCH2WKGaNZ3KgfLfCLiV73vw/videos',
  },
]

const AGENDAR_HREF = 'https://outlook.office.com/book/ReservasEtapaProductivaCSF@sena.edu.co/'

// La insignia de cada enlace sale del propio href: extensión para los formatos
// descargables, dominio para los externos. Así una URL nueva no obliga a
// escribir también su etiqueta.
const extension = (href: string) => (href.split('?')[0].split('.').pop() ?? '').toUpperCase()
const dominio = (href: string) => new URL(href).hostname.replace(/^www\./, '')

// Links de descarga por hito del calculador, tomados del mismo array `recursos`
// para no duplicar URLs: si un formato cambia de nombre solo se edita arriba.
const docLinks = {
  f165: recursos.find((r) => r.label.startsWith('Selección de alternativa'))!,
  f023_1: recursos.find((r) => r.label === 'Visita 1 (GFPI-F-023)')!,
  f023_2: recursos.find((r) => r.label === 'Visita 2 (GFPI-F-023)')!,
  f023_3: recursos.find((r) => r.label === 'Visita 3 (GFPI-F-023)')!,
  f147: recursos.find((r) => r.label.startsWith('Bitácora'))!,
}

// Checklist de cierre: los documentos que pide el juicio de etapa productiva
// y la certificación académica (infografía SENA - Centro de Servicios
// Financieros, Regional Distrito Capital). Se reutilizan los links de
// `recursos` para los dos formatos que ya existen ahí (F-147 y F-023).
const documentosCierre = [
  { texto: 'Fotocopia del documento de identidad ampliada al 150 %.' },
  { texto: 'Carta donde se indique que no le fue entregado carné por parte del Centro de Formación.' },
  { texto: 'Certificado de inscripción en la Agencia Pública de Empleo.' },
  { texto: 'Pantallazo de actualización de datos en SENA Sofía Plus.' },
  {
    texto:
      'Certificación expedida por la empresa, indicando las fechas exactas de inicio y finalización de la Etapa Productiva.',
  },
  {
    texto:
      'Formato GFPI-F-147 V5 (Bitácora de Seguimiento de Etapa Productiva), debidamente diligenciada, firmada y organizada en orden cronológico.',
    doc: recursos.find((r) => r.label.startsWith('Bitácora')),
  },
  {
    texto:
      'Formato GFPI-F-023 V6 (Planeación, Seguimiento y Evaluación de Etapa Productiva), correspondiente a las visitas de concertación, evaluación parcial y evaluación final.',
    doc: recursos.find((r) => r.label === 'Visita 1 (GFPI-F-023)'),
  },
  {
    texto:
      'Soporte de presentación de las Pruebas de Estado Saber TyT (aplica únicamente para programas de nivel tecnólogo).',
  },
]

const meta = [
  { k: 'Ficha', v: '3114731' },
  { k: 'Programa', v: 'ADSO · Tecnólogo' },
  { k: 'Duración', v: '864 h · 6 meses' },
  { k: 'Centro', v: 'CSF' },
]
---

<BaseLayout
  title="Etapa productiva SENA - Ficha 3114731"
  description="Cronograma de la etapa productiva: bitácoras, visitas de seguimiento, formatos oficiales y calculadora para proyectar otra ficha."
  image="/og-default.png"
  noindex={true}
>
  <div id="ep-page" class="max-w-[1180px] mx-auto px-6 md:px-12 lg:px-16 pt-32 pb-24">

    <a
      id="ep-volver"
      href="/"
      class="inline-flex items-center gap-2 text-[11px] font-mono uppercase tracking-[.2em] text-ink-300 hover:text-cyan transition-colors mb-12"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
      Inicio
    </a>

    <header class="mb-12">
      <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-6">
        <span class="text-cyan">/ep</span>
        <span class="h-px flex-1 bg-gradient-to-r from-white/15 to-transparent max-w-[80px]"></span>
        <span>SENA · Ficha 3114731</span>
      </div>

      <div class="grid lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end gap-8">
        <div>
          <h1 class="font-sans text-4xl md:text-6xl font-medium tracking-[-.035em] text-mask leading-[1] mb-5">
            Etapa <span class="font-serif italic font-normal text-mask-cyan">productiva</span>
          </h1>
          <p class="text-[15px] md:text-[16px] text-ink-100 leading-relaxed max-w-xl">
            Seis meses, seis bitácoras y tres visitas de seguimiento, con sus fechas
            exactas y los formatos que pide cada hito. Abajo hay una calculadora que
            proyecta el mismo cronograma para cualquier otra ficha.
          </p>
        </div>

        <dl class="grid grid-cols-2 gap-x-8 gap-y-4 lg:text-right shrink-0">
          {meta.map((m) => (
            <div>
              <dt class="text-[10px] font-mono uppercase tracking-[.15em] text-ink-300 mb-1">{m.k}</dt>
              <dd class="text-[13px] text-ink-50 font-mono">{m.v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </header>

    <!-- Banda de estado. Los números dependen de "hoy" y la página es
         prerenderizada, así que los rellena el script: el HTML estático solo
         lleva las fechas fijas, que no caducan. -->
    <section
      id="ep-estado"
      data-inicio={INICIO_ISO}
      data-fin={FIN_ISO}
      class="rounded-2xl glass border-accent p-6 md:p-7 mb-4"
    >
      <div class="grid lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center gap-6">
        <div>
          <div class="flex items-center gap-2.5 mb-3">
            <span class="w-2 h-2 rounded-full bg-lime pulse-dot shrink-0"></span>
            <span class="text-[11px] font-mono uppercase tracking-[.15em] text-ink-200">Estado</span>
          </div>
          <p id="ep-fase" class="text-[19px] md:text-[22px] text-ink-50 font-medium tracking-[-.02em] leading-tight">
            {fLargo(inicioD)} → {fLargo(finD)}
          </p>
          <p id="ep-proximo" class="text-[12px] font-mono text-ink-300 mt-2">
            6 meses de etapa productiva · 864 horas
          </p>
          <button
            id="ep-cta"
            type="button"
            class="inline-flex items-center gap-2 h-10 mt-5 px-5 rounded-full bg-cyan text-ink-950 text-[13px] font-medium hover:brightness-110 transition-all"
          >
            Crear mi cronograma
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
          </button>
          <p id="ep-cta-nota" class="text-[11px] text-ink-300 mt-2.5 max-w-sm leading-relaxed">
            ¿Eres otro aprendiz? Las fechas de arriba son de esta ficha; abajo puedes
            proyectar las tuyas a partir de tu propia fecha de inicio.
          </p>
        </div>

        <div class="grid grid-cols-3 gap-3 sm:gap-4 shrink-0">
          {[
            { id: 'ep-stat-avance', label: 'Avance' },
            { id: 'ep-stat-dias', label: 'Días restantes' },
            { id: 'ep-stat-bitacora', label: 'Bitácora' },
          ].map((s) => (
            <div class="rounded-xl bg-white/[.03] border border-white/10 px-4 py-3 text-center min-w-[92px]">
              <div id={s.id} class="font-mono text-[20px] leading-none text-ink-50">-</div>
              <div class="text-[10px] font-mono uppercase tracking-[.12em] text-ink-300 mt-2">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Línea de tiempo. Es la traducción visual de las dos tablas de abajo
         (bitácoras y visitas), que son la versión accesible del mismo dato:
         por eso el gráfico va marcado como decorativo. -->
    <figure class="rounded-2xl glass border-accent p-6 md:p-7 mb-4">
      <figcaption class="flex flex-wrap items-center gap-x-5 gap-y-2 mb-6">
        <span class="text-[11px] font-mono uppercase tracking-[.15em] text-ink-200">Cronograma</span>
        <span class="flex items-center gap-1.5 text-[10px] font-mono uppercase tracking-[.12em] text-ink-300">
          <span class="w-2.5 h-2.5 rounded-[3px] bg-cyan/40 border border-cyan/50"></span> Bitácoras
        </span>
        <span class="flex items-center gap-1.5 text-[10px] font-mono uppercase tracking-[.12em] text-ink-300">
          <span class="w-2.5 h-2.5 rounded-[3px] bg-violet/40 border border-violet/50"></span> Visitas
        </span>
        <span class="flex items-center gap-1.5 text-[10px] font-mono uppercase tracking-[.12em] text-ink-300">
          <span class="w-px h-3 bg-lime"></span> Hoy
        </span>
      </figcaption>

      <div class="overflow-x-auto -mx-1 px-1">
        <div id="ep-track" class="relative min-w-[640px] h-[186px]" aria-hidden="true">

          <!-- Regla de meses -->
          {marcasMes.map((m) => (
            <>
              <div class="absolute top-5 bottom-0 w-px bg-white/[.055]" style={`left:${m.left}%`}></div>
              <span
                class="absolute top-0 text-[10px] font-mono uppercase tracking-[.12em] text-ink-300 pl-1.5"
                style={`left:${m.left}%`}
              >{m.label}</span>
            </>
          ))}

          <!-- Carril de visitas. Van como pin y no como banda: las ventanas 2 y
               3 duran una semana, y a esa escala la banda mide 20px - no cabe
               la etiqueta dentro. El pin se alinea al borde más cercano para no
               desbordar el gráfico en los extremos. -->
          {visitas.map((v) => {
            const centro = v.left + v.width / 2
            const desplazamiento = centro > 70 ? '-100%' : centro < 12 ? '0' : '-50%'
            return (
              <>
                <div class="absolute top-[52px] bottom-[64px] w-px bg-violet/25" style={`left:${centro}%`}></div>
                <div
                  class="ep-pin absolute top-[32px] rounded-md bg-violet/15 border border-violet/40 px-2 py-1 whitespace-nowrap"
                  style={`left:${centro}%;transform:translateX(${desplazamiento})`}
                >
                  <span class="text-[10px] font-mono uppercase tracking-[.1em] text-violet">V{v.n} · {v.titulo}</span>
                </div>
              </>
            )
          })}

          <!-- Vía principal + progreso -->
          <div class="absolute left-0 right-0 top-[104px] h-2.5 rounded-full bg-white/[.06] overflow-hidden">
            <div
              id="ep-progreso"
              class="h-full rounded-full bg-gradient-to-r from-cyan-deep via-cyan to-cyan-glow"
              style="width:0%"
            ></div>
          </div>

          <!-- Carril de bitácoras -->
          {bitacoras.map((b) => (
            <div class="absolute top-[126px]" style={`left:${b.left}%;width:${b.width}%`}>
              <div class="ep-bar h-8 rounded-md bg-cyan/12 border border-cyan/30 flex items-center justify-center">
                <span class="text-[10px] font-mono uppercase tracking-[.1em] text-cyan">B{b.n}</span>
              </div>
              <span class="block text-[10px] font-mono text-ink-300 mt-1.5 whitespace-nowrap">{fCorto(b.hasta)}</span>
            </div>
          ))}

          <!-- Marcador de hoy: lo coloca el script y solo si cae dentro de la etapa -->
          <div id="ep-hoy" class="absolute top-4 bottom-0 w-px bg-lime hidden" style="left:0%">
            <span class="absolute -top-4 left-1/2 -translate-x-1/2 text-[9px] font-mono uppercase tracking-[.12em] text-lime whitespace-nowrap">Hoy</span>
            <span class="absolute top-[86px] left-1/2 -translate-x-1/2 w-2 h-2 rounded-full bg-lime"></span>
          </div>

        </div>
      </div>
    </figure>

    <!-- Detalle + barra lateral -->
    <div id="ep-detalle" class="grid lg:grid-cols-[minmax(0,1fr)_300px] gap-4 items-start mb-4">

      <div class="grid sm:grid-cols-2 gap-4">

        <div class="rounded-2xl glass p-6 sm:col-span-2">
          <div class="flex items-center gap-2 mb-5">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan"></span>
            <span class="text-[11px] font-mono uppercase tracking-[.15em] text-ink-100">Cómo funciona la etapa</span>
          </div>
          <div class="grid sm:grid-cols-2 gap-x-8 gap-y-6">
            {contexto.map((c) => (
              <div>
                <h3 class="text-[13px] text-ink-50 font-medium mb-1.5">{c.titulo}</h3>
                <p class="text-[13px] text-ink-200 leading-relaxed">{c.cuerpo}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="rounded-2xl glass p-6">
          <div class="flex items-center gap-2 mb-1">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan"></span>
            <span class="text-[11px] font-mono uppercase tracking-[.15em] text-ink-100">Bitácoras</span>
          </div>
          <p class="text-[11px] font-mono text-ink-300 mb-4 pl-3.5">6 · mensuales · GFPI-F-147</p>
          <p class="text-[11px] text-ink-300 leading-relaxed mb-4 pl-3.5">
            Las fechas de cierre que caen en fin de semana o festivo colombiano quedan marcadas
            con el último día hábil para entregar.
          </p>
          <ol class="space-y-1.5">
            {bitacoras.map((b) => (
              <li class="text-[13px] rounded-lg bg-white/[.03] border border-white/10 px-3 py-2.5">
                <div class="flex items-baseline justify-between gap-3">
                  <span class="text-ink-100 shrink-0">Bitácora {b.n}</span>
                  <span class="text-ink-300 font-mono text-[11px] text-right">{fCorto(b.desde)} → {fCorto(b.hasta)}</span>
                </div>
                {b.inhabil && b.sugerido && (
                  <p class="flex items-start gap-1.5 text-[11px] font-mono text-ember mt-1.5 leading-relaxed">
                    <span aria-hidden="true">▲</span>
                    <span>{b.inhabil.motivo} · entrega el {DIA_CORTO[b.sugerido.getDay()]} {fCorto(b.sugerido)}</span>
                  </p>
                )}
              </li>
            ))}
          </ol>
        </div>

        <div class="rounded-2xl glass p-6">
          <div class="flex items-center gap-2 mb-1">
            <span class="w-1.5 h-1.5 rounded-full bg-violet"></span>
            <span class="text-[11px] font-mono uppercase tracking-[.15em] text-ink-100">Visitas</span>
          </div>
          <p class="text-[11px] font-mono text-ink-300 mb-4 pl-3.5">3 · trimestrales · GFPI-F-023</p>
          <ol class="space-y-2.5">
            {visitas.map((v) => (
