<style is:global>
  /* Hoja imprimible. El botón "Imprimir / PDF" existía desde antes pero sin
     estilos de impresión salía el tema oscuro con navbar, barra lateral y
     formularios: papel gastado en cosas que en papel no sirven. Aquí queda
     solo lo que el aprendiz le muestra al instructor. Va `is:global` porque
     hay que alcanzar navbar, footer y FAB, que viven fuera de esta página. */
  @media print {
    @page {
      size: A4 portrait;
      margin: 14mm;
    }

    html,
    body {
      background: #fff !important;
    }

    /* Cromo del sitio y decorados de fondo. */
    body > header,
    footer,
    .wa-fab,
    #lang-suggest,
    .ambient-blobs,
    .halo {
      display: none !important;
    }
    .grain::after {
      display: none !important;
    }

    #ep-page {
      max-width: none !important;
      padding: 0 !important;
    }

    /* Toda la paleta del sitio es clara sobre oscuro: sobre papel blanco
       desaparece, así que el texto se fuerza a tinta. */
    #ep-page,
    #ep-page * {
      color: #16181c !important;
      box-shadow: none !important;
      text-shadow: none !important;
    }
    #ep-page .text-mask,
    #ep-page .text-mask-cyan {
      background-image: none !important;
      -webkit-text-fill-color: #16181c !important;
    }
    #ep-page .glass,
    #ep-page .border-accent {
      background: #fff !important;
      border: 1px solid #c9ccd3 !important;
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
    }
    #ep-page section,
    #ep-page figure,
    #ep-page aside > div,
    #ep-page li {
      break-inside: avoid;
    }

    /* Interacción pura: no imprime nada útil. */
    #ep-volver,
    #ep-cta,
    #ep-cta-nota,
    #calc-toast,
    #ep-aside,
    #calc-form,
    #calc-vacio,
    #calc-acciones,
    #calc-recordatorio,
    #calc-next,
    #ep-page [role='tablist'] {
      display: none !important;
    }

    /* Las dos rejillas de dos columnas se apilan: a 180mm no caben. */
    #ep-detalle,
    #calc-grid {
      display: block !important;
    }

    #ep-track {
      min-width: 0 !important;
      width: 100% !important;
    }

    /* El cronograma es el motivo de imprimir la hoja: sus fondos tienen que
       sobrevivir al "no imprimir colores de fondo" del navegador. */
    #ep-track,
    #ep-track * {
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }
    #ep-track .ep-bar {
      background: #d7f4f7 !important;
      border-color: #06707a !important;
    }
    #ep-track .ep-bar span {
      color: #06707a !important;
    }
    #ep-track .ep-pin {
      background: #ece7ff !important;
      border-color: #5b46a8 !important;
    }
    #ep-track .ep-pin span {
      color: #5b46a8 !important;
    }
    #ep-progreso {
      background: #06707a !important;
    }

    /* Los checkbox de "entregado" se imprimen vacíos a propósito: la hoja
       sirve para ir marcando a mano lo que se va entregando. */
    #calc-timeline input[type='checkbox'],
    #cierre-checklist input[type='checkbox'] {
      -webkit-appearance: none;
      appearance: none;
      width: 11px;
      height: 11px;
      border: 1px solid #16181c !important;
      border-radius: 2px;
    }
  }
</style>

<script>
  // Dos piezas comparten este script: la banda de estado + el marcador de "hoy"
  // de la línea de tiempo (que dependen de la fecha actual y por eso no pueden
  // prerenderizarse), y la calculadora de cronograma. La proyección de hitos
  // vive en src/lib/sena-ep.ts (módulo puro isomorfo) para que este script y el
  // cron de recordatorios (api/cron/sena-recordatorio) no dupliquen la fórmula.

  import { computeHitos, type Hito as HitoBase, type TipoPrograma, type DocKey } from '../lib/sena-ep'
  import { diaInhabil, habilAnterior } from '../lib/festivos-co'

  const startOfDay = (d: Date) => {
    const x = new Date(d)
    x.setHours(0, 0, 0, 0)
    return x
  }
  const addDays = (d: Date, n: number) => {
    const x = new Date(d)
    x.setDate(x.getDate() + n)
    return x
  }
  const fmtCorto = (d: Date) =>
    d.toLocaleDateString('es-CO', { day: '2-digit', month: 'short', year: 'numeric' })
  const fmtLargo = (d: Date) =>
    d.toLocaleDateString('es-CO', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })
  const diasEntre = (a: Date, b: Date) =>
    Math.round((startOfDay(b).getTime() - startOfDay(a).getTime()) / 86400000)
  const plural = (n: number, s: string) => `${n} ${s}${n === 1 ? '' : 's'}`

  // --- Banda de estado y marcador de hoy ---
  const estadoEl = document.getElementById('ep-estado')
  if (estadoEl) {
    const inicio = new Date(`${estadoEl.dataset.inicio}T00:00:00`)
    const fin = new Date(`${estadoEl.dataset.fin}T00:00:00`)
    const hoy = startOfDay(new Date())
    const total = diasEntre(inicio, fin)
    const transcurridos = diasEntre(inicio, hoy)
    const avance = Math.min(1, Math.max(0, transcurridos / total))

    const faseEl = document.getElementById('ep-fase')!
    const proximoEl = document.getElementById('ep-proximo')!
    const setStat = (id: string, valor: string) => {
      document.getElementById(id)!.textContent = valor
    }

    if (transcurridos < 0) {
      faseEl.textContent = `Empieza en ${plural(-transcurridos, 'día')}`
      setStat('ep-stat-avance', '0%')
      setStat('ep-stat-dias', String(total))
      setStat('ep-stat-bitacora', `0/6`)
    } else if (transcurridos > total) {
      faseEl.textContent = 'Etapa productiva finalizada'
      setStat('ep-stat-avance', '100%')
      setStat('ep-stat-dias', '0')
      setStat('ep-stat-bitacora', '6/6')
    } else {
      // La bitácora en curso es la del mes calendario que corre desde el día de
      // inicio, no `transcurridos / 30`: los meses no miden lo mismo.
      let enCurso = 1
      for (let i = 1; i <= 6; i++) {
        const corte = new Date(inicio)
        corte.setMonth(corte.getMonth() + i)
        if (hoy >= corte) enCurso = i + 1
      }
      faseEl.textContent = `En curso · ${plural(transcurridos, 'día')} de ${total}`
      setStat('ep-stat-avance', `${Math.round(avance * 100)}%`)
      setStat('ep-stat-dias', String(total - transcurridos))
      setStat('ep-stat-bitacora', `${Math.min(enCurso, 6)}/6`)
    }

    // El próximo hito sale de la misma proyección que usa la calculadora.
    const hitos = computeHitos('tecnologo', estadoEl.dataset.inicio!)
    const proximo = hitos.find((h) => startOfDay(h.fecha) >= hoy)
    if (proximo) {
      const delta = diasEntre(hoy, proximo.fecha)
      const cuando = delta === 0 ? 'hoy' : `en ${plural(delta, 'día')}`
      proximoEl.textContent = `Próximo hito: ${proximo.titulo} · ${fmtCorto(proximo.fecha)} (${cuando})`
    }

    const progresoBar = document.getElementById('ep-progreso') as HTMLElement | null
    if (progresoBar) progresoBar.style.width = `${avance * 100}%`

    const hoyEl = document.getElementById('ep-hoy')
    if (hoyEl && transcurridos >= 0 && transcurridos <= total) {
      hoyEl.style.left = `${avance * 100}%`
      hoyEl.classList.remove('hidden')
    }
  }

  // --- Checklist de documentos de cierre ---
  const CIERRE_KEY = 'sena-ep-cierre:3114731'
  const cierreChecklist = document.getElementById('cierre-checklist')
  if (cierreChecklist) {
    const progresoEl = document.getElementById('cierre-progreso')!
    const checks = cierreChecklist.querySelectorAll<HTMLInputElement>('.cierre-check')

    const leer = (): Set<string> => {
      try {
        return new Set(JSON.parse(localStorage.getItem(CIERRE_KEY) ?? '[]'))
      } catch {
        return new Set()
      }
    }
    const actualizar = () => {
      const set = leer()
      progresoEl.textContent = `${set.size}/${checks.length} documentos marcados como listos`
    }

    const set = leer()
    checks.forEach((cb) => {
      const key = cb.dataset.key!
      cb.checked = set.has(key)
      cb.closest('label')?.querySelector('.cierre-texto')?.classList.toggle('line-through', cb.checked)
      cb.closest('label')?.querySelector('.cierre-texto')?.classList.toggle('text-ink-300', cb.checked)

      cb.addEventListener('change', () => {
        const actual = leer()
        if (cb.checked) actual.add(key)
        else actual.delete(key)
        localStorage.setItem(CIERRE_KEY, JSON.stringify([...actual]))
        const texto = cb.closest('label')?.querySelector('.cierre-texto')
        texto?.classList.toggle('line-through', cb.checked)
        texto?.classList.toggle('text-ink-300', cb.checked)
        actualizar()
      })
    })
    actualizar()
  }

  // --- Calculadora ---
  type Estado = 'past' | 'next' | 'future'
  type DocLink = { label: string; href: string }
  type Hito = HitoBase & { estado: Estado }

  const root = document.getElementById('calc')
  if (root) {
    const docLinks = JSON.parse(root.dataset.docLinks ?? '{}') as Record<DocKey, DocLink>

    const tipoEl = document.getElementById('calc-tipo') as HTMLSelectElement
    const inicioEl = document.getElementById('calc-inicio') as HTMLInputElement
    const errorEl = document.getElementById('calc-error')!
    const vacioEl = document.getElementById('calc-vacio')!
    const resultadosEl = document.getElementById('calc-resultados')!
    const timelineEl = document.getElementById('calc-timeline')!
    const nextTextEl = document.getElementById('calc-next-text')!
    const toastEl = document.getElementById('calc-toast')!
    const progresoEl = document.getElementById('calc-progreso')!

    // Los últimos hitos calculados quedan aquí para que exportar/compartir no
    // tengan que recalcular ni leer el DOM.
    let hitosActuales: Hito[] = []
    let checklistKeyActual = ''
    let toastTimer: ReturnType<typeof setTimeout> | undefined

    function mostrarToast(mensaje: string) {
      toastEl.textContent = mensaje
      toastEl.classList.remove('hidden')
      clearTimeout(toastTimer)
      toastTimer = setTimeout(() => toastEl.classList.add('hidden'), 3200)
    }

    const claveHito = (h: HitoBase) => `${h.titulo}|${h.fecha.toISOString().slice(0, 10)}`

    // Un hito que cae en fin de semana o festivo no se puede entregar ese día:
    // el aviso propone el último hábil en vez de dejar que el aprendiz lo
    // descubra el lunes.
    function avisoInhabil(f: Date): string {
      const inhabil = diaInhabil(f)
      if (!inhabil) return ''
      const habil = habilAnterior(f)
      return `<p class="flex items-start gap-1.5 text-[11px] font-mono text-ember mb-1.5 leading-relaxed"><span aria-hidden="true">▲</span><span>${inhabil.motivo} · entrega el ${fmtLargo(habil)}</span></p>`
    }

    // Checklist "entregado" por hito, persistido en localStorage por
    // combinación tipo+inicio (cada simulación tiene su propio progreso).
    function leerChecklist(key: string): Set<string> {
      try {
        return new Set(JSON.parse(localStorage.getItem(key) ?? '[]'))
      } catch {
        return new Set()
      }
    }
    function actualizarProgreso() {
      const set = leerChecklist(checklistKeyActual)
      const total = hitosActuales.length
      const hechos = hitosActuales.filter((h) => set.has(claveHito(h))).length
      progresoEl.textContent = total > 0 ? `${hechos}/${total} hitos marcados como entregados` : ''
    }

    function calcular() {
      const valor = inicioEl.value
      if (!valor) {
        errorEl.classList.remove('hidden')
        return
      }
      errorEl.classList.add('hidden')

      const tipo = tipoEl.value as TipoPrograma
      const hoy = startOfDay(new Date())

      let hitosBase: HitoBase[]
      try {
        hitosBase = computeHitos(tipo, valor)
      } catch {
        errorEl.textContent = 'Fecha de inicio inválida.'
        errorEl.classList.remove('hidden')
        return
      }

      let indiceProximo = hitosBase.findIndex((h) => startOfDay(h.fecha) >= hoy)
      if (indiceProximo === -1) indiceProximo = hitosBase.length - 1

      const hitosConEstado: Hito[] = hitosBase.map((h, i) => ({
        ...h,
        estado: startOfDay(h.fecha) < hoy ? 'past' : i === indiceProximo ? 'next' : 'future',
      }))

      const fechaCierre = hitosBase[hitosBase.length - 1].fecha
      const meses = hitosBase.filter((h) => h.categoria === 'bitacora').length

      document.getElementById('calc-sum-duracion')!.textContent = `${meses} meses`
      document.getElementById('calc-sum-bitacoras')!.textContent = String(meses)
      document.getElementById('calc-sum-cierre')!.textContent = fmtCorto(fechaCierre)

      const proximo = hitosConEstado[indiceProximo]
      const delta = diasEntre(hoy, proximo.fecha)
      const cuando = delta === 0 ? 'hoy' : delta > 0 ? `en ${plural(delta, 'día')}` : 'ya venció'
      nextTextEl.textContent = `${proximo.titulo} · ${fmtCorto(proximo.fecha)} (${cuando})`

      const colorPorEstado: Record<Estado, string> = {
        past: 'text-ink-300',
        next: 'text-lime',
        future: 'text-cyan',
      }
      const labelPorEstado: Record<Estado, string> = {
        past: 'Pasado',
        next: 'Próximo',
        future: 'Pendiente',
      }

      checklistKeyActual = `sena-ep-checklist:${tipo}:${valor}`
      const checklist = leerChecklist(checklistKeyActual)

      timelineEl.innerHTML = ''
      for (const h of hitosConEstado) {
        const doc = docLinks[h.docKey]
        const key = claveHito(h)
        const entregado = checklist.has(key)

        const item = document.createElement('div')
        item.className =
          'calc-item rounded-lg border px-3 py-2.5 ' +
          (h.estado === 'next'
            ? 'bg-lime/[.06] border-lime/30'
            : h.estado === 'past'
              ? 'bg-white/[.02] border-white/10 opacity-70'
              : 'bg-white/[.03] border-white/10')
        item.dataset.categoria = h.categoria

        item.innerHTML = `
          <div class="flex items-center justify-between text-[13px] mb-1 gap-2">
            <span class="calc-title text-ink-100${entregado ? ' line-through text-ink-300' : ''}">${h.titulo}</span>
            <span class="${colorPorEstado[h.estado]} font-mono text-[11px] uppercase shrink-0">${labelPorEstado[h.estado]}</span>
          </div>
          <div class="text-cyan font-mono text-[11px] mb-1.5">${fmtLargo(h.fecha)}</div>
          ${avisoInhabil(h.fecha)}
          <p class="text-[12px] text-ink-300 leading-relaxed mb-2">${h.detalle}</p>
          <div class="flex items-center justify-between gap-3">
            <a href="${doc.href}" target="_blank" rel="noopener noreferrer" class="text-cyan font-mono text-[11px] hover:underline">${doc.label} ↓</a>
            <label class="flex items-center gap-1.5 cursor-pointer select-none">
              <input type="checkbox" data-key="${key}" class="calc-check w-3.5 h-3.5 rounded border-white/20 bg-white/5 accent-cyan" ${entregado ? 'checked' : ''} />
              <span class="text-[10px] font-mono uppercase text-ink-300">Entregado</span>
            </label>
          </div>
        `
        timelineEl.appendChild(item)
      }

      timelineEl.querySelectorAll<HTMLInputElement>('.calc-check').forEach((cb) => {
        cb.addEventListener('change', () => {
          const set = leerChecklist(checklistKeyActual)
          const k = cb.dataset.key!
          if (cb.checked) set.add(k)
          else set.delete(k)
          localStorage.setItem(checklistKeyActual, JSON.stringify([...set]))
          const titulo = cb.closest('.calc-item')?.querySelector('.calc-title')
          titulo?.classList.toggle('line-through', cb.checked)
          titulo?.classList.toggle('text-ink-300', cb.checked)
          actualizarProgreso()
        })
      })

      document.querySelectorAll<HTMLButtonElement>('.calc-chip').forEach((chip) => {
        chip.classList.toggle('active', chip.dataset.filter === 'all')
      })
      applyFiltro('all')

      hitosActuales = hitosConEstado
      actualizarProgreso()

      // El estado mínimo para reconstruir el cronograma cabe en la URL: así un
      // link compartido no necesita backend ni base de datos.
      const params = new URLSearchParams({ tipo, inicio: valor })
      history.replaceState(null, '', `?${params.toString()}`)

      vacioEl.classList.add('hidden')
      resultadosEl.classList.remove('hidden')
      resultadosEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' })
      actualizarEstadoRecordatorio()
    }

    function applyFiltro(filtro: string) {
      document.querySelectorAll<HTMLDivElement>('#calc-timeline > div').forEach((item) => {
        item.classList.toggle('hidden', filtro !== 'all' && item.dataset.categoria !== filtro)
      })
    }

    // RFC 5545 escapa coma, punto y coma y salto de línea con backslash.
    const escapeIcs = (s: string) => s.replace(/([,;])/g, '\\$1').replace(/\n/g, '\\n')
    const fechaIcs = (d: Date) => {
      const y = d.getFullYear()
      const m = String(d.getMonth() + 1).padStart(2, '0')
      const day = String(d.getDate()).padStart(2, '0')
      return `${y}${m}${day}`
    }

    function exportarIcs() {
      if (hitosActuales.length === 0) return

      const dtstamp = fechaIcs(new Date()) + 'T000000Z'

      // Cada evento lleva sus propias alarmas (7 y 1 día antes). Es el
      // recordatorio del aprendiz sin pedirle el correo ni guardar nada:
      // el aviso lo dispara su propio calendario, no este sitio.
      const alarma = (dias: number, titulo: string) =>
        [
          'BEGIN:VALARM',
          `TRIGGER:-P${dias}D`,
          'ACTION:DISPLAY',
          `DESCRIPTION:${escapeIcs(`Faltan ${dias} día${dias === 1 ? '' : 's'}: ${titulo}`)}`,
          'END:VALARM',
        ].join('\r\n')

      const eventos = hitosActuales.map((h, i) => {
        const desde = fechaIcs(h.fecha)
        const hasta = fechaIcs(addDays(h.fecha, 1))
        return [
          'BEGIN:VEVENT',
          `UID:ep-3114731-${i}@codebymike.tech`,
          `DTSTAMP:${dtstamp}`,
          `DTSTART;VALUE=DATE:${desde}`,
          `DTEND;VALUE=DATE:${hasta}`,
          `SUMMARY:${escapeIcs(h.titulo)}`,
          `DESCRIPTION:${escapeIcs(h.detalle)}`,
          alarma(7, h.titulo),
          alarma(1, h.titulo),
          'END:VEVENT',
        ].join('\r\n')
      })

      const ics = [
        'BEGIN:VCALENDAR',
        'VERSION:2.0',
        'PRODID:-//CodeByMike//Etapa Productiva SENA//ES',
        'CALSCALE:GREGORIAN',
        ...eventos,
        'END:VCALENDAR',
      ].join('\r\n')

      const blob = new Blob([ics], { type: 'text/calendar;charset=utf-8' })
      const url = URL.createObjectURL(blob)
      const a = document.createElement('a')
      a.href = url
      a.download = 'etapa-productiva-3114731.ics'
      document.body.appendChild(a)
      a.click()
      a.remove()
      URL.revokeObjectURL(url)
      mostrarToast(`${hitosActuales.length} hitos exportados, con aviso 7 y 1 día antes`)
    }

    async function compartir() {
      const params = new URLSearchParams({ tipo: tipoEl.value, inicio: inicioEl.value })
      const url = `${location.origin}${location.pathname}?${params.toString()}`
      try {
        await navigator.clipboard.writeText(url)
        mostrarToast('Link copiado al portapapeles')
      } catch {
        mostrarToast(url)
      }
    }

    // Recordatorio por email: personal, solo admin. La suscripción activa
    // (si hay) vive en Turso vía /api/admin/sena-recordatorio; el middleware
    // exige sesión admin en ese endpoint, así que un visitante sin sesión solo
    // ve el 401 al intentar activarlo.
    const remindOnBtn = document.getElementById('calc-remind-on') as HTMLButtonElement
    const remindOffBtn = document.getElementById('calc-remind-off') as HTMLButtonElement
    const remindStatusEl = document.getElementById('calc-remind-status')!

    interface RecordatorioActivo {
      tipo: TipoPrograma
      inicio: string
    }

    async function actualizarEstadoRecordatorio() {
      try {
        const res = await fetch('/api/admin/sena-recordatorio')
        if (!res.ok) {
          remindStatusEl.textContent = res.status === 401 ? 'Inicia sesión de admin para activarlo.' : ''
          remindOnBtn.classList.remove('hidden')
          remindOffBtn.classList.add('hidden')
          return
        }
        const sub = (await res.json()) as RecordatorioActivo | null
        const coincide = sub && sub.tipo === tipoEl.value && sub.inicio === inicioEl.value
        remindOnBtn.classList.toggle('hidden', Boolean(sub))
        remindOffBtn.classList.toggle('hidden', !sub)
        remindStatusEl.textContent = sub
          ? coincide
            ? 'Activo para esta simulación.'
            : `Activo para otra simulación (${sub.tipo}, inicio ${sub.inicio}).`
          : ''
      } catch {
        remindStatusEl.textContent = ''
      }
    }

    async function activarRecordatorio() {
      const res = await fetch('/api/admin/sena-recordatorio', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ tipo: tipoEl.value, inicio: inicioEl.value }),
      })
      if (res.status === 401) {
        mostrarToast('Necesitas sesión de admin - inicia sesión primero')
        return
      }
      if (!res.ok) {
        mostrarToast('No se pudo activar el recordatorio')
        return
      }
      mostrarToast('Recordatorio activado')
      actualizarEstadoRecordatorio()
    }

    async function desactivarRecordatorio() {
      const res = await fetch('/api/admin/sena-recordatorio', { method: 'DELETE' })
      if (res.ok) mostrarToast('Recordatorio desactivado')
      actualizarEstadoRecordatorio()
    }

    document.getElementById('ep-cta')?.addEventListener('click', () => {
      root!.scrollIntoView({ behavior: 'smooth', block: 'start' })
      inicioEl.focus({ preventScroll: true })
    })
    document.getElementById('calc-generar')?.addEventListener('click', calcular)
    document.getElementById('calc-print')?.addEventListener('click', () => window.print())
    document.getElementById('calc-ics')?.addEventListener('click', exportarIcs)
    document.getElementById('calc-share')?.addEventListener('click', compartir)
    remindOnBtn?.addEventListener('click', activarRecordatorio)
    remindOffBtn?.addEventListener('click', desactivarRecordatorio)

    document.querySelectorAll<HTMLButtonElement>('.calc-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        document.querySelectorAll<HTMLButtonElement>('.calc-chip').forEach((c) => {
          c.classList.remove('bg-cyan/10', 'border-cyan/40', 'text-cyan')
          c.classList.add('border-white/10', 'text-ink-200')
        })
        chip.classList.remove('border-white/10', 'text-ink-200')
        chip.classList.add('bg-cyan/10', 'border-cyan/40', 'text-cyan')
        applyFiltro(chip.dataset.filter ?? 'all')
      })
    })

    // Un link compartido trae tipo+inicio en la query string: precargar y
    // calcular de una vez para que quien lo reciba no tenga que hacer nada.
    const urlParams = new URLSearchParams(location.search)
    const tipoParam = urlParams.get('tipo')
    const inicioParam = urlParams.get('inicio')
    if (inicioParam) {
      if (tipoParam === 'tecnico' || tipoParam === 'tecnologo') tipoEl.value = tipoParam
      inicioEl.value = inicioParam
      calcular()
    }
  }
</script>
