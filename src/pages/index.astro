---
import BaseLayout from '../layouts/BaseLayout.astro'
import ProyectosIndice from '../components/home/ProyectosIndice.astro'
import ProcesoPipeline from '../components/home/ProcesoPipeline.astro'
import ExpertiseVivo from '../components/home/ExpertiseVivo.astro'
import LabHuella from '../components/home/LabHuella.astro'
import GithubProjects from '../components/GithubProjects.astro'
import { db } from '../db'
import { projects } from '../db/schema'
import { eq } from 'drizzle-orm'
import { getDictionary, getLocaleFromUrl, localizedHref } from '../i18n'
import { safeQuery } from '../lib/safe-query'
import { proyectosInstantanea } from '../lib/fallback/instantanea'
import { leerPulso } from '../lib/pulso-publico'
import { construirSenales } from '../lib/pulso-panel'
import PulsoPanel from '../components/PulsoPanel.astro'
import '../styles/portada.css'

// Página única compartida por /  y /en (ver src/pages/en/index.astro, que
// solo la reexporta): el locale sale de la URL real del request, no del
// archivo - así funciona igual la importen desde donde la importen.
const locale = getLocaleFromUrl(Astro.url.pathname)
const t = getDictionary(locale).home
const L = (path: string) => localizedHref(path, locale)

// La portada NO se cae con la base: sin proyectos se pinta el resto de la
// página (presentación, stack, contacto, repos de GitHub), que es casi todo lo
// que hay aquí. Esta única consulta devolvía un 404 en producción con la cuota
// de Turso agotada.
// El reemplazo no es una lista vacía sino la instantánea de proyectos reales
// (ver src/lib/fallback/instantanea.ts). Una portada sin proyectos no está
// "degradada con elegancia": está rota de una forma que no se nota, que es
// peor. Los datos son los mismos que sirve la base, capturados en su momento;
// la sección de proyectos no depende de que Turso conteste.
// La consulta pide exactamente los campos que pinta la tarjeta, no `select()`
// entero: así el contrato con el reemplazo es explícito (si alguien añade un
// campo a la tarjeta, el tipo obliga a añadirlo también a la instantánea) y de
// paso no se traen a memoria notas internas ni URLs de repositorio que esta
// página no muestra.
const visibleProjects = await safeQuery(
  () =>
    db
      .select({
        slug: projects.slug,
        title: projects.title,
        titleEn: projects.titleEn,
        description: projects.description,
        descriptionEn: projects.descriptionEn,
        techStack: projects.techStack,
        screenshotUrl: projects.screenshotUrl,
      })
      .from(projects)
      .where(eq(projects.visible, true))
      .orderBy(projects.createdAt),
  proyectosInstantanea,
  'home/proyectos-visibles',
)

// Cinta del hero: cifras del propio sitio en lugar de la lista de tecnologías
// que había antes. La lista era decorativa (los números /01../21 eran el índice
// del array) y decía lo mismo que dice el portafolio de cualquiera; esto solo
// puede escribirlo un sitio que de verdad se sondea, se clasifica y se mide.
//
// Apuntar una señal despliega su serie completa (ver PulsoPanel.astro). El
// desglose viaja en la MISMA consulta que la cifra, así que el panel no cuesta
// ni una lectura más: la forma de la serie ya estaba en memoria y solo faltaba
// enseñarla.
//
// Una señal sin dato NO se pinta, y la decisión vive en `construirSenales`:
// sin base la cinta encoge y, si no queda ninguna, desaparece entera y el hero
// respira hasta el bento.
const senales = construirSenales(await leerPulso(), t.pulso, locale, L)
---

<BaseLayout title={t.title} description={t.description}>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      // @id estable para que el nodo Person sea el mismo en ES y EN y en
      // cualquier página que quiera referenciarlo, en vez de dos personas.
      '@id': 'https://codebymike.net/#person',
      name: 'Mike',
      alternateName: 'CodeByMike',
      jobTitle: 'Software Engineer',
      description: t.description,
      image: 'https://github.com/mikerb95.png',
      url: 'https://codebymike.net',
      email: 'mailto:mike@codebymike.net',
      address: { '@type': 'PostalAddress', addressCountry: 'CO' },
      knowsAbout: ['TypeScript', 'React', 'Next.js', 'Astro', 'Node.js', 'PostgreSQL'],
      sameAs: ['https://github.com/mikerb95', 'https://www.linkedin.com/in/mdrb95/'],
    })}
  />

  <!-- ── HUD de diagnóstico: panel fijo que va marcando qué sección ha
       "pasado el chequeo" a medida que se hace scroll. Reutiliza la
       identidad de monitoreo/SIEM del sitio en vez de un efecto genérico.
       Oculto en mobile (poco espacio, aporta menos que estorba). -->
  <div
    id="hud"
    class="hud-panel hidden lg:flex fixed bottom-6 left-6 z-40 flex-col gap-1.5 rounded-xl px-4 py-3 font-mono text-[10px] pointer-events-none select-none"
  >
    <div class="text-ink-300 tracking-[.22em] uppercase mb-0.5">{t.hud.title}</div>
    <div class="hud-line flex items-center justify-between gap-6 text-ink-400" data-key="hero">
      <span>{t.hud.boot}</span><span class="hud-status">-</span>
    </div>
    <div class="hud-line flex items-center justify-between gap-6 text-ink-400" data-key="bento">
      <span>{t.hud.sistema}</span><span class="hud-status">-</span>
    </div>
    <div class="hud-line flex items-center justify-between gap-6 text-ink-400" data-key="proyectos">
      <span>{t.hud.build}</span><span class="hud-status">-</span>
    </div>
    <div class="hud-line flex items-center justify-between gap-6 text-ink-400" data-key="proceso">
      <span>{t.hud.pipeline}</span><span class="hud-status">-</span>
    </div>
    <div class="hud-line flex items-center justify-between gap-6 text-ink-400" data-key="expertise">
      <span>{t.hud.stack}</span><span class="hud-status">-</span>
    </div>
    <div class="hud-line flex items-center justify-between gap-6 text-ink-400" data-key="laboratorio">
      <span>{t.hud.lab}</span><span class="hud-status">-</span>
    </div>
  </div>

  <!-- ── Hero ── -->
  <!-- `overflow-x-clip` y no `overflow-hidden`: el panel del pulso cuelga por
       debajo del hero a propósito (se superpone al bento) y un recorte en
       vertical lo cortaba a media altura. Lo horizontal sí hay que recortarlo,
       por la cinta a sangre; el halo se recorta en su propia caja. -->
  <!-- El terreno (lienzo) ocupa el hero entero y responde al cursor en toda su
       superficie; el velo oscurece solo la columna de texto, para que las curvas
       sigan viéndose alrededor pero no crucen por detrás de cada línea del
       párrafo. Sin WebGL2 el lienzo nunca se muestra y queda el halo de siempre. -->
  <section id="hero" class="relative min-h-[100svh] flex flex-col pt-28 pb-12 px-6 md:px-12 lg:px-20 overflow-x-clip">
    <div class="absolute inset-0 overflow-hidden pointer-events-none z-0"><div class="halo"></div></div>
    <canvas id="isolineas" class="isolineas-lienzo" aria-hidden="true"></canvas>
    <div class="hero-velo" aria-hidden="true"></div>
    <div class="relative flex-1 flex flex-col w-full max-w-[1280px] mx-auto">

      <!-- Availability badge -->
      <div class="flex items-center gap-3 mb-7">
        <span class="w-2 h-2 rounded-full bg-cyan pulse-dot shadow-[0_0_12px_#00f2ff]"></span>
        <span class="text-[11px] font-mono uppercase tracking-[.28em] text-ink-100">{t.badge}</span>
      </div>

      <!-- GitHub credentials -->
      <div class="flex flex-wrap items-center gap-3 mb-11">
        <!-- Top 3 Colombia -->
        <a
          href="https://committers.top/colombia#mikerb95"
          target="_blank"
          rel="noopener"
          class="group inline-flex items-center gap-3 rounded-full glass lift pl-2 pr-4 py-2 transition-colors hover:border-cyan/30"
        >
          <span class="relative flex h-7 w-7 items-center justify-center rounded-full bg-cyan/10 border border-cyan/30 text-cyan shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.5 11.5 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.91 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222 0 1.606-.014 2.898-.014 3.293 0 .322.216.694.825.576C20.565 22.092 24 17.595 24 12.297c0-6.627-5.373-12-12-12"/></svg>
          </span>
          <span class="flex flex-col leading-none">
            <span class="text-[9.5px] font-mono uppercase tracking-[.22em] text-ink-300">{t.githubTop3Label}</span>
            <span class="mt-1 text-[13px] font-medium text-ink-50">Top <span class="text-cyan">#3</span> {t.githubTop3Value}</span>
          </span>
          <svg class="ml-0.5 w-3 h-3 text-ink-300 opacity-0 -translate-x-1 transition-all group-hover:opacity-100 group-hover:translate-x-0 group-hover:text-cyan" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
        </a>

        <!-- Developer Program -->
        <a
          href="https://github.com/mikerb95"
          target="_blank"
          rel="noopener"
          class="group inline-flex items-center gap-3 rounded-full glass lift pl-2 pr-4 py-2 transition-colors hover:border-violet/30"
        >
          <span class="relative flex h-7 w-7 items-center justify-center rounded-full bg-violet/10 border border-violet/30 text-violet shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 14 4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/></svg>
          </span>
          <span class="flex flex-col leading-none">
            <span class="text-[9.5px] font-mono uppercase tracking-[.22em] text-ink-300">{t.githubDevProgramLabel}</span>
            <span class="mt-1 text-[13px] font-medium text-ink-50">GitHub <span class="text-violet">{t.githubDevProgramValue}</span></span>
          </span>
          <svg class="ml-0.5 w-3 h-3 text-ink-300 opacity-0 -translate-x-1 transition-all group-hover:opacity-100 group-hover:translate-x-0 group-hover:text-violet" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
        </a>
      </div>

      <!-- Headline -->
      <h1 class="font-sans font-medium tracking-[-.035em] leading-[.94] text-[clamp(44px,8vw,120px)]">
        {/* Los espacios entre spans son intencionales: al ser `block` no se
            ven, pero sin ellos el texto plano que extrae un buscador (o un
            lector de pantalla) queda pegado - "Ingeniería desoftwarecon". */}
        <span class="hero-line block text-mask">{t.hero.line1}</span>{' '}
        {/* La cursiva serif tiene altura-x mucho menor que la sans a igual
            font-size: sin subirla ~12% y cerrar su interlineado, la línea
            del medio parece flotar suelta entre las otras dos. */}
        <span class="hero-line block text-mask-cyan italic font-serif font-normal text-[1.12em] leading-[.86]">{t.hero.line2}</span>{' '}
        <span class="hero-line block text-mask">{t.hero.line3}</span>
      </h1>

      <div class="mt-10 grid md:grid-cols-12 gap-8 items-end">
        <p class="md:col-span-6 text-[16px] md:text-[18px] text-ink-100 leading-relaxed max-w-xl">
          {t.hero.lead}
        </p>
        <div class="md:col-span-3 space-y-2">
          <div class="text-[10.5px] font-mono uppercase tracking-[.2em] text-ink-300">{t.hero.stackLabel}</div>
          <div class="text-[14px] text-ink-50">{t.hero.stackLine1}</div>
          <div class="text-[14px] text-ink-50">{t.hero.stackLine2}</div>
        </div>
        <!-- Botones magnéticos: se inclinan hacia el cursor al acercarse y el
             texto se adelanta un poco más que la píldora, que es lo que da la
             sensación de profundidad. El `data-magnetico` lo lee el script. -->
        <div class="md:col-span-3 flex md:justify-end gap-3 flex-wrap">
          {visibleProjects.length > 0 ? (
            <a
              href="#proyectos"
              data-magnetico
              class="inline-flex items-center h-12 px-5 text-[14px] font-medium rounded-full bg-cyan text-ink-950 hover:brightness-110 transition-[filter] shadow-glow"
            >
              <span data-magnetico-texto class="inline-flex items-center gap-2">
                {t.hero.ctaProjects}
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </span>
            </a>
          ) : (
            <a
              href={L('/certifications')}
              data-magnetico
              class="inline-flex items-center h-12 px-5 text-[14px] font-medium rounded-full bg-cyan text-ink-950 hover:brightness-110 transition-[filter]"
            >
              <span data-magnetico-texto class="inline-flex items-center gap-2">
                {t.hero.ctaCerts}
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </span>
            </a>
          )}
          <a
            href={L('/contact')}
            data-magnetico
            class="inline-flex items-center h-12 px-5 text-[14px] font-medium rounded-full bg-ink-950/60 backdrop-blur-md text-ink-50 border border-white/10 hover:bg-white/[.06] transition-colors"
          >
            <span data-magnetico-texto class="inline-flex items-center">{t.hero.ctaContact}</span>
          </a>
        </div>
      </div>

      <!-- Pista de interacción: el terreno no es fondo, se puede tocar, y sin
           decirlo casi nadie descubre el clic. Solo con puntero fino; en táctil
           el terreno late solo y el toque también emite. -->
      <p class="hero-pista mt-auto pt-14 hidden md:flex items-center gap-3 self-center text-[10.5px] font-mono uppercase tracking-[.2em] text-ink-200/70" aria-hidden="true">
        <span class="pista-mira"></span>
        {t.hero.pista}
      </p>

    </div>
  </section>

  <!-- ── Cinta de señales ── -->
  <!-- Vive fuera del hero, justo debajo: es lo primero que aparece al empezar
       el scroll, cuando el terreno se aplana. La línea en que se convierte el
       relieve continúa aquí como la cinta de cifras reales del sitio.
       `overflow-x-clip` y no `overflow-hidden`: el panel de cada señal cuelga
       por debajo a propósito (se superpone al bento) y un recorte vertical lo
       cortaba a media altura. -->
  {senales.length > 0 && (
    <section id="pulso" class="relative z-20 px-6 md:px-12 lg:px-20 overflow-x-clip">
      <div class="max-w-[1280px] mx-auto">
        <!-- Cinta de señales del propio sitio (ver src/lib/pulso-publico.ts).
             `pulso-wrap` es el área viva: la cinta abre el panel al apuntar una
             señal y lo cierra al salir del conjunto, no de la cinta - si no,
             bajar el cursor hacia el panel lo cerraría justo antes de llegar. -->
        <div class="pulso-wrap relative">
          <div class="ticker -mx-6 md:-mx-12 lg:-mx-20 overflow-hidden border-y border-white/5 py-4">
            <div class="ticker-track flex w-max">
              {[0, 1].map((copia) => (
                <div class="flex shrink-0" aria-hidden={copia === 1 ? 'true' : undefined}>
                  {senales.map((s) => (
                    <a
                      href={s.href}
                      data-senal={s.id}
                      tabindex={copia === 1 ? -1 : undefined}
                      class="group flex items-baseline gap-3 whitespace-nowrap"
                    >
                      <span class="text-[24px] md:text-[28px] tabular-nums tracking-[-.02em] text-ink-50 transition-colors group-hover:text-cyan">
                        {s.valor}
                      </span>
                      <span class="text-[11px] font-mono uppercase tracking-[.16em] text-ink-200/60 transition-colors group-hover:text-ink-200">
                        {s.etiqueta}
                      </span>
                      <span class="text-cyan/30 px-10 md:px-14" aria-hidden="true">·</span>
                    </a>
                  ))}
                </div>
              ))}
            </div>
          </div>

          <!-- Los paneles se superponen en vez de empujar la página: abrir un
               detalle al pasar el cursor no puede mover el contenido de abajo,
               o el propio gesto de mirar reordena la página bajo el ratón.
               Ocultos por debajo de `md`: sin cursor no hay hover que los abra
               y el tap debe navegar a la página de la métrica, no desplegar. -->
          <div class="pulso-paneles hidden md:block absolute left-0 right-0 top-full z-30 mt-4">
            {senales.map((s) => <PulsoPanel senal={s} />)}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ── Bento ── -->
  <section id="bento" class="px-6 md:px-12 lg:px-20 pt-20 pb-24">
    <div class="max-w-[1280px] mx-auto">
      <div data-etiqueta class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-6">
        <span class="text-cyan">/01</span>
        <span class="h-px flex-1 bg-gradient-to-r from-white/15 to-transparent max-w-[80px]"></span>
        <span>{t.bento.sectionLabel}</span>
      </div>

      <!-- `data-foco`: una sola linterna para toda la rejilla (ver foco() en
           src/lib/motion/efectos.ts). Las tarjetas no llevan `lift`: el
           desplazamiento del hover y la inclinación 3D pelearían por el mismo
           transform. -->
      <div data-foco class="grid grid-cols-12 grid-rows-[180px_180px_180px] gap-4 mt-6">

        <!-- About - span 2 rows -->
        <div class="col-span-12 md:col-span-7 row-span-2 rounded-2xl glass foco overflow-hidden p-7 flex flex-col justify-between relative">
          <div class="absolute -right-12 -bottom-12 w-72 h-72 rounded-full bg-cyan/10 blur-3xl pointer-events-none"></div>
          <div>
            <span class="inline-flex items-center gap-1.5 text-[11px] font-mono uppercase tracking-wider text-cyan">
              <span class="w-1.5 h-1.5 rounded-full pulse-dot bg-cyan"></span>
              {t.bento.about.badge}
            </span>
            <h3 class="mt-5 text-3xl md:text-4xl font-medium tracking-[-.02em] text-ink-50 leading-[1.1] max-w-lg">
              {t.bento.about.title}
            </h3>
          </div>
          <div class="grid grid-cols-3 gap-6 mt-6">
            <div>
              <div class="text-2xl font-medium text-cyan tabular-nums" data-odometro>5+</div>
              <div class="text-[11px] font-mono uppercase tracking-wider text-ink-200 mt-1">{t.bento.about.statYears}</div>
            </div>
            <div>
              <div class="text-2xl font-medium text-cyan tabular-nums" data-odometro>20+</div>
              <div class="text-[11px] font-mono uppercase tracking-wider text-ink-200 mt-1">{t.bento.about.statProjects}</div>
            </div>
            <div>
              <div class="text-2xl font-medium text-cyan tabular-nums" data-odometro>8+</div>
              <div class="text-[11px] font-mono uppercase tracking-wider text-ink-200 mt-1">{t.bento.about.statIndustries}</div>
            </div>
          </div>
        </div>

        <!-- Now - única card viva del bento. El SSR pinta el texto de respaldo
             y el script la reemplaza por hechos reales (deploy, uptime, SIEM)
             que rotan. Ver src/pages/api/now.ts. -->
        <div
          id="now-card"
          class="col-span-6 md:col-span-5 row-span-1 rounded-2xl glass foco overflow-hidden p-5 flex flex-col"
          data-locale={locale}
          data-labels={JSON.stringify(t.bento.now.labels)}
          data-meta={JSON.stringify(t.bento.now.meta)}
          data-conclusion={JSON.stringify(t.bento.now.conclusion)}
          data-budget-label={t.bento.now.budgetLabel}
        >
          <div class="flex items-center justify-between">
            <span class="inline-flex items-center gap-1.5 text-[11px] font-mono uppercase tracking-wider text-lime">
              <span class="w-1.5 h-1.5 rounded-full pulse-dot bg-lime"></span>
              {t.bento.now.badge}
            </span>
            <span id="now-age" class="text-[10px] font-mono text-ink-300 tabular-nums"></span>
          </div>
          <div class="mt-3 min-h-[3.25rem]">
            <div id="now-body">
              <div id="now-label" class="text-[14px] text-ink-50 leading-snug">
                {t.bento.now.body}
              </div>
              <div id="now-meta" class="text-[11px] font-mono text-ink-300 mt-0.5"></div>
            </div>
          </div>
          <div id="now-budget" class="mt-auto hidden">
            <div id="now-budget-label" class="text-[10px] font-mono text-ink-300 mb-1"></div>
            <div class="flex items-center gap-2">
              <div class="h-1.5 flex-1 rounded-full bg-white/5 overflow-hidden">
                <div id="now-budget-bar" class="h-full w-0 bg-gradient-to-r from-lime to-cyan transition-[width] duration-700 motion-reduce:transition-none"></div>
              </div>
              <span id="now-budget-pct" class="text-[10px] font-mono text-ink-200 tabular-nums"></span>
            </div>
          </div>
        </div>

        <!-- Capabilities -->
        <div class="col-span-6 md:col-span-5 row-span-1 rounded-2xl glass foco overflow-hidden p-5">
          <span class="inline-flex items-center gap-1.5 text-[11px] font-mono uppercase tracking-wider text-violet">
            {t.bento.capabilities.badge}
          </span>
          <ul class="mt-3 space-y-1.5 text-[13px] text-ink-100">
            {t.bento.capabilities.items.map((item) => (
              <li class="flex items-center gap-2">
