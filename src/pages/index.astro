<script>
  // Motion de la portada. Cada sección tiene su propia coreografía en vez de
  // compartir un único fade-in; lo común (scroll suave, boot del titular) sale
  // de src/lib/motion-reveal.ts y las micro-interacciones de
  // src/lib/motion/efectos.ts. Aquí solo se decide qué se monta y cuándo:
  //   · Terreno de isolíneas del hero, que se aplana al hacer scroll.
  //   · Titular: boot por carácter y, con ratón, peso variable por cercanía.
  //   · Botones magnéticos, etiquetas de sección, titulares por líneas,
  //     odómetros y la luz que sigue al cursor en el bento.
  //   · HUD fijo que marca "ok" sección por sección.
  // Con movimiento reducido la página queda quieta y completa: el terreno se
  // pinta en un fotograma fijo y todo lo demás se muestra sin animar.
  import gsap from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { initPageMotion, revealCards } from '../lib/motion-reveal'
  import { montarIsolineas } from '../lib/motion/isolineas'
  import {
    foco,
    inclinar,
    magnetico,
    odometro,
    pesoPorCercania,
    punteroFino,
    revelarEtiqueta,
    revelarTitular,
  } from '../lib/motion/efectos'

  const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const hero = document.getElementById('hero')

  // Hora de Bogotá en la tarjeta de ubicación. Es un dato, no decoración: se
  // actualiza también con movimiento reducido. Un segundo exacto de desfase no
  // importa; un reloj que se congela con la pestaña en segundo plano sí, por
  // eso se repinta al volver.
  {
    const reloj = document.querySelector<HTMLElement>('[data-reloj]')
    if (reloj) {
      const fmt = new Intl.DateTimeFormat(reloj.dataset.locale === 'en' ? 'en-GB' : 'es-CO', {
        timeZone: 'America/Bogota',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: false,
      })
      const pintar = () => (reloj.textContent = fmt.format(new Date()))
      pintar()
      window.setInterval(pintar, 1000)
      document.addEventListener('visibilitychange', () => !document.hidden && pintar())
    }
  }

  // ── Terreno ──
  {
    const lienzo = document.getElementById('isolineas') as HTMLCanvasElement | null
    if (hero && lienzo) {
      const iso = montarIsolineas(lienzo, { zona: hero, reducido })
      if (iso) {
        hero.classList.add('con-isolineas')
        if (!reducido) {
          ScrollTrigger.create({
            trigger: hero,
            start: 'top top',
            end: 'bottom top',
            scrub: true,
            onUpdate: (s) => iso.aplanar(s.progress),
          })
        }
      }
    }
  }

  if (!reducido) {
    // Fail-open: cualquier excepción del motion devuelve la visibilidad de lo
    // que pudo quedar escondido (cards del bento, líneas de titulares) en vez
    // de dejar media portada en negro. Mismo criterio que motion-reveal.ts.
    try {
      initPageMotion({ cardSelector: '#bento .glass' })

      // El titular se aleja por capas al salir del hero: cada línea a su
      // velocidad, como planos a distinta profundidad sobre el terreno.
      if (hero) {
        document.querySelectorAll<HTMLElement>('#hero .hero-line').forEach((linea, i) => {
          gsap.to(linea, {
            yPercent: -18 - i * 16,
            opacity: 0.15,
            ease: 'none',
            scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: true },
          })
        })
      }

      // La cinta entra cuando empieza el scroll: las dos rayas se abren desde
      // el centro (la línea en que acaba de convertirse el terreno) y las
      // cifras suben detrás. Queda justo bajo el pliegue, así que es lo primero
      // que aparece al bajar.
      const cinta = document.querySelector<HTMLElement>('#pulso .ticker')
      if (cinta) {
        gsap
          .timeline({ scrollTrigger: { trigger: cinta, start: 'top 98%' } })
          .from(cinta, { clipPath: 'inset(0% 50% 0% 50%)', duration: 1.1, ease: 'expo.out' })
          .from(cinta.querySelector('.ticker-track'), { yPercent: 60, opacity: 0, duration: 0.9, ease: 'power3.out' }, 0.15)
      }

      document.querySelectorAll<HTMLElement>('[data-etiqueta]').forEach(revelarEtiqueta)
      document.querySelectorAll<HTMLElement>('[data-titular]').forEach(revelarTitular)
      document.querySelectorAll<HTMLElement>('[data-odometro]').forEach(odometro)

      if (punteroFino()) {
        document.querySelectorAll<HTMLElement>('[data-magnetico]').forEach((el) => magnetico(el))

        const bento = document.querySelector<HTMLElement>('#bento [data-foco]')
        if (bento) {
          foco(bento)
          bento.querySelectorAll<HTMLElement>('.foco').forEach((c) => inclinar(c, 2.2))
        }

        // El peso por cercanía entra cuando el boot del titular ya terminó: si
        // arranca antes, mide las letras a media subida y los centros quedan
        // desplazados para siempre.
        window.setTimeout(() => {
          const lineas = Array.from(document.querySelectorAll<HTMLElement>('#hero .hero-line'))
          const letras = lineas.flatMap((l) => Array.from(l.children) as HTMLElement[])
          const serif = lineas
            .filter((l) => l.classList.contains('font-serif'))
            .flatMap((l) => Array.from(l.children) as HTMLElement[])
          if (letras.length) pesoPorCercania(letras, { levantar: serif })
        }, 1800)
      }
    } catch (err) {
      console.warn('[motion] portada sin animaciones tras un fallo de init', err)
      revealCards('#bento .glass')
      document.querySelectorAll<HTMLElement>('.titular-linea').forEach((l) => (l.style.transform = 'none'))
    }

    // HUD de diagnóstico - un ScrollTrigger por sección que va marcando
    // el estado: pendiente (-) → activo (● parpadeando) → ok (✓ lima).
    const hudLines = Array.from(document.querySelectorAll<HTMLElement>('.hud-line'))
    const sections = hudLines
      .map((l) => document.getElementById(l.dataset.key ?? ''))
      .filter((el): el is HTMLElement => el !== null)

    const setHud = (activeIndex: number) => {
      hudLines.forEach((line, i) => {
        const status = line.querySelector('.hud-status')
        if (!status) return
        if (i < activeIndex) {
          line.dataset.state = 'ok'
          status.textContent = '✓'
        } else if (i === activeIndex) {
          line.dataset.state = 'active'
          status.textContent = '●'
        } else {
          line.dataset.state = 'pending'
          status.textContent = '-'
        }
      })
    }

    try {
      sections.forEach((section, i) => {
        ScrollTrigger.create({
          trigger: section,
          start: 'top 55%',
          end: 'bottom 55%',
          onEnter: () => setHud(i),
          onEnterBack: () => setHud(i),
        })
      })
    } catch (err) {
      console.warn('[motion] HUD deshabilitado tras un fallo de init', err)
    }
  }
</script>

<script>
  // Card "Ahora" del bento: la rellena /api/now con hechos reales (último
  // deploy, último check de uptime, tráfico clasificado por el SIEM) que van
  // rotando, más el presupuesto de error del SLO en la barra.
  //
  // Va en su propio script, fuera del bloque de prefers-reduced-motion: esto
  // es contenido, no decoración - quien pide menos animación igual merece el
  // dato fresco, solo sin el descifrado (con movimiento reducido el texto
  // cambia directamente).
  import { formatNumber, formatTimeAgo, interpolate } from '../i18n/format'
  import type { Locale } from '../i18n/config'
  import gsap from 'gsap'
  import { ScrambleTextPlugin } from 'gsap/ScrambleTextPlugin'

  gsap.registerPlugin(ScrambleTextPlugin)
  const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  type NowItem =
    | { kind: 'deploy'; at: number; sha: string; branch: string; conclusion: string }
    | { kind: 'uptime'; at: number; name: string; ok: boolean; statusCode: number | null; responseMs: number | null }
    | { kind: 'siem'; at: number; events: number }

  type NowPayload = {
    ts: number
    items: NowItem[]
    budget: { remainingPct: number; health: string; objectivePct: number; windowDays: number } | null
  }

  const card = document.getElementById('now-card')
  const bodyEl = document.getElementById('now-body')
  const labelEl = document.getElementById('now-label')
  const metaEl = document.getElementById('now-meta')
  const ageEl = document.getElementById('now-age')

  const ROTATE_MS = 6000
  const AGE_REFRESH_MS = 30_000

  if (card && bodyEl && labelEl && metaEl && ageEl) {
    const locale = (card.dataset.locale ?? 'es') as Locale
    const labels = JSON.parse(card.dataset.labels ?? '{}') as Record<string, string>
    const metaTpl = JSON.parse(card.dataset.meta ?? '{}') as Record<string, string>
    const conclusions = JSON.parse(card.dataset.conclusion ?? '{}') as Record<string, string>

    // Cada item se traduce a "título + línea técnica". La conclusión del CI o
    // el código HTTP viajan como dato, no como frase, para que el endpoint no
    // tenga que saber en qué idioma está el visitante.
    const describe = (item: NowItem): string => {
      if (item.kind === 'deploy') {
        return interpolate(metaTpl.deploy ?? '', {
          branch: item.branch,
          sha: item.sha,
          conclusion: conclusions[item.conclusion] ?? item.conclusion,
        })
      }
      if (item.kind === 'uptime') {
        return interpolate(metaTpl.uptime ?? '', {
          name: item.name,
          status: item.statusCode ?? (item.ok ? 'ok' : 'error'),
          ms: item.responseMs ?? '-',
        })
      }
      return interpolate(metaTpl.siem ?? '', { events: formatNumber(item.events, locale) })
    }

    let items: NowItem[] = []
    let index = 0
    let rotateTimer: number | undefined
    let ageTimer: number | undefined

    const paint = () => {
      const item = items[index]
      if (!item) return
      labelEl.textContent = labels[item.kind] ?? ''
      metaEl.textContent = describe(item)
      ageEl.textContent = formatTimeAgo(item.at, locale)
    }

    const advance = () => {
      index = (index + 1) % items.length
      const item = items[index]
      if (reducido || !item) {
        paint()
        return
      }
      // El dato nuevo se descifra sobre el anterior, como una lectura que se
      // estabiliza: es el mismo gesto de "boot" del titular del hero y de las
      // cifras de la cinta, y dice que el dato llegó, no que se cambió de slide.
      ageEl.textContent = formatTimeAgo(item.at, locale)
      gsap.to(labelEl, {
        duration: 0.9,
        scrambleText: { text: labels[item.kind] ?? '', chars: 'lowerCase', speed: 0.55, revealDelay: 0.15 },
      })
      gsap.to(metaEl, {
        duration: 1.1,
        scrambleText: { text: describe(item), chars: '0123456789abcdef', speed: 0.6, revealDelay: 0.25 },
      })
    }

    const startRotation = () => {
      if (rotateTimer || items.length < 2) return
      rotateTimer = window.setInterval(advance, ROTATE_MS)
    }
    const stopRotation = () => {
      if (rotateTimer) window.clearInterval(rotateTimer)
      rotateTimer = undefined
    }

    const applyBudget = (budget: NowPayload['budget']) => {
      if (!budget) return
      const wrap = document.getElementById('now-budget')
      const bar = document.getElementById('now-budget-bar')
      const pct = document.getElementById('now-budget-pct')
      const label = document.getElementById('now-budget-label')
      if (!wrap || !bar || !pct || !label) return

      label.textContent = interpolate(card.dataset.budgetLabel ?? '', { days: budget.windowDays })
      pct.textContent = `${budget.remainingPct}%`
      // El color sale de budgetHealth (src/lib/slo.ts), no de un umbral
      // inventado aquí: la barra dice lo mismo que /status.
      const gradient =
        budget.health === 'healthy'
          ? 'from-lime to-cyan'
          : budget.health === 'warning'
            ? 'from-lime to-ember'
            : 'from-ember to-ember'
      bar.className = `h-full bg-gradient-to-r ${gradient} transition-[width] duration-700 motion-reduce:transition-none`
      wrap.classList.remove('hidden')
      // En el siguiente frame para que la transición de ancho se vea.
      requestAnimationFrame(() => {
        bar.style.width = `${budget.remainingPct}%`
      })
    }

    // Fail-open: cualquier error deja el texto de respaldo que ya pintó el SSR.
    fetch('/api/now')
      .then((r) => (r.ok ? r.json() : null))
      .then((data: NowPayload | null) => {
        if (!data || !Array.isArray(data.items) || data.items.length === 0) return
        items = data.items
        paint()
        applyBudget(data.budget)

        // Solo rota mientras la card está a la vista y la pestaña está activa:
        // un timer corriendo en una pestaña de fondo no le sirve a nadie.
        const io = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting && !document.hidden) startRotation()
            else stopRotation()
          }
        })
        io.observe(card)

        document.addEventListener('visibilitychange', () => {
          if (document.hidden) stopRotation()
          else startRotation()
        })

        // "hace 4 min" tiene que envejecer solo en sesiones largas.
        ageTimer = window.setInterval(() => {
          const item = items[index]
          if (item) ageEl.textContent = formatTimeAgo(item.at, locale)
        }, AGE_REFRESH_MS)
      })
      .catch(() => {
        if (ageTimer) window.clearInterval(ageTimer)
      })
  }
</script>

<script>
  // Paneles de la cinta de señales del hero.
  //
  // Sin framework y sin fetch: el marcado de los cinco paneles ya viene del
  // servidor y esto solo decide cuál está abierto, dónde y con qué animación.
  // La cinta se mueve, así que el estado se ancla a la SEÑAL (data-senal) y no
  // al elemento apuntado: las dos copias del bucle comparten identificador y da
  // igual cuál toque el cursor.
  //
  // El panel no ocupa el ancho entero: se coloca bajo la señal apuntada y se
  // desliza de una a otra cuando el cursor recorre la cinta, en vez de
  // apagarse y encenderse. Un parpadeo por cada señal que se cruza al mover el
  // ratón es ruido; el deslizamiento cuenta que es el mismo panel mirando otra
  // cosa. GSAP porque es una secuencia (caja, hilo, barras, barrido, cifra) que
  // hay que poder reencadenar a media animación al cambiar de señal, y eso con
  // transiciones de CSS son cinco `transition-delay` peleándose.
  import { gsap } from 'gsap'

  type Ficha = {
    id: string
    el: HTMLElement
    card: HTMLElement
    hilo: HTMLElement | null
    muesca: HTMLElement | null
    scan: HTMLElement | null
    caja: HTMLElement | null
    valor: HTMLElement | null
    valorTexto: string
    textos: HTMLElement[]
    barras: HTMLElement[]
    tl: gsap.core.Timeline | null
  }

  {
    const wrap = document.querySelector<HTMLElement>('.pulso-wrap')
    const contenedor = wrap?.querySelector<HTMLElement>('.pulso-paneles') ?? null
    const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    const fichas: Ficha[] = contenedor
      ? Array.from(contenedor.querySelectorAll<HTMLElement>('.pulso-panel')).map((el) => {
          const valor = el.querySelector<HTMLElement>('.pulso-valor')
          return {
            id: el.dataset.panel ?? '',
            el,
            card: el.querySelector<HTMLElement>('.pulso-card')!,
            hilo: el.querySelector<HTMLElement>('.pulso-hilo'),
            muesca: el.querySelector<HTMLElement>('.pulso-muesca'),
            scan: el.querySelector<HTMLElement>('.pulso-scan'),
            caja: el.querySelector<HTMLElement>('.pulso-barras'),
            valor,
            valorTexto: valor?.dataset.valor ?? valor?.textContent?.trim() ?? '',
            textos: Array.from(el.querySelectorAll<HTMLElement>('.pulso-titulo, .pulso-desc, .pulso-dato')),
            barras: Array.from(el.querySelectorAll<HTMLElement>('.pbar')),
            tl: null,
          }
        })
      : []

    // Distancia mínima de la muesca a la esquina del panel, en píxeles: menos
    // que esto y el rombo se come el redondeo del borde.
    const MARGEN_MUESCA = 18

    if (wrap && contenedor && fichas.length > 0) {
      const mapa = new Map(fichas.map((f) => [f.id, f]))
      let activo: Ficha | null = null

      // Centro de la señal apuntada, en píxeles desde el borde izquierdo del
      // contenedor de paneles. Se mide sobre la cifra y no sobre el enlace
      // entero: el enlace incluye el separador y su centro cae en el hueco.
      const centroDe = (senal: HTMLElement): number => {
        const cifra = senal.firstElementChild ?? senal
        const r = cifra.getBoundingClientRect()
        return r.left + r.width / 2 - contenedor.getBoundingClientRect().left
      }

      // Ancla el panel bajo ese centro sin dejar que se salga del ancho útil, y
      // deja el hilo apuntando a la señal aunque la caja haya topado con el
      // borde. Devuelve el `left` aplicado, que es lo que permite deslizar
      // desde la posición del panel anterior.
      const colocar = (f: Ficha, centro: number): number => {
        const total = contenedor.clientWidth
        const ancho = f.el.offsetWidth
        const left = Math.min(Math.max(centro - ancho / 2, 0), Math.max(0, total - ancho))
        // El hilo se queda dentro de la caja aunque la señal apuntada esté
        // fuera del ancho útil: la cinta sangra por los lados y una señal a
        // medio salir dejaría la muesca colgando en el vacío.
        const muesca = Math.min(Math.max(centro - left, MARGEN_MUESCA), ancho - MARGEN_MUESCA)
        f.el.style.left = `${left}px`
        f.el.style.setProperty('--muesca', `${Math.round(muesca)}px`)
        return left
      }

      // La cifra se rebobina: los dígitos giran y se fijan de izquierda a
      // derecha. Es el mismo gesto de "boot" del titular del hero, y sirve de
      // acuse de recibo de que el panel trae un dato nuevo y no el de antes.
      const rebobinar = (f: Ficha) => {
        if (!f.valor || !f.valorTexto) return
        const chars = Array.from(f.valorTexto)
        const estado = { p: 0 }
        gsap.killTweensOf(estado)
        gsap.to(estado, {
          p: 1,
          duration: 0.4,
          ease: 'power2.out',
          onUpdate: () => {
            const corte = estado.p * chars.length
            f.valor!.textContent = chars
              .map((c, i) => (i < corte || !/[0-9]/.test(c) ? c : String((Math.random() * 10) | 0)))
              .join('')
          },
          onComplete: () => {
            f.valor!.textContent = f.valorTexto
          },
        })
      }

      const ocultar = (f: Ficha, duracion: number) => {
        f.tl?.kill()
        f.tl = null
        if (reducido) {
          f.el.classList.remove('is-open')
          f.el.hidden = true
          return
        }
        gsap.killTweensOf([f.el, f.card])
        gsap.to(f.el, {
          opacity: 0,
          y: -4,
          duration: duracion,
          ease: 'power2.in',
          onComplete: () => {
            f.el.hidden = true
            gsap.set(f.el, { clearProps: 'transform' })
          },
        })
      }

      const cerrar = () => {
        if (!activo) return
        ocultar(activo, 0.16)
        activo = null
      }

      const abrir = (id: string, senal: HTMLElement) => {
        const f = mapa.get(id)
        if (!f) return

        // La misma señal, pero la otra copia del bucle: el panel ya trae el
        // dato correcto y solo tiene que reengancharse bajo el cursor. Sin
        // esto, apuntar la copia de la derecha dejaba el panel anclado a la
        // de la izquierda, señalando una cifra que no era.
        if (activo === f) {
          if (f.tl?.isActive()) return
          const previo = parseFloat(f.el.style.left) || 0
          const left = colocar(f, centroDe(senal))
          if (!reducido && Math.abs(previo - left) > 2) {
            gsap.fromTo(
              f.el,
              { x: previo - left },
              { x: 0, duration: 0.3, ease: 'power3.out' },
            )
          }
          return
        }

        const anterior = activo
        activo = f

        // Medir exige el panel en el flujo: oculto con `hidden` no tiene ancho.
        f.el.hidden = false
        const left = colocar(f, centroDe(senal))
        const desde = anterior ? (parseFloat(anterior.el.style.left) || 0) - left : 0
        if (anterior) ocultar(anterior, desde === 0 ? 0.16 : 0.1)

        if (reducido) {
          f.el.classList.add('is-open')
          return
        }

        f.tl?.kill()
        gsap.killTweensOf([f.el, f.card])

        const ancho = f.caja?.clientWidth ?? 0
        const tl = gsap.timeline({ defaults: { ease: 'power3.out' } })
        f.tl = tl

        tl.fromTo(
          f.el,
          { opacity: 0, x: desde, y: -6 },
          { opacity: 1, x: 0, y: 0, duration: 0.34 },
          0,
        )
          .fromTo(
            f.card,
            { clipPath: 'inset(0% 46% 0% 46% round 12px)' },
            { clipPath: 'inset(0% 0% 0% 0% round 12px)', duration: 0.42 },
            0,
          )
          .fromTo(f.hilo, { scaleY: 0, opacity: 0 }, { scaleY: 1, opacity: 1, duration: 0.24 }, 0.04)
          .fromTo(
            f.muesca,
            { scale: 0, opacity: 0 },
            { scale: 1, opacity: 1, duration: 0.34, ease: 'back.out(3)' },
            0.1,
          )
          .fromTo(
            f.barras,
            { scaleY: 0.06, opacity: 0.25 },
            {
              scaleY: 1,
              opacity: 1,
              duration: 0.5,
              ease: 'back.out(1.6)',
              stagger: { each: 0.012, from: 'start' },
            },
            0.08,
          )
          .fromTo(
            f.textos,
            { opacity: 0, y: 5 },
            { opacity: 1, y: 0, duration: 0.3, stagger: 0.035 },
            0.1,
          )

        if (f.scan && ancho > 0) {
          tl.fromTo(
            f.scan,
            { x: 0, opacity: 0 },
            { x: ancho, opacity: 0.9, duration: 0.5, ease: 'power1.inOut' },
            0.08,
          ).to(f.scan, { opacity: 0, duration: 0.18 }, 0.45)
        }

        tl.add(() => rebobinar(f), 0.08)
      }

      wrap.addEventListener('pointerover', (e) => {
        const senal = (e.target as HTMLElement).closest<HTMLElement>('[data-senal]')
        if (senal?.dataset.senal) abrir(senal.dataset.senal, senal)
      })

      // Solo el puntero que puede pasear (ratón, trackpad) abre paneles al
      // salir: en un lápiz o un toque, `pointerleave` llega junto con el tap.
      wrap.addEventListener('pointerleave', cerrar)

      // Teclado: tabular por las señales abre el panel de la que tiene el foco.
      // Es la misma información, no una versión reducida para quien no usa
      // ratón.
      wrap.addEventListener('focusin', (e) => {
        const senal = (e.target as HTMLElement).closest<HTMLElement>('[data-senal]')
        if (senal?.dataset.senal) abrir(senal.dataset.senal, senal)
      })
      wrap.addEventListener('focusout', (e) => {
        const siguiente = e.relatedTarget as Node | null
        if (!siguiente || !wrap.contains(siguiente)) cerrar()
      })

      // Escape cierra sin tener que mover el cursor fuera.
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && activo) cerrar()
      })

      // Al cambiar el ancho, el ancla medida deja de valer y el panel quedaría
      // señalando a otra cifra: se cierra en vez de mentir.
      window.addEventListener('resize', cerrar)

      // Tooltip de las barras. Un delegado por panel y no un listener por barra
      // (son 30 por panel), y `title` nativo no sirve: tarda cerca de un
      // segundo en aparecer y estas barras miden pocos píxeles de ancho. Es el
      // mismo patrón que ya usa el historial de /status.
      for (const f of fichas) {
        const caja = f.caja
        const tip = f.el.querySelector<HTMLElement>('.pulso-tooltip')
        if (!caja || !tip) continue

        caja.addEventListener('pointerover', (e) => {
          const barra = (e.target as HTMLElement).closest<HTMLElement>('.pbar')
          if (!barra) return
          const etiqueta = barra.getAttribute('data-label')
          if (!etiqueta) return
          tip.textContent = etiqueta
          tip.classList.remove('hidden')
          // Anclado al centro de la barra y recortado contra los bordes: sin el
          // clamp, las barras de los extremos sacan el tooltip fuera del panel.
          const centro = barra.offsetLeft + barra.offsetWidth / 2
          const mitad = tip.offsetWidth / 2
          tip.style.left = Math.min(Math.max(centro, mitad), caja.clientWidth - mitad) + 'px'
        })
        caja.addEventListener('pointerleave', () => tip.classList.add('hidden'))
      }
    }
  }
</script>
