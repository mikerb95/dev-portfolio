---
// Página de cierre de la sustentación: se comparte DESPUÉS de la
// presentación en vivo (que corre aparte en /presentacion, con su propio
// mando y su propio estilo de escenario). Esta es una página normal del
// sitio - indexable, con Navbar/Footer y traducción a /en - pensada para que
// el jurado o cualquier visitante navegue la documentación por su cuenta.
//
// Los links a la documentación (`DOCS_LINKS`) son un array local a propósito:
// el contenido definitivo llega después y se reemplaza aquí mismo, sin tocar
// el diccionario de i18n salvo que cambien los títulos/descripciones.
import BaseLayout from '../layouts/BaseLayout.astro'
import { getDictionary, getLocaleFromUrl, localizedHref } from '../i18n'
import { ITERACIONES as ITER_PF } from '../data/iteraciones-portfolio'

const locale = getLocaleFromUrl(Astro.url.pathname)
const t = getDictionary(locale)
const L = (path: string) => localizedHref(path, locale)

const historias = ITER_PF.flatMap((i) => i.historias)
const stats = [
  { label: t.presentacionEnd.stats.iteraciones, value: ITER_PF.length },
  { label: t.presentacionEnd.stats.historias, value: historias.length },
  { label: t.presentacionEnd.stats.aceptadas, value: historias.filter((h) => h.col === 'aceptada').length },
]

// Solo el href y el ícono son fijos aquí; título y descripción salen del
// diccionario (t.presentacionEnd.docs) para mantener el mismo patrón de
// traducción que el resto del sitio (ver src/pages/tools.astro).
const DOCS_META = [
  { href: '/docs' },
  { href: '/docs/kanban' },
  { href: '/architecture' },
  { href: '/security' },
  { href: 'https://github.com/mikerb95/dev-portfolio', external: true },
  { href: '/notes' },
]

const docs = DOCS_META.map((meta, i) => ({ ...meta, ...t.presentacionEnd.docs[i] }))
---

<BaseLayout title={t.presentacionEnd.title} description={t.presentacionEnd.description}>
  <div class="max-w-[1280px] mx-auto px-6 md:px-12 lg:px-20 pt-32 pb-24">

    <a href={L('/')} class="inline-flex items-center gap-2 text-[11px] font-mono uppercase tracking-[.2em] text-ink-300 hover:text-cyan transition-colors mb-12">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
      {t.common.back}
    </a>

    <header class="mb-20">
      <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-6">
        <span class="text-cyan">/presentacion-end</span>
        <span class="h-px flex-1 bg-gradient-to-r from-white/15 to-transparent max-w-[80px]"></span>
        <span>{t.presentacionEnd.eyebrow}</span>
      </div>
      <h1 class="hero-line text-5xl md:text-6xl font-medium tracking-[-.035em] text-mask leading-[.95] mb-8">
        {t.presentacionEnd.h1Line1}<br/>{t.presentacionEnd.h1Line2}
      </h1>
      <p class="text-[16px] text-ink-100 max-w-2xl leading-relaxed">
        {t.presentacionEnd.intro}
      </p>
    </header>

    <!-- Documentación -->
    <section class="mb-20">
      <h2 class="text-2xl md:text-3xl font-medium tracking-[-.02em] text-ink-50 mb-2">{t.presentacionEnd.docsHeading}</h2>
      <p class="text-[14px] text-ink-200 max-w-2xl leading-relaxed mb-8">{t.presentacionEnd.docsIntro}</p>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {docs.map((doc) => (
          <a
            href={doc.external ? doc.href : L(doc.href)}
            target={doc.external ? '_blank' : undefined}
            rel={doc.external ? 'noopener noreferrer' : undefined}
            class="group glass rounded-2xl p-6 border border-white/10 hover:bg-white/[.04] hover:border-white/20 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-black/20 transition-all lift block"
          >
            <div class="flex items-start justify-between gap-3 mb-3">
              <span class="h-2 w-2 rounded-full bg-cyan mt-1.5 shrink-0 group-hover:shadow-[0_0_8px_theme(colors.cyan)] transition-shadow"></span>
              <svg class="w-4 h-4 text-ink-300 group-hover:text-cyan transition-colors shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
            </div>
            <div class="text-[15px] font-medium text-ink-50 mb-1.5">{doc.title}</div>
            <div class="text-[13.5px] text-ink-200 leading-relaxed">{doc.description}</div>
          </a>
        ))}
      </div>
    </section>

    <!-- En números -->
    <section class="mb-20">
      <h2 class="text-2xl md:text-3xl font-medium tracking-[-.02em] text-ink-50 mb-2">{t.presentacionEnd.achievementsHeading}</h2>
      <p class="text-[14px] text-ink-200 max-w-2xl leading-relaxed mb-8">{t.presentacionEnd.achievementsIntro}</p>

      <div class="grid gap-4 sm:grid-cols-3">
        {stats.map((s) => (
          <div class="glass rounded-2xl p-6 border border-white/10">
            <div class="text-3xl font-semibold text-ink-50 tabular-nums">{s.value}</div>
            <div class="text-[13px] font-mono uppercase tracking-wide text-ink-200 mt-1">{s.label}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- Cierre -->
    <section class="rounded-2xl glass p-8 md:p-10 border border-white/10 text-center">
      <h2 class="text-2xl md:text-3xl font-medium tracking-[-.02em] text-ink-50 mb-3">{t.presentacionEnd.closingHeading}</h2>
      <p class="text-[15px] text-ink-100 max-w-xl mx-auto leading-relaxed mb-8">{t.presentacionEnd.closingBody}</p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href={L('/contact')} class="rounded-xl bg-cyan/10 border border-cyan/30 px-5 py-2.5 text-[14px] font-medium text-cyan hover:bg-cyan/15 hover:border-cyan/50 transition-colors">
          {t.presentacionEnd.contactCta}
        </a>
        <a href={L('/')} class="text-[14px] text-ink-200 hover:text-ink-50 transition-colors">
          {t.presentacionEnd.backHome}
        </a>
      </div>
    </section>

  </div>
</BaseLayout>
