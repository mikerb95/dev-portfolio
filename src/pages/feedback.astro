---
// Formulario de feedback. Público, corto y anónimo.
//
// Usa BaseLayout (nav, footer, tipografía del sitio) y no el cascarón de
// proyección: quien llega aquí ya salió de la presentación, y aterrizar en una
// pantalla negra sin salida después de escanear un QR se siente como haber
// caído fuera del sitio.
import BaseLayout from '../layouts/BaseLayout.astro'
import { eq } from 'drizzle-orm'
import { db } from '../db'
import { decks } from '../db/schema'

const rawDeck = Number(Astro.url.searchParams.get('deck'))
const [deck] = Number.isInteger(rawDeck) && rawDeck > 0
  ? await db.select({ id: decks.id, title: decks.title }).from(decks).where(eq(decks.id, rawDeck)).limit(1)
  : []

// El formulario recuerda de qué presentación viene: si se cachea, media sala
// mandaría feedback del deck de otro.
Astro.response.headers.set('Cache-Control', 'no-store')
---

<BaseLayout
  title="Comentarios"
  description="Cuéntame qué te pareció la presentación."
  noindex
>
  <div class="max-w-[720px] mx-auto px-6 md:px-12 pt-32 pb-24">
    <div class="text-[11px] font-mono uppercase tracking-[.28em] text-ink-300 mb-5">Comentarios</div>

    <h1 class="text-3xl md:text-5xl font-medium tracking-[-.03em] text-ink-50 leading-[1.05] mb-4">
      ¿Qué te pareció?
    </h1>

    <p class="text-[15px] text-ink-100 leading-relaxed mb-2">
      Es anónimo y son dos minutos. Lo leo todo.
    </p>
    {deck && (
      <p class="text-[13px] font-mono text-cyan mb-8">{deck.title}</p>
    )}

    <form id="feedback-form" class="grid gap-7 mt-8" data-deck={deck?.id ?? ''}>
      <fieldset class="grid gap-3">
        <legend class="text-[12px] font-mono uppercase tracking-[.18em] text-ink-200 mb-1">
          Valoración
        </legend>
        <div class="flex flex-wrap gap-2" id="rating">
          {[1, 2, 3, 4, 5].map((n) => (
            <button
              type="button"
              data-rating={n}
              aria-pressed="false"
              class="rating-btn h-12 w-12 rounded-xl bg-white/[0.03] border border-white/10 text-[15px] text-ink-200 hover:bg-white/[0.07] transition-colors"
            >
              {n}
            </button>
          ))}
        </div>
        <p class="text-[11px] text-ink-300">1 = no me aportó · 5 = muy buena</p>
      </fieldset>

      <label class="grid gap-2">
        <span class="text-[12px] font-mono uppercase tracking-[.18em] text-ink-200">Comentario</span>
        <textarea
          name="comment"
          rows="5"
          maxlength="2000"
          placeholder="Lo que se entendió, lo que no, lo que sobró…"
          class="px-4 py-3 rounded-xl bg-white/[0.03] border border-white/10 text-[14px] text-ink-50 leading-relaxed focus:border-cyan/40 outline-none resize-y"
        ></textarea>
      </label>

      <label class="grid gap-2">
        <span class="text-[12px] font-mono uppercase tracking-[.18em] text-ink-200">
          Contacto <span class="text-ink-300 normal-case tracking-normal">(opcional)</span>
        </span>
        <input
          name="contact"
          maxlength="200"
          placeholder="Correo o teléfono, solo si quieres respuesta"
          class="h-12 px-4 rounded-xl bg-white/[0.03] border border-white/10 text-[14px] text-ink-50 focus:border-cyan/40 outline-none"
        />
      </label>

      <div class="flex items-center gap-4">
        <button
          type="submit"
          class="h-12 px-6 rounded-full bg-cyan text-ink-950 text-[14px] font-medium hover:brightness-110 transition-all shadow-glow"
        >
          Enviar
        </button>
        <span id="feedback-msg" class="text-[12px] font-mono text-ink-200"></span>
      </div>
    </form>

    <div id="feedback-done" class="hidden">
      <p class="text-[20px] text-ink-50 leading-relaxed">Gracias. Recibido.</p>
      <a href="/" class="mt-6 inline-flex items-center gap-2 text-[14px] text-cyan hover:underline">
        Ir al portafolio →
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .rating-btn[aria-pressed='true'] {
    background: color-mix(in srgb, var(--color-cyan) 16%, transparent);
    border-color: color-mix(in srgb, var(--color-cyan) 45%, transparent);
    color: var(--color-cyan);
  }
</style>

<script>
  const form = document.getElementById('feedback-form') as HTMLFormElement | null
  const msg = document.getElementById('feedback-msg')!
  const done = document.getElementById('feedback-done')!

  let rating: number | null = null

  for (const btn of document.querySelectorAll<HTMLButtonElement>('.rating-btn')) {
    btn.addEventListener('click', () => {
      rating = Number(btn.dataset.rating)
      for (const other of document.querySelectorAll<HTMLButtonElement>('.rating-btn')) {
        other.setAttribute('aria-pressed', String(other === btn))
      }
    })
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault()
    const data = new FormData(form)
    const comment = String(data.get('comment') ?? '').trim()

    if (!rating && !comment) {
      msg.textContent = 'deja al menos una valoración o un comentario'
      return
    }

    msg.textContent = 'enviando…'
    const res = await fetch('/api/feedback', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        deckId: form.dataset.deck ? Number(form.dataset.deck) : null,
        rating,
        comment,
        contact: String(data.get('contact') ?? '').trim(),
      }),
    })

    if (res.ok) {
      form.classList.add('hidden')
      done.classList.remove('hidden')
    } else {
      const body = await res.json().catch(() => ({}))
      msg.textContent = body.error ?? 'no se pudo enviar'
    }
  })
</script>
