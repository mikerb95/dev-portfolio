---
// Landing comercial de la línea de capacitación en IA. Hermana de
// /paginas-web: mismo patrón (hero, formatos, proceso, FAQ, CTA por WhatsApp)
// pero para un comprador distinto, que es una organización y no una persona.
//
// Los programas salen de la base (`training_programs` con isPublic): editar el
// catálogo es trabajo del panel, no de este archivo. Solo el texto de marco
// vive aquí, y ese texto sale del diccionario (la página se sirve también bajo
// /en desde el cascarón src/pages/en/capacitacion-ia.astro).
import BaseLayout from '../layouts/BaseLayout.astro'
import MesaTrabajo from '../components/capacitacion/MesaTrabajo.astro'
import PerfilesDemo from '../components/capacitacion/PerfilesDemo.astro'
import ProcesoDias from '../components/capacitacion/ProcesoDias.astro'
import AulaVitrina from '../components/capacitacion/AulaVitrina.astro'
import { getDictionary, getLocaleFromUrl, interpolate, localizedHref } from '../i18n'
import { listarProgramasPublicos } from '../lib/capacitacion/repo'
import { formatearDuracion } from '../lib/capacitacion/tipos'
import { jsonEnScript } from '../lib/json-script'

const locale = getLocaleFromUrl(Astro.url.pathname)
const t = getDictionary(locale)
const c = t.capacitacionIa

let programas: Awaited<ReturnType<typeof listarProgramasPublicos>> = []
try {
  programas = await listarProgramasPublicos()
} catch (err) {
  // La landing sin catálogo sigue vendiendo (hero, proceso y contacto): más
  // vale una página incompleta que una caída.
  console.error('[capacitacion] no se pudo leer el catálogo público', err)
}

// Tres programas (o cualquier múltiplo de tres) caben en una fila de tres; dos
// o cuatro, en dos columnas: así nunca queda una tarjeta sola con un hueco al
// lado.
const colsProgramas = programas.length % 3 === 0 ? 'lg:grid-cols-3' : ''

const WHATSAPP = '573104641228'
const waLink = (text: string) => `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(text)}`

// El aula vive en su propio subdominio y su propio despliegue (Next.js), aparte
// de este sitio: durante una sesión el grupo entra ahí y una caída del
// portafolio no puede llevarse la capacitación por delante. Desde aquí solo se
// enlaza. Estuvo en capacitaciones.codebymike.tech hasta que la baja del .tech
// se llevó por delante la zona entera (sep 2026); el despliegue no se movió,
// solo el dominio con el que se le llega.
const AULA = 'https://capacitaciones.codebymike.net'




// El catálogo vive en español en base de datos: format y level sí se traducen
// (son enumeraciones nuestras), el texto que escribió el admin no.
const etiquetaFormato = (f: keyof typeof c.formatos) => c.formatos[f]
const etiquetaNivel = (n: keyof typeof c.niveles) => c.niveles[n]
---

<BaseLayout title={c.title} description={c.description} image="/og-default.png">
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={jsonEnScript({
      '@context': 'https://schema.org',
      '@type': 'Service',
      serviceType: c.jsonLdServiceType,
      provider: { '@type': 'Person', name: 'Mike', url: 'https://codebymike.net' },
      areaServed: { '@type': 'Country', name: 'Colombia' },
      description: c.jsonLdDescription,
    })}
  />

  <!-- Hero -->
  <!-- Hero: la promesa a la izquierda y, a la derecha, la mesa de trabajo que
       la muestra (ver MesaTrabajo.astro). En móvil la mesa va debajo. -->
  <section class="relative pt-32 pb-20 px-6 md:px-12 lg:px-20 overflow-hidden">
    <div class="halo" style="filter: hue-rotate(60deg);"></div>
    <div class="relative max-w-[1180px] mx-auto grid lg:grid-cols-[1fr_1fr] gap-14 lg:gap-12 items-center">
      <div>
        <div class="inline-flex items-center gap-2.5 mb-8">
          <span class="w-1.5 h-1.5 rounded-full bg-lime pulse-dot"></span>
          <span class="text-[11px] font-mono uppercase tracking-[.22em] text-ink-100">{c.hero.badge}</span>
        </div>

        <h1 class="font-sans font-medium tracking-[-.035em] leading-[1.02] text-[clamp(38px,5.4vw,70px)] text-ink-50 [&>span]:[text-wrap:balance]">
          <span data-hero-linea class="block">{c.hero.h1Line1}</span>{' '}
          <span data-hero-linea class="block text-lime">{c.hero.h1Line2}</span>
        </h1>

        <p data-hero-sigue class="mt-7 text-[16px] md:text-[17px] text-ink-100 leading-relaxed max-w-[56ch]">
          {c.hero.intro}
        </p>

        <div data-hero-sigue class="mt-9 flex flex-wrap gap-3">
          <a
            href={waLink(c.hero.waMessage)}
            target="_blank"
            rel="noopener noreferrer"
            data-magnetico
            class="inline-flex items-center h-12 px-6 rounded-full bg-lime text-ink-950 text-[14px] font-medium hover:brightness-105 transition-[filter] shadow-[0_0_0_1px_rgba(201,255,91,.35),0_0_32px_-8px_rgba(201,255,91,.55)]"
          >
            <span data-magnetico-texto>{c.hero.ctaWhatsapp}</span>
          </a>
          <a
            href={AULA}
            data-magnetico
            class="inline-flex items-center h-12 px-6 rounded-full border border-white/15 text-[14px] text-ink-100 hover:border-lime/40 hover:text-lime transition-colors"
          >
            <span data-magnetico-texto>{c.hero.ctaAula}</span>
          </a>
          <a
            href={localizedHref('/capacitacion', locale)}
            class="inline-flex items-center h-12 px-3 text-[14px] text-ink-200 hover:text-ink-50 transition-colors"
          >
            {c.hero.ctaMaterial} →
          </a>
        </div>
      </div>

      <div data-hero-pieza><MesaTrabajo /></div>
    </div>
  </section>

  <!-- Perfiles -->
  <PerfilesDemo />

  <!-- Programas -->
  {programas.length > 0 && (
    <section class="px-6 md:px-12 lg:px-20 pb-24">
      <div class="max-w-[1180px] mx-auto">
        <h2 data-titular class="font-sans text-3xl md:text-5xl font-medium tracking-[-.025em] text-ink-50 mb-10 leading-[1.05]">{c.programasHeading}</h2>
        <div class={`grid gap-4 md:grid-cols-2 ${colsProgramas}`} data-foco data-entrada>
          {programas.map((p) => (
            <div class="rounded-3xl glass foco p-7 flex flex-col">
              <div class="flex items-center gap-2 text-[10px] font-mono uppercase tracking-[.18em] text-ink-300">
                <span>{etiquetaFormato(p.format)}</span>
                <span>· {etiquetaNivel(p.level)}</span>
                {formatearDuracion(p.durationHours) && <span>· {formatearDuracion(p.durationHours)}</span>}
              </div>

              <h3 class="mt-3 text-[17px] text-ink-50 leading-snug">{p.title}</h3>
              {p.summary && <p class="mt-2 text-[12.5px] text-ink-200 leading-relaxed">{p.summary}</p>}
              {p.audience && <div class="mt-3 text-[11.5px] text-ink-300">{c.programaPara} {p.audience}</div>}

              {p.outcomes.length > 0 && (
                <ul class="mt-4 space-y-1.5">
                  {p.outcomes.map((o) => (
                    <li class="flex gap-2 text-[12.5px] text-ink-200">
                      <span class="text-lime shrink-0">·</span>
                      <span>{o}</span>
                    </li>
                  ))}
                </ul>
              )}

              {p.modules.length > 0 && (
                <details class="mt-4">
                  <summary class="text-[12.5px] text-lime cursor-pointer hover:underline">{c.verTemario}</summary>
                  <ol class="mt-2 space-y-1 text-[12px] text-ink-200 list-decimal pl-5">
                    {p.modules.map((m) => <li>{m}</li>)}
                  </ol>
                </details>
              )}

              <div class="mt-auto pt-5 flex items-center justify-between gap-3">
                <span class="text-[12px] text-ink-100">{p.priceNote ?? c.precioAConvenir}</span>
                <a
                  href={waLink(interpolate(c.waProgramaMessage, { title: p.title }))}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[12px] rounded-lg border border-white/10 px-3 py-1.5 text-ink-100 hover:bg-white/5 transition-colors"
                >
                  {c.preguntar}
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Proceso: del diagnóstico al día 30 -->
  <ProcesoDias />

  <!-- El aula, con capturas reales -->
  <AulaVitrina aula={AULA} />

  <!-- FAQ y cierre -->
  <section class="px-6 md:px-12 lg:px-20 pb-24">
    <div class="max-w-[800px] mx-auto">
      <h2 data-titular class="font-sans text-3xl md:text-5xl font-medium tracking-[-.025em] text-ink-50 text-center mb-10 leading-[1.05]">{c.faqHeading}</h2>
      <div class="space-y-3" data-faq data-entrada>
        {c.faqs.map((f) => (
          <details class="group glass rounded-2xl px-6 py-5 transition-colors hover:border-lime/20">
            <summary class="flex items-center justify-between cursor-pointer list-none text-[15.5px] font-medium text-ink-50">
              {f.q}
              <svg class="w-5 h-5 text-ink-300 transition-transform duration-300 group-open:rotate-45 group-open:text-lime shrink-0 ml-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
            </summary>
            <div class="faq-cuerpo overflow-hidden"><p class="pt-3 text-[14px] text-ink-200 leading-relaxed">{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>

    <div class="max-w-[1000px] mx-auto mt-20" data-foco>
      <div class="ci-cierre glass-strong foco rounded-[2rem] px-8 py-14 md:px-14 text-center">
        <span class="ci-cierre-punto" aria-hidden="true"></span>
        <h2 data-titular class="font-sans text-3xl md:text-5xl font-medium tracking-[-.025em] text-ink-50 leading-[1.05]">{c.ctaTitulo}</h2>
        <p class="mt-5 text-[15px] text-ink-100 leading-relaxed max-w-[52ch] mx-auto">
          {c.ctaBody}
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a
            href={waLink(c.waCtaMessage)}
            target="_blank"
            rel="noopener noreferrer"
            data-magnetico
            class="inline-flex items-center h-12 px-6 rounded-full bg-lime text-ink-950 text-[14px] font-medium hover:brightness-105 transition-[filter]"
          >
            <span data-magnetico-texto>{c.ctaWhatsapp}</span>
          </a>
          <a
            href={localizedHref('/contact', locale)}
            data-magnetico
            class="inline-flex items-center h-12 px-6 rounded-full border border-white/15 text-[14px] text-ink-100 hover:border-lime/40 hover:text-lime transition-colors"
          >
            <span data-magnetico-texto>{c.ctaForm}</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Punto de acento sobre el cierre: el mismo latido lima del distintivo del
     hero, para que el final remita al principio. */
  .ci-cierre {
    position: relative;
  }
  .ci-cierre-punto {
    position: absolute;
    top: 28px;
    left: 50%;
    width: 8px;
    height: 8px;
    margin-left: -4px;
    border-radius: 999px;
    background: var(--color-lime);
    box-shadow: 0 0 0 6px rgba(201, 255, 91, 0.12);
    animation: pulseDot 1.6s ease-in-out infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .ci-cierre-punto {
      animation: none;
    }
  }
</style>

<script>
  // Motion transversal (src/lib/motion/landing.ts); las piezas grandes (mesa de
  // trabajo, perfiles, proceso por días, aula) viven en sus componentes.
  import { montarLanding } from '../lib/motion/landing'

  montarLanding({ inclinarPieza: 3 })
</script>
