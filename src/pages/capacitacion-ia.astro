---
// Landing comercial de la línea de capacitación en IA. Hermana de
// /paginas-web: mismo patrón (hero, formatos, proceso, FAQ, CTA por WhatsApp)
// pero para un comprador distinto, que es una organización y no una persona.
//
// Los programas salen de la base (`training_programs` con isPublic): editar el
// catálogo es trabajo del panel, no de este archivo. Solo el texto de marco
// vive aquí, y ese texto sale del diccionario (la página se sirve también bajo
// /en desde el cascarón src/pages/en/capacitacion-ia.astro).
import BaseLayout from '../layouts/BaseLayout.astro'
import { getDictionary, getLocaleFromUrl, interpolate, localizedHref } from '../i18n'
import { listarProgramasPublicos } from '../lib/capacitacion/repo'
import { formatearDuracion } from '../lib/capacitacion/tipos'

const locale = getLocaleFromUrl(Astro.url.pathname)
const t = getDictionary(locale)
const c = t.capacitacionIa

let programas: Awaited<ReturnType<typeof listarProgramasPublicos>> = []
try {
  programas = await listarProgramasPublicos()
} catch (err) {
  // La landing sin catálogo sigue vendiendo (hero, proceso y contacto): más
  // vale una página incompleta que una caída.
  console.error('[capacitacion] no se pudo leer el catálogo público', err)
}

const WHATSAPP = '573104641228'
const waLink = (text: string) => `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(text)}`

// El aula vive en su propio subdominio y su propio despliegue (Next.js), aparte
// de este sitio: durante una sesión el grupo entra ahí y una caída del
// portafolio no puede llevarse la capacitación por delante. Desde aquí solo se
// enlaza. Estuvo en capacitaciones.codebymike.tech hasta que la baja del .tech
// se llevó por delante la zona entera (sep 2026); el despliegue no se movió,
// solo el dominio con el que se le llega.
const AULA = 'https://capacitaciones.codebymike.net'

// Clases de color explícitas (no interpoladas): Tailwind solo genera las clases
// que ve escritas completas en el código fuente. Van aquí y no en el
// diccionario porque son diseño, no texto.
const AULA_COLORS = [
  { dot: 'bg-cyan', texto: 'text-cyan', href: AULA },
  { dot: 'bg-lime', texto: 'text-lime', href: `${AULA}/empresa` },
  { dot: 'bg-violet', texto: 'text-violet', href: AULA },
]
const aulaPuntos = c.aulaPuntos.map((p, i) => ({ ...p, ...AULA_COLORS[i] }))

const PERFIL_COLORS = [
  { dot: 'bg-ember', texto: 'text-ember' },
  { dot: 'bg-lime', texto: 'text-lime' },
  { dot: 'bg-violet', texto: 'text-violet' },
]
const perfiles = c.perfiles.map((p, i) => ({ ...p, ...PERFIL_COLORS[i] }))

const pasos = c.pasos.map((p, i) => ({ ...p, n: `0${i + 1}` }))

// El catálogo vive en español en base de datos: format y level sí se traducen
// (son enumeraciones nuestras), el texto que escribió el admin no.
const etiquetaFormato = (f: keyof typeof c.formatos) => c.formatos[f]
const etiquetaNivel = (n: keyof typeof c.niveles) => c.niveles[n]
---

<BaseLayout title={c.title} description={c.description} image="/og-default.png">
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Service',
      serviceType: c.jsonLdServiceType,
      provider: { '@type': 'Person', name: 'Mike', url: 'https://codebymike.net' },
      areaServed: { '@type': 'Country', name: 'Colombia' },
      description: c.jsonLdDescription,
    })}
  />

  <!-- Hero -->
  <section class="relative pt-32 pb-20 px-6 md:px-12 lg:px-20 overflow-hidden">
    <div class="halo" style="filter: hue-rotate(60deg);"></div>
    <div class="relative max-w-[1000px] mx-auto text-center">
      <div class="inline-flex items-center gap-2.5 mb-8">
        <span class="w-1.5 h-1.5 rounded-full bg-lime pulse-dot"></span>
        <span class="text-[11px] font-mono uppercase tracking-[.22em] text-ink-100">{c.hero.badge}</span>
      </div>

      <h1 class="font-sans font-medium tracking-[-.03em] leading-[1.02] text-[clamp(36px,6.5vw,74px)] text-ink-50">
        {c.hero.h1Line1}<br />{c.hero.h1Line2}
      </h1>

      <p class="mt-7 text-[15.5px] text-ink-200 leading-relaxed max-w-[64ch] mx-auto">
        {c.hero.intro}
      </p>

      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a
          href={waLink(c.hero.waMessage)}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-xl bg-lime/[0.10] border border-lime/30 px-5 py-2.5 text-[13px] text-lime hover:bg-lime/[0.16] transition-colors"
        >
          {c.hero.ctaWhatsapp}
        </a>
        <a
          href={AULA}
          class="rounded-xl border border-white/10 px-5 py-2.5 text-[13px] text-ink-100 hover:bg-white/5 transition-colors"
        >
          {c.hero.ctaAula}
        </a>
        <a
          href={localizedHref('/capacitacion', locale)}
          class="rounded-xl border border-white/10 px-5 py-2.5 text-[13px] text-ink-100 hover:bg-white/5 transition-colors"
        >
          {c.hero.ctaMaterial}
        </a>
      </div>
    </div>
  </section>

  <!-- Perfiles -->
  <section class="px-6 md:px-12 lg:px-20 pb-20">
    <div class="max-w-[1000px] mx-auto">
      <h2 class="text-[11px] font-mono uppercase tracking-[.22em] text-ink-300 mb-6">{c.perfilesHeading}</h2>
      <div class="grid gap-3 md:grid-cols-3">
        {perfiles.map((p) => (
          <div class="rounded-2xl glass p-6 lift">
            <div class="flex items-center gap-2">
              <span class={`w-1.5 h-1.5 rounded-full ${p.dot}`}></span>
              <span class={`text-[13px] ${p.texto}`}>{p.titulo}</span>
            </div>
            <p class="mt-3 text-[12.5px] text-ink-200 leading-relaxed">{p.detalle}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Programas -->
  {programas.length > 0 && (
    <section class="px-6 md:px-12 lg:px-20 pb-20">
      <div class="max-w-[1000px] mx-auto">
        <h2 class="text-[11px] font-mono uppercase tracking-[.22em] text-ink-300 mb-6">{c.programasHeading}</h2>
        <div class="grid gap-3 md:grid-cols-2">
          {programas.map((p) => (
            <div class="rounded-2xl glass p-6 lift flex flex-col">
              <div class="flex items-center gap-2 text-[10px] font-mono uppercase tracking-[.18em] text-ink-300">
                <span>{etiquetaFormato(p.format)}</span>
                <span>· {etiquetaNivel(p.level)}</span>
                {formatearDuracion(p.durationHours) && <span>· {formatearDuracion(p.durationHours)}</span>}
              </div>

              <h3 class="mt-3 text-[17px] text-ink-50 leading-snug">{p.title}</h3>
              {p.summary && <p class="mt-2 text-[12.5px] text-ink-200 leading-relaxed">{p.summary}</p>}
              {p.audience && <div class="mt-3 text-[11.5px] text-ink-300">{c.programaPara} {p.audience}</div>}

              {p.outcomes.length > 0 && (
                <ul class="mt-4 space-y-1.5">
                  {p.outcomes.map((o) => (
                    <li class="flex gap-2 text-[12.5px] text-ink-200">
                      <span class="text-lime shrink-0">·</span>
                      <span>{o}</span>
                    </li>
                  ))}
                </ul>
              )}

              {p.modules.length > 0 && (
                <details class="mt-4">
                  <summary class="text-[12px] text-cyan cursor-pointer">{c.verTemario}</summary>
                  <ol class="mt-2 space-y-1 text-[12px] text-ink-200 list-decimal pl-5">
                    {p.modules.map((m) => <li>{m}</li>)}
                  </ol>
                </details>
              )}

              <div class="mt-auto pt-5 flex items-center justify-between gap-3">
                <span class="text-[12px] text-ink-100">{p.priceNote ?? c.precioAConvenir}</span>
                <a
                  href={waLink(interpolate(c.waProgramaMessage, { title: p.title }))}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[12px] rounded-lg border border-white/10 px-3 py-1.5 text-ink-100 hover:bg-white/5 transition-colors"
                >
                  {c.preguntar}
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Proceso -->
  <section class="px-6 md:px-12 lg:px-20 pb-20">
    <div class="max-w-[1000px] mx-auto">
      <h2 class="text-[11px] font-mono uppercase tracking-[.22em] text-ink-300 mb-6">{c.procesoHeading}</h2>
      <div class="grid gap-3 md:grid-cols-4">
        {pasos.map((s) => (
          <div class="rounded-2xl glass p-6">
            <div class="font-mono text-[11px] text-cyan tracking-[.2em]">{s.n}</div>
            <div class="mt-3 text-[14px] text-ink-50">{s.titulo}</div>
            <p class="mt-2 text-[12.5px] text-ink-200 leading-relaxed">{s.detalle}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- El aula -->
  <section class="px-6 md:px-12 lg:px-20 pb-20">
    <div class="max-w-[1000px] mx-auto">
      <h2 class="text-[11px] font-mono uppercase tracking-[.22em] text-ink-300 mb-6">
        {c.aulaHeading}
      </h2>

      <div class="rounded-2xl glass p-7">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
          <span class="w-1.5 h-1.5 rounded-full bg-cyan pulse-dot"></span>
          <span class="text-[15px] text-ink-50">{c.aulaNombre}</span>
          <a
            href={AULA}
            class="font-mono text-[11.5px] text-cyan hover:underline"
          >
            capacitaciones.codebymike.net
          </a>
        </div>

        <p class="mt-4 text-[13px] text-ink-200 leading-relaxed max-w-[70ch]">
          {c.aulaIntro}
        </p>

        <div class="mt-6 grid gap-3 md:grid-cols-3">
          {aulaPuntos.map((p) => (
            <div class="rounded-xl border border-white/8 p-5 flex flex-col">
              <div class="flex items-center gap-2">
                <span class={`w-1.5 h-1.5 rounded-full ${p.dot}`}></span>
                <span class={`text-[13px] ${p.texto}`}>{p.titulo}</span>
              </div>
              <p class="mt-3 text-[12.5px] text-ink-200 leading-relaxed">{p.detalle}</p>
              <a
                href={p.href}
                class="mt-auto pt-4 text-[12px] text-ink-100 hover:text-ink-50 transition-colors"
              >
                {p.enlace} →
              </a>
            </div>
          ))}
        </div>

        <p class="mt-6 text-[12px] text-ink-300 leading-relaxed max-w-[70ch]">
          {c.aulaNotaPre}
          <a href={localizedHref('/capacitacion/acceso', locale)} class="text-cyan hover:underline">{c.aulaNotaEnlace}</a>
          {c.aulaNotaPost}
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="px-6 md:px-12 lg:px-20 pb-24">
    <div class="max-w-[760px] mx-auto">
      <h2 class="text-[11px] font-mono uppercase tracking-[.22em] text-ink-300 mb-6">{c.faqHeading}</h2>
      <div class="space-y-2">
        {c.faqs.map((f) => (
          <details class="rounded-2xl glass p-5">
            <summary class="text-[13.5px] text-ink-50 cursor-pointer">{f.q}</summary>
            <p class="mt-3 text-[12.5px] text-ink-200 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>

      <div class="mt-10 rounded-2xl glass p-7 text-center">
        <div class="text-[15px] text-ink-50">{c.ctaTitulo}</div>
        <p class="mt-2 text-[12.5px] text-ink-200 leading-relaxed max-w-[52ch] mx-auto">
          {c.ctaBody}
        </p>
        <div class="mt-5 flex flex-wrap justify-center gap-3">
          <a
            href={waLink(c.waCtaMessage)}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-xl bg-lime/[0.10] border border-lime/30 px-5 py-2.5 text-[13px] text-lime hover:bg-lime/[0.16] transition-colors"
          >
            {c.ctaWhatsapp}
          </a>
          <a
            href={localizedHref('/contact', locale)}
            class="rounded-xl border border-white/10 px-5 py-2.5 text-[13px] text-ink-100 hover:bg-white/5 transition-colors"
          >
            {c.ctaForm}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
