---
// La PANTALLA: lo que se proyecta. `final.html` no se toca ni se edita, y
// además se REEMPLAZA entero cada vez que se itera la presentación: por eso
// toda la lógica de navegación vive aquí y no queda ni un número suyo cableado
// (ni cuántos beats trae, ni cuántas capas, ni sus z-index). El bundle se monta
// en un iframe y se descubre por su forma en cada carga.
//
// Esta página es la ÚNICA fuente de verdad del sistema: es la que sabe en qué
// punto está la presentación y cuántos hay. El servidor solo guarda el destino
// que pide el mando; aquí se cierra la diferencia y se publica el resultado.
//
// EL MAZO NO SON LOS BEATS. El bundle solo sabe contar beats, y su contador
// dice "01 / 19" tanto en la cita como en la portada, y "19 / 19" en el cierre.
// Derivar la posición de ese contador -que es lo que se hacía- colapsaba
// cuatro diapositivas reales en dos números: al arrancar, un solo toque del
// mando gastaba tres flechas de golpe, y el cierre era inalcanzable porque el
// servidor acota el destino contra un total que no lo incluía. El reparto de
// mando que arregla eso: el bundle manda en los beats (por teclas) y esta
// página manda en las capas (por estilo). Las reglas, en
// `src/lib/presentacion/mapa.ts`, probadas sin DOM.
//
// Tres detalles que costaron una depuración y que no son evidentes:
//
//  1. El `KeyboardEvent` tiene que construirse con el constructor DEL IFRAME.
//     Uno creado en este realm y despachado contra el iframe no dispara su
//     listener: la diapositiva sencillamente no se movía.
//  2. La posición se lee del DOM y no del evento `sustentacion:beat` que el
//     bundle emite. Este script es un módulo (diferido), así que el iframe
//     puede haber terminado de cargar ANTES de que corra y el `load` al que se
//     enganchaba el listener ya no vuelve. Cuando pasaba, la posición se
//     quedaba congelada en 1 y la reconciliación "corregía" el servidor hacia
//     atrás, borrando los toques recién pulsados.
//  3. El bundle arranca con sus capas de entrada abiertas y se traga una tecla
//     por cada una antes de mover un beat. Esa deuda se paga una sola vez y en
//     orden; después, mandarle una tecla para retirar una capa movería un beat
//     que nadie pidió.
//
// TRES BEATS PROYECTAN UNA PÁGINA VIVA dentro de otro iframe (la demo del
// portal, `/status`, `/engineering`). Como en producción esa cadena entera es
// de un solo origen, se pueden desplazar desde aquí: se descubre el iframe en
// juego -por forma, como todo lo demás-, se publica su geometría junto a la
// posición y se obedece el desplazamiento que pide el mando. En local esas
// URLs son absolutas a producción y por tanto de otro origen: no se dejan
// tocar, se publica sin geometría y el mando sencillamente no enseña los
// controles.
Astro.response.headers.set('Cache-Control', 'no-store')
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow')
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Presentación</title>
    <style>
      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        padding: 0;
        height: 100%;
        overflow: hidden;
        background: #05070a;
      }
      iframe {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        border: 0;
        /* El bundle se navega por teclado. Sin esto, un clic dentro lo
           movería por su cuenta y el próximo sondeo lo devolvería de golpe. */
        pointer-events: none;
      }
      #aviso-movil {
        position: fixed;
        inset: 0;
        z-index: 10;
        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1.25rem;
        padding: 2rem;
        text-align: center;
        background: rgba(5, 7, 10, 0.92);
        color: #f4f6f8;
        font: 16px/1.4 system-ui, sans-serif;
      }
      #aviso-movil.visible {
        display: flex;
      }
      #aviso-movil svg {
        width: 3rem;
        height: 3rem;
        animation: girar 1.6s ease-in-out infinite;
      }
      @keyframes girar {
        0%,
        100% {
          transform: rotate(0deg);
        }
        50% {
          transform: rotate(-90deg);
        }
      }
      #aviso-movil button {
        pointer-events: auto;
        border: 1px solid #f4f6f8;
        background: transparent;
        color: inherit;
        font: inherit;
        padding: 0.5rem 1.25rem;
        border-radius: 999px;
        cursor: pointer;
      }
    </style>
  </head>
  <body>
    <iframe id="lienzo" src="/final.html" title="Presentación"></iframe>

    <div id="aviso-movil">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="7" y="2" width="10" height="20" rx="2" />
        <line x1="11" y1="18" x2="13" y2="18" />
      </svg>
      <p id="aviso-texto">Gira el teléfono a horizontal para ver bien la presentación.</p>
      <button id="aviso-fullscreen" type="button">Pantalla completa</button>
    </div>

    <script>
      import {
        aGlobal,
        aPunto,
        bundleAunLaTiene,
        paso,
        puntoDesdeCapas,
        totalGlobal,
        type Accion,
        type Mazo,
        type Punto,
      } from '../lib/presentacion/mapa'
      import type { Geometria } from '../lib/presentacion/desplazamiento'
      // El descubrimiento vive fuera porque `/present-admin` necesita el mismo,
      // y dos copias de estas reglas divergirían sin que nadie lo notara hasta
      // tener una ventana en la diapositiva de al lado. Las decisiones con
      // filo (quién recorta a quién, el orden de las zonas) están probadas en
      // `tests/presentacion-lienzo.test.ts`.
      import {
        descubrirMazo,
        estiloEn,
        geometriaDe,
        iframeEnJuego,
        leerBeat as leerBeatDe,
        mismaGeometria as mismaGeo,
        RUIDO_PX,
        urlDe,
        type Capa,
      } from '../lib/presentacion/lienzo'
      // Las dos cosas que esta ventana OBEDECE además de la diapositiva: la URL
      // de la página viva que el ponente está tocando y el elemento que está
      // señalando con el ratón. Las reglas -qué se acepta, qué se descarta por
      // viejo, qué se aplica a qué diapositiva- son puras y viven fuera.
      import {
        debeNavegar,
        esMasNuevo,
        parsearEspejo,
        urlPara,
        type Espejo,
      } from '../lib/presentacion/espejo'
      import {
        aplicarPuntero,
        esMasNuevo as esMasNuevoPuntero,
        parsearPuntero,
        punteroPara,
        type Puntero,
      } from '../lib/presentacion/puntero'

      const iframe = document.getElementById('lienzo') as HTMLIFrameElement

      /* ------------------------------------------------------------------ *
       * Aviso para móvil: girar a horizontal y sugerir pantalla completa.
       * Es orientativo, no bloquea nada -si alguien de verdad quiere
       * proyectar en vertical, puede-, así que se cierra con un toque en
       * cualquier parte y no vuelve a salir hasta la siguiente vez que el
       * teléfono pase por vertical.
       * ------------------------------------------------------------------ */
      const esMovil =
        matchMedia('(pointer: coarse)').matches && matchMedia('(hover: none)').matches
      if (esMovil) {
        const aviso = document.getElementById('aviso-movil') as HTMLElement
        const texto = document.getElementById('aviso-texto') as HTMLElement
        const btnFullscreen = document.getElementById('aviso-fullscreen') as HTMLButtonElement
        let descartado = false

        const enPantallaCompleta = () => Boolean(document.fullscreenElement)

        function actualizarAviso() {
          if (descartado) return
          const vertical = matchMedia('(orientation: portrait)').matches
          if (!vertical) descartado = false // vuelve a poder avisar si regresa a vertical más tarde
          const faltaFullscreen = !enPantallaCompleta()
          if (!vertical && !faltaFullscreen) {
            aviso.classList.remove('visible')
            return
          }
          texto.textContent = vertical
            ? 'Gira el teléfono a horizontal para ver bien la presentación.'
            : 'Toca para entrar en pantalla completa.'
          btnFullscreen.hidden = !faltaFullscreen
          aviso.classList.add('visible')
        }

        btnFullscreen.addEventListener('click', () => {
          document.documentElement.requestFullscreen?.().catch(() => {
            // Algunos navegadores móviles solo permiten pedirla desde un
            // gesto del usuario y aun así la niegan (Safari en iPhone, por
            // ejemplo): no hay nada más que hacer, se deja el aviso de girar.
          })
        })
        aviso.addEventListener('click', (e) => {
          if (e.target === btnFullscreen) return
          descartado = true
          aviso.classList.remove('visible')
        })
        matchMedia('(orientation: portrait)').addEventListener('change', actualizarAviso)
        document.addEventListener('fullscreenchange', actualizarAviso)
        actualizarAviso()
      }

      /** Lo que se publica: posición global, forma del mazo y, si la
       *  diapositiva trae una página viva dentro, su geometría. */
      type Actual = {
        pos: number
        total: number
        intro: number
        outro: number
        scroll?: Geometria
      }
      /** Lo que pinta el contador del bundle, que solo cuenta beats. */
      type Beat = { pos: number; total: number }
      type Origen = 'inicial' | 'latido' | 'mando' | 'ajena'

      /** Cada cuánto se pregunta el destino. */
      const SONDEO_MS = 500
      /** Cada cuánto se republica la posición aunque no haya cambiado, para
       *  que el mando siga viendo la pantalla viva y conserve el techo real. */
      const LATIDO_MS = 5_000
      /** Lo que tarda un paso en asentarse (un beat anima un canvas pesado y
       *  una capa se funde en .4s). */
      const PASO_MS = 350
      /** Lo que se le da a un `scrollTo` suave antes de volver a empujar. El
       *  sondeo va a 500 ms y la animación dura parecido: sin este cierre, el
       *  ciclo siguiente leería una posición a medio camino y pelearía con la
       *  animación en curso, dando saltos cortos en vez de un empujón. */
      const CIERRE_SCROLL_MS = 400

      /* ------------------------------------------------------------------ *
       * Descubrimiento del mazo
       *
       * `final.html` se reemplaza entero cada vez que se itera la
       * presentación, así que nada de él puede estar cableado aquí: ni el
       * número de beats, ni los z-index de sus capas, ni cuántas hay. Lo que
       * se busca son formas, no identidades.
       * ------------------------------------------------------------------ */

      let mazo: Mazo | null = null
      let capas: { intro: Capa[]; outro: Capa[] } = { intro: [], outro: [] }
      /** Qué capas queremos puestas. Es la verdad, no el DOM: mientras una
       *  capa se funde -o mientras la pestaña está en segundo plano y el
       *  navegador congela la transición- su opacidad calculada miente sobre
       *  la intención. */
      let puestas = { intro: [] as boolean[], outro: [] as boolean[] }
      /** Lo último que se le pintó a cada capa, para no reescribir estilos (y
       *  reiniciar el fundido) en cada sondeo. */
      let pintado = { intro: [] as boolean[], outro: [] as boolean[] }
      /** Cuántas capas de entrada le hemos gastado ya al bundle (ver
       *  `bundleAunLaTiene`). Se reinicia si el iframe se recarga. */
      let consumidas = 0
      let contador: HTMLElement | null = null

      const estilo = estiloEn(iframe)

      const leerBeat = (): Beat | null => leerBeatDe(iframe.contentDocument, contador)

      /**
       * Vuelca en el estado local lo que `descubrirMazo` haya visto. Sigue
       * devolviendo un booleano porque el bucle lo usa como "¿ya hay mazo?":
       * mientras el bundle no haya montado su contador, no hay nada que mirar.
       */
      function descubrir(): boolean {
        const hallazgo = descubrirMazo(iframe)
        if (!hallazgo) return false
        contador = hallazgo.contador
        capas = { intro: hallazgo.intro, outro: hallazgo.outro }
        puestas = {
          intro: hallazgo.intro.map(() => true),
          outro: hallazgo.outro.map(() => false),
        }
        pintado = { intro: [...puestas.intro], outro: [...puestas.outro] }
        consumidas = 0
        mazo = { intro: hallazgo.intro.length, beats: hallazgo.beats, outro: hallazgo.outro.length }
        return true
      }

      // Si el bundle se recarga por su cuenta vuelve a tener sus capas de
      // entrada abiertas y su cuenta de teclas sin gastar. Se descubre otra
      // vez desde cero y el destino guardado reconstruye la charla sola.
      iframe.addEventListener('load', () => {
        mazo = null
        contador = null
        ultimo = null
      })

      /* ------------------------------------------------------------------ *
       * Movimiento
       * ------------------------------------------------------------------ */

      function disparar(tecla: string) {
        const w = iframe.contentWindow
        const d = iframe.contentDocument
        if (!w || !d) return
        try {
          // Constructor DEL IFRAME: con el de esta página, el listener del
          // bundle no se entera y la diapositiva no se mueve. Se despacha
          // sobre el documento con `bubbles`, que sube hasta `window`.
          const Ctor =
            (w as unknown as { KeyboardEvent?: typeof KeyboardEvent }).KeyboardEvent ??
            KeyboardEvent
          d.dispatchEvent(new Ctor('keydown', { key: tecla, bubbles: true, cancelable: true }))
        } catch {
          // Iframe recargándose: el próximo sondeo reintenta.
        }
      }

      /**
       * Pone o quita una capa. Es todo lo que hace falta para navegar la
       * entrada y el cierre, y es lo que hace la navegación REVERSIBLE: el
       * bundle solo sabe cerrar su portada (`closeCover` es de ida, y `go`
       * acota en el primer beat), pero su portada no es más que un div tapado,
       * y eso se deshace desde fuera sin recargar nada.
       */
      function pintarCapa(zona: 'intro' | 'outro', idx: number, visible: boolean) {
        const c = capas[zona][idx]
        if (!c) return
        pintado[zona][idx] = visible
        const e = c.el
        e.style.transition = 'opacity .4s linear'
        e.style.pointerEvents = 'none'
        if (visible) {
          e.style.visibility = 'visible'
          e.style.opacity = '1'
        } else {
          e.style.opacity = '0'
          // La visibilidad se retira DESPUÉS del fundido, y solo si para
          // entonces sigue sobrando: quitarla de golpe cortaría la fundida en
          // seco, y quitarla sin comprobar apagaría una capa que el mando
          // acabara de volver a pedir.
          setTimeout(() => {
            if (!puestas[zona][idx]) e.style.visibility = 'hidden'
          }, 450)
        }
      }

      /**
       * Re-afirma la intención en el DOM. Hace falta por un solo escritor
       * ajeno: al cerrar sus capas de entrada, el bundle deja programado un
       * `visibility:hidden` diferido, y una capa que volvimos a poner justo
       * antes se apagaría sola sin esto.
       */
      function afirmarCapas() {
        for (const zona of ['intro', 'outro'] as const) {
          capas[zona].forEach((c, k) => {
            const quiere = puestas[zona][k]
            const roto = quiere && estilo(c.el).visibility === 'hidden'
            if (quiere !== pintado[zona][k] || roto) pintarCapa(zona, k, quiere)
          })
        }
      }

      function aplicar(acc: Accion) {
        if (acc.tipo === 'tecla') {
          disparar(acc.tecla)
          return
        }
        if (!capas[acc.zona][acc.idx]) return
        // Primera vez que se retira una capa de entrada: el bundle todavía la
        // cree suya y se va a tragar una flecha antes de mover ningún beat.
        // Gastársela aquí deja su estado y el nuestro de acuerdo; a partir de
        // ahí la capa es solo estilo.
        if (acc.zona === 'intro' && !acc.visible && bundleAunLaTiene(acc.idx, consumidas)) {
          disparar('ArrowRight')
          consumidas = acc.idx + 1
        }
        puestas[acc.zona][acc.idx] = acc.visible
        pintarCapa(acc.zona, acc.idx, acc.visible)
      }

      /** La posición publicable de un punto: global + forma del mazo + la
       *  geometría de la página de dentro, si esta diapositiva trae una. */
      function posicionDe(m: Mazo, p: Punto, geo?: Geometria | null): Actual {
        return {
          pos: aGlobal(m, p),
          total: totalGlobal(m),
          intro: m.intro,
          outro: m.outro,
          ...(geo ? { scroll: geo } : {}),
        }
      }

      function puntoActual(): Punto | null {
        const beat = leerBeat()
        if (!mazo || !beat) return null
        // El total de beats es del bundle, no nuestro: si se reemplaza por uno
        // con más, el mazo crece solo y el mando ve el techo nuevo.
        mazo = { ...mazo, beats: beat.total }
        return puntoDesdeCapas(mazo, { ...puestas, beat: beat.pos })
      }


      /* ------------------------------------------------------------------ *
       * La página viva de dentro de la diapositiva
       *
       * Igual que las capas: por FORMA, no por identidad, y por eso vive en
       * `lib/presentacion/lienzo.ts` con el resto del descubrimiento. Lo que
       * costó una depuración -que un `overflow:hidden` solo recorta a los
       * descendientes de los que es bloque contenedor- está ahí y probado.
       * ------------------------------------------------------------------ */

      /** Último empujón, para no pelearse con la animación en curso. */
      let empujadoEn = 0

      /**
       * Obedece el desplazamiento pedido. `smooth` no es cosmético: proyectado
       * a pantalla completa, un salto seco de un tercio de pantalla se lee como
       * un corte y el público pierde de vista dónde estaba.
       */
      function desplazar(f: HTMLIFrameElement, geo: Geometria, meta: number) {
        const y = Math.min(Math.max(Math.round(meta), 0), geo.max)
        if (Math.abs(y - geo.y) < RUIDO_PX) return
        if (Date.now() - empujadoEn < CIERRE_SCROLL_MS) return
        empujadoEn = Date.now()
        try {
          f.contentWindow?.scrollTo({ top: y, behavior: 'smooth' })
        } catch {
          // Iframe recargándose o de otro origen: el próximo ciclo reintenta.
        }
      }

      /* ------------------------------------------------------------------ *
       * Publicación y reconciliación
       * ------------------------------------------------------------------ */

      let ultimo: Actual | null = null
      let ultimoReporteEn = 0

      /**
       * Publica la posición real, ya en índice global. Es lo único que escribe
       * `actual`. Devuelve el destino que tiene el servidor en ese momento,
       * que viene de vuelta en la misma respuesta: gratis, y es lo que permite
       * que un viaje largo se entere de un cambio de idea sin pedir nada más.
       */
      async function reportar(actual: Actual, origen: Origen): Promise<number | null> {
        ultimo = actual
        ultimoReporteEn = Date.now()
        try {
          const res = await fetch('/api/presentacion', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              pos: actual.pos,
              total: actual.total,
              // La forma del mazo viaja con la posición: es lo que le permite
              // al mando saber si esa posición es una capa o un beat, y sacar
              // la nota del guion que toca.
              intro: actual.intro,
              outro: actual.outro,
              // Y con ella la geometría de la página de dentro: es lo que le
              // permite al servidor calcular el paso del desplazamiento y al
              // mando apagar los botones en los topes.
              scroll: actual.scroll,
              origen,
            }),
          })
          if (!res.ok) return null
          const { destino } = (await res.json()) as { destino?: number }
          return typeof destino === 'number' ? destino : null
        } catch {
          // Sin red: el latido del próximo ciclo lo vuelve a intentar.
          return null
        }
      }

      /** Evita dos reconciliaciones solapadas peleándose por el mismo hueco. */
      let aplicando = false

      /** Cada cuántos pasos de un viaje largo se publica el avance. */
      const REPORTE_CADA = 4

      async function reconciliar(destino: number) {
        if (aplicando || !mazo) return
        aplicando = true
        // El destino puede cambiar A MITAD del viaje: cruzar el mazo entero
        // son veinte pasos, y en ese rato la persona que tiene el mando puede
        // cambiar de idea. Se re-lee de la respuesta de cada reporte, así que
        // enterarse no cuesta ni una petición extra.
        let meta = destino
        try {
          let sinMover = 0
          let desdeReporte = 0
          for (let intentos = 0; intentos < 80; intentos++) {
            const punto = puntoActual()
            if (!punto || !mazo) break
            const aqui = aGlobal(mazo, punto)
            if (aqui === meta) break
            const acc = paso(mazo, punto, aPunto(mazo, meta))
            if (!acc) break
            aplicar(acc)
            await new Promise((r) => setTimeout(r, PASO_MS))
            const despues = puntoActual()
            // Un paso que no mueve nada tres veces seguidas es un tope real
            // (el bundle también consume teclas sin avanzar). Manda la
            // realidad: mejor que el mando deje de perseguir un fantasma.
            if (despues && mazo && aGlobal(mazo, despues) === aqui) {
              if (++sinMover >= 3) break
            } else {
              sinMover = 0
            }
            // Publicar el avance a mitad de viaje no es cosmético: el mando da
            // por muerta a la pantalla que lleva quince segundos sin hablar, y
            // cruzar el mazo entero puede acercarse a eso.
            if (despues && mazo && ++desdeReporte >= REPORTE_CADA) {
              desdeReporte = 0
              const eco = await reportar(posicionDe(mazo, despues), 'mando')
              if (eco !== null) meta = eco
            }
          }
          const punto = puntoActual()
          if (punto && mazo) {
            const actual = posicionDe(mazo, punto)
            await reportar(actual, actual.pos === meta ? 'mando' : 'ajena')
          }
        } finally {
          aplicando = false
        }
      }

      async function sondear() {
        if (!mazo && !descubrir()) return
        const punto = puntoActual()
        if (!punto || !mazo) return
        afirmarCapas()

        // Se vuelve a buscar en cada vuelta y no una sola vez al descubrir el
        // mazo: el iframe en juego cambia con la diapositiva, y las tres
        // páginas vivas del mazo están en beats distintos.
        const dentro = iframeEnJuego(iframe)
        const geo = geometriaDe(dentro)
        const actual = posicionDe(mazo, punto, geo)

        // Alguien movió el bundle sin pasar por el mando (el teclado del
        // portátil). Manda la realidad, o el sondeo siguiente arrastraría la
        // presentación de vuelta y pelearía con quien está delante del teclado.
        if (!ultimo) {
          await reportar(actual, 'inicial')
        } else if (actual.pos !== ultimo.pos || actual.total !== ultimo.total) {
          await reportar(actual, 'ajena')
        } else if (!mismaGeo(actual.scroll, ultimo.scroll)) {
          // La página de dentro se movió, pero la diapositiva no. Es un
          // `latido` y no una `ajena` a propósito: `ajena` significa "manda la
          // realidad, adopta esta posición como destino", y aquí no hay
          // ninguna posición nueva que adoptar, solo geometría que refrescar
          // para que el mando pinte la barra y los topes.
          await reportar(actual, 'latido')
        } else if (Date.now() - ultimoReporteEn > LATIDO_MS) {
          await reportar(actual, 'latido')
        }

        try {
          const res = await fetch('/api/presentacion?q=destino', { cache: 'no-store' })
          if (!res.ok) return
          const { destino, scroll } = (await res.json()) as { destino: number; scroll?: number }
          if (typeof destino !== 'number') return
          // El servidor ya acota contra el total que se le publicó, así que
          // aquí no hace falta corregirle nada: o el destino es alcanzable, o
          // la reconciliación lo devuelve como movimiento ajeno.
          if (destino !== actual.pos) await reconciliar(destino)
          // El desplazamiento espera a que el mazo esté quieto: si se está
          // cruzando media presentación, la diapositiva de la que habla el
          // scroll pedido ni siquiera está en pantalla todavía.
          else if (dentro && geo && !aplicando && typeof scroll === 'number')
            desplazar(dentro, geo, scroll)
        } catch {
          // Sin red o Redis caído: se reintenta en el próximo ciclo y la
          // presentación se queda donde está en vez de romperse.
        }
      }

      // Bucle que se reprograma solo, en vez de `setInterval`: una
      // reconciliación larga (varias diapositivas de golpe) no deja detrás una
      // cola de sondeos pendientes que se disparen todos al terminar.
      async function bucle() {
        for (;;) {
          await sondear()
          await new Promise((r) => setTimeout(r, SONDEO_MS))
        }
      }
      void bucle()
    </script>
  </body>
</html>
