---
// Página pública: lo que ve todo el mundo. `final.html` no se toca ni se
// edita; se monta en un iframe y se mueve desde fuera simulando la misma
// tecla que ya escucha su propio `window.addEventListener('keydown', ...)`.
//
// Dos detalles que costaron una depuración y que no son evidentes:
//
//  1. El `KeyboardEvent` tiene que construirse con el constructor DEL IFRAME.
//     Uno creado en este realm y despachado contra el iframe no dispara su
//     listener: la diapositiva sencillamente no se movía.
//  2. La posición real sale del propio bundle, que ya emite
//     `sustentacion:beat` con `{ indice }` en cada cambio. Nunca se supone en
//     qué diapositiva va: se pregunta. Eso es lo que permite recuperarse de un
//     sondeo perdido o de una recarga a mitad de la charla.
Astro.response.headers.set('Cache-Control', 'no-store')
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow')
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Presentación</title>
    <style>
      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        padding: 0;
        height: 100%;
        overflow: hidden;
        background: #05070a;
      }
      iframe {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        border: 0;
        /* El bundle se navega por teclado. Sin esto, un clic dentro lo
           movería por su cuenta y el próximo sondeo lo devolvería de golpe. */
        pointer-events: none;
      }
    </style>
  </head>
  <body>
    <iframe id="lienzo" src="/final.html" title="Presentación"></iframe>

    <script>
      const iframe = document.getElementById('lienzo') as HTMLIFrameElement

      /**
       * Dónde está la presentación, leído del propio bundle: pinta su posición
       * como "05 / 14" y de ahí salen la diapositiva actual y el total.
       *
       * Se lee del DOM y no del evento `sustentacion:beat` que el bundle
       * también emite, por una carrera que costó encontrar: este script es un
       * módulo (diferido), así que el iframe puede haber terminado de cargar
       * ANTES de que corra, y entonces el `load` al que se enganchaba el
       * listener ya no vuelve a dispararse. Cuando eso pasaba, la posición se
       * quedaba congelada en 1, la reconciliación creía que la presentación no
       * podía moverse y "corregía" el servidor hacia atrás, borrando los
       * comandos recién pulsados. Leer el DOM no depende de haber llegado a
       * tiempo a ningún evento.
       */
      function leerPosicion(): { pos: number; total: number } | null {
        const d = iframe.contentDocument
        const texto = d?.body?.innerText
        if (!texto) return null
        const m = texto.match(/(\d{1,2})\s*\/\s*(\d{1,2})/)
        return m ? { pos: Number(m[1]), total: Number(m[2]) } : null
      }

      function disparar(tecla: string) {
        const w = iframe.contentWindow
        const d = iframe.contentDocument
        if (!w || !d) return
        try {
          // Constructor DEL IFRAME: con el de esta página, el listener del
          // bundle no se entera y la diapositiva no se mueve. Se despacha
          // sobre el documento con `bubbles`, que sube hasta `window`.
          const Ctor = w.KeyboardEvent || KeyboardEvent
          d.dispatchEvent(new Ctor('keydown', { key: tecla, bubbles: true, cancelable: true }))
        } catch {
          // Iframe recargándose: el próximo sondeo reintenta.
        }
      }

      /** Evita dos reconciliaciones solapadas peleándose por el mismo hueco. */
      let aplicando = false

      async function reconciliar(destino: number) {
        if (aplicando) return
        aplicando = true
        try {
          // Una tecla puede consumirse SIN cambiar de diapositiva: al cargar,
          // el bundle muestra una portada y la primera flecha solo la cierra
          // (igual con las citas y con la pantalla de cierre). Cortar al primer
          // no-movimiento daba por agotada la presentación en la primera
          // pulsación. Tres seguidas sin moverse sí significan "no hay más".
          let sinMover = 0
          for (let intentos = 0; intentos < 40; intentos++) {
            const actual = leerPosicion()
            if (!actual || actual.pos === destino) break
            disparar(actual.pos < destino ? 'ArrowRight' : 'ArrowLeft')
            // 350 ms: cada diapositiva anima un canvas pesado (~450 ms de
            // transición). Encadenando saltos largos más rápido se llegó a
            // dejar la pestaña sin responder, aunque acabara llegando.
            await new Promise((r) => setTimeout(r, 350))
            const despues = leerPosicion()
            if (despues && despues.pos === actual.pos) {
              if (++sinMover >= 3) break
            } else {
              sinMover = 0
            }
          }
        } finally {
          aplicando = false
        }
      }

      async function sondear() {
        try {
          const res = await fetch('/api/presentacion', { cache: 'no-store' })
          if (!res.ok) return
          const { pos } = (await res.json()) as { pos: number }
          const actual = leerPosicion()
          if (typeof pos !== 'number' || !actual) return

          // El servidor no sabe cuántas diapositivas hay. Si el mando se pasó
          // del final, se acota al total real y se le devuelve la posición
          // buena, para que el siguiente toque parta de donde estamos y no
          // haya que pulsar "anterior" varias veces sin efecto.
          const destino = Math.min(Math.max(pos, 1), actual.total)
          if (destino !== pos) {
            await fetch('/api/presentacion', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ pos: destino }),
            }).catch(() => {})
          }
          if (destino !== actual.pos) await reconciliar(destino)
        } catch {
          // Sin red o Redis caído: se reintenta en el próximo ciclo y la
          // presentación se queda donde está en vez de romperse.
        }
      }

      // Bucle que se reprograma solo, en vez de `setInterval`: una
      // reconciliación larga (varias diapositivas de golpe) no deja detrás una
      // cola de sondeos pendientes que se disparen todos al terminar.
      async function bucle() {
        for (;;) {
          await sondear()
          await new Promise((r) => setTimeout(r, 500))
        }
      }
      void bucle()
    </script>
  </body>
</html>
