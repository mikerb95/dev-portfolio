---
// Página pública: lo que ve todo el mundo. `final.html` no se toca ni se
// edita; se monta en un iframe y se mueve desde fuera simulando la misma
// tecla que ya escucha su propio `window.addEventListener('keydown', ...)`.
//
// Dos detalles que costaron una depuración y que no son evidentes:
//
//  1. El `KeyboardEvent` tiene que construirse con el constructor DEL IFRAME.
//     Uno creado en este realm y despachado contra el iframe no dispara su
//     listener: la diapositiva sencillamente no se movía.
//  2. La posición real sale del propio bundle, que ya emite
//     `sustentacion:beat` con `{ indice }` en cada cambio. Nunca se supone en
//     qué diapositiva va: se pregunta. Eso es lo que permite recuperarse de un
//     sondeo perdido o de una recarga a mitad de la charla.
Astro.response.headers.set('Cache-Control', 'no-store')
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow')
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Presentación</title>
    <style>
      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        padding: 0;
        height: 100%;
        overflow: hidden;
        background: #05070a;
      }
      iframe {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        border: 0;
        /* El bundle se navega por teclado. Sin esto, un clic dentro lo
           movería por su cuenta y el próximo sondeo lo devolvería de golpe. */
        pointer-events: none;
      }
    </style>
  </head>
  <body>
    <iframe id="lienzo" src="/final.html" title="Presentación"></iframe>

    <script>
      const iframe = document.getElementById('lienzo') as HTMLIFrameElement

      /** Dónde está la presentación de verdad, según ella misma. */
      let beatReal = 1
      /** Evita dos reconciliaciones solapadas peleándose por el mismo hueco. */
      let aplicando = false

      // El bundle emite `sustentacion:beat` en cada cambio de diapositiva, sea
      // por el mando o por lo que sea. Es la única fuente de verdad.
      function engancharBeats() {
        try {
          iframe.contentWindow?.addEventListener('sustentacion:beat', (e) => {
            const detalle = (e as CustomEvent<{ indice?: number }>).detail
            if (typeof detalle?.indice === 'number') beatReal = detalle.indice
          })
        } catch {
          // Mismo origen, no debería fallar; si falla, la reconciliación sigue
          // funcionando con la posición que tengamos.
        }
      }
      iframe.addEventListener('load', engancharBeats)
      engancharBeats()

      function disparar(tecla: string) {
        const w = iframe.contentWindow
        const d = iframe.contentDocument
        if (!w || !d) return
        try {
          // Constructor DEL IFRAME (ver cabecera): con el de esta página el
          // listener del bundle no se entera. Se despacha sobre el documento
          // con `bubbles`, que sube hasta el listener de `window`.
          const Ctor = w.KeyboardEvent || KeyboardEvent
          d.dispatchEvent(new Ctor('keydown', { key: tecla, bubbles: true, cancelable: true }))
        } catch {
          // Iframe recargándose: el próximo sondeo reintenta.
        }
      }

      async function reconciliar(destino: number) {
        if (aplicando) return
        aplicando = true
        // Una tecla puede consumirse SIN cambiar de diapositiva: al cargar, el
        // bundle muestra una portada y la primera flecha solo la cierra (lo
        // mismo con las citas a pantalla completa). Cortar al primer
        // no-movimiento daba por agotada la presentación en la primera pulsación
        // y devolvía al servidor una posición atrasada, que era justo lo que
        // borraba los comandos recién pulsados. Solo tres intentos seguidos sin
        // moverse significan de verdad "no hay más diapositivas por ahí".
        let sinMover = 0
        try {
          for (let intentos = 0; beatReal !== destino && intentos < 40; intentos++) {
            const antes = beatReal
            disparar(destino > beatReal ? 'ArrowRight' : 'ArrowLeft')
            // 350 ms y no menos: cada diapositiva anima un canvas pesado
            // (~450 ms de transición). Encadenando saltos largos a 200 ms se
            // llegó a dejar la pestaña sin responder, aunque acabara llegando.
            await new Promise((r) => setTimeout(r, 350))
            if (beatReal === antes) {
              if (++sinMover >= 3) break
            } else {
              sinMover = 0
            }
          }
          if (beatReal !== destino && sinMover >= 3) {
            // Llegamos al tope: la posición real manda, se corrige el servidor
            // para que el siguiente toque del mando parta de donde estamos.
            await fetch('/api/presentacion', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ pos: beatReal }),
            }).catch(() => {})
          }
        } finally {
          aplicando = false
        }
      }

      async function sondear() {
        try {
          const res = await fetch('/api/presentacion', { cache: 'no-store' })
          if (!res.ok) return
          const { pos } = (await res.json()) as { pos: number }
          if (typeof pos === 'number' && pos !== beatReal) await reconciliar(pos)
        } catch {
          // Sin red o Redis caído: se reintenta en el próximo ciclo y la
          // presentación se queda donde está en vez de romperse.
        }
      }

      // Bucle que se reprograma solo, en vez de `setInterval`: una
      // reconciliación larga (varias diapositivas de golpe) no deja detrás una
      // cola de sondeos pendientes que se disparen todos al terminar.
      async function bucle() {
        for (;;) {
          await sondear()
          await new Promise((r) => setTimeout(r, 500))
        }
      }
      void bucle()
    </script>
  </body>
</html>
