---
import BaseLayout from '../layouts/BaseLayout.astro'
import ToolMock from '../components/ToolMock.astro'
import { demoAvailable } from '../db'
import { getDictionary, getLocaleFromUrl, localizedHref } from '../i18n'

// Casos de estudio de las herramientas internas construidas sobre este mismo
// sitio. Contenido 100% estático: describe arquitectura y decisiones, nunca
// datos de clientes ni configuración real. El texto vive en el diccionario
// (t.tools.cases); aquí solo quedan los campos no traducibles (num, mock,
// stack de tecnologías, href).

const locale = getLocaleFromUrl(Astro.url.pathname)
const t = getDictionary(locale)
const L = (path: string) => localizedHref(path, locale)

type CaseMeta = {
  num: string
  mock: 'monitors' | 'pnl' | 'seguimiento' | 'vault' | 'pipeline' | 'chaos' | 'security'
  stack: string[]
  liveHref?: string
}

// Los nombres propios (Astro, Turso, Drizzle…) no se traducen; los términos
// descriptivos sí - viven en el diccionario.
const st = t.tools.stackTerms

const CASES_META: CaseMeta[] = [
  { num: '01', mock: 'monitors', stack: ['Astro API routes', 'Drizzle ORM', 'Turso', st.cronExterno, 'ntfy'], liveHref: '/status' },
  { num: '02', mock: 'pnl', stack: ['Drizzle ORM', 'Turso', 'Vitest'], liveHref: '/demo' },
  { num: '03', mock: 'seguimiento', stack: ['Astro SSR', 'Drizzle ORM', st.authAllowlist] },
  { num: '04', mock: 'vault', stack: ['AES-256-GCM', 'node:crypto', st.middlewareAstro] },
  { num: '05', mock: 'pipeline', stack: ['GitHub Actions', 'Vercel', 'Vitest'], liveHref: '/lab' },
  { num: '06', mock: 'chaos', stack: [st.middlewareAstro, st.flagsTtl], liveHref: '/lab' },
  { num: '07', mock: 'security', stack: [st.middlewareAstro, 'Drizzle ORM', 'Turso', st.cronExterno, st.ownStats], liveHref: '/security' },
]

const tools = CASES_META.map((meta, i) => ({ ...meta, ...t.tools.cases[i] }))
---

<BaseLayout title={t.tools.title} description={t.tools.description} image="/og-tools.png">
  <div class="max-w-[1280px] mx-auto px-6 md:px-12 lg:px-20 pt-32 pb-24">

    <!-- Back -->
    <a href={L('/')} class="inline-flex items-center gap-2 text-[11px] font-mono uppercase tracking-[.2em] text-ink-300 hover:text-cyan transition-colors mb-12">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
      {t.common.back}
    </a>

    <header class="mb-20">
      <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-6">
        <span class="text-cyan">/tools</span>
        <span class="h-px flex-1 bg-gradient-to-r from-white/15 to-transparent max-w-[80px]"></span>
        <span>{t.tools.eyebrow}</span>
      </div>
      <h1 class="hero-line text-5xl md:text-6xl font-medium tracking-[-.035em] text-mask leading-[.95] mb-8">
        {t.tools.h1Line1}<br/>{t.tools.h1Line2}
      </h1>
      <p class="text-[16px] text-ink-100 max-w-2xl leading-relaxed">
        {t.tools.intro}
      </p>
    </header>

    <div class="space-y-8">
      {tools.map((tool) => (
        <article class="rounded-2xl glass p-8 md:p-10 lift">
          <div class="flex items-start gap-6 mb-8">
            <span class="font-serif italic text-4xl text-ink-300 leading-none select-none">{tool.num}</span>
            <div>
              <h2 class="text-2xl md:text-3xl font-medium tracking-[-.02em] text-ink-50 mb-1.5">{tool.title}</h2>
              <p class="text-[13px] font-mono text-cyan">{tool.tagline}</p>
            </div>
          </div>

          <div class="grid lg:grid-cols-[1fr_400px] gap-6 mb-8 items-start">
            <div class="space-y-6">
              <div class="rounded-xl bg-white/[.02] border border-white/5 p-5">
                <div class="text-[10px] font-mono uppercase tracking-[.2em] text-ember mb-3">{t.tools.problemLabel}</div>
                <p class="text-[14px] text-ink-100 leading-relaxed">{tool.problema}</p>
              </div>
              <div class="rounded-xl bg-white/[.02] border border-white/5 p-5">
                <div class="text-[10px] font-mono uppercase tracking-[.2em] text-lime mb-3">{t.tools.solutionLabel}</div>
                <p class="text-[14px] text-ink-100 leading-relaxed">{tool.solucion}</p>
              </div>
            </div>
            <div>
              <ToolMock kind={tool.mock} />
              <p class="text-[10px] font-mono text-ink-300 mt-2 text-center">
                {t.tools.mockCaption}
              </p>
            </div>
          </div>

          <div class="mb-8">
            <div class="text-[10px] font-mono uppercase tracking-[.2em] text-ink-300 mb-4">{t.tools.inProductionLabel}</div>
            <ul class="space-y-2.5">
              {tool.detalle.map((d) => (
                <li class="flex items-start gap-3 text-[14px] text-ink-100 leading-relaxed">
                  <span class="w-1 h-1 rounded-full bg-cyan mt-2.5 shrink-0"></span>
                  <span>{d}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="flex flex-wrap items-center gap-1.5">
            {tool.stack.map((s) => (
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-mono uppercase tracking-wider border bg-cyan/10 text-cyan border-cyan/30">
                {s}
              </span>
            ))}
            {tool.liveHref && tool.liveLabel && (
              <a href={L(tool.liveHref)} class="ml-auto inline-flex items-center gap-2 text-[13px] text-cyan hover:underline">
                <span class="w-1.5 h-1.5 rounded-full bg-lime pulse-dot"></span>
                {tool.liveLabel} →
              </a>
            )}
          </div>
        </article>
      ))}
    </div>

    {demoAvailable && (
      <section class="mt-16 rounded-2xl glass p-8 md:p-10">
        <div class="flex flex-col md:flex-row md:items-center gap-6">
          <div class="flex-1">
            <p class="text-[11px] font-mono uppercase tracking-[.18em] text-cyan mb-2">{t.tools.demoPortal.eyebrow}</p>
            <h3 class="text-xl md:text-2xl font-medium text-ink-50 tracking-tight mb-2">
              {t.tools.demoPortal.title}
            </h3>
            <p class="text-[14px] text-ink-200 leading-relaxed max-w-xl">
              {t.tools.demoPortal.body}
            </p>
          </div>
          <a
            href="/api/portal/demo"
            class="shrink-0 inline-flex items-center gap-2 h-11 px-6 text-[14px] font-medium rounded-full bg-cyan text-ink-950 hover:brightness-110 transition-all"
          >
            {t.tools.demoPortal.cta}
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </section>
    )}

    <!-- Cierre -->
    <section class:list={[demoAvailable ? 'mt-8' : 'mt-20', 'rounded-2xl glass p-8 md:p-10 text-center']}>
      <p class="font-serif italic text-2xl md:text-3xl text-mask-cyan mb-4">
        {t.tools.closing.quote}
      </p>
      <p class="text-[14px] text-ink-100 max-w-xl mx-auto leading-relaxed mb-6">
        {t.tools.closing.body}
      </p>
      <a
        href={L('/contact')}
        class="inline-flex items-center gap-2 h-10 px-5 text-[13px] font-medium rounded-full bg-cyan text-ink-950 hover:brightness-110 transition-all"
      >
        {t.tools.closing.cta}
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </section>

  </div>
</BaseLayout>

<script>
  import { initPageMotion } from '../lib/motion-reveal'
  initPageMotion()
</script>
