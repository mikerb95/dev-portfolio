---
// Página sin datos vivos: se genera en el build, no por request.
//
// La única lectura de entorno que queda es `demoAvailable`, y por eso esto es
// seguro: no abre la base, solo mira si `TURSO_DEMO_URL` existe, y esa variable
// está dada de alta en Production y Preview, así que el build ve el mismo valor
// que vería la función. Si algún día este archivo pasa a consultar la BD o a
// depender de algo que cambia entre build y request, hay que quitar el
// prerender: si no, la página se queda congelada sin que nadie se entere.
export const prerender = true

import BaseLayout from '../layouts/BaseLayout.astro'
import EscenaCaso from '../components/tools/EscenaCaso.astro'
import CircuitoOperacion from '../components/tools/CircuitoOperacion.astro'
import { demoAvailable } from '../db'
import { getDictionary, getLocaleFromUrl, localizedHref } from '../i18n'

// Casos de estudio de las herramientas internas construidas sobre este mismo
// sitio. Contenido 100% estático: describe arquitectura y decisiones, nunca
// datos de clientes ni configuración real. El texto vive en el diccionario
// (t.tools.cases); aquí solo quedan los campos no traducibles (num, mock,
// stack de tecnologías, href).

const locale = getLocaleFromUrl(Astro.url.pathname)
const t = getDictionary(locale)
const L = (path: string) => localizedHref(path, locale)

type CaseMeta = {
  num: string
  mock: 'monitors' | 'pnl' | 'seguimiento' | 'vault' | 'pipeline' | 'chaos' | 'security'
  stack: string[]
  liveHref?: string
}

// Los nombres propios (Astro, Turso, Drizzle…) no se traducen; los términos
// descriptivos sí - viven en el diccionario.
const st = t.tools.stackTerms

const CASES_META: CaseMeta[] = [
  { num: '01', mock: 'monitors', stack: ['Astro API routes', 'Drizzle ORM', 'Turso', st.cronExterno, 'ntfy'], liveHref: '/status' },
  { num: '02', mock: 'pnl', stack: ['Drizzle ORM', 'Turso', 'Vitest'], liveHref: '/demo' },
  { num: '03', mock: 'seguimiento', stack: ['Astro SSR', 'Drizzle ORM', st.authAllowlist] },
  { num: '04', mock: 'vault', stack: ['AES-256-GCM', 'node:crypto', st.middlewareAstro] },
  { num: '05', mock: 'pipeline', stack: ['GitHub Actions', 'Vercel', 'Vitest'], liveHref: '/lab' },
  { num: '06', mock: 'chaos', stack: [st.middlewareAstro, st.flagsTtl], liveHref: '/lab' },
  { num: '07', mock: 'security', stack: [st.middlewareAstro, 'Drizzle ORM', 'Turso', st.cronExterno, st.ownStats], liveHref: '/security' },
]

const tools = CASES_META.map((meta, i) => ({ ...meta, ...t.tools.cases[i] }))

// Ruta del panel que "enseña" la ventana en cada caso. Son rutas reales de
// /admin (no se enlazan: el panel es privado).
const RUTAS_PANEL: Record<CaseMeta['mock'], string> = {
  monitors: '/admin/monitors',
  pnl: '/admin/projects',
  seguimiento: '/admin/seguimiento',
  vault: '/admin/costs',
  pipeline: '/admin/lab/pipeline',
  chaos: '/admin/lab/chaos',
  security: '/admin/security',
}
---

<BaseLayout title={t.tools.title} description={t.tools.description} image="/og-tools.png">
  <div class="max-w-[1280px] mx-auto px-6 md:px-12 lg:px-20 pt-32 pb-24">

    <!-- Back -->
    <a href={L('/')} class="inline-flex items-center gap-2 text-[11px] font-mono uppercase tracking-[.2em] text-ink-300 hover:text-cyan transition-colors mb-12">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
      {t.common.back}
    </a>

    <header class="tl-hero mb-24">
      <div class="tl-hero-texto">
        <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-6" data-hero-sigue>
          <span class="text-cyan">/tools</span>
          <span class="h-px flex-1 bg-gradient-to-r from-white/15 to-transparent max-w-[80px]"></span>
          <span>{t.tools.eyebrow}</span>
        </div>
        <h1 class="text-[42px] sm:text-5xl xl:text-[56px] font-medium tracking-[-.035em] leading-[.98] mb-8">
          <span data-hero-linea class="block text-ink-50 tl-balance">{t.tools.h1Line1}</span>{' '}
          <span data-hero-linea class="block text-cyan tl-balance">{t.tools.h1Line2}</span>
        </h1>
        <p class="text-[16px] text-ink-100 max-w-xl leading-relaxed" data-hero-sigue>
          {t.tools.intro}
        </p>
      </div>
      <div class="tl-hero-pieza" data-hero-pieza>
        <CircuitoOperacion />
      </div>
    </header>

    <!-- Casos: en escritorio, el texto corre a la izquierda y la ventana fija
         de la derecha muestra la herramienta del caso que se está leyendo. El
         script mueve cada escena de su caso a la ventana; sin JS, con
         movimiento reducido o en móvil, cada escena se queda dentro de su caso. -->
    <section class="cs" data-casos>
      <div class="cs-lista">
        {tools.map((tool) => (
          <article id={`caso-${tool.num}`} class="cs-caso" data-caso={tool.num}>
            <header class="cs-cab">
              <span class="cs-num" aria-hidden="true">{tool.num}</span>
              <div>
                <h2 class="cs-titulo">{tool.title}</h2>
                <p class="cs-tagline">{tool.tagline}</p>
              </div>
            </header>

            <div class="cs-cuerpo">
              <div class="cs-texto">
                <div class="cs-bloque">
                  <div class="cs-rotulo"><span class="cs-punto cs-punto-problema"></span>{t.tools.problemLabel}</div>
                  <p>{tool.problema}</p>
                </div>
                <div class="cs-bloque">
                  <div class="cs-rotulo"><span class="cs-punto cs-punto-solucion"></span>{t.tools.solutionLabel}</div>
                  <p>{tool.solucion}</p>
                </div>
                <div>
                  <div class="cs-rotulo cs-rotulo-tenue">{t.tools.inProductionLabel}</div>
                  <ul class="cs-detalle">
                    {tool.detalle.map((d) => (
                      <li><span class="cs-vineta" aria-hidden="true"></span><span>{d}</span></li>
                    ))}
                  </ul>
                </div>
                <div class="cs-pie">
                  {tool.stack.map((s) => <span class="cs-stack">{s}</span>)}
                  {tool.liveHref && tool.liveLabel && (
                    <a href={L(tool.liveHref)} class="cs-vivo">
                      <span class="w-1.5 h-1.5 rounded-full bg-lime pulse-dot"></span>
                      {tool.liveLabel} →
                    </a>
                  )}
                </div>
              </div>

              <div class="cs-slot" data-slot={tool.num}>
                <div class="cs-marco">
                  <div class="cs-cromo" aria-hidden="true">
                    <span class="cs-luces"><i></i><i></i><i></i></span>
                    <span class="cs-ruta">{RUTAS_PANEL[tool.mock]}</span>
                    <span class="cs-ilustrativo">{t.tools.motion.ventana.etiqueta}</span>
                  </div>
                  <div class="cs-escena" data-escena-caja={tool.num}>
                    <EscenaCaso kind={tool.mock} />
                  </div>
                </div>
                <p class="cs-pie-escena">{t.tools.mockCaption}</p>
              </div>
            </div>
          </article>
        ))}
      </div>

      <aside class="cs-ventana" data-ventana>
        <div class="cs-marco">
          <div class="cs-cromo" aria-hidden="true">
            <span class="cs-luces"><i></i><i></i><i></i></span>
            <span class="cs-ruta" data-ventana-ruta></span>
            <span class="cs-ilustrativo">{t.tools.motion.ventana.etiqueta}</span>
          </div>
          <div class="cs-pila" data-pila aria-hidden="true"></div>
        </div>
        <nav class="cs-indice" aria-label={t.tools.motion.ventana.indice}>
          {tools.map((tool) => (
            <a href={`#caso-${tool.num}`} data-indice={tool.num} data-ruta={RUTAS_PANEL[tool.mock]}>
              <span class="cs-indice-num">{tool.num}</span>
              <span class="cs-indice-barra" aria-hidden="true"><span></span></span>
            </a>
          ))}
        </nav>
        <p class="cs-pie-escena">{t.tools.mockCaption}</p>
      </aside>
    </section>

    {demoAvailable && (
      <section class="mt-16 rounded-2xl glass p-8 md:p-10">
        <div class="flex flex-col md:flex-row md:items-center gap-6">
          <div class="flex-1">
            <p class="text-[11px] font-mono uppercase tracking-[.18em] text-cyan mb-2">{t.tools.demoPortal.eyebrow}</p>
            <h3 class="text-xl md:text-2xl font-medium text-ink-50 tracking-tight mb-2">
              {t.tools.demoPortal.title}
            </h3>
            <p class="text-[14px] text-ink-200 leading-relaxed max-w-xl">
              {t.tools.demoPortal.body}
            </p>
          </div>
          <a
            href="/api/portal/demo"
            class="shrink-0 inline-flex items-center gap-2 h-11 px-6 text-[14px] font-medium rounded-full bg-cyan text-ink-950 hover:brightness-110 transition-all"
          >
            {t.tools.demoPortal.cta}
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </section>
    )}

    <!-- Cierre -->
    <section class:list={[demoAvailable ? 'mt-8' : 'mt-20', 'rounded-2xl glass p-8 md:p-10 text-center']}>
      <p class="font-serif italic text-2xl md:text-3xl text-mask-cyan mb-4">
        {t.tools.closing.quote}
      </p>
      <p class="text-[14px] text-ink-100 max-w-xl mx-auto leading-relaxed mb-6">
        {t.tools.closing.body}
      </p>
      <a
        href={L('/contact')}
        class="inline-flex items-center gap-2 h-10 px-5 text-[13px] font-medium rounded-full bg-cyan text-ink-950 hover:brightness-110 transition-all"
      >
        {t.tools.closing.cta}
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </section>

  </div>
</BaseLayout>

<script>
  // Mismo lenguaje que las demás páginas con motion (Lenis + GSAP, montaje
  // común en src/lib/motion/landing.ts) más las piezas de esta página.
  import { montarLanding } from '../lib/motion/landing'
  import { montarCircuito } from '../lib/motion/circuito-vivo'
  import { montarCasos } from '../lib/motion/tools-escenas'

  const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const circuito = document.querySelector<HTMLElement>('[data-circuito]')
  if (circuito) {
    try {
      montarCircuito(circuito, { reducido })
    } catch (err) {
      // Fail-open: el mapa en reposo y la bitácora del servidor siguen ahí.
      console.warn('[tools] circuito sin motion', err)
      delete circuito.dataset.vivo
    }
  }
  const casos = document.querySelector<HTMLElement>('[data-casos]')
  if (casos) {
    try {
      montarCasos(casos, { reducido })
    } catch (err) {
      // Fail-open: cada escena vuelve a su caso, completa y quieta.
      console.warn('[tools] casos sin motion', err)
      casos.classList.remove('modo-ventana')
      casos.querySelectorAll<HTMLElement>('[data-escena]').forEach((el) => {
        el.style.removeProperty('clip-path')
        const caja = casos.querySelector(`[data-escena-caja="${el.dataset.caso}"]`)
        if (caja && el.parentElement !== caja) caja.appendChild(el)
      })
    }
  }
  montarLanding({ anclas: true })
</script>

<style>
  .tl-hero { display: grid; gap: 56px; grid-template-columns: minmax(0, 1fr); align-items: center; }
  .tl-balance { text-wrap: balance; }
  @media (min-width: 1200px) {
    .tl-hero { grid-template-columns: minmax(0, 1fr) minmax(0, 620px); gap: 48px; }
  }

  /* ── Casos ── */
  .cs-lista { display: grid; gap: 0; }
  .cs-caso { scroll-margin-top: 104px; padding-block: 72px; }
  .cs-caso:first-child { padding-top: 0; }
  .cs-caso + .cs-caso { border-top: 1px solid rgba(255, 255, 255, 0.06); }
  .cs-cab { display: flex; align-items: flex-start; gap: 20px; margin-bottom: 28px; }
  .cs-num { font-family: var(--font-serif, Georgia, serif); font-style: italic; font-size: 44px; line-height: 0.9; color: #4d4d5d; user-select: none; }
  .cs-titulo { margin: 0 0 6px; font-size: 26px; font-weight: 500; letter-spacing: -0.02em; line-height: 1.15; color: #e7e7ec; text-wrap: balance; }
  .cs-tagline { margin: 0; font-family: var(--font-mono, ui-monospace, monospace); font-size: 13px; color: #00f2ff; }
  .cs-cuerpo { display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px; }
  .cs-texto { display: grid; gap: 22px; align-content: start; }
  .cs-bloque p { margin: 0; font-size: 15px; line-height: 1.7; color: #c4c4cc; }
  .cs-rotulo { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; font-family: var(--font-mono, ui-monospace, monospace); font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: #85858f; }
  .cs-rotulo-tenue { color: #4d4d5d; margin-bottom: 12px; }
  .cs-punto { width: 6px; height: 6px; border-radius: 99px; }
  .cs-punto-problema { background: #ff6b3d; box-shadow: 0 0 10px rgba(255, 107, 61, 0.6); }
  .cs-punto-solucion { background: #c9ff5b; box-shadow: 0 0 10px rgba(201, 255, 91, 0.5); }
  .cs-detalle { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .cs-detalle li { display: grid; grid-template-columns: 4px minmax(0, 1fr); gap: 12px; font-size: 14px; line-height: 1.6; color: #c4c4cc; }
  .cs-vineta { width: 4px; height: 4px; margin-top: 10px; border-radius: 99px; background: #00f2ff; }
  .cs-pie { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .cs-stack { display: inline-flex; align-items: center; padding: 2px 8px; border-radius: 99px; font-family: var(--font-mono, ui-monospace, monospace); font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: #00f2ff; background: rgba(0, 242, 255, 0.08); border: 1px solid rgba(0, 242, 255, 0.25); }
  .cs-vivo { margin-left: auto; display: inline-flex; align-items: center; gap: 8px; font-size: 13px; color: #00f2ff; }
  .cs-vivo:hover { text-decoration: underline; }

  .cs-marco { border-radius: 16px; background: rgba(10, 10, 13, 0.9); border: 1px solid rgba(255, 255, 255, 0.1); box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.8); }
  .cs-cromo { display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-bottom: 1px solid rgba(255, 255, 255, 0.05); background: #0e0e12; border-radius: 16px 16px 0 0; }
  .cs-luces { display: inline-flex; gap: 6px; }
  .cs-luces i { width: 8px; height: 8px; border-radius: 99px; background: rgba(255, 107, 61, 0.6); }
  .cs-luces i:nth-child(2) { background: rgba(201, 255, 91, 0.5); }
  .cs-luces i:nth-child(3) { background: rgba(0, 242, 255, 0.5); }
  .cs-ruta { font-family: var(--font-mono, ui-monospace, monospace); font-size: 10.5px; color: #85858f; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cs-ilustrativo { margin-left: auto; font-family: var(--font-mono, ui-monospace, monospace); font-size: 10px; color: #4d4d5d; white-space: nowrap; }
  .cs-escena { padding: 16px; }
  .cs-pie-escena { margin: 8px 0 0; text-align: center; font-family: var(--font-mono, ui-monospace, monospace); font-size: 10px; color: #4d4d5d; }
  .cs-ventana { display: none; }

  /* Móvil: la escena justo bajo el título, antes del texto largo. */
  @media (max-width: 1023px) {
    .cs-slot { order: -1; }
    .cs-caso { padding-block: 56px; }
  }
  @media (min-width: 768px) {
    .cs-titulo { font-size: 30px; }
  }
  /* Escritorio sin JS (o con movimiento reducido): texto y escena lado a lado. */
  @media (min-width: 1024px) {
    .cs-cuerpo { grid-template-columns: minmax(0, 1fr) minmax(0, 420px); align-items: start; }

    .cs.modo-ventana { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 450px); gap: 64px; align-items: start; }
    .cs.modo-ventana .cs-cuerpo { grid-template-columns: minmax(0, 1fr); }
    .cs.modo-ventana .cs-slot { display: none; }
    .cs.modo-ventana .cs-caso { min-height: 78vh; }
    .cs.modo-ventana .cs-ventana { display: block; position: sticky; top: 104px; }
    .cs-pila { display: grid; padding: 18px; }
    .cs-pila > :global(.es) { grid-area: 1 / 1; align-self: center; }
    .cs-pila > :global(.es:not(.is-activa)) { pointer-events: none; }
  }
  .cs-indice { display: flex; gap: 6px; margin-top: 14px; }
  .cs-indice a { flex: 1; display: grid; gap: 6px; font-family: var(--font-mono, ui-monospace, monospace); font-size: 10.5px; color: #4d4d5d; transition: color 0.25s ease; }
  .cs-indice a:hover, .cs-indice a.is-activo { color: #00f2ff; }
  .cs-indice a:focus-visible { outline: 2px solid rgba(0, 242, 255, 0.6); outline-offset: 3px; border-radius: 4px; }
  .cs-indice-barra { display: block; height: 2px; border-radius: 2px; background: rgba(255, 255, 255, 0.08); overflow: hidden; }
  .cs-indice-barra > span { display: block; height: 100%; background: #00f2ff; transform-origin: left; transform: scaleX(0); }
</style>
