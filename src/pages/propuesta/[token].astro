---
import '../../styles/global.css'
import { db } from '../../db'
import { payments } from '../../db/schema'
import { eq } from 'drizzle-orm'
import { jsonEnScript } from '../../lib/json-script'
import { registrarVista, snapshotDe, version, hoyCO } from '../../lib/plano/db'
import { diferencias } from '../../lib/plano/diff'
import { propuestaPublica } from '../../lib/plano/endpoint'
import { fechaCorta, fechaLarga } from '../../lib/plano/fechas'
import { anticipoDe, vistaCliente } from '../../lib/plano/publico'
import { formatearMonto } from '../../data/tarifario'
import {
  renderClausulas,
  renderContacto,
  renderCronograma,
  renderLineas,
  renderPagos,
  renderPlano,
  renderVersiones,
} from '../../components/plano/vista-render'

// Enlace de la propuesta para el cliente (docs/plan-plano.md, fase 4).
// Pública pero noindex y sin caché: es un documento personal con precios. El
// token se valida por forma antes de consultar, y "no existe" y "no enviada"
// responden igual.

const p = await propuestaPublica(Astro.params.token)
Astro.response.headers.set('Cache-Control', 'no-store')
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow')

let estado: 'abierta' | 'aceptada' | 'convertida' | 'vencida' | 'no' = 'no'
let vista = null as ReturnType<typeof vistaCliente> | null
let cambios: ReturnType<typeof diferencias> = []
let numero = 0
let anticipoPagado = false
let anticipoPendiente = false
let anticipo = 0

if (p) {
  numero = p.aceptadaVersion ?? p.versionActual
  const v = await version(p.id, numero)
  if (v) {
    const s = snapshotDe(v)
    vista = vistaCliente(s)
    anticipo = anticipoDe(s)
    estado = p.estado === 'convertida' ? 'convertida' : p.estado === 'aceptada' ? 'aceptada' : hoyCO() > s.validoHasta ? 'vencida' : 'abierta'
    if (numero > 1 && estado === 'abierta') {
      const prev = await version(p.id, numero - 1)
      if (prev) cambios = diferencias(snapshotDe(prev), s)
    }
    if (p.anticipoPaymentId) {
      const [pago] = await db.select({ status: payments.status }).from(payments).where(eq(payments.id, p.anticipoPaymentId)).limit(1)
      anticipoPagado = pago?.status === 'approved'
      anticipoPendiente = pago?.status === 'pending'
    }
    if (estado === 'abierta') await registrarVista(p)
  }
}
if (!vista) Astro.response.status = 404

const v = vista
const tocable = (id: string) => estado === 'abierta' && Boolean(v?.perillas.lineas.includes(id))
const m = (x: number) => (v ? formatearMonto(x, v.moneda) : '')
const WHATSAPP = 'https://wa.me/573104641228'
const datos = v && p ? { token: p.token, vista: v, estado, anticipoPagado, moneda: v.moneda } : null
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0a0a0d" />
    <title>{v ? `Propuesta · ${v.titulo}` : 'Propuesta'} · CodeByMike</title>
    <!-- Vista previa genérica a propósito: WhatsApp cachea la preview y la
         muestra en el chat; con el precio dentro quedaría a la vista y
         congelada aunque la propuesta cambie. -->
    <meta property="og:title" content="Tu propuesta · CodeByMike" />
    <meta property="og:description" content="Propuesta personal. Ábrela para verla y elegir." />
  </head>
  <body class="pv-body grain">
    {!v ? (
      <main class="pv-vacia">
        <p class="pv-marca">CodeByMike</p>
        <h1>Esta propuesta no está disponible</h1>
        <p>El enlace no existe o la propuesta ya no está vigente. Escríbeme y te envío una actualizada.</p>
        <a href={WHATSAPP} target="_blank" rel="noopener" class="pv-btn">Escribir por WhatsApp</a>
      </main>
    ) : (
      <main id="propuesta" class="pv" data-estado={estado}>
        <header class="pv-hero">
          <div class="pv-hero__texto">
            <p class="pv-marca">CodeByMike · propuesta v{numero}</p>
            <h1 class="pv-titulo">{v.titulo}</h1>
            <p class="pv-para">
              Para <b>{v.cliente.nombre}</b>{v.cliente.empresa && <>, {v.cliente.empresa}</>}
            </p>
            <div class="pv-precio">
              <span class="pv-label">Inversión</span>
              <strong data-precio>{m(v.plan.total)}</strong>
              <span class="pv-sub" data-precio-nota>
                {v.plan.recargoTotal ? 'en cuotas, recargo incluido' : v.plan.descuento ? 'de contado, con descuento' : `en ${v.plan.pagos.length} pagos`}
              </span>
            </div>
            {estado === 'abierta' && <p class="pv-vigencia">Válida hasta el {fechaLarga(v.validoHasta)}</p>}
            {estado === 'vencida' && <p class="pv-vigencia pv-vigencia--mal">Venció el {fechaCorta(v.validoHasta)}. Escríbeme y la actualizo.</p>}
          </div>
          <div class="pv-hero__plano" id="pv-plano" set:html={renderPlano(v, tocable)} />
          {v.perillas.lineas.length > 0 && estado === 'abierta' && (
            <p class="pv-hero__pista">Toca las habitaciones punteadas para agregarlas o quitarlas: el precio se ajusta solo.</p>
          )}
        </header>

        {estado === 'aceptada' || estado === 'convertida' ? (
          <section class="pv-sec pv-aceptada" id="pv-cierre">
            <p class="pv-label">Propuesta aceptada</p>
            <h2>{estado === 'convertida' ? 'Tu proyecto ya arrancó' : '¡Gracias! Quedó aceptada'}</h2>
            <p>
              Aceptada por {p!.aceptadaPor} el {p!.aceptadaEl ? fechaCorta(p!.aceptadaEl.toISOString().slice(0, 10)) : ''}. Esta es la versión {numero}; su
              constancia es:
            </p>
            <code class="pv-constancia">{p!.aceptacionHuella}</code>
            {anticipoPagado ? (
              <p class="pv-ok">Anticipo recibido. Te escribo para arrancar{estado === 'convertida' ? ' y te llega la invitación a tu portal de cliente' : ''}.</p>
            ) : anticipoPendiente ? (
              <p class="pv-sub">Estamos confirmando tu pago con el banco. Esta página se actualiza sola en cuanto llegue.</p>
            ) : v.moneda === 'COP' ? (
              <div class="pv-anticipo">
                <p>Para arrancar falta el anticipo de <b>{m(anticipo)}</b>.</p>
                <button type="button" class="pv-btn pv-btn--primario" id="pv-pagar">Pagar el anticipo</button>
                <p class="pv-sub">Pago seguro con Wompi (Bancolombia): PSE, tarjeta o Nequi.</p>
              </div>
            ) : (
              <p class="pv-sub">Te envío los datos para el anticipo por {v.contacto.canal === 'correo' ? 'correo' : 'WhatsApp'}.</p>
            )}
          </section>
        ) : null}

        {v.resumen && (
          <section class="pv-sec pv-sec--resumen">
            <p class="pv-label">Lo que entendí</p>
            <p class="pv-resumen">{v.resumen}</p>
          </section>
        )}

        {cambios.length > 0 && (
          <section class="pv-sec">
            <p class="pv-label">Qué cambió desde la versión {numero - 1}</p>
            <ul class="pv-cambios">
              {cambios.map((c) => <li data-tipo={c.tipo}>{c.texto}</li>)}
            </ul>
          </section>
        )}

        <section class="pv-sec" id="pv-sec-versiones" hidden={!renderVersiones(v)}>
          <p class="pv-label">Elige tu versión</p>
          <div id="pv-versiones" set:html={renderVersiones(v)} />
        </section>

        <section class="pv-sec">
          <p class="pv-label">Qué incluye</p>
          <div id="pv-lineas" set:html={renderLineas(v)} />
        </section>

        <section class="pv-sec">
          <p class="pv-label">Cómo pagas</p>
          <div id="pv-pagos" set:html={renderPagos(v)} />
        </section>

        <section class="pv-sec">
          <p class="pv-label">Cronograma estimado</p>
          <div id="pv-crono" set:html={renderCronograma(v)} />
        </section>

        <section class="pv-sec">
          <p class="pv-label">Cómo vamos a trabajar</p>
          <div set:html={renderContacto(v)} />
        </section>

        <section class="pv-sec">
          <p class="pv-label">Condiciones, en cristiano</p>
          <p class="pv-sub mb">Toca cada una para ver el texto formal, que es el que vale como acuerdo.</p>
          <div id="pv-clausulas" set:html={renderClausulas(v)} />
        </section>

        {estado === 'abierta' && (
          <section class="pv-sec pv-firmar" id="pv-firmar">
            <p class="pv-label">Aceptar la propuesta</p>
            <h2>¿Arrancamos?</h2>
            <p class="pv-sub">
              Aceptar aquí con tu nombre y documento vale igual que firmar (Ley 527 de 1999). Queda guardada una huella digital de la versión exacta que
              aceptas.
            </p>
            <form id="pv-form" class="pv-form" novalidate>
              <label><span>Nombre completo</span><input name="nombre" autocomplete="name" required /></label>
              <label><span>Cédula o NIT</span><input name="documento" inputmode="numeric" autocomplete="off" required /></label>
              <label class="pv-acepto">
                <input type="checkbox" name="acepto" required />
                <span>Leí la propuesta y sus condiciones, y la acepto por <b data-total-form>{m(v.plan.total)}</b>.</span>
              </label>
              <button type="submit" class="pv-btn pv-btn--primario">Aceptar propuesta</button>
              <p class="pv-error" id="pv-error" role="alert"></p>
            </form>
            <p class="pv-sub">¿Dudas antes de aceptar? <a href={WHATSAPP} target="_blank" rel="noopener">Escríbeme por WhatsApp</a>.</p>
          </section>
        )}

        <footer class="pv-pie">
          <span>Mike Rodríguez · codebymike.net</span>
          <span>Versión {numero} · {fechaCorta(v.generadoEl)}</span>
        </footer>
      </main>
    )}

    {datos && <script is:inline type="application/json" id="pv-datos" set:html={jsonEnScript(datos)} />}
  </body>
</html>

<script>
  import { renderCronograma, renderLineas, renderPagos, renderPlano, renderVersiones, renderClausulas } from '../../components/plano/vista-render'
  import { formatearMonto } from '../../data/tarifario'
  import type { VistaCliente } from '../../lib/plano/publico'
  import type { EleccionCliente } from '../../lib/plano/tipos'

  type Datos = { token: string; vista: VistaCliente; estado: string; anticipoPagado: boolean; moneda: 'COP' | 'USD' }
  const nodo = document.getElementById('pv-datos')
  const raiz = document.getElementById('propuesta')
  if (nodo && raiz) {
    const d = JSON.parse(nodo.textContent!) as Datos
    let vista = d.vista
    const eleccion: EleccionCliente = {}
    const abierta = d.estado === 'abierta'
    const m = (x: number) => formatearMonto(x, d.moneda)
    const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches
    let pedido = 0

    /** Cuenta la cifra hacia el valor nuevo: el precio se mueve, no salta. */
    function contar(el: Element | null, desde: number, hasta: number) {
      if (!el) return
      if (reducido || desde === hasta) {
        el.textContent = m(hasta)
        return
      }
      const t0 = performance.now()
      const dur = 650
      const paso = (t: number) => {
        const k = Math.min((t - t0) / dur, 1)
        const e = 1 - (1 - k) ** 3
        el.textContent = m(Math.round(desde + (hasta - desde) * e))
        if (k < 1) requestAnimationFrame(paso)
      }
      requestAnimationFrame(paso)
    }

    function pintar(nueva: VistaCliente) {
      const antes = vista
      vista = nueva
      const tocable = (id: string) => abierta && nueva.perillas.lineas.includes(id)
      const cambiadas = new Set(nueva.lineas.filter((l) => antes.lineas.find((a) => a.id === l.id)?.incluida !== l.incluida).map((l) => l.id))
      document.getElementById('pv-plano')!.innerHTML = renderPlano(nueva, tocable, cambiadas)
      raiz!.classList.add('pv--listo')
      const vers = renderVersiones(nueva)
      document.getElementById('pv-versiones')!.innerHTML = vers
      document.getElementById('pv-lineas')!.innerHTML = renderLineas(nueva)
      document.getElementById('pv-pagos')!.innerHTML = renderPagos(nueva)
      document.getElementById('pv-crono')!.innerHTML = renderCronograma(nueva)
      document.getElementById('pv-clausulas')!.innerHTML = renderClausulas(nueva)
      contar(document.querySelector('[data-precio]'), antes.plan.total, nueva.plan.total)
      const tf = document.querySelector('[data-total-form]')
      if (tf) tf.textContent = m(nueva.plan.total)
      const nota = document.querySelector('[data-precio-nota]')
      if (nota) nota.textContent = nueva.plan.recargoTotal ? 'en cuotas, recargo incluido' : nueva.plan.descuento ? 'de contado, con descuento' : `en ${nueva.plan.pagos.length} pagos`
      raiz!.classList.remove('pv--cargando')
    }

    async function simular() {
      const n = ++pedido
      raiz!.classList.add('pv--cargando')
      try {
        const r = await fetch(`/api/propuesta/${d.token}/simular`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(eleccion),
        })
        const j = await r.json()
        // Solo la última respuesta pinta: si el cliente tocó dos perillas
        // seguidas, la primera respuesta en llegar tarde no debe ganar.
        if (n === pedido && r.ok) pintar(j.vista)
      } finally {
        if (n === pedido) raiz!.classList.remove('pv--cargando')
      }
    }

    function tocarLinea(id: string) {
      const actual = vista.lineas.find((l) => l.id === id)
      if (!actual) return
      eleccion.lineas = { ...(eleccion.lineas ?? {}), [id]: !actual.incluida }
      simular()
    }

    raiz.addEventListener('click', (ev) => {
      if (!abierta) return
      const t = (ev.target as Element).closest<HTMLElement>('[data-linea],[data-version],[data-plan],[data-cuotas]')
      if (!t) return
      if (t.dataset.linea) return tocarLinea(t.dataset.linea)
      if (t.dataset.version) eleccion.version = t.dataset.version as EleccionCliente['version']
      if (t.dataset.plan) eleccion.planPago = t.dataset.plan as EleccionCliente['planPago']
      if (t.dataset.cuotas) {
        eleccion.planPago = 'cuotas'
        eleccion.numCuotas = Number(t.dataset.cuotas)
      }
      simular()
    })
    raiz.addEventListener('keydown', (ev) => {
      const t = (ev.target as Element).closest<HTMLElement>('[data-linea][role="button"]')
      if (t && (ev.key === 'Enter' || ev.key === ' ')) {
        ev.preventDefault()
        tocarLinea(t.dataset.linea!)
      }
    })

    const form = document.getElementById('pv-form') as HTMLFormElement | null
    form?.addEventListener('submit', async (ev) => {
      ev.preventDefault()
      const f = new FormData(form)
      const err = document.getElementById('pv-error')!
      err.textContent = ''
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement
      btn.disabled = true
      btn.textContent = 'Aceptando…'
      try {
        const r = await fetch(`/api/propuesta/${d.token}/aceptar`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            nombre: f.get('nombre'),
            documento: f.get('documento'),
            acepto: f.get('acepto') === 'on',
            precioVisto: vista.plan.total,
            eleccion,
          }),
        })
        const j = await r.json()
        if (!r.ok) throw new Error(j.error || 'No se pudo aceptar.')
        location.reload()
      } catch (e) {
        err.textContent = e instanceof Error ? e.message : 'No se pudo aceptar.'
        btn.disabled = false
        btn.textContent = 'Aceptar propuesta'
      }
    })

    document.getElementById('pv-pagar')?.addEventListener('click', async (ev) => {
      const btn = ev.currentTarget as HTMLButtonElement
      btn.disabled = true
      btn.textContent = 'Preparando el pago…'
      try {
        const r = await fetch(`/api/propuesta/${d.token}/anticipo`, { method: 'POST' })
        const j = await r.json()
        if (!r.ok) throw new Error(j.error || 'No se pudo preparar el pago.')
        if (j.provider === 'wompi') {
          // Formulario GET al checkout de Wompi con los parámetros firmados.
          const f = document.createElement('form')
          f.method = 'GET'
          f.action = j.url
          for (const [k, val] of Object.entries(j.params as Record<string, string>)) {
            const i = document.createElement('input')
            i.type = 'hidden'
            i.name = k
            i.value = val
            f.appendChild(i)
          }
          document.body.appendChild(f)
          f.submit()
          return
        }
        // Pasarela simulada (sin llaves de Wompi).
        const s = await fetch(j.confirmUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ reference: j.reference, outcome: 'approved', propuestaToken: d.token }),
        })
        if (!s.ok) throw new Error((await s.json()).error || 'El pago no se completó.')
        location.reload()
      } catch (e) {
        alert(e instanceof Error ? e.message : 'No se pudo preparar el pago.')
        btn.disabled = false
        btn.textContent = 'Pagar el anticipo'
      }
    })

    // Volviendo de Wompi el webhook puede tardar unos segundos: se consulta de
    // nuevo hasta que el pago deje de estar pendiente.
    if (document.body.textContent?.includes('Estamos confirmando tu pago')) setTimeout(() => location.reload(), 5000)
  }
</script>

<style is:global>
  .pv-body { background: var(--color-ink-900); color: var(--color-ink-50); min-height: 100vh; }
  .pv { max-width: 1080px; margin: 0 auto; padding: clamp(1.25rem, 4vw, 3rem) clamp(1.1rem, 4vw, 2.5rem) 4rem; }
  .pv-marca { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.24em; text-transform: uppercase; color: var(--color-ink-200); }
  .pv-label { display: block; font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-cyan-dim); margin-bottom: 0.9rem; }
  .pv-label.mt { margin-top: 1.4rem; }
  .pv-sub { font-size: 13px; color: var(--color-ink-200); line-height: 1.55; }
  .pv-sub.mb { margin-bottom: 1rem; }
  .pv a:not(.pv-btn) { color: var(--color-cyan); text-decoration: underline; text-underline-offset: 3px; }

  .pv-hero { display: grid; gap: 1.5rem 2.5rem; align-items: center; padding-bottom: 2.5rem; border-bottom: 1px solid rgba(255, 255, 255, 0.06); }
  @media (min-width: 900px) { .pv-hero { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); } }
  .pv-titulo { font-family: var(--font-serif); font-weight: 400; font-size: clamp(2.3rem, 5.4vw, 3.9rem); line-height: 1.02; letter-spacing: -0.015em; margin: 0.8rem 0 0.9rem; text-wrap: balance; }
  .pv-para { font-size: 15px; color: var(--color-ink-100); }
  .pv-para b { color: var(--color-ink-50); font-weight: 500; }
  .pv-precio { margin-top: 1.8rem; display: flex; flex-direction: column; gap: 0.2rem; }
  .pv-precio .pv-label { margin-bottom: 0.2rem; }
  .pv-precio strong { font-family: var(--font-display); font-weight: 500; font-size: clamp(2.2rem, 4.6vw, 3.2rem); letter-spacing: -0.035em; font-variant-numeric: tabular-nums; line-height: 1; }
  .pv-vigencia { margin-top: 1.1rem; font-size: 12.5px; color: var(--color-lime); font-family: var(--font-mono); }
  .pv-vigencia--mal { color: var(--color-ember); }
  .pv-hero__plano { position: relative; border-radius: 1.2rem; padding: 0.4rem; background:
      linear-gradient(rgba(0, 242, 255, 0.045) 1px, transparent 1px) 0 0 / 20px 20px,
      linear-gradient(90deg, rgba(0, 242, 255, 0.045) 1px, transparent 1px) 0 0 / 20px 20px,
      radial-gradient(120% 90% at 30% 20%, rgba(0, 122, 130, 0.22), rgba(10, 10, 13, 0.6));
    border: 1px solid rgba(0, 242, 255, 0.12); }
  .pv-hero__pista { grid-column: 1 / -1; font-size: 12.5px; color: var(--color-ink-200); text-align: right; margin-top: -0.6rem; }
  .pv--cargando .pv-hero__plano, .pv--cargando [data-precio] { opacity: 0.6; transition: opacity 0.2s; }

  /* Plano */
  .pv-plano { width: 100%; height: auto; display: block; overflow: visible; }
  .pv-exterior { fill: none; stroke: rgba(231, 231, 236, 0.85); stroke-width: 3.5; stroke-dasharray: 100; stroke-dashoffset: 0; animation: pv-trazo 1.6s cubic-bezier(0.6, 0, 0.2, 1) both; }
  .pv-cuarto__piso { fill: transparent; transition: fill 0.5s; }
  .pv-cuarto__muro { fill: none; stroke: rgba(231, 231, 236, 0.75); stroke-width: 1.6; stroke-dasharray: 100; animation: pv-trazo 1.1s cubic-bezier(0.6, 0, 0.2, 1) both; animation-delay: calc(0.35s + var(--i) * 0.09s); transition: stroke 0.4s, stroke-width 0.4s; }
  .pv-cuarto--hecho .pv-cuarto__piso { fill: url(#pv-rayado); }
  .pv-rayado { stroke: rgba(0, 242, 255, 0.16); stroke-width: 1.4; }
  .pv-cuarto--posible .pv-cuarto__muro { stroke: rgba(167, 139, 255, 0.7); stroke-dasharray: 3 4; animation: none; }
  .pv-cuarto--posible .pv-cuarto__piso { fill: rgba(167, 139, 255, 0.04); }
  .pv-cuarto__nombre { fill: var(--color-ink-50); font-family: var(--font-mono); text-anchor: middle; dominant-baseline: middle; letter-spacing: 0.02em; opacity: 0; animation: pv-aparece 0.6s ease both; animation-delay: calc(0.9s + var(--i) * 0.09s); }
  .pv-cuarto--posible .pv-cuarto__nombre { fill: rgba(196, 196, 204, 0.8); }
  .pv-cuarto__mas { fill: var(--color-violet); font-family: var(--font-mono); font-size: 15px; text-anchor: middle; }
  .pv-puerta { fill: none; stroke: rgba(0, 242, 255, 0.5); stroke-width: 1; stroke-dasharray: 2 2; }
  .pv-cuarto--tocable { cursor: pointer; outline: none; }
  .pv-cuarto--tocable:hover .pv-cuarto__piso, .pv-cuarto--tocable:focus-visible .pv-cuarto__piso { fill: rgba(0, 242, 255, 0.09); }
  .pv-cuarto--tocable:focus-visible .pv-cuarto__muro { stroke: var(--color-cyan); stroke-width: 2.4; }
  .pv-cota line { stroke: var(--color-cyan); stroke-width: 1; }
  .pv-cota__guia { stroke-dasharray: 2 3; opacity: 0.6; }
