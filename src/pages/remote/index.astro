---
// El MANDO de `/final.html`: lo que llevo en la mano. Manda intenciones a
// `/api/presentacion`; quien las cumple es `/presentacion`, que es la que
// tiene el bundle delante.
//
// Vive en `/remote` a secas porque se teclea de memoria en el celular, con la
// sala esperando. Es la ruta más corta que queda libre en la raíz.
//
// OJO al vecindario: `/remote/<sessionId>` es otra cosa (el control de las
// presentaciones con deck y PIN) y sigue exigiendo sesión de admin. El
// middleware separa las dos por ruta EXACTA; ver el comentario del matcher
// `isAdmin`.
//
// La regla de diseño de esta pantalla: NO MENTIR. La versión anterior pintaba
// "ok" en cuanto el POST devolvía 200, que solo confirma que el servidor
// apuntó la intención. En el final del mazo eso era un botón que respondía
// "ok" mientras nada se movía. Aquí lo que se pinta grande es la posición REAL
// que publica la pantalla, y el destino solo aparece cuando todavía no se ha
// alcanzado.
//
// Sondea una vez por segundo y SOLO con la pestaña visible: el teléfono pasa
// la charla entera bloqueado en el bolsillo y no tiene sentido gastar
// lecturas del almacén para nadie.
Astro.response.headers.set('Cache-Control', 'no-store')
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow')
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#05070a" />
    <title>Control · Presentación</title>
    <style>
      * {
        box-sizing: border-box;
        -webkit-tap-highlight-color: transparent;
      }
      html,
      body {
        margin: 0;
        min-height: 100%;
        background: #05070a;
        color: #e9f2f9;
        font-family: system-ui, -apple-system, sans-serif;
        /* Sin selección accidental al mantener pulsado un botón. */
        -webkit-user-select: none;
        user-select: none;
      }
      main {
        /* Altura FIJA, no mínima: con `min-height` la columna crece cuando el
           guion es largo y se lleva los botones fuera de la pantalla, que es
           lo único que la mano busca a ciegas. Acotada, el único que cede es
           el panel de notas, que hace scroll dentro de sí mismo. */
        height: 100svh;
        overflow: hidden;
        /* Es un mando de pulgar. Si acaba abierto en un portátil, no tiene
           sentido estirar los botones a lo ancho de la pantalla. */
        max-width: 520px;
        margin-inline: auto;
        display: flex;
        flex-direction: column;
        gap: 16px;
        padding: 14px 16px calc(16px + env(safe-area-inset-bottom));
      }

      /* Cabecera: estado del enlace con la pantalla. */
      header {
        display: flex;
        align-items: center;
        gap: 8px;
        font: 12px/1 ui-monospace, Menlo, Consolas, monospace;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #5c7488;
      }
      #pulso {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #2b3947;
        flex: none;
        transition: background 0.2s;
      }
      header[data-enlace='viva'] #pulso {
        background: #35d07f;
        box-shadow: 0 0 0 4px rgba(53, 208, 127, 0.12);
      }
      header[data-enlace='sola'] #pulso {
        background: #d8a13a;
      }
      header[data-enlace='caida'] #pulso {
        background: #d2544a;
      }

      /* Posición real, que es lo que de verdad importa mirar, y al lado el
         nombre de la diapositiva: el número dice dónde estás, el título dice
         de qué estás hablando. */
      .lectura {
        display: flex;
        align-items: baseline;
        gap: 10px;
        font-variant-numeric: tabular-nums;
        line-height: 1;
      }
      .cifra {
        display: flex;
        align-items: baseline;
        gap: 6px;
        flex: none;
      }
      #titulo {
        flex: 1;
        min-width: 0;
        font-size: 1.05rem;
        font-weight: 600;
        line-height: 1.25;
        color: #cfe3f2;
        text-wrap: balance;
      }
      #dur {
        flex: none;
        font: 11px/1 ui-monospace, Menlo, Consolas, monospace;
        color: #5c7488;
      }
      #pos {
        font-size: 4.6rem;
        font-weight: 700;
        letter-spacing: -0.03em;
      }
      #total {
        font-size: 1.6rem;
        font-weight: 500;
        color: #5c7488;
      }
      #viaje {
        text-align: center;
        min-height: 1.2em;
        font: 13px/1.2 ui-monospace, Menlo, Consolas, monospace;
        color: #7fb2d8;
      }
      #viaje:empty::before {
        content: '\00a0';
      }

      /* El guion. Se lleva el hueco que sobra y hace scroll dentro de sí
         mismo: los botones no pueden salirse de la pantalla por mucho que se
         alargue una nota, que es lo único que la mano busca a ciegas. */
      #nota {
        flex: 1 1 auto;
        /* Sin esto un elemento flex no baja de su contenido y el `overflow`
           de abajo no llega a activarse nunca. */
        min-height: 0;
        overflow-y: auto;
        overscroll-behavior: contain;
        -webkit-overflow-scrolling: touch;
        /* Sitio para la barra de scroll de escritorio: sin esto el texto se
           mete por debajo. En el móvil la barra flota y no ocupa nada. */
        padding-right: 8px;
        scrollbar-width: thin;
        scrollbar-color: #22303e transparent;
        display: flex;
        flex-direction: column;
        gap: 10px;
      }
      #pantalla {
        margin: 0;
        padding: 10px 12px;
        border-radius: 10px;
        background: #0a1219;
        color: #7fb2d8;
        font-size: 0.95rem;
        line-height: 1.35;
      }
      #pantalla::before {
        content: 'en pantalla';
        display: block;
        margin-bottom: 4px;
        font: 10px/1 ui-monospace, Menlo, Consolas, monospace;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #46586a;
      }
      #notas {
        margin: 0;
        padding: 0;
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 12px;
      }
      #notas :global(li) {
        position: relative;
        padding-left: 16px;
        font-size: 1.02rem;
        line-height: 1.45;
        color: #dbe8f2;
      }
      /* Un punto por idea. Nada de franja de color pegada al margen. */
      #notas :global(li)::before {
        content: '';
        position: absolute;
        left: 2px;
        top: 0.62em;
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: #2f5f80;
      }
      #vacio {
        margin: 0;
        font: 13px/1.4 ui-monospace, Menlo, Consolas, monospace;
        color: #46586a;
      }

      /* Rejilla de salto: el total lo publica la pantalla, así que se puede
         pintar un botón por diapositiva sin que nadie lo escriba a mano. */
      /* `display:grid` gana a `[hidden]`, que solo trae `display:none` de la
         hoja del navegador. Sin esta regla la rejilla no se esconde nunca. */
      #saltos[hidden] {
        display: none;
      }
      #saltos {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(44px, 1fr));
        gap: 6px;
      }
      /* `:global` es obligatorio, no cosmético: Astro reescribe cada selector
         de este bloque con su `[data-astro-cid-…]`, y estos botones los crea
         el script en tiempo de ejecución, así que no llevan ese atributo. Sin
         esto salen con el estilo por defecto del navegador (fondo claro sobre
         una página negra) y solo se ve en el móvil, ya montado. */
      #saltos :global(button) {
        padding: 10px 0;
        font: 600 14px/1 ui-monospace, Menlo, Consolas, monospace;
        color: #7d94a8;
        background: #0a0f16;
        border: 1px solid #16202c;
        border-radius: 10px;
      }
      #saltos :global(button[aria-current='true']) {
        color: #05070a;
        background: #7fb2d8;
        border-color: #7fb2d8;
      }

      /* Desplazamiento de la página viva que hay dentro de un beat. Ocupa el
         sitio de la rejilla de saltos, que es lo que menos se usa en mitad de
         una demo y lo único que se puede quitar sin empujar el guion. */
      #desplaza[hidden] {
        display: none;
      }
      #desplaza {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }
      #botones {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
      }
      #botones button {
        padding: 18px 0;
        font-size: 1.5rem;
        line-height: 1;
        color: #cfe3f2;
        background: #0a0f16;
        border: 1px solid #16202c;
        border-radius: 12px;
        touch-action: manipulation;
      }
      #botones button:active {
        background: #17222f;
      }
      #botones button:disabled {
        opacity: 0.32;
      }
      /* Por dónde va la página de dentro. Dos píxeles: es una referencia de
         reojo mientras se habla, no un dato que haya que leer. */
      #recorrido {
        height: 2px;
        border-radius: 2px;
        background: #16202c;
        overflow: hidden;
      }
      #recorrido span {
        display: block;
        height: 100%;
        width: 0;
        background: #2f5f80;
        transition: width 0.25s linear;
      }

      .mandos {
        margin-top: auto;
        display: flex;
        flex-direction: column;
        gap: 12px;
      }
      .mandos button {
        border: 1px solid #1b2836;
        background: #0b1017;
        color: #e9f2f9;
        border-radius: 16px;
        font-size: 1.4rem;
        font-weight: 600;
        padding: 26px 0;
        touch-action: manipulation;
      }
      .mandos button:active {
        background: #17222f;
      }
      .mandos button:disabled {
        opacity: 0.32;
      }
      #siguiente {
        padding: 40px 0;
        background: #12324a;
        border-color: #1e4c6e;
      }
      #siguiente:active {
        background: #184163;
      }
      #aviso {
        text-align: center;
        min-height: 1.2em;
        font: 12px/1.2 ui-monospace, Menlo, Consolas, monospace;
        color: #d2544a;
      }
    </style>
  </head>
  <body>
    <main>
      <header id="enlace" data-enlace="">
        <span id="pulso" aria-hidden="true"></span>
        <span id="estado">conectando</span>
      </header>

      <p class="lectura">
        <span class="cifra"><span id="pos">-</span><span id="total">/ -</span></span>
        <span id="titulo"></span>
        <span id="dur"></span>
      </p>
      <p id="viaje" aria-live="polite"></p>

      <section id="nota" aria-live="polite" aria-label="Notas de la diapositiva">
        <p id="pantalla" hidden></p>
        <ul id="notas"></ul>
        <p id="vacio" hidden>sin notas para esta diapositiva</p>
      </section>

      <div id="saltos"></div>

      <section id="desplaza" hidden aria-label="Desplazar la página proyectada">
        <div id="botones">
          <button id="subir" type="button" aria-label="Subir">↑</button>
          <button id="bajar" type="button" aria-label="Bajar">↓</button>
        </div>
        <div id="recorrido"><span id="avance"></span></div>
      </section>

      <div class="mandos">
        <p id="aviso" aria-live="polite"></p>
        <button id="anterior" type="button">← Anterior</button>
        <button id="siguiente" type="button">Siguiente →</button>
      </div>
    </main>

    <script>
      import { mazoPublicado, notaDeGlobal } from '../../lib/presentacion/guion'

      type Geometria = { y: number; max: number; alto: number }
      type Actual = {
        pos: number
        total: number
        ts: number
        intro?: number
        outro?: number
        scroll?: Geometria
      }
      /** `scroll` es el desplazamiento PEDIDO, el equivalente de `destino`
       *  para la página que hay dentro de la diapositiva. La geometría real
       *  viene dentro de `actual`. */
      type Estado = { destino: number; actual: Actual | null; viva?: boolean; scroll?: number }

      const el = {
        enlace: document.getElementById('enlace') as HTMLElement,
        estado: document.getElementById('estado') as HTMLElement,
        pos: document.getElementById('pos') as HTMLElement,
        total: document.getElementById('total') as HTMLElement,
        viaje: document.getElementById('viaje') as HTMLElement,
        saltos: document.getElementById('saltos') as HTMLElement,
        aviso: document.getElementById('aviso') as HTMLElement,
        anterior: document.getElementById('anterior') as HTMLButtonElement,
        siguiente: document.getElementById('siguiente') as HTMLButtonElement,
        titulo: document.getElementById('titulo') as HTMLElement,
        dur: document.getElementById('dur') as HTMLElement,
        pantalla: document.getElementById('pantalla') as HTMLElement,
        notas: document.getElementById('notas') as HTMLElement,
        vacio: document.getElementById('vacio') as HTMLElement,
        desplaza: document.getElementById('desplaza') as HTMLElement,
        subir: document.getElementById('subir') as HTMLButtonElement,
        bajar: document.getElementById('bajar') as HTMLButtonElement,
        avance: document.getElementById('avance') as HTMLElement,
      }

      const SONDEO_MS = 1_000

      let estado: Estado | null = null
      let totalPintado = 0

      function pintar(nuevo: Estado, hayRed: boolean) {
        estado = nuevo
        const { destino, actual } = nuevo
        const viva = hayRed && Boolean(nuevo.viva)

        el.enlace.dataset.enlace = !hayRed ? 'caida' : viva ? 'viva' : 'sola'
        el.estado.textContent = !hayRed
          ? 'sin red'
          : viva
            ? 'pantalla en línea'
            : 'pantalla sin responder'

        el.pos.textContent = actual ? String(actual.pos) : '-'
        el.total.textContent = actual ? `/ ${actual.total}` : '/ -'

        // El destino solo se enseña mientras es una promesa pendiente. Cuando
        // coincide con la posición real no aporta nada y solo hace ruido.
        el.viaje.textContent =
          actual && destino !== actual.pos
            ? `${destino > actual.pos ? 'avanzando' : 'volviendo'} a ${destino}`
            : ''

        // Los topes salen del total REAL del mazo, no de una constante. Un
        // botón que no puede hacer nada se apaga en vez de mentir.
        el.anterior.disabled = !actual || destino <= 1
        el.siguiente.disabled = Boolean(actual && destino >= actual.total)

        // La nota va con el DESTINO, no con la posición confirmada. Ver
        // `pintarNota`.
        pintarNota(destino, actual)
        pintarDesplazamiento(actual?.scroll, nuevo.scroll ?? 0)
        if (actual && actual.total !== totalPintado) pintarSaltos(actual.total)
        for (const b of el.saltos.querySelectorAll('button')) {
          b.setAttribute('aria-current', String(Number(b.dataset.n) === destino))
        }
      }

      /**
       * Los controles de desplazamiento, que SUSTITUYEN a la rejilla de saltos
       * mientras la diapositiva tenga una página viva dentro. Es el sitio que
       * menos se usa en mitad de una demo y el único que se puede ceder sin
       * empujar el guion fuera de la pantalla.
       *
       * Aparecen solos y se van solos: la pantalla publica la geometría del
       * iframe que descubre, y sin geometría -sin iframe, con uno de otro
       * origen, o con una página que cabe entera- aquí no hay nada que pintar.
       *
       * Los topes se comparan contra lo PEDIDO y se acotan contra el máximo
       * REAL, igual que "Siguiente" se apaga con el destino contra el total del
       * mazo: mientras el `scrollTo` anima, la posición real va por detrás, y
       * mirarla dejaría el botón encendido en el fondo de la página.
       */
      function pintarDesplazamiento(geo: Geometria | undefined, pedido: number) {
        const hay = Boolean(geo && geo.max >= 1)
        el.desplaza.hidden = !hay
        el.saltos.hidden = hay
        if (!geo || !hay) return
        el.subir.disabled = pedido <= 0
        el.bajar.disabled = pedido >= geo.max
        // La barra enseña la posición REAL, no la pedida: es la referencia de
        // por dónde va lo que está viendo el público.
        el.avance.style.width = `${Math.round((geo.y / geo.max) * 100)}%`
      }

      /** Segundos estimados, legibles de un vistazo: 45s, 1:30, 2:30. */
      const duracion = (s: number) =>
        s < 60 ? `${s}s` : `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`

      /** Última posición con la nota ya montada, para no rehacer el DOM en
       *  cada sondeo (uno por segundo, toda la charla). */
      let notaPintada: number | null = null

      /**
       * El guion de la diapositiva de la que se va a hablar.
       *
       * Va con el DESTINO y no con la posición confirmada, que es lo contrario
       * de lo que hace el número grande, y es deliberado. La posición real
       * llega hasta dos segundos tarde: el mando avisa al servidor, la pantalla
       * lo lee en su sondeo, mueve la diapositiva, publica, y el teléfono lo
       * sondea. En ese hueco lo que se está leyendo es la nota anterior, que en
       * una charla es justo el momento en que se mira el teléfono. Con el
       * destino, la nota cambia en el mismo fotograma del toque.
       *
       * No es mentir, que es la regla de esta pantalla: el destino ES lo que se
       * va a decir, la línea de "avanzando a N" de justo encima dice que la
       * proyección todavía va por detrás, y si la pantalla no llegara, publica
       * su posición como movimiento ajeno, el servidor la adopta como destino y
       * la nota vuelve sola a la realidad. Converge siempre.
       *
       * La FORMA del mazo, en cambio, sale de `actual`: es lo único que sabe
       * cuántas capas hay. Sin ella no se enseña nada, porque un número sin
       * forma no distingue una capa de un beat, y la nota equivocada delante
       * del público es peor que ninguna.
       */
      function pintarNota(destino: number, actual: Actual | null) {
        const mazo = actual ? mazoPublicado(actual) : null
        const clave = mazo ? destino : null
        if (clave === notaPintada) return
        notaPintada = clave

        const nota = mazo ? notaDeGlobal(mazo, destino) : null
        el.titulo.textContent = nota?.titulo ?? ''
        el.dur.textContent = nota?.dur ? duracion(nota.dur) : ''

        el.pantalla.textContent = nota?.enPantalla ?? ''
        el.pantalla.hidden = !nota?.enPantalla

        const lineas = nota?.notas ?? []
        el.notas.replaceChildren(
          ...lineas.map((t) => {
            const li = document.createElement('li')
            li.textContent = t
            return li
          })
        )
        // El hueco se dice, no se deja en blanco: en una diapositiva sin guion
        // hay que saber que falta escribirlo, no dudar de si el mando falla.
        el.vacio.hidden = !nota || lineas.length > 0
        // Una nota nueva se lee desde arriba.
        el.notas.parentElement?.scrollTo({ top: 0 })
      }

      function pintarSaltos(total: number) {
        totalPintado = total
        el.saltos.replaceChildren(
          ...Array.from({ length: total }, (_, i) => {
            const b = document.createElement('button')
            b.type = 'button'
            b.dataset.n = String(i + 1)
            b.textContent = String(i + 1)
            b.addEventListener('click', () => mandar({ destino: i + 1 }))
            return b
          })
        )
      }

      /**
       * Una petición a la vez. Con 5G irregular, dos toques rápidos podían
       * cruzarse y la respuesta vieja pisaba a la nueva, dejando pintado un
       * destino anterior al real.
       */
      let enVuelo: Promise<void> | null = null

      async function pedir(init?: RequestInit) {
        try {
          const res = await fetch('/api/presentacion', { cache: 'no-store', ...init })
          if (!res.ok) {
            el.aviso.textContent = res.status === 503 ? 'almacén no disponible' : 'error al enviar'
            return
          }
          el.aviso.textContent = ''
          pintar((await res.json()) as Estado, true)
        } catch {
          el.enlace.dataset.enlace = 'caida'
          el.estado.textContent = 'sin red'
        }
      }

      function mandar(cuerpo: Record<string, unknown>) {
        // Adelanto local del destino: el pulgar ve el efecto en el mismo
        // fotograma del toque, y la respuesta lo confirma o lo corrige.
        if (estado) {
          const delta = cuerpo.accion === 'siguiente' ? 1 : cuerpo.accion === 'anterior' ? -1 : 0
          const tentativo =
            typeof cuerpo.destino === 'number' ? cuerpo.destino : estado.destino + delta
          const tope = estado.actual?.total ?? 999
          pintar({ ...estado, destino: Math.min(Math.max(tentativo, 1), tope) }, true)
        }
        const tarea = (enVuelo ?? Promise.resolve()).then(() =>
          pedir({
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(cuerpo),
          })
        )
        enVuelo = tarea.finally(() => {
          if (enVuelo === tarea) enVuelo = null
        })
      }

      el.anterior.addEventListener('click', () => mandar({ accion: 'anterior' }))
      el.siguiente.addEventListener('click', () => mandar({ accion: 'siguiente' }))

      /**
       * Mantener pulsado repite. Recorrer una página larga a toques sueltos
       * son quince golpes de pulgar mientras se habla; con la repetición es
       * dejar el dedo puesto y mirar la proyección.
       *
       * El primer empujón sale en el `pointerdown`, no al soltar: el retardo
       * de un `click` se nota mucho cuando lo que se está viendo es la
       * pantalla de la sala y no el teléfono.
       */
      const REPETIR_MS = 350

      function repetible(boton: HTMLButtonElement, accion: 'subir' | 'bajar') {
        let timer: number | undefined
        const parar = () => {
          clearInterval(timer)
          timer = undefined
        }
        boton.addEventListener('pointerdown', (e) => {
          e.preventDefault()
          if (boton.disabled) return
          mandar({ accion })
          parar()
          timer = window.setInterval(() => {
            // El botón puede apagarse a mitad de la repetición al llegar al
            // fondo: sin esto seguiría mandando toques que el servidor acota
            // contra el mismo número una y otra vez.
            // Con la red lenta, una repetición por ciclo llenaría la cola de
            // `enVuelo` y la página seguiría bajando un rato después de
            // levantar el dedo. Un empujón en vuelo a la vez.
            if (boton.disabled) parar()
            else if (!enVuelo) mandar({ accion })
          }, REPETIR_MS)
        })
        // `pointercancel` es el que importa en el móvil: el navegador se lleva
        // el puntero en cuanto interpreta un gesto de scroll, y sin él el dedo
        // levantado dejaría el temporizador corriendo para siempre.
        for (const ev of ['pointerup', 'pointercancel', 'pointerleave'] as const) {
          boton.addEventListener(ev, parar)
        }
      }

      repetible(el.subir, 'subir')
      repetible(el.bajar, 'bajar')

      // El teléfono también sirve de receptor de un presentador bluetooth:
      // sus flechas llegan aquí como teclas normales.
      document.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'PageDown') mandar({ accion: 'siguiente' })
        else if (e.key === 'ArrowLeft' || e.key === 'PageUp') mandar({ accion: 'anterior' })
      })

      async function bucle() {
        // La primera lectura no espera a nada: la página tiene que pintar la
        // posición aunque el teléfono la haya abierto en segundo plano (una
        // notificación por encima, la pantalla bloqueada al sacarlo del
        // bolsillo) y el primer `visibilitychange` llegue después.
        await pedir()
        for (;;) {
          // Con la pantalla del teléfono apagada no hay nadie mirando: sondear
          // ahí solo gasta batería y lecturas del almacén.
          if (document.visibilityState === 'visible' && !enVuelo) await pedir()
          await new Promise((r) => setTimeout(r, SONDEO_MS))
        }
      }
      // Sondeo inmediato al volver a mirar el teléfono, sin esperar a la
      // siguiente vuelta del bucle: es el momento en que se lee la nota.
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible' && !enVuelo) void pedir()
      })
      void bucle()
    </script>
  </body>
</html>
