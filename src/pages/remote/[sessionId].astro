---
// Control remoto. Es el celular en la mano del presentador, así que todo lo de
// aquí está pensado para mirarse de reojo: notas grandes arriba, botones
// enormes abajo, sin scroll de página y sin un solo elemento que exija
// puntería.
//
// La ruta está en el matcher `isAdmin` del middleware: sin sesión de admin no
// se llega, y el secreto del presentador que autoriza los comandos se entrega
// en el HTML de esta página — nunca en una URL, nunca a la vista del público.
//
// Aquí NO se carga el iframe del deck. Cargar el deck entero en un móvil para
// leer un atributo sería absurdo: las notas vienen de `deck_slides`, que se
// llenó al subir el archivo.
import PresentLayout from '../../layouts/PresentLayout.astro'
import ClosingScreen from '../../components/present/ClosingScreen.astro'
import { getDeckSlides } from '../../lib/present/decks'
import { getSession, presenterSecretFor, toPublicSnapshot } from '../../lib/present/session'
import { busCredentials } from '../../lib/present/store'

const { sessionId } = Astro.params
const session = sessionId ? await getSession(sessionId) : null

Astro.response.headers.set('Cache-Control', 'no-store')
if (!session) Astro.response.status = 404

const slides = session ? await getDeckSlides(session.deckId) : []
const bus = busCredentials()
const snapshot = session ? toPublicSnapshot(session) : null
// Se recalcula aquí en vez de leerse de Redis: el secreto no está guardado en
// ninguna parte, se deriva del id de sesión. Esta página es el único sitio del
// sitio que lo materializa.
const presenterSecret = session ? await presenterSecretFor(session.id) : ''
const feedbackUrl = `${Astro.url.origin}/feedback`
---

<PresentLayout title={session ? `Control · ${session.deckTitle}` : 'Control'} background="#0a0a0d">
  {!session ? (
    <main class="empty">
      <p class="eyebrow">Control remoto</p>
      <h1>Esta sesión ya no existe.</h1>
      <a class="empty-cta" href="/admin/presentaciones">Volver a la biblioteca</a>
    </main>
  ) : (
    <>
      <main class="remote" id="remote">
        {/* Mitad superior: contexto + notas */}
        <section class="notes-pane">
          <header class="notes-head">
            <span class="counter mono" id="counter">–/{session.totalSlides}</span>
            <span class="label" id="label">—</span>
            <span class="conn" id="conn" title="Estado de la conexión" aria-live="polite"></span>
          </header>
          <div class="notes" id="notes" tabindex="0">
            <p class="notes-empty">Sin notas para este slide.</p>
          </div>
        </section>

        {/* Mitad inferior: controles al alcance del pulgar */}
        <section class="controls">
          <div class="nav-row">
            <button type="button" class="nav-btn" id="prev" aria-label="Slide anterior">
              <span aria-hidden="true">←</span> Anterior
            </button>
            <button type="button" class="nav-btn nav-btn-primary" id="next" aria-label="Siguiente slide">
              Siguiente <span aria-hidden="true">→</span>
            </button>
          </div>

          <div class="secondary">
            <button type="button" class="ghost" id="grid-open">Slides</button>
            <button type="button" class="ghost ghost-go" id="start">Iniciar presentación</button>
            <button type="button" class="ghost ghost-end" id="end">Finalizar</button>
          </div>
        </section>
      </main>

      {/* Rejilla de salto directo */}
      <div class="grid-sheet" id="grid-sheet" hidden>
        <div class="grid-head">
          <span class="eyebrow">Ir al slide</span>
          <button type="button" class="ghost" id="grid-close">Cerrar</button>
        </div>
        <ol class="grid">
          {slides.map((s) => (
            <li>
              <button type="button" class="grid-item" data-slide={s.idx}>
                <span class="grid-num mono">{s.idx + 1}</span>
                <span class="grid-label">{s.label ?? 'Sin rótulo'}</span>
              </button>
            </li>
          ))}
        </ol>
      </div>

      <ClosingScreen feedbackUrl={feedbackUrl} deckId={session.deckId} />

      <script
        type="application/json"
        id="present-config"
        set:html={JSON.stringify({
          snapshot,
          bus,
          // El secreto vive en el HTML de una página que ya está detrás del
          // gate de admin y que se sirve con `no-store`. No aparece en la URL,
          // así que no queda en el historial, ni en un referer, ni en el QR que
          // se proyecta.
          secret: presenterSecret,
          slides: slides.map((s) => ({ idx: s.idx, label: s.label, notes: s.speakerNotes })),
        })}
      />
    </>
  )}
</PresentLayout>

<style>
  .empty {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    text-align: center;
    padding: 2rem;
  }
  .empty h1 { font-size: 1.5rem; font-weight: 500; }
  .empty-cta { color: var(--cyan); text-decoration: none; font-size: 0.9rem; }

  /* Altura fija en dos mitades: sin scroll de página, pase lo que pase con el
     teclado del sistema o la barra del navegador. `dvh` y no `vh` porque en
     iOS la barra de Safari se come el 100vh justo donde van los botones. */
  .remote {
    height: 100dvh;
    display: grid;
    grid-template-rows: 1fr auto;
    padding: calc(0.75rem + var(--safe-top)) 0.75rem calc(0.75rem + var(--safe-bottom));
    gap: 0.75rem;
  }

  .notes-pane {
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    background: var(--ink-800);
    border: 1px solid #1f1f2b;
    border-radius: 16px;
    padding: 0.85rem 0.95rem;
  }

  .notes-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid #1f1f2b;
  }
  .counter {
    font-size: 0.85rem;
    color: var(--cyan);
    font-weight: 600;
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }
  .label {
    font-size: 0.85rem;
    color: var(--ink-100);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex: 1;
  }
  /* Punto de estado, no franja de color: dice si el celular sigue hablando con
     el servidor sin ocupar una línea de la pantalla. */
  .conn {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--ink-300);
    flex-shrink: 0;
    transition: background 0.3s ease;
  }
  .conn[data-status='live'] { background: var(--lime); }
  .conn[data-status='polling'] { background: #ffb454; }

  /* Las notas son lo único que se lee en vivo: tamaño de lectura real, no de
     interfaz, y su propio scroll cuando son largas. */
  .notes {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    font-size: clamp(1.05rem, 4.4vw, 1.4rem);
    line-height: 1.55;
    color: var(--ink-50);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .notes-empty { color: var(--ink-300); font-size: 1rem; font-style: italic; }

  .controls { display: flex; flex-direction: column; gap: 0.6rem; }

  .nav-row { display: grid; grid-template-columns: 1fr 1.4fr; gap: 0.6rem; }

  /* 72px: por encima del mínimo del brief (64) y del objetivo táctil cómodo.
     Se pulsan sin mirar. */
  .nav-btn {
    min-height: 72px;
    border-radius: 16px;
    border: 1px solid #26263a;
    background: var(--ink-700);
    color: var(--ink-50);
    font-size: 1.05rem;
    font-weight: 500;
    font-family: inherit;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    transition: transform 0.08s ease, background 0.15s ease;
  }
  .nav-btn:active { transform: scale(0.98); background: #23232f; }
  .nav-btn-primary {
    background: color-mix(in srgb, var(--cyan) 16%, var(--ink-700));
    border-color: color-mix(in srgb, var(--cyan) 40%, transparent);
    color: var(--cyan-glow);
  }
  .nav-btn-primary:active { background: color-mix(in srgb, var(--cyan) 26%, var(--ink-700)); }
  .nav-btn:disabled { opacity: 0.35; }

  .secondary { display: flex; gap: 0.5rem; }
  .ghost {
    flex: 1;
    min-height: 44px;
    border-radius: 12px;
    border: 1px solid #22222e;
    background: transparent;
    color: var(--ink-200);
    font-size: 0.82rem;
    font-family: inherit;
    cursor: pointer;
    touch-action: manipulation;
  }
  .ghost:active { background: #17171f; }
  .ghost-go { color: var(--lime); border-color: color-mix(in srgb, var(--lime) 28%, transparent); }
  .ghost-end { color: #ff7a7a; border-color: rgba(255, 122, 122, 0.28); }
  .ghost[hidden] { display: none; }

  .grid-sheet {
    position: fixed;
    inset: 0;
    z-index: 30;
    background: #0a0a0d;
    display: flex;
    flex-direction: column;
    padding: calc(0.9rem + var(--safe-top)) 0.9rem calc(0.9rem + var(--safe-bottom));
    gap: 0.8rem;
  }
  .grid-sheet[hidden] { display: none; }
  .grid-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .grid-head .ghost { flex: 0 0 auto; padding: 0 1rem; }

  .grid {
    list-style: none;
    overflow-y: auto;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 0.5rem;
    padding-bottom: 1rem;
  }
  .grid-item {
    width: 100%;
    min-height: 64px;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 0.8rem;
    border-radius: 12px;
    border: 1px solid #1f1f2b;
    background: var(--ink-800);
    color: var(--ink-100);
    font-family: inherit;
    font-size: 0.82rem;
    text-align: left;
    cursor: pointer;
  }
  .grid-item[data-current='true'] {
    border-color: color-mix(in srgb, var(--cyan) 45%, transparent);
    background: color-mix(in srgb, var(--cyan) 10%, var(--ink-800));
  }
  .grid-num { color: var(--cyan); font-weight: 600; flex-shrink: 0; }
  .grid-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
</style>

<script>
  import { startSync, type Snapshot } from '../../lib/present/client-sync'

  const configEl = document.getElementById('present-config')

  if (configEl) {
    const { snapshot, bus, secret, slides } = JSON.parse(configEl.textContent || '{}') as {
      snapshot: Snapshot
      bus: { url: string; token: string } | null
      secret: string
      slides: { idx: number; label: string | null; notes: string | null }[]
    }

    const sessionId = snapshot.sessionId
    const counter = document.getElementById('counter')!
    const label = document.getElementById('label')!
    const notes = document.getElementById('notes')!
    const conn = document.getElementById('conn')!
    const prevBtn = document.getElementById('prev') as HTMLButtonElement
    const nextBtn = document.getElementById('next') as HTMLButtonElement
    const startBtn = document.getElementById('start') as HTMLButtonElement
    const endBtn = document.getElementById('end') as HTMLButtonElement
    const gridSheet = document.getElementById('grid-sheet')!
    const closing = document.getElementById('closing')!

    // ── Comandos ────────────────────────────────────────────────────────────
    // Optimista a medias: el háptico dispara al instante (es lo que confirma
    // al pulgar que el toque entró), pero la pantalla no se mueve hasta que
    // responde el servidor. Adelantar las notas a un salto que el servidor
    // podría rechazar es exactamente cómo un presentador acaba leyendo las
    // notas equivocadas.
    const send = async (payload: Record<string, unknown>) => {
      buzz()
      try {
        const res = await fetch(`/api/admin/present/${sessionId}/control`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...payload, secret }),
        })
        if (res.ok) render((await res.json()) as Snapshot)
      } catch {
        // Sin red. El siguiente snapshot del bus o del resync recolocará la
        // pantalla; no hay que avisar de nada en mitad de una charla.
      }
    }

    /** Vibración corta. Silenciosa si el dispositivo no la soporta. */
    const buzz = () => {
      try {
        navigator.vibrate?.(12)
      } catch {
        /* no todos los navegadores la exponen, y ninguno la necesita */
      }
    }

    // ── Pintado ─────────────────────────────────────────────────────────────
    const render = (snap: Snapshot) => {
      if (snap.state === 'ended') {
        closing.hidden = false
        return
      }

      const slide = slides.find((s) => s.idx === snap.currentSlide)
      counter.textContent = `${snap.currentSlide + 1}/${snap.totalSlides}`
      label.textContent = slide?.label ?? '—'

      if (slide?.notes) {
        notes.textContent = slide.notes
      } else {
        notes.innerHTML = '<p class="notes-empty">Sin notas para este slide.</p>'
      }
      // Nota nueva, scroll arriba: seguir viendo el final de la nota anterior
      // es peor que no ver nada.
      notes.scrollTop = 0

      startBtn.hidden = snap.state !== 'lobby'
      prevBtn.disabled = snap.state === 'lobby' || snap.currentSlide === 0

      for (const el of document.querySelectorAll<HTMLElement>('.grid-item')) {
        el.dataset.current = String(Number(el.dataset.slide) === snap.currentSlide)
      }
    }

    // ── Interacción ─────────────────────────────────────────────────────────
    prevBtn.addEventListener('click', () => send({ type: 'prev' }))
    nextBtn.addEventListener('click', () => send({ type: 'next' }))
    startBtn.addEventListener('click', () => send({ type: 'start' }))
    endBtn.addEventListener('click', () => send({ type: 'end' }))

    document.getElementById('grid-open')!.addEventListener('click', () => { gridSheet.hidden = false })
    document.getElementById('grid-close')!.addEventListener('click', () => { gridSheet.hidden = true })
    for (const el of document.querySelectorAll<HTMLElement>('.grid-item')) {
      el.addEventListener('click', () => {
        gridSheet.hidden = true
        send({ type: 'goto', slide: Number(el.dataset.slide) })
      })
    }

    // Teclado, por si el control es un portátil y no el celular.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'PageDown' || e.key === ' ') {
        e.preventDefault()
        send({ type: 'next' })
      } else if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
        e.preventDefault()
        send({ type: 'prev' })
      } else if (e.key === 'Escape') {
        gridSheet.hidden = true
      }
    })

    // ── Pantalla encendida ──────────────────────────────────────────────────
    // Un celular que se apaga a los 30 segundos obliga a desbloquearlo entre
    // slide y slide. Degradación silenciosa: si el navegador no trae Wake Lock,
    // no se avisa de nada — no hay nada que el presentador pueda hacer al
    // respecto en mitad de una charla.
    let wakeLock: WakeLockSentinel | null = null
    const keepAwake = async () => {
      try {
        wakeLock = await navigator.wakeLock?.request('screen')
      } catch {
        /* denegado o no soportado */
      }
    }
    void keepAwake()
    // El bloqueo se pierde al volver de segundo plano: hay que rehacerlo.
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible' && !wakeLock) void keepAwake()
    })

    render(snapshot)
    startSync({
      sessionId,
      bus,
      onSnapshot: render,
      onStatus: (status) => { conn.dataset.status = status },
    })
  }
</script>
