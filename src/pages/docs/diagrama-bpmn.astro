---
import BaseLayout from '../../layouts/BaseLayout.astro'
import DocsNav from '../../components/DocsNav.astro'
import BpmnDiagram from '../../components/BpmnDiagram.astro'
import BpmnShape from '../../components/BpmnShape.astro'
import { procesosBpmn, leyendaBpmn, COMPUERTAS_BPMN } from '../../data/bpmn'
import { sizeOf, type BpmnNodeType, type PlacedNode } from '../../lib/bpmn-layout'

// Monta una figura suelta (sin carriles ni flujos) en un lienzo ajustado a su
// tamaño, para las muestras de la leyenda y de las compuertas. Es el MISMO
// componente que usa el diagrama: si cambia el dibujo de un símbolo, cambia en
// los tres sitios a la vez.
function muestra(type: BpmnNodeType, alto: number) {
  const { w, h } = sizeOf(type)
  const pad = 3
  const node: PlacedNode = {
    id: `muestra-${type}`,
    type,
    label: '',
    lane: 'l',
    col: 0,
    row: 0,
    cx: w / 2 + pad,
    cy: h / 2 + pad,
    w,
    h,
    lines: [],
    outside: false,
    labelAbove: false,
  }
  const vbW = w + pad * 2
  const vbH = h + pad * 2
  return { node, vbW, vbH, alto, ancho: Math.round((vbW * alto) / vbH) }
}

const ALTO_MUESTRA = 30
const muestras = leyendaBpmn.map((item) => ({ ...item, ...muestra(item.type, ALTO_MUESTRA) }))
// Las compuertas se muestran a escala 1:1 (el rombo mide 42 px más el margen):
// reducidas, el pentágono de la basada en eventos deja de distinguirse del
// círculo, que es justo lo que hay que poder diferenciar aquí.
const compuertas = COMPUERTAS_BPMN.map((c) => ({ ...c, ...muestra(c.type, sizeOf(c.type).h + 6) }))
---

<BaseLayout title="Diagramas BPMN">
  <div class="max-w-[1280px] mx-auto px-6 md:px-12 lg:px-20 pt-32 pb-24">
    <DocsNav />

    <div class="max-w-3xl mb-8">
      <p class="text-[14.5px] text-ink-200 leading-relaxed">
        Los cuatro procesos de negocio del sistema en notación BPMN: cobro de campo, acceso al
        portal de clientes, respuesta de seguridad y ciclo de monitoreo. A diferencia de los
        diagramas de secuencia, aquí lo que se lee es <em>quién</em> hace cada cosa y
        <em>dónde se decide</em> el camino — por eso cada participante tiene su carril y toda
        bifurcación pasa por una compuerta.
      </p>
      <p class="text-[13.5px] text-ink-300 leading-relaxed mt-3">
        El SVG se genera en el servidor desde un modelo tipado
        (<code class="font-mono text-ink-200">src/data/bpmn.ts</code>); las posiciones, el ruteo de
        las flechas y el corte de las etiquetas los calcula{' '}
        <code class="font-mono text-ink-200">src/lib/bpmn-layout.ts</code>, con tests que verifican
        que ninguna flecha atraviese una figura ajena y que ningún nodo quede encimado.
      </p>
    </div>

    <!-- ── Leyenda de la notación ─────────────────────────────────────── -->
    <section class="mb-10">
      <h2 class="text-[12px] font-semibold uppercase tracking-[0.12em] text-ink-200 mb-3">Notación</h2>
      <ul class="bpmn-scope grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-3.5 list-none p-0 m-0">
        {muestras.map((m) => (
          <li class="flex items-center gap-3">
            <span class="shrink-0 grid place-items-center w-[76px]">
              <svg
                width={m.ancho}
                height={ALTO_MUESTRA}
                viewBox={`0 0 ${m.vbW} ${m.vbH}`}
                aria-hidden="true"
                xmlns="http://www.w3.org/2000/svg"
              >
                <BpmnShape node={m.node} />
              </svg>
            </span>
            <span class="min-w-0">
              <span class="block text-[12.5px] text-ink-50 leading-tight">{m.label}</span>
              <span class="block text-[11.5px] text-ink-300 leading-tight mt-0.5">{m.desc}</span>
            </span>
          </li>
        ))}
      </ul>
    </section>

    <!-- ── Las cinco compuertas ───────────────────────────────────────── -->
    <section class="mb-12">
      <h2 class="text-[12px] font-semibold uppercase tracking-[0.12em] text-ink-200 mb-2">Los 5 tipos de compuerta</h2>
      <p class="text-[13.5px] text-ink-300 leading-relaxed max-w-3xl mb-5">
        Las cinco se dibujan con el mismo rombo: lo único que cambia es el marcador de dentro. Ese
        detalle no es decorativo — decide si el proceso sigue por un camino o por varios, y si al
        juntarse espera a los demás o no. De las cinco, estos diagramas solo necesitan la{' '}
        <strong class="font-medium text-ink-100">exclusiva</strong>; las otras cuatro van aquí con
        el ejemplo de dónde encajarían en este sistema, para que se entienda la diferencia.
      </p>

      <ul class="bpmn-scope grid grid-cols-1 lg:grid-cols-2 gap-x-7 gap-y-5 list-none p-0 m-0">
        {compuertas.map((c) => (
          <li class="compuerta rounded-xl bg-ink-800/70 border border-white/10 p-4 transition-colors">
            <div class="flex items-start gap-3.5">
              <span class="shrink-0 grid place-items-center w-[52px] h-[52px] rounded-lg bg-ink-850">
                <svg
                  width={c.ancho}
                  height={c.alto}
                  viewBox={`0 0 ${c.vbW} ${c.vbH}`}
                  aria-hidden="true"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <BpmnShape node={c.node} />
                </svg>
              </span>

              <div class="min-w-0">
                <h3 class="text-[13.5px] font-semibold text-ink-50 leading-tight">
                  Compuerta {c.nombre}
                  {c.alias && <span class="ml-1.5 font-mono text-[11px] text-ink-300">{c.alias}</span>}
                  {c.usada && (
                    <span class="ml-2 align-middle text-[10px] uppercase tracking-[0.08em] text-cyan-dim">
                      en uso
                    </span>
                  )}
                </h3>
                <p class="text-[11.5px] text-ink-400 mt-0.5">Se marca con {c.marcador}.</p>
              </div>
            </div>

            <dl class="mt-3 space-y-1.5 text-[12.5px] leading-relaxed">
              <div class="flex gap-2">
                <dt class="shrink-0 w-[76px] text-ink-400">Al dividir</dt>
                <dd class="m-0 text-ink-100">{c.divergencia}</dd>
              </div>
              <div class="flex gap-2">
                <dt class="shrink-0 w-[76px] text-ink-400">Al juntar</dt>
                <dd class="m-0 text-ink-100">{c.convergencia}</dd>
              </div>
            </dl>

            <p class="mt-2.5 text-[12.5px] text-ink-200 leading-relaxed">
              <span class="inline-block w-1.5 h-1.5 rounded-full bg-cyan-dim align-middle mr-2 -translate-y-px"></span>
              {c.ejemplo}
            </p>
          </li>
        ))}
      </ul>
    </section>

    <!-- ── Procesos ───────────────────────────────────────────────────── -->
    <div class="space-y-12">
      {procesosBpmn.map((p) => (
        <section id={p.id} class="scroll-mt-28">
          <h2 class="text-[15px] font-semibold text-ink-50 mb-1">{p.titulo}</h2>
          <p class="text-[13.5px] text-ink-300 leading-relaxed max-w-3xl mb-1.5">{p.desc}</p>
          <p class="text-[12px] text-ink-400 font-mono mb-3.5 break-words">{p.origen}</p>

          <BpmnDiagram proceso={p} />

          {p.nota && (
            <p class="mt-3 max-w-3xl text-[13px] text-ink-200 leading-relaxed">
              <span class="inline-block w-1.5 h-1.5 rounded-full bg-cyan-dim align-middle mr-2 -translate-y-px"></span>
              {p.nota}
            </p>
          )}
        </section>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  /* Tinte de marca al pasar por encima, en vez de una franja de acento. */
  .compuerta:hover {
    background: color-mix(in srgb, var(--color-cyan-dim) 6%, var(--color-ink-800));
    border-color: color-mix(in srgb, var(--color-cyan-dim) 30%, transparent);
  }
</style>
