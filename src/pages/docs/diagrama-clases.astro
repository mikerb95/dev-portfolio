---
import BaseLayout from '../../layouts/BaseLayout.astro'
import DocsNav from '../../components/DocsNav.astro'

const diagramas = [
  {
    id: 'crm',
    titulo: 'CRM y finanzas',
    src: `classDiagram
    class Client {
      +int id
      +string name
      +string email
      +string company
      +string notes
    }
    class Project {
      +int id
      +string slug
      +string title
      +string techStack
      +string status
      +bool visible
      +Date startDate
      +Date endDate
    }
    class Message {
      +int id
      +string name
      +string email
      +string body
      +bool read
    }
    class Finance {
      +int id
      +decimal amount
      +string status
      +Date dueDate
    }
    class ProjectService {
      +int id
      +string category
      +string provider
      +decimal cost
      +string billingCycle
      +Date renewalDate
      +string payer
      +decimal billedToClient
      +string secrets~cifrado~
    }
    class ProjectEnvVar {
      +string key
      +string value~cifrado~
      +string environment
    }
    class ProjectContact {
      +string name
      +string role
    }
    class ProjectAdr {
      +string title
      +string status
      +string context
      +string decision
      +string rationale
    }
    class Briefing {
      +string title
      +string status
      +decimal estimatedBudget
      +decimal agreedBudget
      +Date deadline
    }
    class BriefingItem {
      +string kind
      +string content
      +bool done
    }
    class Interaction {
      +string type
      +string title
      +string nextAction
      +Date dueDate
      +bool done
    }

    Client "1" --> "*" Project : posee
    Client "1" --> "*" Message : envía
    Client "1" --> "*" Finance : factura
    Project "1" --> "*" Finance
    Project "1" --> "*" ProjectService : consume
    Project "1" --> "*" ProjectEnvVar
    Project "1" --> "*" ProjectContact
    Project "1" --> "*" ProjectAdr
    Project "1" --> "*" Briefing
    Briefing "1" --> "*" BriefingItem
    Client "1" --> "*" Interaction
    Project "1" --> "*" Interaction
    Briefing "1" --> "*" Interaction`,
  },
  {
    id: 'observabilidad',
    titulo: 'Observabilidad y pagos',
    src: `classDiagram
    class Monitor {
      +int id
      +string name
      +string url
      +string expectedText
      +int latencyThresholdMs
      +string lastStatus
      +Date sslExpiresAt
    }
    class MonitorCheck {
      +Date at
      +bool ok
      +int statusCode
      +int responseMs
    }
    class MonitorIncident {
      +Date startedAt
      +Date resolvedAt
      +string cause
      +int durationSec
    }
    class Payment {
      +string reference
      +string idempotencyKey
      +int amountCents
      +string status
      +string provider
      +int version
    }
    class PaymentEvent {
      +string type
      +bool duplicate
      +bool outOfOrder
      +bool amountMismatch
    }

    Monitor "1" --> "*" MonitorCheck : registra
    Monitor "1" --> "*" MonitorIncident : agrupa
    Payment "1" --> "*" PaymentEvent : recibe`,
  },
  {
    id: 'seguridad',
    titulo: 'Seguridad (micro-SIEM)',
    src: `classDiagram
    class SecurityEvent {
      +Date at
      +string ipHash
      +string path
      +string category
      +string severity
      +string action
      +int hits
    }
    class SecurityRollup {
      +string bucket
      +Date at
      +string category
      +int count
      +int uniqueIps
    }
    class SecurityAnomaly {
      +Date at
      +string kind
      +decimal zScore
      +decimal baseline
      +bool notified
      +bool acknowledged
    }

    SecurityEvent "*" --> "1" SecurityRollup : agrega
    SecurityRollup ..> SecurityAnomaly : detecta baseline`,
  },
]
---

<BaseLayout title="Diagrama de clases">
  <div class="max-w-[1280px] mx-auto px-6 md:px-12 lg:px-20 pt-32 pb-24">
  <DocsNav />

  <div class="max-w-3xl mb-6">
    <p class="text-[14.5px] text-ink-200 leading-relaxed">
      Entidades del dominio derivadas directamente de <span class="font-mono text-cyan">src/db/schema.ts</span>,
      agrupadas por módulo para mantener cada diagrama legible.
    </p>
  </div>

  <div class="space-y-10">
    {diagramas.map((d) => (
      <section>
        <h2 class={`text-[14.5px] font-semibold text-ink-50 ${d.nota ? 'mb-1' : 'mb-3'}`}>{d.titulo}</h2>
        {d.nota && <p class="text-[13px] text-ink-300 mb-3">{d.nota}</p>}
        <div class="rounded-xl border border-white/15 bg-ink-800 p-4 overflow-x-auto">
          <pre class="mermaid">{d.src}</pre>
        </div>
      </section>
    ))}
  </div>
  </div>
</BaseLayout>

<script>
  import mermaid from 'mermaid'
  mermaid.initialize({
    startOnLoad: false,
    theme: 'dark',
    securityLevel: 'loose',
    themeVariables: {
      background: '#13131a',
      primaryColor: '#1c1c26',
      primaryTextColor: '#e7e7ec',
      primaryBorderColor: '#6a6a7a',
      lineColor: '#c4c4cc',
      secondaryColor: '#171720',
      tertiaryColor: '#0e0e12',
      textColor: '#e7e7ec',
      edgeLabelBackground: '#13131a',
      classText: '#e7e7ec',
    },
  })

  // Mermaid traza las relaciones con curvas suaves y pinta todas las clases
  // del mismo color. La notación de clases de manual usa segmentos rectos y
  // distingue las cajas por su papel en el modelo, así que se retoca el SVG
  // recién renderizado: no hay forma de pedirle ninguna de las dos cosas por
  // configuración sin cambiar de motor de layout.
  const CODO = 18

  // Tinte por papel estructural, deducido de las propias relaciones: quién
  // manda (solo origen), quién depende (solo destino) y quién hace de puente.
  const TINTES = {
    raiz: { fill: '#1b2434', stroke: '#5c7391' },
    puente: { fill: '#241f31', stroke: '#7a6a99' },
    hoja: { fill: '#1a2a23', stroke: '#5c8f76' },
  }

  function rolesDe(fuente: string) {
    const origen = new Set<string>()
    const destino = new Set<string>()
    for (const linea of fuente.split('\n')) {
      const m = linea.match(/^\s*(\w+)\s+(?:"[^"]*"\s*)?[-.<>o*|]{2,}\s*(?:"[^"]*"\s*)?(\w+)/)
      if (!m || /^\s*class\b/.test(linea)) continue
      origen.add(m[1])
      destino.add(m[2])
    }
    return (nombre: string) => {
      const esOrigen = origen.has(nombre)
      const esDestino = destino.has(nombre)
      if (esOrigen && esDestino) return TINTES.puente
      if (esDestino) return TINTES.hoja
      return TINTES.raiz
    }
  }

  // Ruta en escuadra entre los extremos del trazo original: se conserva de
  // dónde sale y a dónde llega (y por tanto el ángulo de la punta de flecha),
  // solo cambia el camino intermedio.
  function ortogonalizar(path: SVGPathElement) {
    const largo = path.getTotalLength()
    if (!largo) return
    const a = path.getPointAtLength(0)
    const b = path.getPointAtLength(largo)
    // Dirección de salida y de llegada, para decidir si el primer tramo es
    // vertical u horizontal y que la flecha no entre de costado a la caja.
    const salida = path.getPointAtLength(Math.min(CODO, largo / 3))
    const llegada = path.getPointAtLength(Math.max(largo - CODO, (largo * 2) / 3))
    const verticalSale = Math.abs(salida.y - a.y) >= Math.abs(salida.x - a.x)
    const verticalLlega = Math.abs(b.y - llegada.y) >= Math.abs(b.x - llegada.x)

    let d
    if (verticalSale && verticalLlega) {
      const my = (a.y + b.y) / 2
      d = `M${a.x},${a.y} L${a.x},${my} L${b.x},${my} L${b.x},${b.y}`
    } else if (!verticalSale && !verticalLlega) {
      const mx = (a.x + b.x) / 2
      d = `M${a.x},${a.y} L${mx},${a.y} L${mx},${b.y} L${b.x},${b.y}`
    } else if (verticalSale) {
      d = `M${a.x},${a.y} L${a.x},${b.y} L${b.x},${b.y}`
    } else {
      d = `M${a.x},${a.y} L${b.x},${a.y} L${b.x},${b.y}`
    }
    path.setAttribute('d', d)
  }

  const fuentes = [...document.querySelectorAll('pre.mermaid')].map((el) => el.textContent ?? '')
  await mermaid.run()

  document.querySelectorAll<SVGSVGElement>('svg[id^="mermaid"]').forEach((svg, i) => {
    const rol = rolesDe(fuentes[i] ?? '')

    svg.querySelectorAll<SVGGElement>('g.node').forEach((nodo) => {
      const nombre = nodo.id.match(/classId-(.+?)-\d+$/)?.[1]
      if (!nombre) return
      const { fill, stroke } = rol(nombre)
      // El contorno de la caja es un path dentro de g.label-container; los
      // g.divider son los separadores entre compartimentos y se dejan como
      // están, que es lo que mantiene legible la división en tres bandas.
      nodo.querySelectorAll<SVGElement>('g.label-container path, g.label-container rect').forEach((forma) => {
        forma.style.fill = fill
        forma.style.stroke = stroke
      })
    })

    svg.querySelectorAll<SVGPathElement>('.edgePaths path, path.relation').forEach(ortogonalizar)
  })
</script>

<style>
  .mermaid { display: flex; justify-content: center; }
</style>
