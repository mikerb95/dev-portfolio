---
import BaseLayout from '../../layouts/BaseLayout.astro'
import DocsNav from '../../components/DocsNav.astro'
import ActivityDiagram from '../../components/uml/ActivityDiagram.astro'
import ActivityShape from '../../components/uml/ActivityShape.astro'
import { ACTIVIDADES } from '../../data/actividades'
import { sizeOf, type PlacedActivityNode, type UmlActivityNodeType } from '../../lib/uml-activity'

// La leyenda no dibuja iconos aparte: monta el MISMO componente de figura que
// el diagrama. Si un símbolo cambia, cambia en los dos sitios — una leyenda que
// se desincroniza del dibujo es peor que no tenerla.
const LEYENDA: { type: UmlActivityNodeType; label: string; desc: string }[] = [
  { type: 'initial', label: 'Nodo inicial', desc: 'Círculo relleno. Donde arranca la actividad; no admite transiciones entrantes.' },
  { type: 'action', label: 'Acción', desc: 'Rectángulo de esquinas redondeadas: un paso ejecutable.' },
  { type: 'decision', label: 'Decisión', desc: 'Rombo con una entrada y varias salidas, cada una con su guarda entre corchetes.' },
  { type: 'merge', label: 'Unión de decisión', desc: 'El mismo rombo al revés: varias entradas, una sola salida sin guarda.' },
  { type: 'fork', label: 'Bifurcación', desc: 'Barra que reparte el control en ramas concurrentes.' },
  { type: 'join', label: 'Unión concurrente', desc: 'La misma barra sincronizando: no sigue hasta que llegan todas las ramas.' },
  { type: 'sendSignal', label: 'Envío de señal', desc: 'Pentágono con la punta hacia fuera: el sistema notifica.' },
  { type: 'acceptEvent', label: 'Recepción de evento', desc: 'Pentágono con la muesca: el sistema espera algo de fuera.' },
  { type: 'activityFinal', label: 'Final de actividad', desc: 'Diana. Termina la actividad completa, incluidas las ramas vivas.' },
  { type: 'flowFinal', label: 'Final de flujo', desc: 'Círculo con aspa. Termina ESTA rama y deja la actividad corriendo.' },
]

const ALTO = 34

/** Encierra una figura suelta en un lienzo mínimo, centrada, para la leyenda. */
function muestra(type: UmlActivityNodeType) {
  const { w, h } = sizeOf(type)
  const vbW = w + 8
  const vbH = h + 8
  const node: PlacedActivityNode = {
    id: `muestra-${type}`,
    type,
    particion: 'muestra',
    fila: 0,
    cx: vbW / 2,
    cy: vbH / 2,
    w,
    h,
    lines: [],
    labelX: vbW / 2,
    labelY: vbH / 2,
    labelAlign: 'middle',
  }
  return { node, vbW, vbH, ancho: Math.round((vbW / vbH) * ALTO) }
}

const muestras = LEYENDA.map((item) => ({ ...item, ...muestra(item.type) }))
---

<BaseLayout title="Diagrama de actividades">
  <div class="max-w-[1280px] mx-auto px-6 md:px-12 lg:px-20 pt-32 pb-24">
    <DocsNav />

    <div class="max-w-3xl mb-8">
      <p class="text-[14.5px] text-ink-200 leading-relaxed">
        Tres flujos de control internos en notación de actividades UML 2.5.1. No repiten lo que ya
        está en <a href="/docs/diagrama-bpmn" class="text-cyan-dim hover:text-cyan transition-colors underline underline-offset-4 decoration-cyan-dim/40">los diagramas BPMN</a>:
        aquellos documentan procesos de negocio —quién habla con quién para cobrar, para dar acceso,
        para responder a un incidente—; estos documentan <em>algoritmos</em>, que es donde esta
        notación aporta lo que BPMN no tiene tan a mano: la rama concurrente que nunca se vuelve a
        unir y el bucle de reintento.
      </p>
      <p class="text-[13.5px] text-ink-300 leading-relaxed mt-3">
        El SVG se genera en el servidor desde un modelo tipado
        (<code class="font-mono text-ink-200">src/data/actividades.ts</code>); las posiciones, el
        ruteo y el corte de etiquetas los calcula
        <code class="font-mono text-ink-200">src/lib/uml-activity.ts</code>. Los tests no solo
        verifican el dibujo (nada encimado, ninguna transición atravesando una figura ajena):
        también verifican la <strong class="font-medium text-ink-100">notación</strong> — que toda
        decisión tenga al menos dos salidas y todas con guarda, que una unión tenga una sola salida,
        que ningún nodo final tenga transiciones salientes y que no queden nodos inalcanzables.
      </p>
      <p class="text-[13.5px] text-ink-300 leading-relaxed mt-3">
        No se usó Mermaid a propósito: su <code class="font-mono text-ink-200">flowchart</code> no es
        notación de actividad —no tiene barra de bifurcación, ni particiones, ni distingue el final
        de flujo del final de actividad—, y esas tres cosas son justo lo que estos diagramas afirman.
      </p>
    </div>

    <!-- ── Leyenda de la notación ─────────────────────────────────────── -->
    <section class="mb-12">
      <h2 class="text-[12px] font-semibold uppercase tracking-[0.12em] text-ink-200 mb-3">Notación</h2>
      <ul class="uml-scope grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3.5 list-none p-0 m-0">
        {muestras.map((m) => (
          <li class="flex items-center gap-3">
            <span class="shrink-0 grid place-items-center w-[92px]">
              <svg width={m.ancho} height={ALTO} viewBox={`0 0 ${m.vbW} ${m.vbH}`} aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                <ActivityShape node={m.node} />
              </svg>
            </span>
            <span class="min-w-0">
              <span class="block text-[12.5px] text-ink-50 leading-tight">{m.label}</span>
              <span class="block text-[11.5px] text-ink-300 leading-tight mt-0.5">{m.desc}</span>
            </span>
          </li>
        ))}
      </ul>
    </section>

    <!-- ── Actividades ────────────────────────────────────────────────── -->
    <div class="space-y-12">
      {ACTIVIDADES.map((a) => (
        <section id={a.id} class="scroll-mt-28">
          <h2 class="text-[15px] font-semibold text-ink-50 mb-1">{a.titulo}</h2>
          <p class="text-[13.5px] text-ink-300 leading-relaxed max-w-3xl mb-1.5">{a.desc}</p>
          <p class="text-[12px] text-ink-400 font-mono mb-3.5 break-words">{a.origen}</p>

          <div class="rounded-xl border border-white/15 bg-ink-800 p-3 overflow-x-auto">
            <ActivityDiagram model={a} />
          </div>

          {a.nota && (
            <p class="mt-3 max-w-3xl text-[13px] text-ink-200 leading-relaxed">
              <span class="inline-block w-1.5 h-1.5 rounded-full bg-cyan-dim align-middle mr-2 -translate-y-px" />
              {a.nota}
            </p>
          )}
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
