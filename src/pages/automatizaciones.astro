---
// Lo que corre solo: workflows de GitHub Actions, tareas programadas y los
// automatismos que dispara el propio tráfico.
//
// Página PÚBLICA, mismo criterio OPSEC que /status: solo agregados y
// descripciones. Nada de rutas señuelo, umbrales de bloqueo ni nombres de
// reglas de detección. El catálogo vive en `src/data/automatizaciones.ts`; aquí
// solo se cruza con el estado real.
//
// FAIL-OPEN en las dos fuentes. Si la API de GitHub no responde (cuota, caída)
// o la base no contesta, la sección se pinta con lo que hay y se dice que no se
// pudo leer. Una página de observabilidad que devuelve 500 cuando lo observado
// falla no sirve para nada, que es justo cuando más se mira.
import BaseLayout from '../layouts/BaseLayout.astro'
import { getDictionary, getLocaleFromUrl, localizedHref } from '../i18n'
import { db } from '../db'
import { cronRuns } from '../db/schema'
import { desc } from 'drizzle-orm'
import { mapRunEstado } from '../lib/lab/pipeline-live'
import { safeQuery } from '../lib/safe-query'
import { serverEnv } from '../lib/env'
import { WORKFLOWS, CRONS, AUTOMATISMOS } from '../data/automatizaciones'

const locale = getLocaleFromUrl(Astro.url.pathname)
const t = getDictionary(locale)
const L = (path: string) => localizedHref(path, locale)

const REPO = 'mikerb95/dev-portfolio'

type GhRun = {
  name: string | null
  status: string | null
  conclusion: string | null
  created_at: string
  html_url: string | null
  event: string | null
}

// UNA sola petición para los seis workflows: se piden las últimas corridas de
// `main` y se reduce a la más reciente de cada nombre. Pedir el último run
// workflow por workflow serían seis peticiones contra una cuota de 60/hora sin
// token, y esta página la puede abrir cualquiera.
let runs: GhRun[] = []
let githubOk = true
try {
  const token = serverEnv('GITHUB_API_TOKEN')
  const res = await fetch(
    `https://api.github.com/repos/${REPO}/actions/runs?branch=main&per_page=40`,
    {
      headers: {
        Accept: 'application/vnd.github+json',
        ...(token ? { Authorization: `Bearer ${token}` } : {}),
      },
    }
  )
  if (res.ok) {
    runs = ((await res.json()) as { workflow_runs?: GhRun[] }).workflow_runs ?? []
  } else {
    githubOk = false
  }
} catch {
  githubOk = false
}

const ultimoRun = new Map<string, GhRun>()
for (const r of runs) {
  if (r.name && !ultimoRun.has(r.name)) ultimoRun.set(r.name, r)
}

// Bitácora de crons: las últimas filas por fecha, reducidas en memoria a la
// última de cada job. Con LIMIT sobre el índice de fecha son ~150 filas
// escaneadas, no la tabla entera (Turso factura filas escaneadas).
type Fila = { job: string; ok: boolean; durationMs: number | null; createdAt: Date | null }

// `safeQuery` y no un try/catch propio: es el patrón del repo para el render de
// páginas públicas, y deja el fallo en el log del servidor en vez de tragárselo.
// Cubre también el caso "la migración todavía no se aplicó": la página se sirve
// igual y la sección lo dice.
const filasOrNull = await safeQuery<Fila[] | null>(
  () =>
    db
      .select({
        job: cronRuns.job,
        ok: cronRuns.ok,
        durationMs: cronRuns.durationMs,
        createdAt: cronRuns.createdAt,
      })
      .from(cronRuns)
      .orderBy(desc(cronRuns.createdAt))
      .limit(150) as Promise<Fila[]>,
  null,
  'automatizaciones: bitácora de crons'
)
// `null` distingue "la consulta falló" de "la tabla existe pero aún no tiene
// filas": son dos cosas distintas y solo la primera es un aviso.
const bitacoraOk = filasOrNull !== null
const filas = filasOrNull ?? []

const ultimaEjecucion = new Map<string, Fila>()
for (const f of filas) {
  if (!ultimaEjecucion.has(f.job)) ultimaEjecucion.set(f.job, f)
}

function haceCuanto(d: Date | null | undefined): string | null {
  if (!d) return null
  const min = Math.floor((Date.now() - d.getTime()) / 60000)
  if (min < 1) return 'hace un momento'
  if (min < 60) return `hace ${min} min`
  const h = Math.floor(min / 60)
  if (h < 24) return `hace ${h} h`
  return `hace ${Math.floor(h / 24)} d`
}

// Mismo criterio cromático que /status y /engineering: lima lo sano, ámbar lo
// que exige mirar, cian lo que está en curso. El acento no se inventa por página.
const ESTADO_CLS: Record<string, string> = {
  ok: 'text-lime border-lime/30 bg-lime/10',
  fail: 'text-ember border-ember/40 bg-ember/15',
  in_progress: 'text-cyan border-cyan/30 bg-cyan/10',
  pending: 'text-ink-200 border-white/10 bg-white/5',
  skip: 'text-ink-300 border-white/10 bg-white/5',
}

const ETIQUETA_DISPARADOR: Record<string, string> = {
  push: 'en cada push',
  pull_request: 'en cada pull request',
  semanal: 'semanal',
  manual: 'a mano',
  vercel: 'cron de Vercel',
  externo: 'cron externo',
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=600')
---


<BaseLayout
  title="Automatizaciones"
  description="Lo que corre solo en codebymike.net: integración continua, tareas programadas y los automatismos que dispara el propio tráfico, con su último resultado real."
>
  <div class="max-w-[1280px] mx-auto px-6 md:px-12 lg:px-20 pt-32 pb-24">
    <a
      href={L('/')}
      class="inline-flex items-center gap-2 text-[11px] font-mono uppercase tracking-[.2em] text-ink-300 hover:text-cyan transition-colors mb-12"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
      {t.common.back}
    </a>

    <header class="mb-12">
      <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-6">
        <span class="text-cyan">/automatizaciones</span>
        <span class="h-px flex-1 bg-gradient-to-r from-white/15 to-transparent max-w-[80px]"></span>
        <span>Ingeniería</span>
      </div>
      <h1 class="hero-line text-5xl md:text-6xl font-medium tracking-[-.035em] text-mask leading-[.95] mb-8">
        Lo que corre<br />solo.
      </h1>
      <p class="text-[16px] text-ink-100 max-w-2xl leading-relaxed">
        Seis workflows de integración continua, diez tareas programadas y los automatismos que
        dispara el propio tráfico. Abajo está el <em>último resultado real</em> de cada uno,
        leído de GitHub y de mi propia bitácora.
        <span class="text-ink-300"> No es una descripción de cómo debería funcionar.</span>
      </p>
    </header>

    <!-- ── Integración continua ── -->
    <section class="mb-14">
      <div class="flex items-baseline justify-between gap-4 mb-5">
        <h2 class="text-[13px] font-mono uppercase tracking-[.2em] text-ink-200">Integración continua</h2>
        {!githubOk && <span class="text-[11px] font-mono text-ember">GitHub no responde</span>}
      </div>
      <p class="text-[13px] text-ink-300 max-w-2xl leading-relaxed mb-5">
        Nada llega a producción sin pasar por aquí. La verificación posterior al despliegue puede
        revertir sola lo que acaba de publicarse.
      </p>

      <div class="grid md:grid-cols-2 gap-3">
        {
          WORKFLOWS.map((w) => {
            const run = ultimoRun.get(w.nombre)
            const estado = run ? mapRunEstado(run.status, run.conclusion) : null
            return (
              <div class="rounded-2xl glass p-5 hover:border-cyan/25 transition-colors">
                <div class="flex items-center justify-between gap-3 mb-3">
                  <span class="text-[13px] font-mono font-semibold text-ink-50">{w.nombre}</span>
                  {estado && (
                    <span
                      class={`px-1.5 py-0.5 rounded-full text-[9px] font-mono uppercase tracking-wider border ${ESTADO_CLS[estado] ?? ESTADO_CLS.pending}`}
                    >
                      {estado}
                    </span>
                  )}
                </div>
                <p class="text-[13px] text-ink-100 leading-relaxed mb-2">{w.hace}</p>
                {w.detalle && <p class="text-[12px] text-ink-300 leading-relaxed mb-3">{w.detalle}</p>}
                <div class="flex items-center gap-3 text-[10px] font-mono uppercase tracking-[.12em] text-ink-400 pt-3 border-t border-white/[.06]">
                  <span>{w.disparadores.map((d) => ETIQUETA_DISPARADOR[d] ?? d).join(' · ')}</span>
                  {run?.created_at && <span class="text-ink-300">{haceCuanto(new Date(run.created_at))}</span>}
                  <span class="ml-auto normal-case tracking-normal">{w.archivo}</span>
                </div>
              </div>
            )
          })
        }
      </div>
    </section>

    <!-- ── Tareas programadas ── -->
    <section class="mb-14">
      <div class="flex items-baseline justify-between gap-4 mb-5">
        <h2 class="text-[13px] font-mono uppercase tracking-[.2em] text-ink-200">Tareas programadas</h2>
        {!bitacoraOk && <span class="text-[11px] font-mono text-ink-400">bitácora no disponible</span>}
      </div>
      <p class="text-[13px] text-ink-300 max-w-2xl leading-relaxed mb-5">
        El plan que uso permite una ejecución diaria por tarea, así que lo que necesita más
        frecuencia lo dispara un programador externo contra el mismo endpoint, con el mismo secreto.
        Cada ejecución autorizada queda anotada: un cron que deja de dispararse no produce un error,
        produce silencio.
      </p>

      <div class="rounded-2xl glass overflow-x-auto">
        <table class="w-full min-w-[46rem] text-left">
          <thead>
            <tr class="border-b border-white/[.06]">
              <th class="text-[10px] font-mono uppercase tracking-[.15em] text-ink-400 font-medium px-5 py-3">Tarea</th>
              <th class="text-[10px] font-mono uppercase tracking-[.15em] text-ink-400 font-medium px-3 py-3">Cuándo</th>
              <th class="text-[10px] font-mono uppercase tracking-[.15em] text-ink-400 font-medium px-3 py-3">Origen</th>
              <th class="text-[10px] font-mono uppercase tracking-[.15em] text-ink-400 font-medium px-3 py-3">Qué hace</th>
              <th class="text-[10px] font-mono uppercase tracking-[.15em] text-ink-400 font-medium px-5 py-3">Última</th>
            </tr>
          </thead>
          <tbody>
            {
              CRONS.map((c) => {
                const u = ultimaEjecucion.get(c.job)
                return (
                  <tr class="border-b border-white/[.04] last:border-0">
                    <td class="px-5 py-4 align-top font-mono text-[12px] text-ink-50 whitespace-nowrap">{c.job}</td>
                    <td class="px-3 py-4 align-top font-mono text-[12px] text-ink-200 whitespace-nowrap tabular-nums">{c.horario}</td>
                    <td class="px-3 py-4 align-top">
                      <span
                        class={`px-1.5 py-0.5 rounded-full text-[9px] font-mono uppercase tracking-wider border whitespace-nowrap ${
                          c.origen === 'vercel'
                            ? 'text-ink-200 border-white/10 bg-white/5'
                            : 'text-violet border-violet/30 bg-violet/10'
                        }`}
                      >
                        {c.origen}
                      </span>
                    </td>
                    <td class="px-3 py-4 align-top max-w-[30rem]">
                      <span class="text-[13px] text-ink-100 leading-relaxed">{c.hace}</span>
                      <span class="block text-[12px] text-ink-400 leading-relaxed mt-1">Si falla: {c.siFalla}</span>
                    </td>
                    <td class="px-5 py-4 align-top font-mono text-[12px] whitespace-nowrap">
                      {u ? (
                        <span class={u.ok ? 'text-lime' : 'text-ember'}>{haceCuanto(u.createdAt)}</span>
                      ) : (
                        <span class="text-ink-400">sin registro</span>
                      )}
                    </td>
                  </tr>
                )
              })
            }
          </tbody>
        </table>
      </div>
    </section>

    <!-- ── Automatismos del producto ── -->
    <section>
      <h2 class="text-[13px] font-mono uppercase tracking-[.2em] text-ink-200 mb-5">Automatismos del producto</h2>
      <p class="text-[13px] text-ink-300 max-w-2xl leading-relaxed mb-5">
        Estos no los dispara un calendario ni un push, sino el propio tráfico.
      </p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {
          AUTOMATISMOS.map((a) => (
            <div class="rounded-2xl glass p-5 hover:border-cyan/25 transition-colors">
              <h3 class="text-[13px] font-medium text-ink-50 mb-2">{a.nombre}</h3>
              <p class="text-[13px] text-ink-100 leading-relaxed mb-3">{a.hace}</p>
              <span class="text-[10px] font-mono uppercase tracking-[.12em] text-ink-400">{a.cuando}</span>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
