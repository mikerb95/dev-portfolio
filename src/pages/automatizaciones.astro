---
// Lo que corre solo: workflows de GitHub Actions, tareas programadas y los
// automatismos que dispara el propio tráfico.
//
// Página PÚBLICA, mismo criterio OPSEC que /status: solo agregados y
// descripciones. Nada de rutas señuelo, umbrales de bloqueo ni nombres de
// reglas de detección. El catálogo vive en `src/data/automatizaciones.ts`; aquí
// solo se cruza con el estado real.
//
// FAIL-OPEN en las dos fuentes. Si la API de GitHub no responde (cuota, caída)
// o la base no contesta, la sección se pinta con lo que hay y se dice que no se
// pudo leer. Una página de observabilidad que devuelve 500 cuando lo observado
// falla no sirve para nada, que es justo cuando más se mira.
import BaseLayout from '../layouts/BaseLayout.astro'
import { getDictionary, getLocaleFromUrl, interpolate, localizedHref, tx } from '../i18n'
import { db } from '../db'
import { cronRuns } from '../db/schema'
import { desc, gte } from 'drizzle-orm'
import { mapRunEstado } from '../lib/lab/pipeline-live'
import { safeQuery } from '../lib/safe-query'
import { serverEnv } from '../lib/env'
import { jsonEnScript } from '../lib/json-script'
import { WORKFLOWS, CRONS, AUTOMATISMOS } from '../data/automatizaciones'
import type { Bilingual, BilingualOptional } from '../i18n/bilingual'
import { toleranciaMin } from '../lib/cron-silencio'
import { consumoTolerancia, construirPartitura, estadoFila, type Corrida } from '../lib/motion/partitura'
import Partitura from '../components/automatizaciones/Partitura.astro'
import DisparadoresCI from '../components/automatizaciones/DisparadoresCI.astro'
import EscenaAutomatismo from '../components/automatizaciones/EscenaAutomatismo.astro'

const locale = getLocaleFromUrl(Astro.url.pathname)
const t = getDictionary(locale)
const a = t.automatizaciones
const L = (path: string) => localizedHref(path, locale)
// Traduce un campo del catálogo al idioma de la página, cayendo al español.
// Con sobrecargas para conservar la distinción de `tx`: un campo obligatorio
// siempre devuelve texto, y solo uno opcional puede venir vacío.
function T(value: Bilingual): string
function T(value: BilingualOptional): string | undefined
function T(value: BilingualOptional): string | undefined {
  return tx(value, locale)
}

// Las dos cifras de la entradilla se cuentan, no se escriben (RNF-14). Los
// crons se cuentan por job distinto y no por fila: `uptime-check` aparece dos
// veces porque tiene dos disparadores, pero es una sola tarea.
const totalWorkflows = WORKFLOWS.length
const totalCrons = new Set(CRONS.map((c) => c.job)).size

const REPO = 'mikerb95/dev-portfolio'

type GhRun = {
  name: string | null
  status: string | null
  conclusion: string | null
  created_at: string
  html_url: string | null
  event: string | null
}

// UNA sola petición para los seis workflows: se piden las últimas corridas de
// `main` y se reduce a la más reciente de cada nombre. Pedir el último run
// workflow por workflow serían seis peticiones contra una cuota de 60/hora sin
// token, y esta página la puede abrir cualquiera.
let runs: GhRun[] = []
let githubOk = true
try {
  const token = serverEnv('GITHUB_API_TOKEN')
  const res = await fetch(
    `https://api.github.com/repos/${REPO}/actions/runs?branch=main&per_page=40`,
    {
      headers: {
        Accept: 'application/vnd.github+json',
        ...(token ? { Authorization: `Bearer ${token}` } : {}),
      },
    }
  )
  if (res.ok) {
    runs = ((await res.json()) as { workflow_runs?: GhRun[] }).workflow_runs ?? []
  } else {
    githubOk = false
  }
} catch {
  githubOk = false
}

const ultimoRun = new Map<string, GhRun>()
for (const r of runs) {
  if (r.name && !ultimoRun.has(r.name)) ultimoRun.set(r.name, r)
}

// Bitácora de crons: un rango de 48 h sobre el índice de fecha.
//
// Antes eran las últimas 150 filas, y con el sondeo cada 5 min y el agregado
// cada 15 eso daba unas 9 h de historia: todos los diarios salían "sin
// registro" aunque corrían, justo en la página que promete el último
// resultado real. 48 h cubren la tolerancia más larga (36 h de un diario, ver
// `toleranciaMin`), así que la tabla puede acusar un silencio de verdad, y de
// paso alimentan la partitura y su simulacro.
//
// Coste: ~800 filas por render (Turso factura filas escaneadas), cacheadas 5
// min en la CDN; la misma magnitud que la cinta de la portada lee en 24 h. El
// LIMIT es el techo si alguien añade crons frecuentes: si se alcanza, la
// ventana efectiva se mide y nada se acusa sin historia suficiente.
const VENTANA_H = 48
const TECHO_FILAS = 1400
type Fila = { job: string; ok: boolean; durationMs: number | null; createdAt: Date | null }

const ahora = Date.now()
// `safeQuery` y no un try/catch propio: es el patrón del repo para el render de
// páginas públicas, y deja el fallo en el log del servidor en vez de tragárselo.
// Cubre también el caso "la migración todavía no se aplicó": la página se sirve
// igual y la sección lo dice.
const filasOrNull = await safeQuery<Fila[] | null>(
  () =>
    db
      .select({
        job: cronRuns.job,
        ok: cronRuns.ok,
        durationMs: cronRuns.durationMs,
        createdAt: cronRuns.createdAt,
      })
      .from(cronRuns)
      .where(gte(cronRuns.createdAt, new Date(ahora - VENTANA_H * 3_600_000)))
      .orderBy(desc(cronRuns.createdAt))
      .limit(TECHO_FILAS) as Promise<Fila[]>,
  null,
  'automatizaciones: bitácora de crons'
)
// `null` distingue "la consulta falló" de "la tabla existe pero aún no tiene
// filas": son dos cosas distintas y solo la primera es un aviso.
const bitacoraOk = filasOrNull !== null
const filas = filasOrNull ?? []
const corridas: Corrida[] = filas
  .filter((f) => f.createdAt)
  .map((f) => ({ job: f.job, at: f.createdAt!.getTime(), ok: f.ok, ms: f.durationMs }))
// Cuánta historia se leyó de verdad: toda la ventana, salvo que el techo haya
// cortado la consulta antes.
const ventanaLeidaMin =
  filas.length >= TECHO_FILAS && corridas.length
    ? (ahora - corridas[corridas.length - 1].at) / 60000
    : bitacoraOk
      ? VENTANA_H * 60
      : 0

const partitura = construirPartitura(corridas, CRONS, ahora)

const ultimaEjecucion = new Map<string, Corrida>()
for (const c of corridas) {
  if (!ultimaEjecucion.has(c.job)) ultimaEjecucion.set(c.job, c)
}

function haceCuanto(at: number | null | undefined): string | null {
  if (!at) return null
  const min = Math.floor((ahora - at) / 60000)
  if (min < 1) return a.agoJustNow
  if (min < 60) return interpolate(a.agoMinutes, { n: min })
  const h = Math.floor(min / 60)
  if (h < 24) return interpolate(a.agoHours, { n: h })
  return interpolate(a.agoDaysShort, { n: Math.floor(h / 24) })
}

// La página y la alerta usan la MISMA definición de silencio (`toleranciaMin`,
// vía `estadoFila`): si divergieran, la tabla diría que todo va bien mientras
// el push dice lo contrario, y la que se cree es siempre la que se está mirando.
const durTol = (min: number) =>
  min >= 60
    ? interpolate(a.motion.dur, { h: Math.floor(min / 60), m: min % 60 }).replace(/ 0 min$/, '')
    : interpolate(a.motion.durMin, { m: min })

Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=600')

const m = a.motion
// Lo que el selector de CI pinta como "última real" de cada workflow, ya
// resuelto: estado, hace cuánto y el enlace a la corrida en GitHub.
const ultimosCI = Object.fromEntries(
  [...ultimoRun].map(([nombre, r]) => [
    nombre,
    { estado: mapRunEstado(r.status, r.conclusion), hace: haceCuanto(new Date(r.created_at).getTime()), url: r.html_url },
  ])
)
// Lo que necesita el navegador para que "hace 3 min" siga contando mientras la
// página está abierta: el instante de la última corrida y la tolerancia.
const ESTADO_FILA_CLS = { ok: 'text-lime', fallo: 'text-ember', silencio: 'text-ember', 'sin-registro': 'text-ink-400' } as const
---


<BaseLayout title={a.title} description={a.description}>
  <div class="max-w-[1280px] mx-auto px-6 md:px-12 lg:px-20 pt-32 pb-24" data-locale={locale}>
    <a
      href={L('/')}
      class="inline-flex items-center gap-2 text-[11px] font-mono uppercase tracking-[.2em] text-ink-300 hover:text-cyan transition-colors mb-12"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
      {t.common.back}
    </a>

    <header class="au-hero mb-10">
      <div>
        <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-6" data-hero-sigue>
          <span class="text-cyan">/automatizaciones</span>
          <span class="h-px flex-1 bg-gradient-to-r from-white/15 to-transparent max-w-[80px]"></span>
          <span>{a.eyebrow}</span>
        </div>
        <h1 class="text-5xl md:text-6xl xl:text-[68px] font-medium tracking-[-.035em] leading-[.95]">
          <span data-hero-linea class="block text-ink-50">{a.h1Line1}</span>{' '}
          <span data-hero-linea class="block text-cyan">{a.h1Line2}</span>
        </h1>
      </div>
      <p class="text-[15.5px] text-ink-100 max-w-xl leading-relaxed" data-hero-sigue>
        {interpolate(a.intro, { workflows: totalWorkflows, crons: totalCrons })}{' '}
        <em>{a.introEm}</em>{' '}{a.introMid}
        <span class="text-ink-300"> {a.introTail}</span>
      </p>
    </header>

    <div class="mb-28" data-hero-pieza>
      <Partitura partitura={partitura} corridas={corridas} ok={bitacoraOk} />
    </div>

    <!-- ── Integración continua ── -->
    <section class="mb-28" aria-labelledby="au-ci-titulo">
      <div class="flex items-baseline justify-between gap-4 mb-4">
        <p class="text-[11px] font-mono uppercase tracking-[.2em] text-ink-200">{a.ci.heading}</p>
        {!githubOk && <span class="text-[11px] font-mono text-ember">{a.ci.githubDown}</span>}
      </div>
      <h2 id="au-ci-titulo" data-titular class="text-3xl md:text-5xl font-medium tracking-[-.025em] text-ink-50 leading-[1.05] mb-5 max-w-3xl">
        {m.ci.titulo}
      </h2>
      <p class="text-[14px] text-ink-300 max-w-2xl leading-relaxed mb-10">{a.ci.intro}</p>
      <DisparadoresCI ultimos={ultimosCI} />
    </section>

    <!-- ── Tareas programadas ── -->
    <section class="mb-28" aria-labelledby="au-crons-titulo">
      <div class="flex items-baseline justify-between gap-4 mb-4">
        <p class="text-[11px] font-mono uppercase tracking-[.2em] text-ink-200">{a.crons.heading}</p>
        {!bitacoraOk && <span class="text-[11px] font-mono text-ink-400">{a.crons.logUnavailable}</span>}
      </div>
      <h2 id="au-crons-titulo" data-titular class="text-3xl md:text-5xl font-medium tracking-[-.025em] text-ink-50 leading-[1.05] mb-5 max-w-3xl">
        {m.crons.titulo}
      </h2>
      <p class="text-[14px] text-ink-300 max-w-2xl leading-relaxed mb-10">{a.crons.intro}</p>

      <div class="au-tabla rounded-2xl glass" data-tabla-crons>
        <table class="w-full text-left">
          <thead>
            <tr>
              <th class="au-th pl-5">{a.crons.colTask}</th>
              <th class="au-th">{a.crons.colWhen}</th>
              <th class="au-th">{a.crons.colSource}</th>
              <th class="au-th">{a.crons.colWhat}</th>
              <th class="au-th">{m.crons.colMedidor}</th>
              <th class="au-th pr-5">{a.crons.colLast}</th>
            </tr>
          </thead>
          <tbody>
            {
              CRONS.map((c) => {
                const u = ultimaEjecucion.get(c.job) ?? null
                const estado = estadoFila(c.cadaMin, u, ventanaLeidaMin, ahora)
                const tol = toleranciaMin(c.cadaMin)
                const consumo = consumoTolerancia(c.cadaMin, u?.at ?? null, ahora)
                return (
                  <tr data-fila={c.job} data-at={u?.at ?? ''} data-tol={tol} data-cada={c.cadaMin} data-ok={u?.ok ? '1' : '0'}>
                    <td class="au-td pl-5 font-mono text-[12px] text-ink-50 whitespace-nowrap" data-rotulo={a.crons.colTask}>{c.job}</td>
                    <td class="au-td font-mono text-[12px] text-ink-200 whitespace-nowrap tabular-nums" data-rotulo={a.crons.colWhen}>{T(c.horario)}</td>
                    <td class="au-td" data-rotulo={a.crons.colSource}>
                      <span
                        class={`px-1.5 py-0.5 rounded-full text-[9px] font-mono uppercase tracking-wider border whitespace-nowrap ${
                          c.origen === 'vercel'
                            ? 'text-ink-200 border-white/10 bg-white/5'
                            : 'text-violet border-violet/30 bg-violet/10'
                        }`}
                      >
                        {c.origen}
                      </span>
                    </td>
                    <td class="au-td au-td-que">
                      <span class="text-[13px] text-ink-100 leading-relaxed">{T(c.hace)}</span>
                      <span class="block text-[12px] text-ink-400 leading-relaxed mt-1">{interpolate(a.crons.ifFails, { texto: T(c.siFalla) })}</span>
                    </td>
                    <td class="au-td" data-rotulo={m.crons.colMedidor}>
                      <span
                        class="au-medidor"
                        data-medidor
                        data-estado={estado}
                        style={`--consumo:${Math.min(1, consumo).toFixed(3)};--cada:${Math.min(1, c.cadaMin / tol).toFixed(3)}`}
                        title={interpolate(m.crons.medidor, { tol: durTol(tol) })}
                        role="img"
                        aria-label={interpolate(m.crons.medidor, { tol: durTol(tol) })}
                      >
                        <i></i>
                      </span>
                    </td>
                    <td class="au-td pr-5 font-mono text-[12px] whitespace-nowrap" data-rotulo={a.crons.colLast}>
                      <span class={ESTADO_FILA_CLS[estado]} data-hace title={interpolate(a.crons.expected, { horario: T(c.horario) })}>
                        {estado === 'silencio'
                          ? u
                            ? interpolate(a.crons.silent, { ago: haceCuanto(u.at) ?? '' })
                            : interpolate(m.crons.silencioSinRegistro, { h: Math.round(ventanaLeidaMin / 60) })
                          : estado === 'sin-registro'
                            ? a.crons.noRecord
                            : haceCuanto(u?.at)}
                      </span>
                    </td>
                  </tr>
                )
              })
            }
          </tbody>
        </table>
      </div>
    </section>

    <!-- ── Automatismos del producto ── -->
    <section aria-labelledby="au-prod-titulo">
      <p class="text-[11px] font-mono uppercase tracking-[.2em] text-ink-200 mb-4">{a.product.heading}</p>
      <h2 id="au-prod-titulo" data-titular class="text-3xl md:text-5xl font-medium tracking-[-.025em] text-ink-50 leading-[1.05] mb-5 max-w-3xl">
        {m.producto.titulo}
      </h2>
      <p class="text-[14px] text-ink-300 max-w-2xl leading-relaxed mb-2">{a.product.intro}</p>
      <p class="text-[10.5px] font-mono uppercase tracking-[.14em] text-ink-400 mb-10">{m.producto.nota}</p>
      <div class="grid grid-cols-[minmax(0,1fr)] sm:grid-cols-2 lg:grid-cols-3 gap-3" data-entrada data-foco>
        {
          AUTOMATISMOS.map((auto) => (
            <article class="foco au-auto rounded-2xl glass overflow-hidden">
              <EscenaAutomatismo id={auto.id} />
              <div class="p-5">
                <h3 class="text-[14px] font-medium text-ink-50 mb-2">{T(auto.nombre)}</h3>
                <p class="text-[13px] text-ink-100 leading-relaxed mb-3">{T(auto.hace)}</p>
                <span class="text-[10px] font-mono uppercase tracking-[.12em] text-ink-400">{T(auto.cuando)}</span>
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </div>

  <script
    id="au-i18n"
    type="application/json"
    set:html={jsonEnScript({
      agoJustNow: a.agoJustNow,
      agoMinutes: a.agoMinutes,
      agoHours: a.agoHours,
      agoDaysShort: a.agoDaysShort,
      silent: a.crons.silent,
    })}
  />
</BaseLayout>

<script>
  // Mismo lenguaje que las demás páginas con motion (Lenis + GSAP, montaje
  // común en src/lib/motion/landing.ts) más las piezas de esta página.
  import { montarLanding } from '../lib/motion/landing'
  import { montarAutomatizaciones } from '../lib/motion/automatizaciones'

  const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  montarAutomatizaciones({ reducido })
  montarLanding()
</script>

<style is:global>
  .au-hero {
    display: grid;
    gap: 28px;
  }
  @media (min-width: 1024px) {
    .au-hero { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: end; gap: 48px; }
  }
  .au-hero h1 span { text-wrap: balance; }

  /* Tabla de crons: tabla de verdad en escritorio; en móvil cada fila es una
     ficha, con el rótulo de la columna delante de cada dato. */
  .au-th {
    font: 500 10px/1 var(--font-mono, ui-monospace, monospace);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #3a3a48;
    padding: 14px 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .au-td { padding: 16px 12px; vertical-align: top; }
  .au-tabla tbody tr { border-bottom: 1px solid rgba(255, 255, 255, 0.04); transition: background-color 0.2s ease; }
  .au-tabla tbody tr:last-child { border-bottom: 0; }
  .au-tabla tbody tr.au-activo { background: rgba(0, 242, 255, 0.04); }
  .au-td-que { max-width: 28rem; }
  @media (max-width: 1023px) {
    .au-tabla thead { display: none; }
    .au-tabla table, .au-tabla tbody { display: block; }
    .au-tabla tbody tr {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 6px 12px;
      padding: 16px 18px;
    }
    .au-tabla .au-td { padding: 0; }
    .au-tabla .au-td:nth-child(1) { grid-column: 1; }
    .au-tabla .au-td:nth-child(2) { grid-column: 2; text-align: right; }
    .au-tabla .au-td:nth-child(3) { grid-column: 1; }
    .au-tabla .au-td:nth-child(6) { grid-column: 2; grid-row: 2; text-align: right; }
    .au-tabla .au-td-que { grid-column: 1 / -1; max-width: none; }
    .au-tabla .au-td:nth-child(5) { grid-column: 1 / -1; }
    .au-tabla .au-td:nth-child(5) .au-medidor { width: 100%; }
  }

  /* Medidor de silencio: cuánto de lo que se tolera ya se consumió desde la
     última corrida. La raya marca el intervalo declarado: a su izquierda es
     puntualidad, entre ella y el final es retraso tolerado, y el final es
     silencio. */
  .au-medidor {
    position: relative;
    display: block;
    width: 7.5rem;
    height: 6px;
    margin-top: 6px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.06);
    overflow: hidden;
  }
  .au-medidor i {
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(var(--consumo, 0) * 100%);
    border-radius: 3px;
    background: #c9ff5b;
    opacity: 0.8;
    transition: width 0.6s ease;
  }
  .au-medidor::after {
    content: '';
    position: absolute;
    top: -2px;
    bottom: -2px;
    left: calc(var(--cada, 0.33) * 100%);
    border-left: 1px solid rgba(231, 231, 236, 0.5);
  }
  .au-medidor[data-estado='fallo'] i { background: #ff6b3d; }
  .au-medidor[data-estado='silencio'] i, .au-medidor[data-estado='sin-registro'] i { background: #ff6b3d; opacity: 0.9; }
  .au-medidor[data-estado='sin-registro'] i { background: #3a3a48; }
</style>
