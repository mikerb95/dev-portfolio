---
// Lo que corre solo: workflows de GitHub Actions, tareas programadas y los
// automatismos que dispara el propio tráfico.
//
// Página PÚBLICA, mismo criterio OPSEC que /status: solo agregados y
// descripciones. Nada de rutas señuelo, umbrales de bloqueo ni nombres de
// reglas de detección. El catálogo vive en `src/data/automatizaciones.ts`; aquí
// solo se cruza con el estado real.
//
// FAIL-OPEN en las dos fuentes. Si la API de GitHub no responde (cuota, caída)
// o la base no contesta, la sección se pinta con lo que hay y se dice que no se
// pudo leer. Una página de observabilidad que devuelve 500 cuando lo observado
// falla no sirve para nada, que es justo cuando más se mira.
import BaseLayout from '../layouts/BaseLayout.astro'
import { getDictionary, getLocaleFromUrl, interpolate, localizedHref, tx } from '../i18n'
import { db } from '../db'
import { cronRuns } from '../db/schema'
import { desc, gte } from 'drizzle-orm'
import { mapRunEstado } from '../lib/lab/pipeline-live'
import { safeQuery } from '../lib/safe-query'
import { serverEnv } from '../lib/env'
import { WORKFLOWS, CRONS, AUTOMATISMOS } from '../data/automatizaciones'
import type { Bilingual, BilingualOptional } from '../i18n/bilingual'
import { toleranciaMin } from '../lib/cron-silencio'
import { consumoTolerancia, construirPartitura, estadoFila, type Corrida } from '../lib/motion/partitura'
import Partitura from '../components/automatizaciones/Partitura.astro'
import DisparadoresCI from '../components/automatizaciones/DisparadoresCI.astro'
import EscenaAutomatismo from '../components/automatizaciones/EscenaAutomatismo.astro'

const locale = getLocaleFromUrl(Astro.url.pathname)
const t = getDictionary(locale)
const a = t.automatizaciones
const L = (path: string) => localizedHref(path, locale)
// Traduce un campo del catálogo al idioma de la página, cayendo al español.
// Con sobrecargas para conservar la distinción de `tx`: un campo obligatorio
// siempre devuelve texto, y solo uno opcional puede venir vacío.
function T(value: Bilingual): string
function T(value: BilingualOptional): string | undefined
function T(value: BilingualOptional): string | undefined {
  return tx(value, locale)
}

// Las dos cifras de la entradilla se cuentan, no se escriben (RNF-14). Los
// crons se cuentan por job distinto y no por fila: `uptime-check` aparece dos
// veces porque tiene dos disparadores, pero es una sola tarea.
const totalWorkflows = WORKFLOWS.length
const totalCrons = new Set(CRONS.map((c) => c.job)).size

const REPO = 'mikerb95/dev-portfolio'

type GhRun = {
  name: string | null
  status: string | null
  conclusion: string | null
  created_at: string
  html_url: string | null
  event: string | null
}

// UNA sola petición para los seis workflows: se piden las últimas corridas de
// `main` y se reduce a la más reciente de cada nombre. Pedir el último run
// workflow por workflow serían seis peticiones contra una cuota de 60/hora sin
// token, y esta página la puede abrir cualquiera.
let runs: GhRun[] = []
let githubOk = true
try {
  const token = serverEnv('GITHUB_API_TOKEN')
  const res = await fetch(
    `https://api.github.com/repos/${REPO}/actions/runs?branch=main&per_page=40`,
    {
      headers: {
        Accept: 'application/vnd.github+json',
        ...(token ? { Authorization: `Bearer ${token}` } : {}),
      },
    }
  )
  if (res.ok) {
    runs = ((await res.json()) as { workflow_runs?: GhRun[] }).workflow_runs ?? []
  } else {
    githubOk = false
  }
} catch {
  githubOk = false
}

const ultimoRun = new Map<string, GhRun>()
for (const r of runs) {
  if (r.name && !ultimoRun.has(r.name)) ultimoRun.set(r.name, r)
}

// Bitácora de crons: un rango de 48 h sobre el índice de fecha.
//
// Antes eran las últimas 150 filas, y con el sondeo cada 5 min y el agregado
// cada 15 eso daba unas 9 h de historia: todos los diarios salían "sin
// registro" aunque corrían, justo en la página que promete el último
// resultado real. 48 h cubren la tolerancia más larga (36 h de un diario, ver
// `toleranciaMin`), así que la tabla puede acusar un silencio de verdad, y de
// paso alimentan la partitura y su simulacro.
//
// Coste: ~800 filas por render (Turso factura filas escaneadas), cacheadas 5
// min en la CDN; la misma magnitud que la cinta de la portada lee en 24 h. El
// LIMIT es el techo si alguien añade crons frecuentes: si se alcanza, la
// ventana efectiva se mide y nada se acusa sin historia suficiente.
const VENTANA_H = 48
const TECHO_FILAS = 1400
type Fila = { job: string; ok: boolean; durationMs: number | null; createdAt: Date | null }

const ahora = Date.now()
// `safeQuery` y no un try/catch propio: es el patrón del repo para el render de
// páginas públicas, y deja el fallo en el log del servidor en vez de tragárselo.
// Cubre también el caso "la migración todavía no se aplicó": la página se sirve
// igual y la sección lo dice.
const filasOrNull = await safeQuery<Fila[] | null>(
  () =>
    db
      .select({
        job: cronRuns.job,
        ok: cronRuns.ok,
        durationMs: cronRuns.durationMs,
        createdAt: cronRuns.createdAt,
      })
      .from(cronRuns)
      .where(gte(cronRuns.createdAt, new Date(ahora - VENTANA_H * 3_600_000)))
      .orderBy(desc(cronRuns.createdAt))
      .limit(TECHO_FILAS) as Promise<Fila[]>,
  null,
  'automatizaciones: bitácora de crons'
)
// `null` distingue "la consulta falló" de "la tabla existe pero aún no tiene
// filas": son dos cosas distintas y solo la primera es un aviso.
const bitacoraOk = filasOrNull !== null
const filas = filasOrNull ?? []
const corridas: Corrida[] = filas
  .filter((f) => f.createdAt)
  .map((f) => ({ job: f.job, at: f.createdAt!.getTime(), ok: f.ok, ms: f.durationMs }))
// Cuánta historia se leyó de verdad: toda la ventana, salvo que el techo haya
// cortado la consulta antes.
const ventanaLeidaMin =
  filas.length >= TECHO_FILAS && corridas.length
    ? (ahora - corridas[corridas.length - 1].at) / 60000
    : bitacoraOk
      ? VENTANA_H * 60
      : 0

const partitura = construirPartitura(corridas, CRONS, ahora)

const ultimaEjecucion = new Map<string, Corrida>()
for (const c of corridas) {
  if (!ultimaEjecucion.has(c.job)) ultimaEjecucion.set(c.job, c)
}

function haceCuanto(at: number | null | undefined): string | null {
  if (!at) return null
  const min = Math.floor((ahora - at) / 60000)
  if (min < 1) return a.agoJustNow
  if (min < 60) return interpolate(a.agoMinutes, { n: min })
  const h = Math.floor(min / 60)
  if (h < 24) return interpolate(a.agoHours, { n: h })
  return interpolate(a.agoDaysShort, { n: Math.floor(h / 24) })
}

// La página y la alerta usan la MISMA definición de silencio (`toleranciaMin`,
// vía `estadoFila`): si divergieran, la tabla diría que todo va bien mientras
// el push dice lo contrario, y la que se cree es siempre la que se está mirando.
const durTol = (min: number) =>
  min >= 60
    ? interpolate(a.motion.dur, { h: Math.floor(min / 60), m: min % 60 }).replace(/ 0 min$/, '')
    : interpolate(a.motion.durMin, { m: min })

Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=600')
---


<BaseLayout title={a.title} description={a.description}>
  <div class="max-w-[1280px] mx-auto px-6 md:px-12 lg:px-20 pt-32 pb-24">
    <a
      href={L('/')}
      class="inline-flex items-center gap-2 text-[11px] font-mono uppercase tracking-[.2em] text-ink-300 hover:text-cyan transition-colors mb-12"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
      {t.common.back}
    </a>

    <header class="mb-12">
      <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-6">
        <span class="text-cyan">/automatizaciones</span>
        <span class="h-px flex-1 bg-gradient-to-r from-white/15 to-transparent max-w-[80px]"></span>
        <span>{a.eyebrow}</span>
      </div>
      <h1 class="hero-line text-5xl md:text-6xl font-medium tracking-[-.035em] text-mask leading-[.95] mb-8">
        {a.h1Line1}<br />{a.h1Line2}
      </h1>
      <p class="text-[16px] text-ink-100 max-w-2xl leading-relaxed">
        {interpolate(a.intro, { workflows: totalWorkflows, crons: totalCrons })}
        <em>{a.introEm}</em> {a.introMid}
        <span class="text-ink-300"> {a.introTail}</span>
      </p>
    </header>

    <!-- ── Integración continua ── -->
    <section class="mb-14">
      <div class="flex items-baseline justify-between gap-4 mb-5">
        <h2 class="text-[13px] font-mono uppercase tracking-[.2em] text-ink-200">{a.ci.heading}</h2>
        {!githubOk && <span class="text-[11px] font-mono text-ember">{a.ci.githubDown}</span>}
      </div>
      <p class="text-[13px] text-ink-300 max-w-2xl leading-relaxed mb-5">
        {a.ci.intro}
      </p>

      <div class="grid md:grid-cols-2 gap-3">
        {
          WORKFLOWS.map((w) => {
            const run = ultimoRun.get(w.nombre)
            const estado = run ? mapRunEstado(run.status, run.conclusion) : null
            return (
              <div class="rounded-2xl glass p-5 hover:border-cyan/25 transition-colors">
                <div class="flex items-center justify-between gap-3 mb-3">
                  <span class="text-[13px] font-mono font-semibold text-ink-50">{w.nombre}</span>
                  {estado && (
                    <span
                      class={`px-1.5 py-0.5 rounded-full text-[9px] font-mono uppercase tracking-wider border ${ESTADO_CLS[estado] ?? ESTADO_CLS.pending}`}
                    >
                      {estado}
                    </span>
                  )}
                </div>
                <p class="text-[13px] text-ink-100 leading-relaxed mb-2">{T(w.hace)}</p>
                {w.detalle && <p class="text-[12px] text-ink-300 leading-relaxed mb-3">{T(w.detalle)}</p>}
                <div class="flex items-center gap-3 text-[10px] font-mono uppercase tracking-[.12em] text-ink-400 pt-3 border-t border-white/[.06]">
                  <span>{w.disparadores.map((d) => a.triggers[d]).join(' · ')}</span>
                  {run?.created_at && <span class="text-ink-300">{haceCuanto(new Date(run.created_at))}</span>}
                  <span class="ml-auto normal-case tracking-normal">{w.archivo}</span>
                </div>
              </div>
            )
          })
        }
      </div>
    </section>

    <!-- ── Tareas programadas ── -->
    <section class="mb-14">
      <div class="flex items-baseline justify-between gap-4 mb-5">
        <h2 class="text-[13px] font-mono uppercase tracking-[.2em] text-ink-200">{a.crons.heading}</h2>
        {!bitacoraOk && <span class="text-[11px] font-mono text-ink-400">{a.crons.logUnavailable}</span>}
      </div>
      <p class="text-[13px] text-ink-300 max-w-2xl leading-relaxed mb-5">
        {a.crons.intro}
      </p>

      <div class="rounded-2xl glass overflow-x-auto">
        <table class="w-full min-w-[46rem] text-left">
          <thead>
            <tr class="border-b border-white/[.06]">
              <th class="text-[10px] font-mono uppercase tracking-[.15em] text-ink-400 font-medium px-5 py-3">{a.crons.colTask}</th>
              <th class="text-[10px] font-mono uppercase tracking-[.15em] text-ink-400 font-medium px-3 py-3">{a.crons.colWhen}</th>
              <th class="text-[10px] font-mono uppercase tracking-[.15em] text-ink-400 font-medium px-3 py-3">{a.crons.colSource}</th>
              <th class="text-[10px] font-mono uppercase tracking-[.15em] text-ink-400 font-medium px-3 py-3">{a.crons.colWhat}</th>
              <th class="text-[10px] font-mono uppercase tracking-[.15em] text-ink-400 font-medium px-5 py-3">{a.crons.colLast}</th>
            </tr>
          </thead>
          <tbody>
            {
              CRONS.map((c) => {
                const u = ultimaEjecucion.get(c.job)
                return (
                  <tr class="border-b border-white/[.04] last:border-0">
                    <td class="px-5 py-4 align-top font-mono text-[12px] text-ink-50 whitespace-nowrap">{c.job}</td>
                    <td class="px-3 py-4 align-top font-mono text-[12px] text-ink-200 whitespace-nowrap tabular-nums">{T(c.horario)}</td>
                    <td class="px-3 py-4 align-top">
                      <span
                        class={`px-1.5 py-0.5 rounded-full text-[9px] font-mono uppercase tracking-wider border whitespace-nowrap ${
                          c.origen === 'vercel'
                            ? 'text-ink-200 border-white/10 bg-white/5'
                            : 'text-violet border-violet/30 bg-violet/10'
                        }`}
                      >
                        {c.origen}
                      </span>
                    </td>
                    <td class="px-3 py-4 align-top max-w-[30rem]">
                      <span class="text-[13px] text-ink-100 leading-relaxed">{T(c.hace)}</span>
                      <span class="block text-[12px] text-ink-400 leading-relaxed mt-1">{interpolate(a.crons.ifFails, { texto: T(c.siFalla) })}</span>
                    </td>
                    <td class="px-5 py-4 align-top font-mono text-[12px] whitespace-nowrap">
                      {u ? (
                        enSilencio(c.cadaMin, u.createdAt) ? (
                          <span class="text-ember" title={interpolate(a.crons.expected, { horario: T(c.horario) })}>
                            {interpolate(a.crons.silent, { ago: haceCuanto(u.createdAt) ?? '' })}
                          </span>
                        ) : (
                          <span class={u.ok ? 'text-lime' : 'text-ember'}>{haceCuanto(u.createdAt)}</span>
                        )
                      ) : (
                        <span class="text-ink-400">{a.crons.noRecord}</span>
                      )}
                    </td>
                  </tr>
                )
              })
            }
          </tbody>
        </table>
      </div>
    </section>

    <!-- ── Automatismos del producto ── -->
    <section>
      <h2 class="text-[13px] font-mono uppercase tracking-[.2em] text-ink-200 mb-5">{a.product.heading}</h2>
      <p class="text-[13px] text-ink-300 max-w-2xl leading-relaxed mb-5">
        {a.product.intro}
      </p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {
          AUTOMATISMOS.map((auto) => (
            <div class="rounded-2xl glass p-5 hover:border-cyan/25 transition-colors">
              <h3 class="text-[13px] font-medium text-ink-50 mb-2">{T(auto.nombre)}</h3>
              <p class="text-[13px] text-ink-100 leading-relaxed mb-3">{T(auto.hace)}</p>
              <span class="text-[10px] font-mono uppercase tracking-[.12em] text-ink-400">{T(auto.cuando)}</span>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
