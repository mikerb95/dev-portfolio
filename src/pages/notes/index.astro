---
// Página sin datos vivos: se genera en el build, no por request.
export const prerender = true

import BaseLayout from '../../layouts/BaseLayout.astro'
import FichaDecision, { type FichaEntrada } from '../../components/notes/FichaDecision.astro'
import BitacoraNotas from '../../components/notes/BitacoraNotas.astro'
import { getDictionary, getLocaleFromUrl, localizedHref } from '../../i18n'
import { getNotes, notaVista } from '../../lib/notes'

const locale = getLocaleFromUrl(Astro.url.pathname)
const t = getDictionary(locale)
const n = t.notes
const L = (path: string) => localizedHref(path, locale)

// Solo las notas del idioma que se está viendo: un índice en inglés con
// artículos en español sería peor que un índice corto.
const notas = (await getNotes(locale)).map(notaVista)

// La ficha recorre las decisiones de la más reciente a la más antigua; una
// nota sin `decision` en su frontmatter simplemente no entra.
const fichas: FichaEntrada[] = notas.flatMap((x) =>
  x.decision
    ? [{ href: L(`/notes/${x.slug}`), titulo: x.title, familia: x.familias[0], minutos: x.minutos, claveMapa: x.claveMapa, ...x.decision }]
    : [],
)

// Cifras del resumen, todas derivadas del contenido: cuántas notas, cuánto
// se tarda en leerlas todas y desde cuándo se escriben.
const minutosTotales = notas.reduce((s, x) => s + x.minutos, 0)
const primera = notas[notas.length - 1]?.date
const fmtDesde = new Intl.DateTimeFormat(locale === 'en' ? 'en-US' : 'es-CO', { month: 'long', year: 'numeric', timeZone: 'UTC' })
---

<BaseLayout title={n.title} description={n.description} image="/og-notes.png">
  <div class="max-w-[1280px] mx-auto px-6 md:px-12 lg:px-20 pt-32 pb-24">

    <!-- Back -->
    <a href={L('/')} class="inline-flex items-center gap-2 text-[11px] font-mono uppercase tracking-[.2em] text-ink-300 hover:text-cyan transition-colors mb-12">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
      {t.common.back}
    </a>

    <header class="nt-hero">
      <div class="nt-hero-texto">
        <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-6" data-hero-sigue>
          <span class="text-cyan">/notes</span>
          <span class="h-px flex-1 bg-gradient-to-r from-white/15 to-transparent max-w-[80px]"></span>
          <span>{n.eyebrow}</span>
        </div>
        <h1 class="text-[46px] sm:text-6xl xl:text-[68px] font-medium tracking-[-.04em] leading-[.95] mb-8">
          <span data-hero-linea class="block text-ink-50">{n.h1Line1}</span>{' '}
          <span data-hero-linea class="block text-cyan">{n.h1Line2}</span>
        </h1>
        <p class="text-[16px] text-ink-100 max-w-xl leading-relaxed" data-hero-sigue>
          {n.introPre} <a href={L('/tools')} class="text-cyan hover:underline">{n.introLink}</a>{n.introPost}
        </p>
        {notas.length > 0 && (
          <dl class="nt-resumen" data-hero-sigue>
            <div><dt>{n.motion.resumen.notas}</dt><dd data-odometro data-odometro-inicio="top bottom">{notas.length}</dd></div>
            <div><dt>{n.motion.resumen.minutos}</dt><dd data-odometro data-odometro-inicio="top bottom">{minutosTotales}</dd></div>
            {primera && <div><dt>{n.motion.resumen.desde}</dt><dd class="nt-resumen-fecha">{fmtDesde.format(primera)}</dd></div>}
          </dl>
        )}
      </div>
      {fichas.length > 0 && (
        <div class="nt-hero-pieza" data-hero-pieza>
          <FichaDecision fichas={fichas} />
        </div>
      )}
    </header>

    {notas.length === 0 ? (
      <div class="rounded-2xl glass p-12 text-center">
        <p class="text-[13px] font-mono text-ink-300">{n.empty}</p>
      </div>
    ) : (
      <BitacoraNotas notas={notas} />
    )}

  </div>
</BaseLayout>

<style>
  .nt-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 56px;
    margin-bottom: 112px;
  }
  @media (min-width: 1024px) {
    .nt-hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 470px);
      gap: 72px;
      align-items: center;
      margin-bottom: 140px;
    }
  }
  .nt-hero h1 span { text-wrap: balance; }

  /* Tres cifras en fila, separadas por un filete: se leen como la ficha
     técnica de la colección. */
  .nt-resumen {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin-top: 40px;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    padding-top: 20px;
  }
  .nt-resumen > div {
    display: flex;
    flex-direction: column-reverse;
    gap: 4px;
    padding-right: 28px;
    margin-right: 28px;
    border-right: 1px solid rgba(255, 255, 255, 0.07);
  }
  .nt-resumen > div:last-child { border-right: 0; margin-right: 0; padding-right: 0; }
  .nt-resumen dt {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #85858f;
  }
  .nt-resumen dd {
    margin: 0;
    font-size: 30px;
    font-weight: 500;
    letter-spacing: -0.03em;
    color: #e7e7ec;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }
  .nt-resumen dd.nt-resumen-fecha { font-size: 17px; line-height: 1.95; letter-spacing: -0.01em; }
  @media (max-width: 479px) {
    .nt-resumen > div { padding-right: 18px; margin-right: 18px; }
    .nt-resumen dd { font-size: 26px; }
  }

</style>

<script>
  // Mismo lenguaje que las demás páginas con motion (Lenis + GSAP, montaje
  // común en src/lib/motion/landing.ts). La ficha y la bitácora se montan
  // solas desde sus componentes.
  import { montarLanding } from '../../lib/motion/landing'
  montarLanding()
</script>
