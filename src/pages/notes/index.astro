---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getDictionary, getLocaleFromUrl, localizedHref } from '../../i18n'
import { getNotes, noteSlug } from '../../lib/notes'

const locale = getLocaleFromUrl(Astro.url.pathname)
const t = getDictionary(locale)
const n = t.notes
const L = (path: string) => localizedHref(path, locale)

// Solo las notas del idioma que se está viendo: un índice en inglés con
// artículos en español sería peor que un índice corto.
const notes = await getNotes(locale)

// timeZone UTC: la fecha del frontmatter es un día calendario, no un instante;
// sin esto, America/Bogota (-5) la retrocede al día anterior.
const fmtDate = new Intl.DateTimeFormat(locale === 'en' ? 'en-US' : 'es-CO', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
})
---

<BaseLayout title={n.title} description={n.description} image="/og-notes.png">
  <div class="max-w-[1280px] mx-auto px-6 md:px-12 lg:px-20 pt-32 pb-24">

    <!-- Back -->
    <a href={L('/')} class="inline-flex items-center gap-2 text-[11px] font-mono uppercase tracking-[.2em] text-ink-300 hover:text-cyan transition-colors mb-12">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
      {t.common.back}
    </a>

    <header class="mb-16">
      <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-6">
        <span class="text-cyan">/notes</span>
        <span class="h-px flex-1 bg-gradient-to-r from-white/15 to-transparent max-w-[80px]"></span>
        <span>{n.eyebrow}</span>
      </div>
      <h1 class="hero-line overflow-hidden text-5xl md:text-6xl font-medium tracking-[-.035em] text-mask leading-[.95] mb-8">
        {n.h1Line1}<br/>{n.h1Line2}
      </h1>
      <p class="text-[16px] text-ink-100 max-w-xl leading-relaxed">
        {n.introPre} <a href={L('/tools')} class="text-cyan hover:underline">{n.introLink}</a>{n.introPost}
      </p>
    </header>

    {notes.length === 0 && (
      <div class="rounded-2xl glass p-12 text-center">
        <p class="text-[13px] font-mono text-ink-300">{n.empty}</p>
      </div>
    )}

    <div class="space-y-4">
      {notes.map((note) => (
        <a href={L(`/notes/${noteSlug(note)}`)} class="block rounded-2xl glass p-7 lift group">
          <div class="flex flex-wrap items-center gap-3 mb-3">
            <span class="text-[11px] font-mono text-ink-300">{fmtDate.format(note.data.date)}</span>
            {note.data.tags.map((tag) => (
              <span class="text-[10px] font-mono uppercase tracking-wider px-2 py-0.5 rounded-full border border-white/10 text-ink-200">{tag}</span>
            ))}
          </div>
          <h2 class="text-xl md:text-2xl font-medium tracking-[-.02em] text-ink-50 group-hover:text-cyan transition-colors mb-2">
            {note.data.title}
          </h2>
          <p class="text-[14px] text-ink-200 leading-relaxed max-w-2xl">{note.data.description}</p>
        </a>
      ))}
    </div>

  </div>
</BaseLayout>

<script>
  import { initPageMotion } from '../../lib/motion-reveal'
  initPageMotion()
</script>
