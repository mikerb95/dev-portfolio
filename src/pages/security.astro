---
import BaseLayout from '../layouts/BaseLayout.astro'
import { db } from '../db'
import { securityEvents, blockedIps } from '../db/schema'
import { and, gte, sql } from 'drizzle-orm'
import { getDictionary, getLocaleFromUrl, interpolate, intlLocale, localizedHref } from '../i18n'

const locale = getLocaleFromUrl(Astro.url.pathname)
const t = getDictionary(locale)
const s = t.security
const L = (path: string) => localizedHref(path, locale)

// Página pública de seguridad. Documenta hallazgos reales de una auditoría
// sobre este mismo repositorio, mapeados a OWASP Top 10, con el commit que
// aplicó cada corrección. Contenido 100% estático y verificable en el
// historial de git público.
//
// La sección "Security Operations" expone en vivo agregados del micro-SIEM
// propio (docs/plan-security-observability.md). OPSEC deliberada: SOLO
// agregados — nunca IPs completas, nunca nombres de reglas exactos, nunca se
// revela cuáles rutas son endpoints señuelo. El filtrado ocurre aquí mismo, en
// el servidor: esta página nunca lee ip/path crudos de security_events.

const SECOPS_WINDOW_DAYS = 30
const DAY_MS = 86_400_000
const secOpsSince = new Date(Date.now() - SECOPS_WINDOW_DAYS * DAY_MS)

const CAT_LABELS: Record<string, string> = s.secops.categoryLabels

const sumHits = sql<number>`coalesce(sum(${securityEvents.hits}), 0)`

const [totalRow] = await db.select({ v: sumHits }).from(securityEvents).where(gte(securityEvents.at, secOpsSince))
const totalDetected = Number(totalRow?.v ?? 0)

const byCategory = await db
  .select({ category: securityEvents.category, count: sumHits })
  .from(securityEvents)
  .where(gte(securityEvents.at, secOpsSince))
  .groupBy(securityEvents.category)
  .orderBy(sql`2 desc`)
  .limit(8)
const catMax = Math.max(1, ...byCategory.map((c) => Number(c.count)))

const byCountry = await db
  .select({ country: securityEvents.country, count: sumHits })
  .from(securityEvents)
  .where(and(gte(securityEvents.at, secOpsSince), sql`${securityEvents.country} is not null`))
  .groupBy(securityEvents.country)
  .orderBy(sql`2 desc`)
  .limit(6)
const countryMax = Math.max(1, ...byCountry.map((c) => Number(c.count)))

const [blocksRow] = await db
  .select({ n: sql<number>`count(*)` })
  .from(blockedIps)
  .where(and(gte(blockedIps.createdAt, secOpsSince), sql`${blockedIps.source} = 'auto'`))
const autoBlocks30d = Number(blocksRow?.n ?? 0)

// Tendencia: eventos por día (14 días), para el mini-gráfico de barras.
const dayExpr = sql<string>`date(${securityEvents.at}, 'unixepoch')`
const dailyRaw = await db
  .select({ day: dayExpr, count: sumHits })
  .from(securityEvents)
  .where(gte(securityEvents.at, new Date(Date.now() - 14 * DAY_MS)))
  .groupBy(dayExpr)
const dailyMap = new Map(dailyRaw.map((r) => [r.day, Number(r.count)]))
const trend = Array.from({ length: 14 }, (_, i) => {
  const day = new Date(Date.now() - (13 - i) * DAY_MS).toISOString().slice(0, 10)
  return { day, count: dailyMap.get(day) ?? 0 }
})
const trendMax = Math.max(1, ...trend.map((t) => t.count))

type Severity = 'alta' | 'media'

// Metadatos no traducibles (identificador, ruta de archivo, commit, fecha,
// clasificación OWASP): el texto (título/problema/solución) viene del
// diccionario por índice — mismo patrón que /tools.
const FINDINGS_META: { id: string; owasp: string; severity: Severity; file: string; commit: string; date: string }[] = [
  { id: 'upload-ext', owasp: 'A03:2021 · Injection', severity: 'alta', file: 'src/pages/api/admin/upload.ts', commit: 'd439054', date: '2026-07-06' },
  { id: 'contact-abuse', owasp: 'A04:2021 · Insecure Design', severity: 'media', file: 'src/pages/api/contact.ts', commit: '779f4b0', date: '2026-07-06' },
  { id: 'legacy-session', owasp: 'A01:2021 · Broken Access Control', severity: 'media', file: 'src/middleware.ts', commit: '14b08e2', date: '2026-07-06' },
  { id: 'missing-headers', owasp: 'A05:2021 · Security Misconfiguration', severity: 'media', file: 'src/middleware.ts', commit: '32bcf0d', date: '2026-07-06' },
]

const findings = FINDINGS_META.map((meta, i) => ({ ...meta, ...s.findings[i] }))
const good = s.controls

const severityCls: Record<Severity, string> = {
  alta: 'text-ember border-ember/40 bg-ember/15',
  media: 'text-ember/80 border-ember/25 bg-ember/10',
}
---

<BaseLayout title={s.title} description={s.description} image="/og-security.png">
  <div class="max-w-[1280px] mx-auto px-6 md:px-12 lg:px-20 pt-32 pb-24">

    <!-- Back -->
    <a href={L('/')} class="inline-flex items-center gap-2 text-[11px] font-mono uppercase tracking-[.2em] text-ink-300 hover:text-cyan transition-colors mb-12">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
      {t.common.back}
    </a>

    <header class="mb-12">
      <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-6">
        <span class="text-cyan">/security</span>
        <span class="h-px flex-1 bg-gradient-to-r from-white/15 to-transparent max-w-[80px]"></span>
        <span>{s.eyebrow}</span>
      </div>
      <h1 class="hero-line overflow-hidden text-5xl md:text-6xl font-medium tracking-[-.035em] text-mask leading-[.95] mb-8">
        {s.h1Line1}<br/>{s.h1Line2}
      </h1>
      <p class="text-[16px] text-ink-100 max-w-xl leading-relaxed">
        {s.intro}
      </p>
    </header>

    <!-- Security Operations: micro-SIEM propio en vivo -->
    <section class="mb-20">
      <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-cyan pulse-dot"></span>
        <span>{s.secops.badge}</span>
      </div>

      <p class="text-[14px] text-ink-100 max-w-2xl leading-relaxed mb-8">
        {interpolate(s.secops.intro, { days: SECOPS_WINDOW_DAYS })}
      </p>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-8">
        <div class="rounded-2xl glass p-5">
          <div class="text-[10px] font-mono uppercase tracking-[.18em] text-ink-300">{s.secops.detected}</div>
          <div class="mt-1.5 text-3xl font-medium text-ink-50 tabular-nums">{totalDetected.toLocaleString(intlLocale(locale))}</div>
        </div>
        <div class="rounded-2xl glass p-5">
          <div class="text-[10px] font-mono uppercase tracking-[.18em] text-ink-300">{s.secops.autoBlocks}</div>
          <div class="mt-1.5 text-3xl font-medium text-cyan tabular-nums">{autoBlocks30d.toLocaleString(intlLocale(locale))}</div>
        </div>
        <div class="rounded-2xl glass p-5">
          <div class="text-[10px] font-mono uppercase tracking-[.18em] text-ink-300">{s.secops.owaspCategories}</div>
          <div class="mt-1.5 text-3xl font-medium text-ink-50 tabular-nums">{byCategory.length}</div>
        </div>
        <div class="rounded-2xl glass p-5">
          <div class="text-[10px] font-mono uppercase tracking-[.18em] text-ink-300">{s.secops.overheadP99}</div>
          <div class="mt-1.5 text-3xl font-medium text-lime tabular-nums">≤5ms</div>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-4 mb-4">
        <!-- Desglose OWASP -->
        <div class="rounded-2xl glass p-6">
          <h3 class="text-[13px] font-medium text-ink-50 mb-4">{s.secops.byCategoryHeading}</h3>
          {byCategory.length === 0 ? (
            <p class="text-[13px] text-ink-400">{s.secops.byCategoryEmpty}</p>
          ) : (
            <ul class="space-y-2.5">
              {byCategory.map((c) => (
                <li>
                  <div class="flex items-center justify-between text-[12px] mb-1">
                    <span class="text-ink-100">{CAT_LABELS[c.category] ?? c.category}</span>
                    <span class="font-mono text-ink-300">{Number(c.count)}</span>
                  </div>
                  <div class="h-1.5 rounded-full bg-white/[.05] overflow-hidden">
                    <div class="h-full rounded-full bg-cyan" style={`width:${(Number(c.count) / catMax) * 100}%`}></div>
                  </div>
                </li>
              ))}
            </ul>
          )}
        </div>

        <!-- Origen geográfico -->
        <div class="rounded-2xl glass p-6">
          <h3 class="text-[13px] font-medium text-ink-50 mb-4">{s.secops.byCountryHeading}</h3>
          {byCountry.length === 0 ? (
            <p class="text-[13px] text-ink-400">{s.secops.byCountryEmpty}</p>
          ) : (
            <ul class="space-y-2.5">
              {byCountry.map((c) => (
                <li>
                  <div class="flex items-center justify-between text-[12px] mb-1">
                    <span class="text-ink-100 font-mono">{c.country}</span>
                    <span class="font-mono text-ink-300">{Number(c.count)}</span>
                  </div>
                  <div class="h-1.5 rounded-full bg-white/[.05] overflow-hidden">
                    <div class="h-full rounded-full bg-lime" style={`width:${(Number(c.count) / countryMax) * 100}%`}></div>
                  </div>
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>

      <!-- Tendencia 14 días -->
      <div class="rounded-2xl glass p-6 mb-8">
        <h3 class="text-[13px] font-medium text-ink-50 mb-4">{s.secops.trendHeading}</h3>
        <div class="flex items-end gap-1 h-20">
          {trend.map((pt) => (
            <div class="flex-1 h-full group relative flex items-end">
              <div
                class="pointer-events-none absolute bottom-full left-1/2 -translate-x-1/2 mb-2 whitespace-nowrap rounded-lg border border-cyan/30 bg-ink-950 px-2.5 py-1.5 text-[11px] font-mono text-ink-50 opacity-0 shadow-lg transition-opacity duration-150 group-hover:opacity-100 z-10"
              >
                <span class="text-ink-300">{pt.day}:</span> <span class="text-cyan">{pt.count}</span> {s.secops.trendTooltipSuffix}
              </div>
              <div
                class="w-full rounded-t bg-cyan/60 hover:bg-cyan transition-colors"
                style={`height:${Math.max(3, (pt.count / trendMax) * 100)}%`}
              ></div>
            </div>
          ))}
        </div>
        <div class="flex justify-between text-[10px] font-mono text-ink-400 mt-2">
          <span>{trend[0]?.day}</span>
          <span>{trend[trend.length - 1]?.day}</span>
        </div>
      </div>

      <!-- Cómo funciona -->
      <div class="grid md:grid-cols-2 gap-4">
        <div class="rounded-2xl glass p-6">
          <h3 class="text-[13px] font-medium text-ink-50 mb-4">{s.secops.howItWorksHeading}</h3>
          <ol class="space-y-3 text-[13px] text-ink-100 leading-relaxed">
            {s.secops.layers.map((layer, i) => (
              <li><span class="text-cyan font-mono text-[11px] mr-2">{String(i + 1).padStart(2, '0')}</span>{layer}</li>
            ))}
          </ol>
        </div>
        <div class="rounded-2xl glass p-6">
          <h3 class="text-[13px] font-medium text-ink-50 mb-4">{s.secops.sloHeading}</h3>
          <ul class="space-y-2.5 text-[13px] text-ink-100">
            <li class="flex justify-between"><span>{s.secops.slo.overhead}</span><span class="font-mono text-lime">≤ 5 ms</span></li>
            <li class="flex justify-between"><span>{s.secops.slo.detectionToBlock}</span><span class="font-mono text-lime">≤ 60 min</span></li>
            <li class="flex justify-between"><span>{s.secops.slo.detectionToAlert}</span><span class="font-mono text-lime">≤ 60 s</span></li>
            <li class="flex justify-between"><span>{s.secops.slo.falsePositives}</span><span class="font-mono text-lime">&lt; 0.1%</span></li>
            <li class="flex justify-between"><span>{s.secops.slo.retention}</span><span class="font-mono text-ink-200">{s.secops.slo.retentionValue}</span></li>
          </ul>
          <p class="text-[11px] text-ink-400 mt-4 leading-relaxed">
            {s.secops.opsecNote}
          </p>
        </div>
      </div>
    </section>

    <!-- Hallazgos corregidos -->
    <section class="mb-20">
      <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-lime"></span>
        <span>{s.findingsHeading} · {findings.length}</span>
      </div>

      <div class="space-y-4">
        {findings.map((f) => (
          <div class="rounded-2xl glass p-6 lift">
            <div class="flex flex-wrap items-center gap-3 mb-4">
              <h2 class="text-[15px] font-medium">{f.title}</h2>
              <span class={`text-[10px] font-mono uppercase tracking-[.15em] px-2.5 py-1 rounded-full border ${severityCls[f.severity]}`}>
                {s.severity[f.severity]}
              </span>
              <span class="text-[11px] font-mono text-cyan">{f.owasp}</span>
              <span class="ml-auto text-[11px] font-mono text-ink-300">{f.file}</span>
            </div>

            <div class="grid md:grid-cols-2 gap-4 mb-4">
              <div class="rounded-xl bg-white/[.02] border border-white/5 p-4">
                <div class="text-[10px] font-mono uppercase tracking-[.2em] text-ember mb-2">{s.problemLabel}</div>
                <p class="text-[13px] text-ink-100 leading-relaxed">{f.problema}</p>
              </div>
              <div class="rounded-xl bg-white/[.02] border border-white/5 p-4">
                <div class="text-[10px] font-mono uppercase tracking-[.2em] text-lime mb-2">{s.fixLabel}</div>
                <p class="text-[13px] text-ink-100 leading-relaxed">{f.solucion}</p>
              </div>
            </div>

            <div class="flex items-center gap-3 text-[11px] font-mono text-ink-300">
              <span>{f.date}</span>
              <a
                href={`https://github.com/mikerb95/dev-portfolio/commit/${f.commit}`}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-1.5 text-cyan hover:underline"
              >
                {s.commitPrefix} {f.commit} ↗
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Controles ya vigentes -->
    <section class="mb-20">
      <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-cyan"></span>
        <span>{s.controlsHeading}</span>
      </div>
      <div class="grid md:grid-cols-2 gap-4">
        {good.map((g) => (
          <div class="rounded-2xl glass p-6">
            <h3 class="text-[14px] font-medium mb-2">{g.title}</h3>
            <p class="text-[13px] text-ink-100 leading-relaxed">{g.detail}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Metodología -->
    <section class="rounded-2xl glass p-8">
      <div class="text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-4">{s.methodology.heading}</div>
      <div class="grid md:grid-cols-3 gap-6 text-[13px] text-ink-100 leading-relaxed">
        <p>{s.methodology.p1}</p>
        <p>{s.methodology.p2}</p>
        <p>{s.methodology.p3}</p>
      </div>
    </section>

  </div>
</BaseLayout>

<script>
  import { initPageMotion } from '../lib/motion-reveal'
  initPageMotion()
</script>
