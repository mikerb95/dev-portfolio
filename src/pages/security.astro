---
import BaseLayout from '../layouts/BaseLayout.astro'
import { db } from '../db'
import { securityEvents, blockedIps } from '../db/schema'
import { and, gte, notInArray, sql } from 'drizzle-orm'
import { AUDIT_CATEGORIES } from '../lib/security/audit'
import { getDictionary, getLocaleFromUrl, interpolate, intlLocale, localizedHref } from '../i18n'
import { safeQuery } from '../lib/safe-query'
import FiltroCapas from '../components/security/FiltroCapas.astro'
import HallazgosCommits from '../components/security/HallazgosCommits.astro'
import ControlesVivos from '../components/security/ControlesVivos.astro'
import { destinoDe, repartoHostil, resumenCapas } from '../lib/motion/filtro'

const locale = getLocaleFromUrl(Astro.url.pathname)
const t = getDictionary(locale)
const s = t.security
const L = (path: string) => localizedHref(path, locale)

// Página pública de seguridad. Documenta hallazgos reales de una auditoría
// sobre este mismo repositorio, mapeados a OWASP Top 10, con el commit que
// aplicó cada corrección. Contenido 100% estático y verificable en el
// historial de git público.
//
// La sección "Security Operations" expone en vivo agregados del micro-SIEM
// propio (docs/plan-security-observability.md). OPSEC deliberada: SOLO
// agregados - nunca IPs completas, nunca nombres de reglas exactos, nunca se
// revela cuáles rutas son endpoints señuelo. El filtrado ocurre aquí mismo, en
// el servidor: esta página nunca lee ip/path crudos de security_events.

const SECOPS_WINDOW_DAYS = 30
const DAY_MS = 86_400_000
const secOpsSince = new Date(Date.now() - SECOPS_WINDOW_DAYS * DAY_MS)

const CAT_LABELS: Record<string, string> = s.secops.categoryLabels

const sumHits = sql<number>`coalesce(sum(${securityEvents.hits}), 0)`

// Solo amenazas. La tabla guarda también rastro de acciones legítimas (mis
// entradas al panel, clientes consultando sus pagos, alumnos canjeando un
// código): contarlas aquí las publicaba como ataques, y el gráfico diario
// habría enseñado qué días entro al panel. Ver lib/security/audit.ts.
const soloAmenazas = notInArray(securityEvents.category, AUDIT_CATEGORIES)

// Los agregados del micro-SIEM son un extra de esta página: el catálogo de
// hallazgos OWASP es estático y debe verse aunque la base no responda.
const [totalRow] = await safeQuery(
  () => db.select({ v: sumHits }).from(securityEvents).where(and(gte(securityEvents.at, secOpsSince), soloAmenazas)),
  [] as { v: number }[],
  'security/total-detectado',
)
const totalDetected = Number(totalRow?.v ?? 0)

const byCategory = await safeQuery(
  () =>
    db
      .select({ category: securityEvents.category, count: sumHits })
      .from(securityEvents)
      .where(and(gte(securityEvents.at, secOpsSince), soloAmenazas))
      .groupBy(securityEvents.category)
      .orderBy(sql`2 desc`)
      // Hay 10 categorías posibles: con el tope anterior (8) el señuelo, que
      // suele ser la más pequeña, desaparecía del reparto y del hero. Subir el
      // tope no lee más filas: el escaneo es el mismo, solo cambia el corte.
      .limit(12),
  [] as { category: string; count: number }[],
  'security/por-categoria',
)
const catMax = Math.max(1, ...byCategory.map((c) => Number(c.count)))
// El hero no hace consultas propias: reparte los mismos agregados de arriba.
const reparto = repartoHostil(byCategory)

const byCountry = await safeQuery(
  () =>
    db
      .select({ country: securityEvents.country, count: sumHits })
      .from(securityEvents)
      .where(and(gte(securityEvents.at, secOpsSince), soloAmenazas, sql`${securityEvents.country} is not null`))
      .groupBy(securityEvents.country)
      .orderBy(sql`2 desc`)
      .limit(6),
  [] as { country: string | null; count: number }[],
  'security/por-pais',
)
const countryMax = Math.max(1, ...byCountry.map((c) => Number(c.count)))

const [blocksRow] = await safeQuery(
  () =>
    db
      .select({ n: sql<number>`count(*)` })
      .from(blockedIps)
      .where(and(gte(blockedIps.createdAt, secOpsSince), sql`${blockedIps.source} = 'auto'`)),
  [] as { n: number }[],
  'security/bloqueos-automaticos',
)
const autoBlocks30d = Number(blocksRow?.n ?? 0)
const resumen = resumenCapas(byCategory, totalDetected, autoBlocks30d)

// Tendencia: eventos por día (14 días), para el mini-gráfico de barras.
const dayExpr = sql<string>`date(${securityEvents.at}, 'unixepoch')`
const dailyRaw = await safeQuery(
  () =>
    db
      .select({ day: dayExpr, count: sumHits })
      .from(securityEvents)
      .where(and(gte(securityEvents.at, new Date(Date.now() - 14 * DAY_MS)), soloAmenazas))
      .groupBy(dayExpr),
  [] as { day: string; count: number }[],
  'security/tendencia-diaria',
)
const dailyMap = new Map(dailyRaw.map((r) => [r.day, Number(r.count)]))
const trend = Array.from({ length: 14 }, (_, i) => {
  const day = new Date(Date.now() - (13 - i) * DAY_MS).toISOString().slice(0, 10)
  return { day, count: dailyMap.get(day) ?? 0 }
})
const trendMax = Math.max(1, ...trend.map((t) => t.count))

type Severity = 'alta' | 'media'

// Metadatos no traducibles (identificador, ruta de archivo, commit, fecha,
// clasificación OWASP): el texto (título/problema/solución) viene del
// diccionario por índice - mismo patrón que /tools.
const FINDINGS_META: { id: string; owasp: string; severity: Severity; file: string; commit: string; date: string }[] = [
  { id: 'upload-ext', owasp: 'A03:2021 · Injection', severity: 'alta', file: 'src/pages/api/admin/upload.ts', commit: 'd439054', date: '2026-07-06' },
  { id: 'contact-abuse', owasp: 'A04:2021 · Insecure Design', severity: 'media', file: 'src/pages/api/contact.ts', commit: '779f4b0', date: '2026-07-06' },
  { id: 'legacy-session', owasp: 'A01:2021 · Broken Access Control', severity: 'media', file: 'src/middleware.ts', commit: '14b08e2', date: '2026-07-06' },
  { id: 'missing-headers', owasp: 'A05:2021 · Security Misconfiguration', severity: 'media', file: 'src/middleware.ts', commit: '32bcf0d', date: '2026-07-06' },
]

const findings = FINDINGS_META.map((meta, i) => ({ ...meta, ...s.findings[i] }))
const m = s.motion
const fmt = (n: number) => n.toLocaleString(intlLocale(locale))

// Mismo código de color que el hero: lo frenado y lo registrado en ember, el
// señuelo en violeta. Así el desglose se lee como la bitácora del filtro.
const barraCls: Record<string, string> = { frenada: 'bg-ember', senuelo: 'bg-violet', registrada: 'bg-ember/60' }

// Colores de las capas, los mismos puntos de la leyenda del filtro.
const capaPunto = ['border border-dashed border-ink-200', 'bg-cyan', 'bg-violet', 'bg-lime']

const slo = [
  { label: s.secops.slo.overhead, valor: '≤ 5 ms' },
  { label: s.secops.slo.detectionToBlock, valor: '≤ 60 min' },
  { label: s.secops.slo.detectionToAlert, valor: '≤ 60 s' },
  { label: s.secops.slo.falsePositives, valor: '< 0.1%' },
  { label: s.secops.slo.retention, valor: s.secops.slo.retentionValue },
]
---

<BaseLayout title={s.title} description={s.description} image="/og-security.png">
  <!-- overflow-x: clip y no hidden: recorta lo que asome por los lados sin
       crear un contenedor de scroll, que rompería el scroll suave. -->
  <div class="overflow-x-clip">
  <div class="max-w-[1280px] mx-auto px-6 md:px-12 lg:px-20 pt-32 pb-24">

    <a href={L('/')} class="inline-flex items-center gap-2 text-[11px] font-mono uppercase tracking-[.2em] text-ink-300 hover:text-cyan transition-colors mb-12">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
      {t.common.back}
    </a>

    <header class="mb-28 grid grid-cols-[minmax(0,1fr)] lg:grid-cols-[minmax(0,1fr)_minmax(0,560px)] gap-12 lg:gap-16 items-center">
      <div>
        <div data-hero-sigue class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-6">
          <span class="text-cyan">/security</span>
          <span class="h-px flex-1 bg-gradient-to-r from-white/15 to-transparent max-w-[80px]"></span>
          <span>{s.eyebrow}</span>
        </div>
        <h1 class="text-5xl md:text-6xl xl:text-7xl font-medium tracking-[-.035em] leading-[.98] mb-8 [&>span]:[text-wrap:balance]">
          <span data-hero-linea class="block text-ink-50">{s.h1Line1}</span>{' '}
          <span data-hero-linea class="block text-cyan">{s.h1Line2}</span>
        </h1>
        <p data-hero-sigue class="text-[16px] text-ink-100 max-w-xl leading-relaxed">
          {s.intro}
        </p>
      </div>
      <FiltroCapas reparto={reparto} resumen={resumen} dias={SECOPS_WINDOW_DAYS} />
    </header>

    <!-- ── /01 Security Operations: micro-SIEM propio en vivo ── -->
    <section class="mb-28" aria-labelledby="sec-secops">
      <div data-etiqueta class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-6">
        <span class="text-cyan">/01</span>
        <span class="h-px flex-1 bg-gradient-to-r from-white/15 to-transparent max-w-[80px]"></span>
        <span class="inline-flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-cyan pulse-dot"></span>{s.secops.badge}</span>
      </div>
      <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4 mb-10">
        <h2 id="sec-secops" data-titular class="text-3xl md:text-5xl font-medium tracking-[-.025em] text-ink-50 leading-[1.05] max-w-2xl">
          {m.secopsTitle}
        </h2>
        <p class="max-w-md text-[14px] text-ink-300 leading-relaxed">
          {interpolate(s.secops.intro, { days: SECOPS_WINDOW_DAYS })}
        </p>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-4" data-entrada>
        <div class="so-kpi">
          <div class="so-kpi-etq">{s.secops.detected}</div>
          <div class="so-kpi-num text-ink-50" data-odometro>{fmt(totalDetected)}</div>
        </div>
        <div class="so-kpi">
          <div class="so-kpi-etq">{s.secops.autoBlocks}</div>
          <div class="so-kpi-num text-lime" data-odometro>{fmt(autoBlocks30d)}</div>
        </div>
        <div class="so-kpi">
          <div class="so-kpi-etq">{s.secops.owaspCategories}</div>
          <div class="so-kpi-num text-ink-50" data-odometro>{byCategory.length}</div>
        </div>
        <div class="so-kpi">
          <div class="so-kpi-etq">{s.secops.overheadP99}</div>
          <div class="so-kpi-num text-cyan">≤5ms</div>
        </div>
      </div>

      <div class="grid lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] gap-4 mb-4">
        <div class="so-panel" data-barras>
          <h3 class="so-panel-titulo">{s.secops.byCategoryHeading}</h3>
          {byCategory.length === 0 ? (
            <p class="text-[13px] text-ink-400">{s.secops.byCategoryEmpty}</p>
          ) : (
            <ul class="space-y-3">
              {byCategory.map((c) => (
                <li>
                  <div class="flex items-center justify-between gap-4 text-[12px] mb-1.5">
                    <span class="text-ink-100 truncate">{CAT_LABELS[c.category] ?? c.category}</span>
                    <span class="font-mono text-ink-300 tabular-nums">{fmt(Number(c.count))}</span>
                  </div>
                  <div class="h-1.5 rounded-full bg-white/[.05] overflow-hidden">
                    <div class={`so-barra h-full rounded-full ${barraCls[destinoDe(c.category)]}`} style={`width:${(Number(c.count) / catMax) * 100}%`}></div>
                  </div>
                </li>
              ))}
            </ul>
          )}
        </div>

        <div class="so-panel" data-barras>
          <h3 class="so-panel-titulo">{s.secops.byCountryHeading}</h3>
          {byCountry.length === 0 ? (
            <p class="text-[13px] text-ink-400">{s.secops.byCountryEmpty}</p>
          ) : (
            <ul class="space-y-3">
              {byCountry.map((c) => (
                <li>
                  <div class="flex items-center justify-between text-[12px] mb-1.5">
                    <span class="text-ink-100 font-mono">{c.country}</span>
                    <span class="font-mono text-ink-300 tabular-nums">{fmt(Number(c.count))}</span>
                  </div>
                  <div class="h-1.5 rounded-full bg-white/[.05] overflow-hidden">
                    <div class="so-barra h-full rounded-full bg-cyan/70" style={`width:${(Number(c.count) / countryMax) * 100}%`}></div>
                  </div>
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>

      <!-- Tendencia 14 días -->
      <div class="so-panel mb-4" data-tendencia>
        <h3 class="so-panel-titulo">{s.secops.trendHeading}</h3>
        <div class="so-tend" data-tend>
          <span class="so-barrido" data-barrido aria-hidden="true"></span>
          {trend.map((pt, i) => (
            <div class={`so-dia ${i < 3 ? 'so-dia-izq' : i > trend.length - 4 ? 'so-dia-der' : ''}`}>
              <div class="so-tip">
                <span class="text-ink-300">{pt.day}:</span> <span class="text-cyan">{pt.count}</span> {s.secops.trendTooltipSuffix}
              </div>
              <div class="so-col" style={`height:${Math.max(3, (pt.count / trendMax) * 100)}%`}></div>
            </div>
          ))}
        </div>
        <div class="flex justify-between text-[10px] font-mono text-ink-400 mt-2">
          <span>{trend[0]?.day}</span>
          <span>{trend[trend.length - 1]?.day}</span>
        </div>
      </div>

      <!-- Cómo funciona: las mismas cuatro capas del filtro del hero -->
      <div class="grid lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] gap-4">
        <div class="so-panel">
          <h3 class="so-panel-titulo">{s.secops.howItWorksHeading}</h3>
          <ol class="so-ruta" data-ruta>
            <span class="so-ruta-linea" aria-hidden="true"><span data-ruta-luz></span></span>
            {s.secops.layers.map((layer, i) => (
              <li class="so-ruta-paso">
                <span class={`so-ruta-punto ${capaPunto[i]}`} aria-hidden="true"></span>
                <span class="text-cyan font-mono text-[11px] mr-2">{String(i + 1).padStart(2, '0')}</span>
                <span class="text-[13px] text-ink-100 leading-relaxed">{layer}</span>
              </li>
            ))}
          </ol>
        </div>
        <div class="so-panel">
          <h3 class="so-panel-titulo">{s.secops.sloHeading}</h3>
          <ul class="space-y-2.5 text-[13px] text-ink-100" data-slo>
            {slo.map((r) => (
              <li class="so-slo">
                <span>{r.label}</span>
                <span class="so-slo-guia" aria-hidden="true"></span>
                <span class="font-mono text-lime whitespace-nowrap" data-slo-valor>{r.valor}</span>
              </li>
            ))}
          </ul>
          <p class="text-[11px] text-ink-400 mt-5 leading-relaxed">{s.secops.opsecNote}</p>
        </div>
      </div>
    </section>

    <!-- ── /02 Hallazgos corregidos ── -->
    <section class="mb-28" aria-labelledby="sec-hallazgos">
      <div data-etiqueta class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-6">
        <span class="text-cyan">/02</span>
        <span class="h-px flex-1 bg-gradient-to-r from-white/15 to-transparent max-w-[80px]"></span>
        <span>{s.findingsHeading} · {findings.length}</span>
      </div>
      <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4 mb-12">
        <h2 id="sec-hallazgos" data-titular class="text-3xl md:text-5xl font-medium tracking-[-.025em] text-ink-50 leading-[1.05] max-w-2xl">
          {m.findingsTitle}
        </h2>
        <p class="max-w-md text-[14px] text-ink-300 leading-relaxed">{m.findingsHint}</p>
      </div>
      <HallazgosCommits findings={findings} />
    </section>

    <!-- ── /03 Controles ya vigentes ── -->
    <section class="mb-28" aria-labelledby="sec-controles">
      <div data-etiqueta class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-6">
        <span class="text-cyan">/03</span>
        <span class="h-px flex-1 bg-gradient-to-r from-white/15 to-transparent max-w-[80px]"></span>
        <span>{s.controlsHeading}</span>
      </div>
      <h2 id="sec-controles" data-titular class="text-3xl md:text-5xl font-medium tracking-[-.025em] text-ink-50 leading-[1.05] max-w-2xl mb-10">
        {m.controlsTitle}
      </h2>
      <ControlesVivos />
    </section>

    <!-- ── /04 Metodología ── -->
    <section aria-labelledby="sec-metodo">
      <div data-etiqueta class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-6">
        <span class="text-cyan">/04</span>
        <span class="h-px flex-1 bg-gradient-to-r from-white/15 to-transparent max-w-[80px]"></span>
        <span>{s.methodology.heading}</span>
      </div>
      <h2 id="sec-metodo" data-titular class="text-3xl md:text-5xl font-medium tracking-[-.025em] text-ink-50 leading-[1.05] max-w-2xl mb-12">
        {m.methodologyTitle}
      </h2>
      <ol class="me-pasos" data-metodo>
        <span class="me-linea" aria-hidden="true"><span data-metodo-luz></span></span>
        {[s.methodology.p1, s.methodology.p2, s.methodology.p3].map((p, i) => (
          <li class="me-paso">
            <span class="me-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="me-titulo">{m.pasos[i]}</h3>
            <p class="me-texto">{p}</p>
          </li>
        ))}
      </ol>
    </section>

  </div>
  </div>
</BaseLayout>

<style is:global>
  .so-kpi,
  .so-panel {
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(255, 255, 255, 0.07);
  }
  .so-kpi {
    padding: 18px 20px;
  }
  .so-kpi-etq {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #85858f;
  }
  .so-kpi-num {
    margin-top: 6px;
    font-size: 34px;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }
  .so-panel {
    padding: 22px 24px;
  }
  .so-panel-titulo {
    font-size: 13px;
    font-weight: 500;
    color: #e7e7ec;
    margin-bottom: 16px;
  }
  .so-barra {
    transform-origin: left center;
  }
  .so-tend {
    position: relative;
    display: flex;
    align-items: flex-end;
    gap: 4px;
    height: 96px;
  }
  .so-dia {
    position: relative;
    flex: 1;
    height: 100%;
    display: flex;
    align-items: flex-end;
  }
  .so-col {
    width: 100%;
    border-radius: 3px 3px 0 0;
    background: linear-gradient(180deg, rgba(255, 107, 61, 0.9), rgba(255, 107, 61, 0.25));
    transform-origin: bottom center;
    transition: filter 0.15s ease;
  }
  .so-dia:hover .so-col {
    filter: brightness(1.35);
  }
  .so-tip {
    pointer-events: none;
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    margin-bottom: 8px;
    white-space: nowrap;
    border-radius: 8px;
    border: 1px solid rgba(0, 242, 255, 0.3);
    background: #121216;
    padding: 5px 9px;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 11px;
    color: #e7e7ec;
    opacity: 0;
    transition: opacity 0.15s ease;
    z-index: 3;
  }
  /* Los extremos alinean el tooltip hacia dentro: centrado, el del último
     día se salía de la página y abría scroll horizontal en móvil. */
  .so-dia-izq .so-tip {
    left: 0;
    transform: none;
  }
  .so-dia-der .so-tip {
    left: auto;
    right: 0;
    transform: none;
  }
  .so-dia:hover .so-tip {
    opacity: 1;
  }
  .so-barrido {
    position: absolute;
    top: -6px;
    bottom: 0;
    left: 0;
    width: 2px;
    background: #c9ff5b;
    box-shadow: 0 0 14px 2px rgba(201, 255, 91, 0.5);
    opacity: 0;
    pointer-events: none;
    z-index: 2;
  }
  .so-ruta {
    position: relative;
    display: grid;
    gap: 16px;
  }
  .so-ruta-linea {
    position: absolute;
    left: 3.5px;
    top: 8px;
    bottom: 8px;
    width: 1px;
    background: rgba(255, 255, 255, 0.08);
  }
  .so-ruta-linea > span {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #85858f, #00f2ff 35%, #a78bff 65%, #c9ff5b);
    transform-origin: top center;
  }
  .so-ruta-paso {
    position: relative;
    padding-left: 22px;
  }
  .so-ruta-punto {
    position: absolute;
    left: 0;
    top: 7px;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    box-shadow: 0 0 0 3px #16161c;
  }
  .so-slo {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .so-slo-guia {
    flex: 1;
    min-width: 12px;
    border-bottom: 1px dotted rgba(255, 255, 255, 0.14);
    transform-origin: left center;
  }

  .me-pasos {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }
  .me-linea {
    position: absolute;
    left: 0;
    right: 0;
    top: 19px;
    height: 1px;
    background: rgba(255, 255, 255, 0.08);
  }
  .me-linea > span {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, #00f2ff, #c9ff5b);
    transform-origin: left center;
  }
  .me-paso {
    position: relative;
  }
  .me-num {
