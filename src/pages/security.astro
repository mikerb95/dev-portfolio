<script>
  // Mismo lenguaje que las demás páginas con motion (Lenis + GSAP, montaje
  // común en src/lib/motion/landing.ts) más las piezas de esta página.
  import { montarLanding } from '../lib/motion/landing'
  import { montarFiltro } from '../lib/motion/filtro-lienzo'
  import { montarSecciones } from '../lib/motion/security'
  import { revelarEtiqueta } from '../lib/motion/efectos'

  const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const filtro = document.querySelector<HTMLElement>('[data-filtro]')
  if (filtro) {
    try {
      montarFiltro(filtro, { reducido })
    } catch (err) {
      // Fail-open: la instantánea del servidor sigue ahí.
      console.warn('[security] filtro sin motion', err)
      delete filtro.dataset.vivo
    }
  }
  montarLanding()
  montarSecciones({ reducido })
  if (!reducido) {
    try {
      document.querySelectorAll<HTMLElement>('[data-etiqueta]').forEach(revelarEtiqueta)
    } catch (err) {
      console.warn('[security] etiquetas sin motion', err)
    }
  }
</script>
