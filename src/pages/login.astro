---
import '../styles/global.css'
import { debeOfrecerClave } from '../lib/sustentacion/acceso'
import { serverEnv } from '../lib/env'
import { demoAvailable } from '../db'
import LoginForm from '../components/portal/LoginForm.astro'
// Puerta única de entrada del sitio, con dos pestañas: "Cliente" (el portal,
// email + contraseña) y "Admin" (el panel). Son sistemas de autenticación
// separados que solo comparten la pantalla: cada pestaña habla con sus propios
// endpoints y ninguna cookie de una sirve para la otra.
//
// Pestaña del admin: dos puertas independientes, cualquiera basta.
// - GitHub OAuth (como siempre): signIn() de auth-astro/client hace el POST
//   con token CSRF que Auth.js exige (un GET directo a /api/auth/signin/github
//   lanza UnknownAction).
// - Llave de seguridad (passwordless): ceremonia WebAuthn contra
//   /api/auth/webauthn/{options,verify} y luego signIn('passkey', { proof }).
const params = new URL(Astro.request.url).searchParams
const callbackUrl = params.get('callbackUrl') ?? '/entrar'

// Qué pestaña se abre. Cliente por defecto: es quien llega sin saber a dónde
// ir, desde el botón del navbar. Se abre en Admin cuando hay un `callbackUrl`,
// porque eso solo lo pone el middleware al rebotar a alguien de una ruta del
// panel (o de la sustentación) y ofrecerle ahí un formulario de cliente sería
// mandarlo por la puerta equivocada. `?como=` fuerza cualquiera de las dos.
type Pestana = 'cliente' | 'admin'
const como = params.get('como')
const forzada: Pestana | null =
  como === 'cliente' || como === 'admin' ? como : params.has('callbackUrl') ? 'admin' : null
const pestana: Pestana = forzada ?? 'cliente'

// Tercera puerta, y solo para la sustentación: la contraseña de
// SUSTENTACION_PASSWORD. Aparece aquí porque es donde el middleware deja a
// quien iba al panel de la sustentación sin sesión, y mandarlo a otra pantalla
// a teclearla sería un rebote más justo antes de entrar al salón.
//
// Se muestra ÚNICAMENTE si el destino era una ruta de la sustentación: en el
// login normal del panel no pinta nada, y anunciar una puerta con menos
// garantías en la pantalla de entrada general sería invitar a usarla.
// Ver el alcance (tres rutas, nada más) en src/lib/sustentacion/acceso.ts.
const ofreceClaveSustentacion = debeOfrecerClave(
  callbackUrl,
  serverEnv('SUSTENTACION_PASSWORD')
)

Astro.response.headers.set('Cache-Control', 'private, no-store')
---

<!doctype html>
<html lang="es" data-login-tab={pestana}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Entrar - CodeByMike</title>
    {/* Sin pestaña forzada, la que eligió la última vez en este navegador
        (en los equipos de Mike, Admin). Va inline y en el head para decidirla
        antes del primer pintado: resolverla desde el módulo haría parpadear el
        formulario del cliente en cada entrada al panel. */}
    {!forzada && (
      <script is:inline>
        try {
          var guardada = localStorage.getItem('login-pestana')
          if (guardada === 'admin' || guardada === 'cliente') {
            document.documentElement.dataset.loginTab = guardada
          }
        } catch (e) {}
      </script>
    )}
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#07070a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* Sin JS y rumbo al panel: caemos al signin de Auth.js con GitHub. En la
        pestaña del cliente no, que lo mandaría a una pantalla de GitHub que no
        es para él. */}
    {pestana === 'admin' && (
      <noscript>
        <meta
          http-equiv="refresh"
          content={`0;url=/api/auth/signin?callbackUrl=${encodeURIComponent(callbackUrl)}`}
        />
      </noscript>
    )}
  </head>

  <body class="grain bg-ink-950 text-ink-50">
    <main class="login-stage">
      <div class="login-aura" aria-hidden="true"></div>

      <section class="login-card glass-strong">
        <span class="login-kicker">/auth</span>
        <h1 class="login-title">Entrar</h1>

        <div class="login-tabs" role="tablist" aria-label="Tipo de cuenta">
          <span class="login-tabs-pill" aria-hidden="true"></span>
          <button
            id="tab-cliente"
            class="login-tab"
            type="button"
            role="tab"
            data-tab="cliente"
            aria-controls="panel-cliente"
            aria-selected={pestana === 'cliente' ? 'true' : 'false'}
            tabindex={pestana === 'cliente' ? 0 : -1}
          >
            Cliente
          </button>
          <button
            id="tab-admin"
            class="login-tab"
            type="button"
            role="tab"
            data-tab="admin"
            aria-controls="panel-admin"
            aria-selected={pestana === 'admin' ? 'true' : 'false'}
            tabindex={pestana === 'admin' ? 0 : -1}
          >
            Admin
          </button>
        </div>

        <div id="panel-cliente" class="login-panel login-panel-cliente" role="tabpanel" aria-labelledby="tab-cliente">
          <p class="login-lead">Tus proyectos, facturas y documentos.</p>

          <LoginForm next="/portal" />

          <p class="login-demo">
            El acceso es por invitación. ¿Crees que deberías tener cuenta?{' '}
            <a href="/contact">Escríbeme</a>.
          </p>
          {
            demoAvailable && (
              <p class="login-demo login-demo-sep">
                ¿Solo mirando? <a href="/api/portal/demo">Entra a la demo del portal</a>.
              </p>
            )
          }
        </div>

        <div id="panel-admin" class="login-panel" role="tabpanel" aria-labelledby="tab-admin">
          <p class="login-lead">El panel de control.</p>

          <div class="login-options">
            <button id="btn-github" class="login-btn login-btn-primary" type="button">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .5C5.73.5.98 5.24.98 11.520c0 5.02 3.26 9.28 7.77 10.78.57.1.78-.25.78-.55v-2.15c-3.160.7-3.830-1.350-3.830-1.350-.52-1.3-1.26-1.66-1.26-1.66-1.030-.7.08-.68.08-.68 1.14.08 1.74 1.180 1.74 1.180 1.020 1.730 2.670 1.230 3.320.95.1-.74.4-1.240.72-1.520-2.520-.29-5.170-1.260-5.170-5.6 0-1.24.44-2.25 1.17-3.04-.12-.29-.5-1.45.11-3.03 0 0 .96-.31 3.14 1.16a10.9 10.9 0 0 1 5.72 0c2.18-1.47 3.13-1.16 3.13-1.16.62 1.58.23 2.74.11 3.03.73.79 1.17 1.8 1.17 3.04 0 4.35-2.65 5.31-5.18 5.59.41.35.77 1.04.77 2.1v3.12c0 .3.2.66.79.55 4.5-1.5 7.76-5.76 7.76-10.78C23.02 5.24 18.27.5 12 .5z"/>
              </svg>
              Continuar con GitHub
            </button>

            <div class="login-or"><span>o</span></div>

            <button id="btn-passkey" class="login-btn login-btn-ghost" type="button">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
              <span id="passkey-label">Usar mi llave de seguridad</span>
            </button>
          </div>
          {
            ofreceClaveSustentacion && (
              <form id="form-sustentacion" class="login-sust">
                <div class="login-or"><span>o</span></div>
                <label class="login-sust-label" for="clave-sustentacion">
                  Clave de la sustentación
                </label>
                <input
                  id="clave-sustentacion"
                  class="login-sust-input"
                  type="password"
                  autocomplete="current-password"
                  autocapitalize="off"
                  autocorrect="off"
                  spellcheck="false"
                  placeholder="Contraseña"
                />
                <button class="login-btn login-btn-ghost" type="submit">Entrar a la sustentación</button>
                <p class="login-sust-nota">
                  Solo abre el escenario y el panel de la sustentación, nada más del panel.
                </p>
              </form>
            )
          }

          <p id="login-status" class="login-status" role="status" aria-live="polite"></p>

          <p class="login-demo">
            ¿Solo mirando? <a href="/demo">Entra a la demo</a> - el panel completo con datos
            ficticios, sin cuenta.
          </p>
        </div>
      </section>
    </main>

    <style>
      /* Con el formulario del cliente la tarjeta ya no cabe siempre en un
         móvil apaisado: el escenario hace scroll y la tarjeta se coloca con
         margin, que a diferencia de place-items no la corta por arriba cuando
         es más alta que la pantalla. Va anclada arriba y no centrada: las dos
         pestañas tienen alturas distintas, y centrada la tarjeta se recolocaba
         al cambiar y el selector saltaba bajo el dedo. */
      .login-stage { position: fixed; inset: 0; display: grid; padding: 24px; overflow-x: hidden; overflow-y: auto; }
      .login-aura {
        position: fixed; left: 50%; top: 50%; translate: -50% -50%;
        width: 720px; height: 720px; max-width: 120vw; max-height: 120vh;
        border-radius: 50%;
        background:
          radial-gradient(closest-side, rgba(0, 242, 255, 0.14), rgba(0, 242, 255, 0) 70%),
          radial-gradient(closest-side, rgba(167, 139, 255, 0.12), rgba(167, 139, 255, 0) 70%);
        filter: blur(8px);
        pointer-events: none;
      }
      .login-card {
        position: relative; margin: min(12vh, 110px) auto auto; width: min(400px, 100%); border-radius: 28px; padding: 36px 30px 30px;
        text-align: center;
        box-shadow: 0 40px 120px -40px rgba(0, 0, 0, 0.8), inset 0 1px 0 rgba(255, 255, 255, 0.06);
      }
      .login-kicker {
        font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.24em; text-transform: uppercase; color: #00f2ff;
      }
      .login-title { margin: 8px 0 20px; font-size: 22px; font-weight: 500; letter-spacing: -0.02em; color: #e7e7ec; }

      /* Selector de pestañas. Qué panel se ve lo decide el atributo del <html>
         y no el `hidden` de cada panel, porque el script inline del head lo
         fija antes de que exista el DOM de la tarjeta. */
      .login-tabs {
        position: relative; display: grid; grid-template-columns: 1fr 1fr;
        padding: 4px; margin-bottom: 22px; border-radius: 999px;
        background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08);
      }
      .login-tabs-pill {
        position: absolute; top: 4px; bottom: 4px; left: 4px; width: calc(50% - 4px);
        border-radius: 999px; background: rgba(0, 242, 255, 0.1);
        box-shadow: inset 0 0 0 1px rgba(0, 242, 255, 0.28), 0 6px 20px -10px rgba(0, 242, 255, 0.6);
      }
      :root[data-login-tab='admin'] .login-tabs-pill { translate: 100% 0; }
      /* La transición se arma después del primer pintado: si no, la píldora
         viajaría de Cliente a Admin al cargar en los equipos que abren en Admin. */
      .login-tabs.listo .login-tabs-pill { transition: translate 0.32s cubic-bezier(0.2, 0.7, 0.2, 1); }
      .login-tab {
        position: relative; height: 36px; border: 0; border-radius: 999px; background: none;
        font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.12em; text-transform: uppercase;
        color: #7c7c8a; cursor: pointer; transition: color 0.2s ease;
      }
      .login-tab:hover { color: #c4c4cc; }
      .login-tab:focus-visible { outline: 2px solid #00f2ff; outline-offset: 2px; }
      :root[data-login-tab='cliente'] #tab-cliente,
      :root[data-login-tab='admin'] #tab-admin { color: #e7e7ec; }

      :root[data-login-tab='cliente'] #panel-admin,
      :root[data-login-tab='admin'] #panel-cliente { display: none; }
      .login-panel.entra { animation: login-entra 0.28s cubic-bezier(0.2, 0.7, 0.2, 1); }
      @keyframes login-entra {
        from { opacity: 0; transform: translateY(4px); }
        to { opacity: 1; transform: none; }
      }
      @media (prefers-reduced-motion: reduce) {
        .login-tabs.listo .login-tabs-pill { transition: none; }
        .login-panel.entra { animation: none; }
      }
      .login-panel-cliente { text-align: left; }
      .login-lead { margin: 0 0 18px; font-size: 12.5px; color: #85858f; text-align: center; }

      .login-options { display: grid; gap: 12px; }
      .login-btn {
        display: flex; align-items: center; justify-content: center; gap: 10px;
        height: 46px; border-radius: 14px; font-size: 13.5px; font-weight: 500;
        cursor: pointer; transition: opacity 0.2s ease, border-color 0.2s ease;
        font-family: inherit;
      }
      .login-btn:disabled { opacity: 0.5; cursor: default; }
      .login-btn-primary { background: #e7e7ec; color: #0b0b0e; border: none; }
      .login-btn-primary:hover:not(:disabled) { opacity: 0.92; }
      .login-btn-ghost {
        background: rgba(255,255,255,.03); color: #c4c4cc; border: 1px solid rgba(255,255,255,.1);
      }
      .login-btn-ghost:hover:not(:disabled) { border-color: rgba(0,242,255,.35); color: #e7e7ec; }

      .login-or { display: flex; align-items: center; gap: 10px; color: #4d4d5d; font-size: 11px; font-family: var(--font-mono); }
      .login-or::before, .login-or::after { content: ''; flex: 1; height: 1px; background: rgba(255,255,255,.08); }

      .login-status { margin-top: 18px; font-size: 12px; color: #85858f; min-height: 16px; }
      .login-status:empty { margin-top: 0; min-height: 0; }
      .login-status.err { color: #ff8a65; }
      .login-panel-cliente .login-demo { margin-top: 18px; text-align: center; }
      .login-demo-sep { padding-top: 14px; border-top: 1px solid rgba(255, 255, 255, 0.06); }
      .login-demo { margin-top: 14px; font-size: 12px; line-height: 1.6; color: #85858f; }
      .login-demo a { color: #00f2ff; text-decoration: none; }
      .login-demo a:hover { text-decoration: underline; }

      .login-sust { display: grid; gap: 10px; margin-top: 12px; text-align: left; }
      .login-sust-label {
        font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.18em;
        text-transform: uppercase; color: #7c7c8a;
      }
      .login-sust-input {
        height: 46px; padding: 0 14px; border-radius: 14px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #e7e7ec; font-size: 14px; font-family: var(--font-mono); letter-spacing: 0.06em;
      }
      .login-sust-input:focus { outline: 2px solid #00f2ff; outline-offset: -2px; }
      .login-sust-nota { margin: 0; font-size: 11px; line-height: 1.5; color: #7c7c8a; }
    </style>

    <script>
      import { signIn } from 'auth-astro/client'
      import { startAuthentication } from '@simplewebauthn/browser'

      // signIn() de auth-astro decide la URL mirando `providerId === 'credentials'`
      // literalmente, así que con nuestro provider 'passkey' postearía al endpoint
      // equivocado (/signin/ en vez de /callback/, que es el que Auth.js espera
      // para un provider tipo Credentials). Replicamos su lógica apuntando al
      // endpoint correcto.
      async function signInWithPasskey(proof: string, callbackUrl: string): Promise<void> {
        const csrfRes = await fetch('/api/auth/csrf')
        const { csrfToken } = await csrfRes.json()
        const res = await fetch('/api/auth/callback/passkey', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Auth-Return-Redirect': '1' },
          body: new URLSearchParams({ proof, csrfToken, callbackUrl }),
        })
        const data = await res.json()
        window.location.href = data.url ?? callbackUrl
      }

      const callbackUrl = new URL(window.location.href).searchParams.get('callbackUrl') ?? '/entrar'

      // Pestañas. La visible la marca `data-login-tab` en el <html> (puesto por
      // el servidor, o por el script inline si hay una elección guardada); aquí
      // solo se sincroniza la accesibilidad y se atienden los cambios.
      type Pestana = 'cliente' | 'admin'
      const raiz = document.documentElement
      const lista = document.querySelector('.login-tabs') as HTMLElement
      const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.login-tab'))

      function mostrar(pestana: Pestana, opciones: { enfocar?: boolean; animar?: boolean } = {}) {
        raiz.dataset.loginTab = pestana
        for (const tab of tabs) {
          const activa = tab.dataset.tab === pestana
          tab.setAttribute('aria-selected', String(activa))
          tab.tabIndex = activa ? 0 : -1
        }
        const panel = document.getElementById(`panel-${pestana}`) as HTMLElement
        if (opciones.animar) {
          panel.classList.remove('entra')
          void panel.offsetWidth
          panel.classList.add('entra')
        }
        if (opciones.enfocar) {
          // Al primer campo útil, para que cambiar de pestaña y escribir sea un
          // solo gesto.
          const destino = pestana === 'cliente'
            ? document.getElementById('portal-email')
            : document.getElementById('clave-sustentacion') ?? document.getElementById('btn-github')
          destino?.focus()
        }
      }

      function elegir(pestana: Pestana, enfocarTab = false) {
        if (raiz.dataset.loginTab === pestana) return
        mostrar(pestana, { enfocar: !enfocarTab, animar: true })
        if (enfocarTab) tabs.find((t) => t.dataset.tab === pestana)?.focus()
        // Se recuerda solo lo que se elige a mano: así un rebote del middleware
        // (que abre en Admin) no le cambia la pestaña a nadie para la próxima.
        try { localStorage.setItem('login-pestana', pestana) } catch {}
      }

      mostrar((raiz.dataset.loginTab as Pestana) ?? 'cliente')
      requestAnimationFrame(() => lista.classList.add('listo'))

      for (const tab of tabs) {
        tab.addEventListener('click', () => elegir(tab.dataset.tab as Pestana))
        // Patrón de tablist del WAI-ARIA: flechas entre pestañas, Inicio/Fin a
        // los extremos. Con dos pestañas las cuatro teclas se reducen a "la otra".
        tab.addEventListener('keydown', (e) => {
          if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(e.key)) return
          e.preventDefault()
          const destino: Pestana =
            e.key === 'Home' ? 'cliente'
            : e.key === 'End' ? 'admin'
            : tab.dataset.tab === 'cliente' ? 'admin' : 'cliente'
          elegir(destino, true)
        })
      }
      const status = document.getElementById('login-status') as HTMLElement
      const githubBtn = document.getElementById('btn-github') as HTMLButtonElement
      const passkeyBtn = document.getElementById('btn-passkey') as HTMLButtonElement
      const passkeyLabel = document.getElementById('passkey-label') as HTMLElement

      // Clave de la sustentación. Solo existe en el DOM cuando el destino era una
      // ruta de la sustentación y la variable está configurada.
      const formSust = document.getElementById('form-sustentacion') as HTMLFormElement | null
      formSust?.addEventListener('submit', async (e) => {
        e.preventDefault()
        const campo = document.getElementById('clave-sustentacion') as HTMLInputElement
        status.classList.remove('err')
        status.textContent = 'Comprobando…'
        try {
          const res = await fetch('/api/sustentacion/acceso', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ password: campo.value }),
          })
          if (!res.ok) {
            const d = await res.json().catch(() => ({}))
            throw new Error(d.error ?? 'no se pudo entrar')
          }
          // Al destino original, que el servidor ya comprobó que es una ruta de
          // la sustentación antes de ofrecer siquiera este formulario. `replace`
          // para que volver atrás no traiga el formulario con la clave escrita.
          window.location.replace(callbackUrl)
        } catch (err) {
          status.classList.add('err')
          status.textContent = err instanceof Error ? err.message : 'no se pudo entrar'
        }
      })

      githubBtn.addEventListener('click', () => {
        githubBtn.disabled = true
        passkeyBtn.disabled = true
        // auth-astro/client re-exporta el tipo de opciones desde 'next-auth/react',
        // que no está instalado (solo se usa como tipo, no en runtime): TS no puede
        // resolverlo y ve el objeto de opciones como {}. Cast puntual, no afecta runtime.
        signIn('github', { callbackUrl } as Parameters<typeof signIn>[1])
      })

      passkeyBtn.addEventListener('click', async () => {
        githubBtn.disabled = true
        passkeyBtn.disabled = true
        status.classList.remove('err')
        passkeyLabel.textContent = 'Esperando la llave…'
        status.textContent = 'Toca tu llave de seguridad cuando parpadee.'
        try {
          const optRes = await fetch('/api/auth/webauthn/options', { method: 'POST' })
          if (!optRes.ok) throw new Error('no se pudo iniciar la verificación')
          const options = await optRes.json()

          const authResponse = await startAuthentication({ optionsJSON: options })

          const verifyRes = await fetch('/api/auth/webauthn/verify', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(authResponse),
          })
          const result = await verifyRes.json()
          if (!verifyRes.ok || !result.ok) throw new Error(result.error ?? 'no se pudo verificar la llave')

          status.textContent = 'Llave verificada, entrando…'
          await signInWithPasskey(result.proof, callbackUrl)
        } catch (err) {
          status.classList.add('err')
          status.textContent = err instanceof Error ? err.message : 'algo falló con la llave'
          passkeyLabel.textContent = 'Usar mi llave de seguridad'
          githubBtn.disabled = false
          passkeyBtn.disabled = false
        }
      })
    </script>
  </body>
</html>
