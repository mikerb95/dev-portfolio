---
import BaseLayout from '../../../../layouts/BaseLayout.astro'
import { getRoom } from '../../../../lib/fingerprint'
import { getDictionary, getLocaleFromUrl } from '../../../../i18n'

const locale = getLocaleFromUrl(Astro.url.pathname)
const r = getDictionary(locale).fpRoom

const roomId = Astro.params.room!
const room = await getRoom(roomId)

if (!room) {
  return new Response(null, { status: 404 })
}
---

<BaseLayout title={r.title} description={r.description} noindex>
  <div id="fp-root" data-room={roomId} class="max-w-[640px] mx-auto px-6 pt-28 pb-24">
    <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-8">
      <span class="w-1.5 h-1.5 rounded-full bg-cyan pulse-dot"></span>
      <span>{r.room} {roomId}</span>
    </div>

    <div id="consent-gate">
      <h1 class="text-3xl font-medium tracking-[-.02em] text-mask mb-4">{r.gateTitle}</h1>
      <p class="text-[14px] text-ink-100 leading-relaxed mb-6">
        {r.gateBody}
      </p>
      <button id="accept" class="w-full h-14 rounded-2xl bg-white text-zinc-900 text-[14px] font-medium hover:bg-zinc-100 transition-colors">
        {r.accept}
      </button>
    </div>

    <div id="result" class="hidden">
      <h1 class="text-3xl font-medium tracking-[-.02em] text-mask mb-2">
        {r.youAre} <span id="label-num" class="text-cyan">#?</span>
      </h1>
      <p id="returning-note" class="hidden text-[13px] text-ember mb-4">
        {r.returningNote}
      </p>
      <p class="text-[14px] text-ink-100 leading-relaxed mb-8">
        {r.revealed}
      </p>

      <div id="signals" class="space-y-3 mb-8"></div>

      <div class="rounded-2xl glass p-5">
        <div class="text-[10px] font-mono uppercase tracking-[.18em] text-ink-300 mb-1">{r.uniqueness}</div>
        <div class="text-2xl font-medium text-mask tabular-nums"><span id="entropy-bits">?</span> {r.bits}</div>
        <p class="text-[12px] text-ink-400 mt-2 leading-relaxed">
          {r.oddsPre} <span id="entropy-odds">?</span> {r.oddsPost}
        </p>
      </div>

      <p class="text-[12px] font-mono text-ink-400 mt-6 text-center">
        {r.watchBoard}
      </p>
    </div>
  </div>

  <script
    id="fp-room-i18n"
    type="application/json"
    set:html={JSON.stringify({
      collecting: r.collecting,
      retryError: r.retryError,
      empty: r.empty,
      intlLocale: locale === 'en' ? 'en-US' : 'es-CO',
    })}
  />
</BaseLayout>

<script>
  import { collectFingerprint, startBehaviorTracking, type BehaviorSample } from '../../../../lib/fingerprint-client'

  const root = document.getElementById('fp-root') as HTMLElement
  const roomId = root.dataset.room!
  const L = JSON.parse(document.getElementById('fp-room-i18n')!.textContent!) as Record<string, string>

  const esc = (v: unknown) => String(v ?? '').replace(/[&<>"']/g, (c) =>
    ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!))

  const acceptBtn = document.getElementById('accept') as HTMLButtonElement
  const gate = document.getElementById('consent-gate')!
  const result = document.getElementById('result')!

  let getSnapshot: (() => BehaviorSample) | null = null
  let deviceHash: string | null = null

  acceptBtn.addEventListener('click', async () => {
    acceptBtn.disabled = true
    acceptBtn.textContent = L.collecting

    // startBehaviorTracking pide el permiso de deviceorientation en iOS, que
    // exige gesto de usuario activo. Debe llamarse ANTES de cualquier await
    // (collectFingerprint espera audio + FingerprintJS): tras un await el gesto
    // ya se consumió y iOS rechaza el prompt, dejando el giroscopio muerto.
    getSnapshot = startBehaviorTracking()

    const fp = await collectFingerprint()
    deviceHash = fp.hash

    const res = await fetch(`/api/lab/fp/${roomId}/join`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ hash: fp.hash, entropyBits: fp.entropyBits, libFpHash: fp.libFpHash, signals: fp.signals }),
    })
    if (!res.ok) {
      acceptBtn.textContent = L.retryError
      acceptBtn.disabled = false
      return
    }
    const join = await res.json()

    gate.classList.add('hidden')
    result.classList.remove('hidden')
    document.getElementById('label-num')!.textContent = `#${join.label}`
    if (join.isReturning) document.getElementById('returning-note')!.classList.remove('hidden')

    const list = document.getElementById('signals')!
    for (const s of fp.signals) {
      const row = document.createElement('div')
      row.className = 'rounded-xl bg-white/[.02] border border-white/5 p-4'
      // esc() sobre display: el User-Agent es controlable por el usuario, no lo
      // inyectamos crudo aunque solo pueda afectarse a sí mismo.
      const dim = s.bits === 0 ? ' opacity-50' : ''
      row.innerHTML = `<div class="flex items-center justify-between mb-1"><span class="text-[11px] font-mono uppercase tracking-[.15em] text-ink-300">${esc(s.label)}</span><span class="text-[10px] font-mono text-ink-400">${s.bits} bit${s.bits === 1 ? '' : 's'}</span></div><div class="text-[13px] text-ink-100 break-all${dim}">${esc(s.display) || L.empty}</div>`
      list.appendChild(row)
    }
    document.getElementById('entropy-bits')!.textContent = fp.entropyBits.toFixed(0)
    document.getElementById('entropy-odds')!.textContent = Math.round(2 ** fp.entropyBits).toLocaleString(L.intlLocale)

    const beat = setInterval(async () => {
      if (!getSnapshot || !deviceHash) return
      const behavior = getSnapshot()
      const r = await fetch(`/api/lab/fp/${roomId}/beat`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ hash: deviceHash, behavior }),
      }).catch(() => null)
      // Si la sala expiró (404), no seguimos latiendo contra el vacío.
      if (r && r.status === 404) clearInterval(beat)
    }, 4000)
  })
</script>
