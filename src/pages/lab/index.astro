---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { db } from '../../db'
import { ciRuns, labExperiments, payments, paymentEvents, securityFindings } from '../../db/schema'
import { desc, gte, sql } from 'drizzle-orm'
import { getDictionary, getLocaleFromUrl, localizedHref } from '../../i18n'

const locale = getLocaleFromUrl(Astro.url.pathname)
const t = getDictionary(locale)
const lb = t.lab
const L = (path: string) => localizedHref(path, locale)

// Vitrina pública del LAB. Expone SOLO datos agregados o públicos por naturaleza
// (el repo y sus GitHub Actions son públicos): corridas de CI, experimentos con
// su veredicto, y contadores de la pasarela sandbox. Nunca payloads crudos,
// URLs de preview, flags de chaos activos ni parámetros de experimentos.

const DAY_MS = 86_400_000
const now = Date.now()
const since30 = new Date(now - 30 * DAY_MS)

// ── Pipeline CI/CD ──────────────────────────────────────────────────────────
const runs = await db
  .select({
    sha: ciRuns.sha,
    branch: ciRuns.branch,
    url: ciRuns.url,
    conclusion: ciRuns.conclusion,
    testsPassed: ciRuns.testsPassed,
    testsFailed: ciRuns.testsFailed,
    coveragePct: ciRuns.coveragePct,
    durationMs: ciRuns.durationMs,
    healthOk: ciRuns.healthOk,
    createdAt: ciRuns.createdAt,
  })
  .from(ciRuns)
  .orderBy(desc(ciRuns.createdAt))
  .limit(15)

const [ciAgg] = await db
  .select({
    total: sql<number>`count(*)`,
    ok: sql<number>`coalesce(sum(${ciRuns.conclusion} = 'success'), 0)`,
    avgMs: sql<number>`coalesce(avg(${ciRuns.durationMs}), 0)`,
  })
  .from(ciRuns)
  .where(gte(ciRuns.createdAt, since30))

const successRate30 = ciAgg.total > 0 ? Math.round((ciAgg.ok / ciAgg.total) * 1000) / 10 : null
const lastCoverage = runs.find((r) => r.coveragePct != null)?.coveragePct ?? null

// El mutation score se reporta como un ci_run más (mismo mecanismo), pero es
// semanal/manual: buscarlo solo en los últimos 15 runs lo perdería casi
// siempre entre pushes normales. Se busca aparte, sin ventana.
const [lastMutation] = await db
  .select({ mutationScore: ciRuns.mutationScore, createdAt: ciRuns.createdAt })
  .from(ciRuns)
  .where(sql`${ciRuns.mutationScore} is not null`)
  .orderBy(desc(ciRuns.createdAt))
  .limit(1)

// ── Hallazgos de seguridad/accesibilidad (agregados; sin título ni ruta) ────
// Solo se publica el conteo por estado: cuántos hay abiertos vs. cerrados. El
// detalle (qué es, dónde) vive en el panel - no le damos el mapa al atacante.
const [findingsAgg] = await db
  .select({
    open: sql<number>`coalesce(sum(${securityFindings.status} = 'open'), 0)`,
    resolved: sql<number>`coalesce(sum(${securityFindings.status} = 'resolved'), 0)`,
    accepted: sql<number>`coalesce(sum(${securityFindings.status} = 'accepted'), 0)`,
    total: sql<number>`count(*)`,
  })
  .from(securityFindings)
const hasFindings = findingsAgg.total > 0

// ── Experimentos (chaos + ataques a la pasarela) ────────────────────────────
// Agrupado por tipo: un mismo experimento se corre muchas veces (13 corridas de
// caída de BD ahogarían al resto en una lista cronológica). Lo que importa aquí
// es qué defensas se probaron y si alguna vez fallaron.
const experiments = await db
  .select({
    kind: labExperiments.kind,
    runs: sql<number>`count(*)`,
    ok: sql<number>`coalesce(sum(${labExperiments.ok}), 0)`,
    lastRunAt: sql<number>`max(${labExperiments.ranAt})`,
  })
  .from(labExperiments)
  .groupBy(labExperiments.kind)
  .orderBy(desc(sql`max(${labExperiments.ranAt})`))

const [expAgg] = await db
  .select({
    total: sql<number>`count(*)`,
    ok: sql<number>`coalesce(sum(${labExperiments.ok}), 0)`,
  })
  .from(labExperiments)

// Etiquetas amigables por tipo de experimento; el detalle crudo se queda en el
// panel. El `kind` es la clave técnica que escribe el experimento - no se
// traduce; lo que se traduce es su etiqueta legible.
const EXPERIMENT_LABELS: Record<string, string> = {
  'chaos:db_fail_midtx': lb.experiments.labels.dbFailMidtx,
  'payments:double_click': lb.experiments.labels.doubleClick,
  'payments:duplicate_webhook': lb.experiments.labels.duplicateWebhook,
  'payments:out_of_order': lb.experiments.labels.outOfOrder,
  'payments:race_condition': lb.experiments.labels.raceCondition,
}
const expLabel = (kind: string) => EXPERIMENT_LABELS[kind] ?? kind.replace(/[_:]/g, ' ')

// ── Pasarela sandbox: agregados de resiliencia ──────────────────────────────
const [payAgg] = await db
  .select({
    total: sql<number>`count(*)`,
    approved: sql<number>`coalesce(sum(${payments.status} = 'approved'), 0)`,
  })
  .from(payments)

const [evtAgg] = await db
  .select({
    total: sql<number>`count(*)`,
    duplicates: sql<number>`coalesce(sum(${paymentEvents.duplicate}), 0)`,
    outOfOrder: sql<number>`coalesce(sum(${paymentEvents.outOfOrder}), 0)`,
    mismatches: sql<number>`coalesce(sum(${paymentEvents.amountMismatch}), 0)`,
  })
  .from(paymentEvents)

const absorbed = evtAgg.duplicates + evtAgg.outOfOrder + evtAgg.mismatches

// ── Presentación ────────────────────────────────────────────────────────────
const fmtDate = new Intl.DateTimeFormat(locale === 'en' ? 'en-US' : 'es-CO', {
  day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit',
  timeZone: 'America/Bogota',
})

const fmtDuration = (ms: number | null) => {
  if (ms == null) return '-'
  const s = Math.round(ms / 1000)
  return s < 60 ? `${s}s` : `${Math.floor(s / 60)}m ${s % 60}s`
}

// Resumen de una corrida en una línea; se arma aquí para no arrastrar los saltos
// de línea del template al HTML.
const runMeta = (r: (typeof runs)[number]) =>
  [
    r.testsPassed != null ? `${r.testsPassed} ${lb.pipeline.testsLabel}` : null,
    r.testsFailed ? `${r.testsFailed} ${lb.pipeline.failedLabel}` : null,
    r.coveragePct != null ? `${Math.round(r.coveragePct * 10) / 10}% ${lb.pipeline.covLabel}` : null,
  ]
    .filter(Boolean)
    .join(' · ')

const runBadge = {
  success: { label: lb.pipeline.badgeOk, cls: 'text-lime border-lime/30 bg-lime/10' },
  failure: { label: lb.pipeline.badgeFailure, cls: 'text-ember border-ember/40 bg-ember/15' },
  rolled_back: { label: lb.pipeline.badgeRollback, cls: 'text-ember border-ember/30 bg-ember/10' },
} as const

// La tarjeta de SAST/a11y solo aparece en "En construcción" mientras no haya
// hallazgos ingeridos; en cuanto CI reporte, arriba se muestra la sección real.
const upcoming = [
  { title: lb.upcoming.k6Title, desc: lb.upcoming.k6Desc },
  ...(hasFindings ? [] : [{ title: lb.upcoming.sastTitle, desc: lb.upcoming.sastDesc }]),
  ...(lastMutation ? [] : [{ title: lb.upcoming.mutationTitle, desc: lb.upcoming.mutationDesc }]),
]
---

<BaseLayout title={lb.title} description={lb.description}>
  <div class="max-w-[1280px] mx-auto px-6 md:px-12 lg:px-20 pt-32 pb-24">

    <a href={L('/')} class="inline-flex items-center gap-2 text-[11px] font-mono uppercase tracking-[.2em] text-ink-300 hover:text-cyan transition-colors mb-12">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
      {t.common.back}
    </a>

    <header class="mb-12">
      <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-6">
        <span class="text-cyan">/lab</span>
        <span class="h-px flex-1 bg-gradient-to-r from-white/15 to-transparent max-w-[80px]"></span>
        <span>{lb.eyebrow}</span>
      </div>
      <h1 class="hero-line text-5xl md:text-6xl font-medium tracking-[-.035em] text-mask leading-[.95] mb-8">
        {lb.h1Line1}<br/>{lb.h1Line2}
      </h1>
      <p class="text-[16px] text-ink-100 max-w-xl leading-relaxed">
        {lb.intro}
      </p>
    </header>

    <!-- KPIs -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-16">
      <div class="rounded-2xl glass p-5">
        <div class={`font-mono text-[26px] leading-none tracking-tight ${successRate30 !== null && successRate30 >= 90 ? 'text-lime' : 'text-ember'}`}>
          {successRate30 === null ? '-' : `${successRate30}%`}
        </div>
        <div class="text-[10px] font-mono uppercase tracking-[.15em] text-ink-300 mt-2">{lb.kpi.pipelines}</div>
      </div>
      <div class="rounded-2xl glass p-5">
        <div class="font-mono text-[26px] leading-none tracking-tight text-ink-50">
          {lastCoverage === null ? '-' : `${Math.round(lastCoverage * 10) / 10}%`}
        </div>
        <div class="text-[10px] font-mono uppercase tracking-[.15em] text-ink-300 mt-2">{lb.kpi.coverage}</div>
      </div>
      <div class="rounded-2xl glass p-5">
        <div class={`font-mono text-[26px] leading-none tracking-tight ${expAgg.total > 0 && expAgg.ok === expAgg.total ? 'text-lime' : 'text-ink-50'}`}>
          {expAgg.ok}/{expAgg.total}
        </div>
        <div class="text-[10px] font-mono uppercase tracking-[.15em] text-ink-300 mt-2">{lb.kpi.experiments}</div>
      </div>
      <div class="rounded-2xl glass p-5">
        <div class="font-mono text-[26px] leading-none tracking-tight text-cyan">{absorbed}</div>
        <div class="text-[10px] font-mono uppercase tracking-[.15em] text-ink-300 mt-2">{lb.kpi.absorbed}</div>
      </div>
      {lastMutation && (
        <div class="rounded-2xl glass p-5" title={lb.kpi.mutationTitle}>
          <div class={`font-mono text-[26px] leading-none tracking-tight ${lastMutation.mutationScore! >= 80 ? 'text-lime' : lastMutation.mutationScore! >= 60 ? 'text-cyan' : 'text-ember'}`}>
            {Math.round(lastMutation.mutationScore! * 10) / 10}%
          </div>
          <div class="text-[10px] font-mono uppercase tracking-[.15em] text-ink-300 mt-2">{lb.kpi.mutationScore}</div>
        </div>
      )}
    </div>

    <!-- Pipeline CI/CD -->
    <section class="mb-16">
      <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-ink-400"></span>
        <span>{lb.pipeline.heading}</span>
      </div>
      <p class="text-[13px] text-ink-200 max-w-2xl leading-relaxed mb-6">
        {lb.pipeline.body}
      </p>
      {runs.length === 0 ? (
        <div class="rounded-2xl glass p-8">
          <p class="text-[13px] font-mono text-ink-300">{lb.pipeline.empty}</p>
        </div>
      ) : (
        <div class="rounded-2xl glass divide-y divide-white/5 overflow-hidden">
          {runs.map((r) => {
            const badge = runBadge[r.conclusion] ?? runBadge.failure
            return (
              <div class="p-4 md:px-6 flex flex-wrap items-center gap-x-4 gap-y-1 text-[13px]">
                <span class={`text-[10px] font-mono uppercase tracking-[.15em] px-2.5 py-1 rounded-full border ${badge.cls}`}>
                  {badge.label}
                </span>
                <span class="font-mono text-[12px] text-ink-100">
                  {r.url
                    ? <a href={r.url} target="_blank" rel="noopener" class="hover:text-cyan transition-colors">{r.sha.slice(0, 7)} ↗</a>
                    : r.sha.slice(0, 7)}
                </span>
                <span class="font-mono text-[11px] text-ink-300 hidden sm:inline">{runMeta(r)}</span>
                <span class="ml-auto font-mono text-[11px] text-ink-300">
                  {fmtDuration(r.durationMs)} · {r.createdAt ? fmtDate.format(r.createdAt) : '-'}
                </span>
              </div>
            )
          })}
        </div>
      )}
    </section>

    <!-- Experimentos -->
    <section class="mb-16">
      <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-ink-400"></span>
        <span>{lb.experiments.heading}</span>
      </div>
      <p class="text-[13px] text-ink-200 max-w-2xl leading-relaxed mb-6">
        {lb.experiments.body}
      </p>
      {experiments.length === 0 ? (
        <div class="rounded-2xl glass p-8">
          <p class="text-[13px] font-mono text-ink-300">{lb.experiments.empty}</p>
        </div>
      ) : (
        <div class="rounded-2xl glass divide-y divide-white/5">
          {experiments.map((e) => {
            const allOk = e.ok === e.runs
            return (
              <div class="p-4 md:px-6 flex flex-wrap items-center gap-x-4 gap-y-1 text-[13px]">
                <span class={`w-1.5 h-1.5 rounded-full shrink-0 ${allOk ? 'bg-lime' : 'bg-ember'}`}></span>
                <span class="text-ink-50">{expLabel(e.kind)}</span>
                <span class={`text-[10px] font-mono uppercase tracking-[.15em] ${allOk ? 'text-lime' : 'text-ember'}`}>
                  {allOk
                    ? `${e.runs} ${e.runs === 1 ? lb.experiments.runOne : lb.experiments.runMany} · ${lb.experiments.passed}`
                    : `${e.ok}/${e.runs} ${lb.experiments.passedRatio}`}
                </span>
                <span class="ml-auto font-mono text-[11px] text-ink-300">
                  {lb.experiments.last} {e.lastRunAt ? fmtDate.format(new Date(e.lastRunAt * 1000)) : '-'}
                </span>
              </div>
            )
          })}
        </div>
      )}
    </section>

    <!-- Seguridad & accesibilidad -->
    {hasFindings && (
      <section class="mb-16">
        <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-ink-400"></span>
          <span>{lb.findings.heading}</span>
        </div>
        <p class="text-[13px] text-ink-200 max-w-2xl leading-relaxed mb-6">
          {lb.findings.bodyPre} <span class="text-ink-50">{lb.findings.resolvedWord}</span>{' '}
          {lb.findings.bodyMid} <span class="text-ink-50">{lb.findings.acceptedWord}</span>.
        </p>
        <div class="grid grid-cols-3 gap-4 max-w-lg">
          <div class="rounded-2xl glass p-5">
            <div class={`font-mono text-[22px] leading-none ${findingsAgg.open > 0 ? 'text-ember' : 'text-lime'}`}>{findingsAgg.open}</div>
            <div class="text-[10px] font-mono uppercase tracking-[.15em] text-ink-300 mt-2">{lb.findings.open}</div>
          </div>
          <div class="rounded-2xl glass p-5">
            <div class="font-mono text-[22px] leading-none text-lime">{findingsAgg.resolved}</div>
            <div class="text-[10px] font-mono uppercase tracking-[.15em] text-ink-300 mt-2">{lb.findings.resolved}</div>
          </div>
          <div class="rounded-2xl glass p-5">
            <div class="font-mono text-[22px] leading-none text-cyan">{findingsAgg.accepted}</div>
            <div class="text-[10px] font-mono uppercase tracking-[.15em] text-ink-300 mt-2">{lb.findings.accepted}</div>
          </div>
        </div>
      </section>
    )}

    <!-- Pasarela sandbox -->
    <section class="mb-16">
      <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-ink-400"></span>
        <span>{lb.gateway.heading}</span>
      </div>
      <p class="text-[13px] text-ink-200 max-w-2xl leading-relaxed mb-6">
        {lb.gateway.bodyPre} <span class="text-ink-50">{lb.gateway.neutralizedWord}</span>{lb.gateway.bodyPost}
      </p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="rounded-2xl glass p-5">
          <div class="font-mono text-[22px] leading-none text-ink-50">{payAgg.total}</div>
          <div class="text-[10px] font-mono uppercase tracking-[.15em] text-ink-300 mt-2">{lb.gateway.payments}</div>
        </div>
        <div class="rounded-2xl glass p-5">
          <div class="font-mono text-[22px] leading-none text-lime">{evtAgg.duplicates}</div>
          <div class="text-[10px] font-mono uppercase tracking-[.15em] text-ink-300 mt-2">{lb.gateway.duplicates}</div>
        </div>
        <div class="rounded-2xl glass p-5">
          <div class="font-mono text-[22px] leading-none text-lime">{evtAgg.outOfOrder}</div>
          <div class="text-[10px] font-mono uppercase tracking-[.15em] text-ink-300 mt-2">{lb.gateway.outOfOrder}</div>
        </div>
        <div class="rounded-2xl glass p-5">
          <div class="font-mono text-[22px] leading-none text-lime">{evtAgg.mismatches}</div>
          <div class="text-[10px] font-mono uppercase tracking-[.15em] text-ink-300 mt-2">{lb.gateway.mismatches}</div>
        </div>
      </div>
    </section>

    <!-- Analizador de sitios -->
    <section class="mb-16">
      <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-ink-400"></span>
        <span>{lb.siteCheck.heading}</span>
      </div>
      <p class="text-[13px] text-ink-200 max-w-2xl leading-relaxed mb-6">
        {lb.siteCheck.bodyPre} <span class="text-ink-50">{lb.siteCheck.lighthouseWord}</span>{' '}
        {lb.siteCheck.bodyPost}
      </p>
      <a href={L('/lab/site-check')} class="inline-flex rounded-2xl glass p-6 lift group max-w-sm">
        <div>
          <h3 class="text-[14px] font-medium text-ink-50 mb-1.5">{lb.siteCheck.cardTitle}</h3>
          <p class="text-[12px] text-ink-300 leading-relaxed mb-3">
            {lb.siteCheck.cardBody}
          </p>
          <span class="text-[13px] text-cyan group-hover:underline">{lb.siteCheck.cardCta}</span>
        </div>
      </a>
    </section>

    <!-- Demo interactiva + enlaces -->
    <section class="grid md:grid-cols-3 gap-4 mb-16">
      <a href={L('/lab/fingerprint')} class="rounded-2xl glass p-6 lift group">
        <h3 class="text-[14px] font-medium text-ink-50 mb-1.5">{lb.cards.fingerprintTitle}</h3>
        <p class="text-[12px] text-ink-300 leading-relaxed mb-3">
          {lb.cards.fingerprintBody}
        </p>
        <span class="text-[13px] text-cyan group-hover:underline">{lb.cards.fingerprintCta}</span>
      </a>
      <a href={L('/status')} class="rounded-2xl glass p-6 lift group">
        <h3 class="text-[14px] font-medium text-ink-50 mb-1.5">{lb.cards.statusTitle}</h3>
        <p class="text-[12px] text-ink-300 leading-relaxed mb-3">
          {lb.cards.statusBody}
        </p>
        <span class="text-[13px] text-cyan group-hover:underline">{lb.cards.statusCta}</span>
      </a>
      <a href={L('/security')} class="rounded-2xl glass p-6 lift group">
        <h3 class="text-[14px] font-medium text-ink-50 mb-1.5">{lb.cards.securityTitle}</h3>
        <p class="text-[12px] text-ink-300 leading-relaxed mb-3">
          {lb.cards.securityBody}
        </p>
        <span class="text-[13px] text-cyan group-hover:underline">{lb.cards.securityCta}</span>
      </a>
    </section>

    <!-- Próximamente -->
    <section class="mb-16">
      <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-ink-400"></span>
        <span>{lb.upcoming.heading}</span>
      </div>
      <div class="grid md:grid-cols-3 gap-4">
        {upcoming.map((u) => (
          <div class="rounded-2xl border border-white/5 bg-white/[.02] p-6">
            <h3 class="text-[14px] font-medium text-ink-200 mb-1.5">{u.title}</h3>
            <p class="text-[12px] text-ink-400 leading-relaxed">{u.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Metodología -->
    <section class="rounded-2xl glass p-8">
      <div class="text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-4">{lb.methodology.heading}</div>
      <div class="grid md:grid-cols-3 gap-6 text-[13px] text-ink-100 leading-relaxed">
        <p>
          {lb.methodology.p1}
        </p>
        <p>
          {lb.methodology.p2Pre}{' '}
          <span class="text-ink-50">{lb.methodology.failOpenWord}</span>{lb.methodology.p2Post}
        </p>
        <p>
          {lb.methodology.p3}
        </p>
      </div>
    </section>

  </div>
</BaseLayout>

<script>
  import { initPageMotion } from '../../lib/motion-reveal'
  initPageMotion()
</script>
