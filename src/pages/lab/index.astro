---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { db } from '../../db'
import { ciRuns, labExperiments, loadTestRuns, payments, paymentEvents, securityFindings } from '../../db/schema'
import { desc, gte, sql } from 'drizzle-orm'
import { getDictionary, getLocaleFromUrl, interpolate, localizedHref } from '../../i18n'
import BancoEnsayo from '../../components/lab/BancoEnsayo.astro'
import PistaPipeline, { type FilaPista } from '../../components/lab/PistaPipeline.astro'
import CicloHallazgos from '../../components/lab/CicloHallazgos.astro'
import EscaleraCarga from '../../components/lab/EscaleraCarga.astro'
import { leerEscalones } from '../../lib/motion/lab-datos'
import type { Corridas, Experimento } from '../../lib/motion/ensayo'

const locale = getLocaleFromUrl(Astro.url.pathname)
const t = getDictionary(locale)
const lb = t.lab
const mo = lb.motion
const L = (path: string) => localizedHref(path, locale)

// Vitrina pública del LAB. Expone SOLO datos agregados o públicos por naturaleza
// (el repo y sus GitHub Actions son públicos): corridas de CI, experimentos con
// su veredicto, y contadores de la pasarela sandbox. Nunca payloads crudos,
// URLs de preview, flags de chaos activos ni parámetros de experimentos.

const DAY_MS = 86_400_000
const now = Date.now()
const since30 = new Date(now - 30 * DAY_MS)

// ── Pipeline CI/CD ──────────────────────────────────────────────────────────
const runs = await db
  .select({
    sha: ciRuns.sha,
    branch: ciRuns.branch,
    url: ciRuns.url,
    conclusion: ciRuns.conclusion,
    testsPassed: ciRuns.testsPassed,
    testsFailed: ciRuns.testsFailed,
    coveragePct: ciRuns.coveragePct,
    durationMs: ciRuns.durationMs,
    healthOk: ciRuns.healthOk,
    createdAt: ciRuns.createdAt,
  })
  .from(ciRuns)
  .orderBy(desc(ciRuns.createdAt))
  .limit(15)

const [ciAgg] = await db
  .select({
    total: sql<number>`count(*)`,
    ok: sql<number>`coalesce(sum(${ciRuns.conclusion} = 'success'), 0)`,
    avgMs: sql<number>`coalesce(avg(${ciRuns.durationMs}), 0)`,
  })
  .from(ciRuns)
  .where(gte(ciRuns.createdAt, since30))

const successRate30 = ciAgg.total > 0 ? Math.round((ciAgg.ok / ciAgg.total) * 1000) / 10 : null
const lastCoverage = runs.find((r) => r.coveragePct != null)?.coveragePct ?? null

// El mutation score se reporta como un ci_run más (mismo mecanismo), pero es
// semanal/manual: buscarlo solo en los últimos 15 runs lo perdería casi
// siempre entre pushes normales. Se busca aparte, sin ventana.
const [lastMutation] = await db
  .select({ mutationScore: ciRuns.mutationScore, createdAt: ciRuns.createdAt })
  .from(ciRuns)
  .where(sql`${ciRuns.mutationScore} is not null`)
  .orderBy(desc(ciRuns.createdAt))
  .limit(1)

// ── Hallazgos de seguridad/accesibilidad (agregados; sin título ni ruta) ────
// Solo se publica el conteo por estado: cuántos hay abiertos vs. cerrados. El
// detalle (qué es, dónde) vive en el panel - no le damos el mapa al atacante.
const [findingsAgg] = await db
  .select({
    open: sql<number>`coalesce(sum(${securityFindings.status} = 'open'), 0)`,
    resolved: sql<number>`coalesce(sum(${securityFindings.status} = 'resolved'), 0)`,
    accepted: sql<number>`coalesce(sum(${securityFindings.status} = 'accepted'), 0)`,
    total: sql<number>`count(*)`,
  })
  .from(securityFindings)
const hasFindings = findingsAgg.total > 0

// ── Load testing (k6) ───────────────────────────────────────────────────────
// Solo la última corrida de estrés, que es la que responde las tres preguntas
// (capacidad, quiebre, recuperación). Una fila, no una agregación: la tabla
// crece una fila por corrida manual, así que esto no repite el problema de
// coste de escanear monitor_checks en una ruta pública.
//
// OPSEC: se publica el comportamiento, nunca el objetivo. La URL del target es
// un entorno desechable, pero decir en público contra qué se corre es decir
// dónde hay un entorno menos vigilado que producción.
const [lastLoad] = await db
  .select({
    scenario: loadTestRuns.scenario,
    p95: loadTestRuns.p95,
    sustainedRps: loadTestRuns.sustainedRps,
    breakingPointRps: loadTestRuns.breakingPointRps,
    recoveredAfterS: loadTestRuns.recoveredAfterS,
    stepsJson: loadTestRuns.stepsJson,
    ranAt: loadTestRuns.ranAt,
  })
  .from(loadTestRuns)
  .where(sql`${loadTestRuns.scenario} = 'estres'`)
  .orderBy(desc(loadTestRuns.ranAt))
  .limit(1)

// La escalera se dibuja con los escalones de esa misma fila (unos pocos KB).
const escalones = leerEscalones(lastLoad?.stepsJson ?? null)

// ── Experimentos (chaos + ataques a la pasarela) ────────────────────────────
// Agrupado por tipo: un mismo experimento se corre muchas veces (13 corridas de
// caída de BD ahogarían al resto en una lista cronológica). Lo que importa aquí
// es qué defensas se probaron y si alguna vez fallaron.
const experiments = await db
  .select({
    kind: labExperiments.kind,
    runs: sql<number>`count(*)`,
    ok: sql<number>`coalesce(sum(${labExperiments.ok}), 0)`,
    lastRunAt: sql<number>`max(${labExperiments.ranAt})`,
  })
  .from(labExperiments)
  .groupBy(labExperiments.kind)
  .orderBy(desc(sql`max(${labExperiments.ranAt})`))

const [expAgg] = await db
  .select({
    total: sql<number>`count(*)`,
    ok: sql<number>`coalesce(sum(${labExperiments.ok}), 0)`,
  })
  .from(labExperiments)

// El banco de ensayo del hero reproduce cada experimento y sella con sus
// corridas reales, agrupadas por `kind` (la clave técnica que escribe el
// experimento).
const corridas: Partial<Record<Experimento, Corridas>> = Object.fromEntries(
  experiments.map((e) => [e.kind, { runs: Number(e.runs), ok: Number(e.ok), lastRunAt: e.lastRunAt ? Number(e.lastRunAt) : null }]),
)

// ── Pasarela sandbox: agregados de resiliencia ──────────────────────────────
const [payAgg] = await db
  .select({
    total: sql<number>`count(*)`,
    approved: sql<number>`coalesce(sum(${payments.status} = 'approved'), 0)`,
  })
  .from(payments)

const [evtAgg] = await db
  .select({
    total: sql<number>`count(*)`,
    duplicates: sql<number>`coalesce(sum(${paymentEvents.duplicate}), 0)`,
    outOfOrder: sql<number>`coalesce(sum(${paymentEvents.outOfOrder}), 0)`,
    mismatches: sql<number>`coalesce(sum(${paymentEvents.amountMismatch}), 0)`,
  })
  .from(paymentEvents)

const absorbed = evtAgg.duplicates + evtAgg.outOfOrder + evtAgg.mismatches

// ── Presentación ────────────────────────────────────────────────────────────
const fmtDate = new Intl.DateTimeFormat(locale === 'en' ? 'en-US' : 'es-CO', {
  day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit',
  timeZone: 'America/Bogota',
})

const fmtDuration = (ms: number | null) => {
  if (ms == null) return '-'
  const s = Math.round(ms / 1000)
  return s < 60 ? `${s}s` : `${Math.floor(s / 60)}m ${s % 60}s`
}

// Resumen de una corrida en una línea; se arma aquí para no arrastrar los saltos
// de línea del template al HTML.
const runMeta = (r: (typeof runs)[number]) =>
  [
    r.testsPassed != null ? `${r.testsPassed} ${lb.pipeline.testsLabel}` : null,
    r.testsFailed ? `${r.testsFailed} ${lb.pipeline.failedLabel}` : null,
    r.coveragePct != null ? `${Math.round(r.coveragePct * 10) / 10}% ${lb.pipeline.covLabel}` : null,
  ]
    .filter(Boolean)
    .join(' · ')

const badgeDe: Record<string, string> = {
  success: lb.pipeline.badgeOk,
  failure: lb.pipeline.badgeFailure,
  rolled_back: lb.pipeline.badgeRollback,
}
const filasPista: FilaPista[] = runs.map((r) => ({
  sha: r.sha,
  url: r.url,
  conclusion: r.conclusion,
  healthOk: r.healthOk,
  badge: badgeDe[r.conclusion] ?? lb.pipeline.badgeFailure,
  meta: runMeta(r),
  cuando: `${fmtDuration(r.durationMs)} · ${r.createdAt ? fmtDate.format(r.createdAt) : '-'}`,
}))

// Las 12 pruebas del analizador, por el nombre corto que usa su código.
const PRUEBAS = ['http', 'tls', 'https', 'headers', 'dns', 'rdap', 'robots', 'sitemap', 'seo', 'perf', 'a11y', 'lighthouse']

// La tarjeta de SAST/a11y solo aparece en "En construcción" mientras no haya
// hallazgos ingeridos; en cuanto CI reporte, arriba se muestra la sección real.
const upcoming = [
  ...(lastLoad ? [] : [{ title: lb.upcoming.k6Title, desc: lb.upcoming.k6Desc }]),
  ...(hasFindings ? [] : [{ title: lb.upcoming.sastTitle, desc: lb.upcoming.sastDesc }]),
  ...(lastMutation ? [] : [{ title: lb.upcoming.mutationTitle, desc: lb.upcoming.mutationDesc }]),
]
---

<BaseLayout title={lb.title} description={lb.description}>
  <div class="max-w-[1280px] mx-auto px-6 md:px-12 lg:px-20 pt-32 pb-24">

    <a href={L('/')} class="inline-flex items-center gap-2 text-[11px] font-mono uppercase tracking-[.2em] text-ink-300 hover:text-cyan transition-colors mb-12">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
      {t.common.back}
    </a>

    <header class="lb-hero mb-14">
      <div>
        <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-6" data-hero-sigue>
          <span class="text-cyan">/lab</span>
          <span class="h-px flex-1 bg-gradient-to-r from-white/15 to-transparent max-w-[80px]"></span>
          <span>{lb.eyebrow}</span>
        </div>
        <h1 class="text-[42px] sm:text-5xl xl:text-[56px] font-medium tracking-[-.035em] leading-[.98] mb-8">
          <span data-hero-linea class="block text-ink-50 lb-balance">{lb.h1Line1}</span>{' '}
          <span data-hero-linea class="block text-cyan lb-balance">{lb.h1Line2}</span>
        </h1>
        <p class="text-[16px] text-ink-100 max-w-xl leading-relaxed mb-5" data-hero-sigue>
          {lb.intro}
        </p>
        <p class="text-[13px] text-ink-300 max-w-xl leading-relaxed" data-hero-sigue>
          {lb.experiments.body}
        </p>
      </div>
      <div class="lb-hero-pieza" data-hero-pieza>
        <BancoEnsayo corridas={corridas} />
      </div>
    </header>

    <!-- KPIs: una sola franja de lecturas, como la cara de un instrumento. Sin
         entrada escalonada: las celdas escondidas dejarían ver la franja vacía,
         y el odómetro ya es la entrada. -->
    <dl class="lb-kpis mb-20" style={`--kpis: ${lastMutation ? 5 : 4}`}>
      <div class="lb-kpi">
        <dt class="lb-kpi-rot">{lb.kpi.pipelines}</dt>
        <dd class={`lb-kpi-valor ${successRate30 !== null && successRate30 >= 90 ? 'text-lime' : 'text-ember'}`} data-odometro data-odometro-inicio="top bottom">
          {successRate30 === null ? '-' : `${successRate30}%`}
        </dd>
      </div>
      <div class="lb-kpi">
        <dt class="lb-kpi-rot">{lb.kpi.coverage}</dt>
        <dd class="lb-kpi-valor text-ink-50" data-odometro data-odometro-inicio="top bottom">
          {lastCoverage === null ? '-' : `${Math.round(lastCoverage * 10) / 10}%`}
        </dd>
      </div>
      <div class="lb-kpi">
        <dt class="lb-kpi-rot">{lb.kpi.experiments}</dt>
        <dd class={`lb-kpi-valor ${expAgg.total > 0 && expAgg.ok === expAgg.total ? 'text-lime' : 'text-ink-50'}`} data-odometro data-odometro-inicio="top bottom">
          {expAgg.ok}/{expAgg.total}
        </dd>
      </div>
      <div class="lb-kpi">
        <dt class="lb-kpi-rot">{lb.kpi.absorbed}</dt>
        <dd class="lb-kpi-valor text-cyan" data-odometro data-odometro-inicio="top bottom">{absorbed}</dd>
      </div>
      {lastMutation && (
        <div class="lb-kpi" title={lb.kpi.mutationTitle}>
          <dt class="lb-kpi-rot">{lb.kpi.mutationScore}</dt>
          <dd class={`lb-kpi-valor ${lastMutation.mutationScore! >= 80 ? 'text-lime' : lastMutation.mutationScore! >= 60 ? 'text-cyan' : 'text-ember'}`} data-odometro data-odometro-inicio="top bottom">
            {Math.round(lastMutation.mutationScore! * 10) / 10}%
          </dd>
        </div>
      )}
    </dl>

    <!-- Pipeline CI/CD -->
    <section class="mb-16">
      <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-ink-400"></span>
        <span>{lb.pipeline.heading}</span>
      </div>
      <p class="text-[13px] text-ink-200 max-w-2xl leading-relaxed mb-6">
        {lb.pipeline.body}
      </p>
      {runs.length === 0 ? (
        <div class="rounded-2xl glass p-8">
          <p class="text-[13px] font-mono text-ink-300">{lb.pipeline.empty}</p>
        </div>
      ) : (
        <PistaPipeline filas={filasPista} />
      )}
    </section>

    <!-- Seguridad & accesibilidad -->
    {hasFindings && (
      <section class="mb-16">
        <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-ink-400"></span>
          <span>{lb.findings.heading}</span>
        </div>
        <p class="text-[13px] text-ink-200 max-w-2xl leading-relaxed mb-6">
          {lb.findings.bodyPre} <span class="text-ink-50">{lb.findings.resolvedWord}</span>{' '}
          {lb.findings.bodyMid} <span class="text-ink-50">{lb.findings.acceptedWord}</span>.
        </p>
        <CicloHallazgos conteo={{ open: Number(findingsAgg.open), resolved: Number(findingsAgg.resolved), accepted: Number(findingsAgg.accepted) }} />
      </section>
    )}

    <!-- Load testing -->
    {lastLoad && (
      <section class="mb-16">
        <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-ink-400"></span>
          <span>{lb.load.heading}</span>
        </div>
        <p class="text-[13px] text-ink-200 max-w-2xl leading-relaxed mb-6">
          {lb.load.bodyPre} <span class="text-ink-50">{lb.load.breakWord}</span> {lb.load.bodyPost}
        </p>
        {escalones.length > 0 && <EscaleraCarga pasos={escalones} recuperadoS={lastLoad.recoveredAfterS} />}
        <dl class="lb-kpis" style="--kpis: 4">
          <div class="lb-kpi">
            <dt class="lb-kpi-rot">{lb.load.sustained}</dt>
            <dd class="lb-kpi-valor lb-kpi-sm text-lime" data-odometro>
              {lastLoad.sustainedRps === null ? '-' : `${Math.round(lastLoad.sustainedRps)}/s`}
            </dd>
          </div>
          <div class="lb-kpi">
            <dt class="lb-kpi-rot">{lb.load.breaking}</dt>
            <dd class="lb-kpi-valor lb-kpi-sm text-ember" data-odometro>
              {lastLoad.breakingPointRps === null ? lb.load.noBreak : `${Math.round(lastLoad.breakingPointRps)}/s`}
            </dd>
          </div>
          <div class="lb-kpi">
            <dt class="lb-kpi-rot">{lb.load.recovery}</dt>
            <dd class="lb-kpi-valor lb-kpi-sm text-ink-50" data-odometro>
              {lastLoad.recoveredAfterS === null ? lb.load.noRecovery : `${lastLoad.recoveredAfterS}s`}
            </dd>
          </div>
          <div class="lb-kpi">
            <dt class="lb-kpi-rot">{lb.load.p95}</dt>
            <dd class="lb-kpi-valor lb-kpi-sm text-ink-50" data-odometro>
              {lastLoad.p95 === null ? '-' : lastLoad.p95 >= 1000 ? `${(lastLoad.p95 / 1000).toFixed(1)}s` : `${Math.round(lastLoad.p95)}ms`}
            </dd>
          </div>
        </dl>
      </section>
    )}

    <!-- Pasarela sandbox -->
    <section class="mb-16">
      <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-ink-400"></span>
        <span>{lb.gateway.heading}</span>
      </div>
      <p class="text-[13px] text-ink-200 max-w-2xl leading-relaxed mb-6">
        {lb.gateway.bodyPre} <span class="text-ink-50">{lb.gateway.neutralizedWord}</span>{lb.gateway.bodyPost}
      </p>
      <!-- Cada contador nombra la defensa que lo neutralizó, con el mismo
           número que tiene en el banco de ensayo del hero. -->
      <dl class="lb-kpis" style="--kpis: 4">
        <div class="lb-kpi">
          <dt class="lb-kpi-rot">{lb.gateway.payments}</dt>
          <dd class="lb-kpi-valor lb-kpi-sm text-ink-50" data-odometro>{payAgg.total}</dd>
        </div>
        {[
          { n: evtAgg.duplicates, rot: lb.gateway.duplicates, defensa: `2 · ${mo.banco.guardas.visto}` },
          { n: evtAgg.outOfOrder, rot: lb.gateway.outOfOrder, defensa: `3 · ${mo.banco.guardas.legal}` },
          { n: evtAgg.mismatches, rot: lb.gateway.mismatches, defensa: mo.pasarela.montos },
        ].map((c) => (
          <div class="lb-kpi">
            <dt class="lb-kpi-rot">{c.rot}</dt>
            <dd class="lb-kpi-valor lb-kpi-sm text-lime" data-odometro>{c.n}</dd>
            <dd class="lb-defensa"><span aria-hidden="true"></span>{mo.pasarela.defensa} {c.defensa}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- Analizador de sitios -->
    <section class="mb-16">
      <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-ink-400"></span>
        <span>{lb.siteCheck.heading}</span>
      </div>
      <p class="text-[13px] text-ink-200 max-w-2xl leading-relaxed mb-6">
        {lb.siteCheck.bodyPre} <span class="text-ink-50">{lb.siteCheck.lighthouseWord}</span>{' '}
        {lb.siteCheck.bodyPost}
      </p>
      <a href={L('/lab/site-check')} class="lb-analizador rounded-2xl glass lift group">
        <div class="p-6">
          <h3 class="text-[14px] font-medium text-ink-50 mb-1.5">{lb.siteCheck.cardTitle}</h3>
          <p class="text-[12px] text-ink-300 leading-relaxed mb-3">
            {lb.siteCheck.cardBody}
          </p>
          <span class="text-[13px] text-cyan group-hover:underline">{lb.siteCheck.cardCta}</span>
        </div>
        <!-- Las 12 pruebas corriendo en paralelo y llegando en desorden, como
             las transmite el analizador (streaming NDJSON). Sin resultados:
             aquí no se analiza nada, y un rojo o un verde serían inventados. -->
        <div class="lb-an-panel" data-analizador aria-hidden="true">
          <div class="lb-an-cab">
            <span class="lb-an-host">{t.siteCheck.inputPlaceholder}</span>
            <span class="lb-an-cuenta" data-an-cuenta>{interpolate(mo.analizador.pruebas, { n: PRUEBAS.length, total: PRUEBAS.length })}</span>
          </div>
          <div class="lb-an-rejilla">
            {PRUEBAS.map((p) => <span class="lb-an-prueba" data-an-prueba data-hecha="">{p}</span>)}
          </div>
          <span class="lb-an-nota">{mo.analizador.ilustrativo}</span>
        </div>
      </a>
    </section>

    <!-- Demo interactiva + enlaces -->
    <section class="grid md:grid-cols-3 gap-4 mb-16" data-foco data-entrada>
      <a href={L('/lab/fingerprint')} class="foco rounded-2xl glass p-6 lift group">
        <h3 class="text-[14px] font-medium text-ink-50 mb-1.5">{lb.cards.fingerprintTitle}</h3>
        <p class="text-[12px] text-ink-300 leading-relaxed mb-3">
          {lb.cards.fingerprintBody}
        </p>
        <span class="text-[13px] text-cyan group-hover:underline">{lb.cards.fingerprintCta}</span>
      </a>
      <a href={L('/status')} class="foco rounded-2xl glass p-6 lift group">
        <h3 class="text-[14px] font-medium text-ink-50 mb-1.5">{lb.cards.statusTitle}</h3>
        <p class="text-[12px] text-ink-300 leading-relaxed mb-3">
          {lb.cards.statusBody}
        </p>
        <span class="text-[13px] text-cyan group-hover:underline">{lb.cards.statusCta}</span>
      </a>
      <a href={L('/security')} class="foco rounded-2xl glass p-6 lift group">
        <h3 class="text-[14px] font-medium text-ink-50 mb-1.5">{lb.cards.securityTitle}</h3>
        <p class="text-[12px] text-ink-300 leading-relaxed mb-3">
          {lb.cards.securityBody}
        </p>
        <span class="text-[13px] text-cyan group-hover:underline">{lb.cards.securityCta}</span>
      </a>
    </section>

    <!-- Próximamente -->
    {upcoming.length > 0 && (
    <section class="mb-16">
      <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-ink-400"></span>
        <span>{lb.upcoming.heading}</span>
      </div>
      <div class="grid md:grid-cols-3 gap-4">
        {upcoming.map((u) => (
          <div class="rounded-2xl border border-white/5 bg-white/[.02] p-6">
            <h3 class="text-[14px] font-medium text-ink-200 mb-1.5">{u.title}</h3>
            <p class="text-[12px] text-ink-400 leading-relaxed">{u.desc}</p>
          </div>
        ))}
      </div>
    </section>
    )}

    <!-- Metodología -->
    <section class="rounded-2xl glass p-8">
      <div class="text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-4">{lb.methodology.heading}</div>
      <div class="grid md:grid-cols-3 gap-6 text-[13px] text-ink-100 leading-relaxed" data-entrada>
        <p>
          {lb.methodology.p1}
        </p>
        <p>
          {lb.methodology.p2Pre}{' '}
          <span class="text-ink-50">{lb.methodology.failOpenWord}</span>{lb.methodology.p2Post}
        </p>
        <p>
          {lb.methodology.p3}
        </p>
      </div>
    </section>

  </div>
</BaseLayout>

<script>
  // Mismo lenguaje que las demás páginas con motion (Lenis + GSAP, montaje
  // común en src/lib/motion/landing.ts) más las piezas de esta página.
  import { montarLanding } from '../../lib/motion/landing'
  import { montarBanco } from '../../lib/motion/ensayo-vivo'
  import { montarSecciones } from '../../lib/motion/lab'

  const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const banco = document.querySelector<HTMLElement>('[data-banco]')
  if (banco) {
    try {
      montarBanco(banco, { reducido })
    } catch (err) {
      // Fail-open: el experimento resuelto que pintó el servidor sigue ahí.
      console.warn('[lab] banco sin motion', err)
      delete banco.dataset.vivo
    }
  }
  montarSecciones({ reducido })
  montarLanding()
</script>

