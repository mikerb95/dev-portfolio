---
import BaseLayout from '../layouts/BaseLayout.astro'
import CertCard from '../components/CertCard.astro'
import { db } from '../db'
import { educationMilestones, skillTracks, skillSessions, skillMilestones } from '../db/schema'
import { eq, desc, sql } from 'drizzle-orm'
import { getDictionary, getLocaleFromUrl, localizedHref } from '../i18n'
import { computeStreak, dayKeyOf } from '../lib/skills'

const locale = getLocaleFromUrl(Astro.url.pathname)
const t = getDictionary(locale)
const cert = t.certifications
const L = (path: string) => localizedHref(path, locale)

const certs = await db
  .select()
  .from(educationMilestones)
  .where(eq(educationMilestones.isPublic, true))
  .orderBy(desc(educationMilestones.completedDate), desc(educationMilestones.createdAt))

// Resumen agregado de los tracks del tracker privado que estén marcados como
// públicos. Solo cifras: horas, porcentaje del temario y racha. La bitácora y
// los hitos individuales no salen del panel (misma regla de OPSEC que /status).
const publicTracks = await db
  .select()
  .from(skillTracks)
  .where(eq(skillTracks.isPublic, true))
  .orderBy(desc(skillTracks.isActive), skillTracks.name)

const today = dayKeyOf()
const specializations = await Promise.all(
  publicTracks.map(async (t) => {
    const [days, milestoneStats] = await Promise.all([
      db
        .select({ day: skillSessions.day, minutes: sql<number>`sum(${skillSessions.minutes})` })
        .from(skillSessions)
        .where(eq(skillSessions.trackId, t.id))
        .groupBy(skillSessions.day),
      db
        .select({
          total: sql<number>`count(*)`,
          done: sql<number>`sum(case when ${skillMilestones.status} = 'hecho' then 1 else 0 end)`,
        })
        .from(skillMilestones)
        .where(eq(skillMilestones.trackId, t.id)),
    ])

    const sessions = days.map((d) => ({ day: d.day, minutes: Number(d.minutes) }))
    const totalMinutes = sessions.reduce((acc, s) => acc + s.minutes, 0)
    const total = Number(milestoneStats[0]?.total ?? 0)
    const done = Number(milestoneStats[0]?.done ?? 0)

    return {
      name: t.name,
      tagline: t.tagline,
      startedOn: t.startedOn,
      hours: Math.round(totalMinutes / 60),
      pct: total > 0 ? Math.round((done / total) * 100) : 0,
      recordStreak: computeStreak(sessions, today).record,
    }
  })
)
// Un track recién sembrado, sin una sola sesión, no dice nada bueno en público.
const visibleSpecializations = specializations.filter((s) => s.hours > 0 || s.pct > 0)

const byStatus = {
  en_curso: certs.filter((c) => c.status === 'en_curso'),
  completado: certs.filter((c) => c.status === 'completado'),
  pausado: certs.filter((c) => c.status === 'pausado'),
}
---

<BaseLayout title={cert.title} description={cert.description} image="/og-certifications.png">
  <div class="max-w-[1280px] mx-auto px-6 md:px-12 lg:px-20 pt-32 pb-24">

    <!-- Back -->
    <a href={L('/')} class="inline-flex items-center gap-2 text-[11px] font-mono uppercase tracking-[.2em] text-ink-300 hover:text-cyan transition-colors mb-12">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
      {t.common.back}
    </a>

    <header class="mb-16">
      <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-6">
        <span class="text-cyan">/certifications</span>
        <span class="h-px flex-1 bg-gradient-to-r from-white/15 to-transparent max-w-[80px]"></span>
        <span>{cert.eyebrow}</span>
      </div>
      <h1 class="hero-line text-5xl md:text-6xl font-medium tracking-[-.035em] text-mask leading-[.95] mb-8">
        {cert.h1Line1}<br/>{cert.h1Line2}
      </h1>
      <p class="text-[16px] text-ink-100 max-w-xl leading-relaxed">
        {cert.intro}
      </p>
    </header>

    {certs.length === 0 && (
      <div class="rounded-2xl glass p-12 text-center">
        <p class="text-[13px] font-mono text-ink-300">{cert.empty}</p>
      </div>
    )}

    {byStatus.en_curso.length > 0 && (
      <section class="mb-16">
        <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-cyan pulse-dot"></span>
          <span>{cert.statusInProgress}</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {byStatus.en_curso.map((c) => <CertCard cert={c} />)}
        </div>
      </section>
    )}

    {byStatus.completado.length > 0 && (
      <section class="mb-16">
        <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-lime"></span>
          <span>{cert.statusCompletedSection}</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {byStatus.completado.map((c) => <CertCard cert={c} />)}
        </div>
      </section>
    )}

    {byStatus.pausado.length > 0 && (
      <section>
        <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-ink-400"></span>
          <span>{cert.statusPausedSection}</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {byStatus.pausado.map((c) => <CertCard cert={c} />)}
        </div>
      </section>
    )}

    <!-- CTA Cards -->
    <section class="mt-20">
      <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-6">
        <span class="text-cyan">//</span>
        <span>{cert.fullProfile.heading}</span>
        <span class="h-px flex-1 bg-gradient-to-r from-white/15 to-transparent max-w-[80px]"></span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

        <!-- Platzi -->
        <a
          href="https://platzi.com/p/MichaelRodriguez/"
          target="_blank"
          rel="noopener"
          class="group rounded-2xl glass lift p-6 flex items-center gap-5 hover:border-cyan/30 transition-colors border border-white/5"
        >
          <div class="w-12 h-12 rounded-xl bg-[#98CA3F]/10 border border-[#98CA3F]/20 flex items-center justify-center shrink-0">
            <svg width="24" height="24" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M16 0C7.163 0 0 7.163 0 16s7.163 16 16 16 16-7.163 16-16S24.837 0 16 0z" fill="#98CA3F"/>
              <path d="M10.5 22.5V9.5l11 6.5-11 6.5z" fill="white"/>
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-[13px] font-mono uppercase tracking-[.12em] text-ink-300 mb-0.5">{cert.fullProfile.platziLabel}</p>
            <p class="text-[15px] font-medium text-ink-50 leading-snug">{cert.fullProfile.platziTitle}</p>
            <p class="text-[12px] text-ink-300 mt-1">{cert.fullProfile.platziDetail}</p>
          </div>
          <svg class="text-ink-400 group-hover:text-cyan transition-colors shrink-0" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
        </a>

        <!-- LinkedIn -->
        <a
          href="https://www.linkedin.com/in/mdrb95/"
          target="_blank"
          rel="noopener"
          class="group rounded-2xl glass lift p-6 flex items-center gap-5 hover:border-cyan/30 transition-colors border border-white/5"
        >
          <div class="w-12 h-12 rounded-xl bg-[#0A66C2]/10 border border-[#0A66C2]/20 flex items-center justify-center shrink-0">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="#0A66C2" xmlns="http://www.w3.org/2000/svg">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-[13px] font-mono uppercase tracking-[.12em] text-ink-300 mb-0.5">{cert.fullProfile.linkedinLabel}</p>
            <p class="text-[15px] font-medium text-ink-50 leading-snug">{cert.fullProfile.linkedinTitle}</p>
            <p class="text-[12px] text-ink-300 mt-1">{cert.fullProfile.linkedinDetail}</p>
          </div>
          <svg class="text-ink-400 group-hover:text-cyan transition-colors shrink-0" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
        </a>

      </div>
    </section>

  </div>
</BaseLayout>

<script>
  import { initPageMotion } from '../lib/motion-reveal'
  initPageMotion()
</script>
