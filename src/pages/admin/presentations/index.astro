---
// Hub de presentaciones: reúne los dos tipos que conviven en el repo y que
// antes no tenían un lugar común — los decks escritos en código (reveal.js,
// registrados en src/data/presentaciones.ts) y las presentaciones de cliente
// que viven en la base con control remoto por proyecto.
import AdminLayout from '../../../layouts/AdminLayout.astro'
import { db } from '../../../db'
import { projects, presentations, presentationSlides } from '../../../db/schema'
import { eq, desc, count } from 'drizzle-orm'
import { DECKS } from '../../../data/presentaciones'

const presRows = await db
  .select({
    id: presentations.id,
    title: presentations.title,
    currentSlide: presentations.currentSlide,
    isActive: presentations.isActive,
    shareToken: presentations.shareToken,
    projectId: presentations.projectId,
    projectTitle: projects.title,
    slideCount: count(presentationSlides.id),
  })
  .from(presentations)
  .leftJoin(projects, eq(presentations.projectId, projects.id))
  .leftJoin(presentationSlides, eq(presentationSlides.presentationId, presentations.id))
  .groupBy(presentations.id)
  .orderBy(desc(presentations.id))

const decksListos = DECKS.filter((d) => d.estado !== 'archivado')
const totalSlidesCliente = presRows.reduce((a, p) => a + p.slideCount, 0)

const ESTADO_BADGE: Record<string, string> = {
  listo: 'bg-lime/10 text-lime border-lime/30',
  borrador: 'bg-violet/15 text-violet border-violet/30',
  archivado: 'bg-white/5 text-ink-300 border-white/10',
}

const ACCESO_LABEL: Record<string, string> = {
  admin: 'Solo admin',
  publico: 'Público',
}

const origin = Astro.url.origin
---

<AdminLayout title="Presentaciones">
  <p class="text-[12px] text-ink-200 max-w-2xl mb-6">
    Todo lo que se proyecta desde este portafolio. Los <strong class="text-ink-100">decks en código</strong>
    se escriben como páginas Astro sobre reveal.js y se dan de alta en
    <span class="font-mono text-cyan">src/data/presentaciones.ts</span>; las
    <strong class="text-ink-100">presentaciones de cliente</strong> son imágenes subidas a un proyecto,
    con control remoto y enlace público por token.
  </p>

  <!-- KPIs -->
  <div class="grid grid-cols-3 gap-3 md:gap-4 mb-8">
    <div class="rounded-2xl glass p-5">
      <div class="text-[10px] font-mono uppercase tracking-[.22em] text-ink-200">Decks en código</div>
      <div class="mt-2 text-2xl md:text-3xl font-medium tracking-tight text-ink-50">{decksListos.length}</div>
    </div>
    <div class="rounded-2xl glass p-5">
      <div class="text-[10px] font-mono uppercase tracking-[.22em] text-ink-200">De cliente</div>
      <div class="mt-2 text-2xl md:text-3xl font-medium tracking-tight text-ink-50">{presRows.length}</div>
    </div>
    <div class="rounded-2xl glass p-5">
      <div class="text-[10px] font-mono uppercase tracking-[.22em] text-ink-200">Slides subidas</div>
      <div class="mt-2 text-2xl md:text-3xl font-medium tracking-tight text-ink-50">{totalSlidesCliente}</div>
    </div>
  </div>

  <!-- ── Decks en código ────────────────────────────────────────────── -->
  <section class="mb-10">
    <div class="flex items-baseline justify-between gap-3 mb-3">
      <h2 class="text-[13px] font-medium text-ink-50">Decks en código</h2>
      <span class="text-[11px] font-mono text-ink-300">reveal.js · SlidesLayout</span>
    </div>

    <div class="grid gap-3 md:grid-cols-2">
      {decksListos.map((d) => (
        <article class="rounded-2xl glass p-5 flex flex-col gap-3 hover:bg-white/[0.04] transition-colors">
          <div class="flex items-start justify-between gap-3">
            <div class="flex items-center gap-2 min-w-0">
              <span class={`w-1.5 h-1.5 rounded-full shrink-0 ${d.estado === 'listo' ? 'bg-lime' : 'bg-violet'}`}></span>
              <h3 class="text-[14px] text-ink-50 truncate">{d.titulo}</h3>
            </div>
            <span class={`shrink-0 text-[10px] font-mono px-2 py-0.5 rounded-full border ${ESTADO_BADGE[d.estado]}`}>
              {d.estado}
            </span>
          </div>

          <p class="text-[12px] text-ink-200 leading-relaxed">{d.descripcion}</p>

          <div class="flex flex-wrap gap-1.5 text-[10px] font-mono text-ink-300">
            <span class="px-2 py-0.5 rounded-full bg-white/5 border border-white/10">{ACCESO_LABEL[d.acceso]}</span>
            <span class="px-2 py-0.5 rounded-full bg-white/5 border border-white/10">{d.contexto}</span>
            {d.datosDerivados && (
              <span class="px-2 py-0.5 rounded-full bg-cyan/10 border border-cyan/25 text-cyan">cifras derivadas</span>
            )}
          </div>

          <div class="mt-auto pt-2 flex items-center justify-between gap-3">
            <span class="text-[11px] font-mono text-ink-300">rev. {d.actualizado}</span>
            <a
              href={d.href}
              target="_blank"
              class="inline-flex items-center gap-1.5 h-8 px-3 text-[12px] rounded-full bg-cyan/15 text-cyan border border-cyan/30 hover:bg-cyan/25 transition-colors"
            >
              Abrir ↗
            </a>
          </div>
        </article>
      ))}
    </div>

    <p class="mt-3 text-[11px] font-mono text-ink-300">
      Deck nuevo: una página en <span class="text-cyan">src/pages/admin/presentations/</span> con
      <span class="text-cyan">SlidesLayout</span> + su entrada en
      <span class="text-cyan">src/data/presentaciones.ts</span>.
    </p>
  </section>

  <!-- ── Presentaciones de cliente ──────────────────────────────────── -->
  <section>
    <div class="flex items-baseline justify-between gap-3 mb-3">
      <h2 class="text-[13px] font-medium text-ink-50">Presentaciones de cliente</h2>
      <span class="text-[11px] font-mono text-ink-300">se crean desde cada proyecto</span>
    </div>

    {presRows.length === 0 ? (
      <div class="rounded-2xl glass p-8 text-center">
        <p class="text-[12px] text-ink-200">
          Sin presentaciones de cliente todavía. Se crean desde
          <a href="/admin/projects" class="text-cyan hover:underline">un proyecto</a> → Slides.
        </p>
      </div>
    ) : (
      <div class="space-y-3">
        {presRows.map((p) => (
          <div class="rounded-2xl glass p-4 flex flex-wrap items-center gap-4">
            <div class="flex-1 min-w-[200px]">
              <div class="flex items-center gap-2">
                <span class={`w-1.5 h-1.5 rounded-full shrink-0 ${p.isActive ? 'bg-lime' : 'bg-ink-500'}`}></span>
                <span class="text-[14px] text-ink-50 truncate">{p.title}</span>
              </div>
              <div class="mt-1 text-[11px] font-mono text-ink-300">
                {p.projectTitle ? (
                  <a href={`/admin/projects/${p.projectId}/slides`} class="hover:text-cyan transition-colors">
                    {p.projectTitle}
                  </a>
                ) : (
                  <span>sin proyecto</span>
                )}
                <span> · {p.slideCount} slides · en la {(p.currentSlide ?? 0) + 1}</span>
              </div>
            </div>

            <div class="flex items-center gap-2 shrink-0">
              <a
                href={`/admin/presentations/${p.id}/control`}
                class="h-8 px-3 inline-flex items-center rounded-full bg-violet/15 text-violet border border-violet/30 text-[12px] hover:bg-violet/25 transition-colors"
              >
                Control
              </a>
              <a
                href={`/admin/presentations/${p.id}/present`}
                target="_blank"
                class="h-8 px-3 inline-flex items-center rounded-full bg-cyan/15 text-cyan border border-cyan/30 text-[12px] hover:bg-cyan/25 transition-colors"
              >
                Proyectar ↗
              </a>
              <button
                class="btn-share h-8 px-3 inline-flex items-center rounded-full bg-white/5 text-ink-200 border border-white/10 text-[12px] hover:bg-white/10 transition-colors"
                data-token={p.shareToken}
              >
                Copiar enlace
              </button>
            </div>
          </div>
        ))}
      </div>
    )}
  </section>
</AdminLayout>

<script define:vars={{ origin }}>
  document.querySelectorAll('.btn-share').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = `${origin}/present/${btn.dataset.token}`
      await navigator.clipboard.writeText(url)
      const original = btn.textContent
      btn.textContent = 'Copiado ✓'
      setTimeout(() => { btn.textContent = original }, 1500)
    })
  })
</script>
