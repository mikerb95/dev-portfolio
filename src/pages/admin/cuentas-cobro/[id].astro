---
import AdminLayout from '../../../layouts/AdminLayout.astro'
import {
  cuentaCobro,
  loadEmisorYConfig,
  parseRetenciones,
  parseSnapshot,
} from '../../../lib/cuentas-cobro-db'
import {
  formatFechaCorta,
  ibcSeguridadSocial,
  montoEnLetras,
  parseDeudor,
  validateCuentaCobro,
  type Deudor,
  type Emisor,
} from '../../../lib/cuentas-cobro'
// formatFechaCorta y no formatDate: este último usa la zona del servidor (UTC
// en Vercel) y correría un día las fechas del documento. Ver lib/cuentas-cobro.ts.
import { formatMoney } from '../../../lib/portal/format'

const id = Number(Astro.params.id)
const detalle = Number.isInteger(id) ? await cuentaCobro(id) : null
if (!detalle) return Astro.redirect('/admin/cuentas-cobro')

const { cuenta, items } = detalle
const { emisor: emisorVivo, config } = await loadEmisorYConfig()

// Emitida: se muestra el snapshot, que es lo que salió impreso. Borrador: los
// datos vivos, que son los que se congelarían al emitir.
const emisor = parseSnapshot<Emisor>(cuenta.issuerSnapshot) ?? emisorVivo
const deudor = parseSnapshot<Deudor>(cuenta.payerSnapshot) ?? parseDeudor(detalle.clientName, detalle.company, detalle.billingInfo)
const congelado = cuenta.issuerSnapshot != null

const retenciones = parseRetenciones(cuenta.retentions)
const aplicadas = retenciones.filter((r) => r.applied)
const ibc = ibcSeguridadSocial(cuenta.totalCents, config.smmlvCents)

const esBorrador = cuenta.status === 'draft'

// En borrador se valida en cada carga para que los problemas se vean ANTES de
// pulsar "Emitir", no como un error después.
const problemas = esBorrador
  ? validateCuentaCobro({
      docType: 'cuenta_cobro',
      concept: cuenta.concept,
      city: cuenta.city,
      items: items.map((i) => ({ description: i.description, quantity: i.quantity, unitCents: i.unitCents })),
      emisor,
      deudor,
      taxCents: cuenta.taxCents,
    })
  : []

const STATUS_LABELS: Record<string, string> = {
  draft: 'Borrador',
  sent: 'Emitida',
  paid: 'Pagada',
  overdue: 'Vencida',
  void: 'Anulada',
}

const STATUS_STYLE: Record<string, string> = {
  draft: 'bg-white/[.04] text-ink-300 border-white/10',
  sent: 'bg-cyan/10 text-cyan border-cyan/25',
  paid: 'bg-lime/10 text-lime border-lime/25',
  overdue: 'bg-ember/10 text-ember border-ember/25',
  void: 'bg-white/[.04] text-ink-300 border-white/10',
}
---

<AdminLayout title={`Cuenta de cobro ${cuenta.number}`}>
  <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
    <a href="/admin/cuentas-cobro" class="text-[12px] text-ink-300 hover:text-cyan transition-colors">← Cuentas de cobro</a>
    <div class="flex items-center gap-2">
      <a
        href={`/api/admin/cuentas-cobro/${cuenta.id}/pdf`}
        target="_blank"
        rel="noopener"
        class="h-9 px-4 inline-flex items-center rounded-full bg-white/[.03] border border-white/10 text-[13px] text-ink-100 hover:bg-white/[.06] transition-colors"
      >
        {esBorrador ? 'Previsualizar PDF' : 'Descargar PDF'}
      </a>
      {esBorrador && (
        <button
          id="btn-issue"
          data-id={cuenta.id}
          disabled={problemas.length > 0}
          class="h-9 px-4 rounded-full bg-cyan text-ink-950 text-[13px] font-semibold hover:bg-cyan-glow transition-colors disabled:opacity-40 disabled:cursor-not-allowed"
        >
          Emitir
        </button>
      )}
      {(cuenta.status === 'sent' || cuenta.status === 'overdue') && (
        <>
          <button id="btn-paid" data-id={cuenta.id} class="h-9 px-4 rounded-full bg-lime/15 border border-lime/30 text-lime text-[13px] font-medium hover:bg-lime/25 transition-colors">
            Marcar pagada
          </button>
          <button id="btn-void" data-id={cuenta.id} class="h-9 px-4 rounded-full bg-white/[.03] border border-white/10 text-[13px] text-ink-200 hover:text-ember hover:border-ember/25 transition-colors">
            Anular
          </button>
        </>
      )}
    </div>
  </div>

  <div class="flex flex-wrap items-baseline gap-3 mb-5">
    <h1 class="text-[24px] font-medium tracking-tight text-ink-50 font-mono">{cuenta.number}</h1>
    <span class:list={['px-2 py-0.5 rounded-full border text-[11px] font-mono', STATUS_STYLE[cuenta.status]]}>
      {STATUS_LABELS[cuenta.status]}
    </span>
    {congelado && (
      <span class="text-[11px] font-mono text-ink-300">
        datos congelados el {formatFechaCorta(cuenta.issuedAt)}
      </span>
    )}
  </div>

  {problemas.length > 0 && (
    <div class="mb-5 rounded-xl border border-ember/25 bg-ember/[.07] px-4 py-3">
      <p class="text-[13px] text-ink-100 font-medium">No se puede emitir todavía:</p>
      <ul class="mt-1.5 space-y-0.5 text-[12.5px] text-ink-200">
        {problemas.map((p) => <li>· {p}</li>)}
      </ul>
      <p class="mt-2 text-[11.5px] text-ink-300">
        Estos campos son los que el pagador necesita para generar su Documento Soporte ante la DIAN
        (Res. 000167 de 2021). Sin ellos, contabilidad devuelve el documento.
      </p>
    </div>
  )}

  <div class="grid gap-4 lg:grid-cols-[1.6fr_1fr]">
    <div class="space-y-4">
      <!-- Documento -->
      <div class="glass rounded-2xl p-5">
        <div class="grid gap-5 sm:grid-cols-2">
          <!--
            El orden es el del documento y es lo contrario de lo intuitivo: la
            fórmula es "[DEUDOR] DEBE A [EMISOR]", así que "DEBE A" encabeza a
            quien cobra. El deudor va primero, bajo "SEÑORES".
          -->
          <div>
            <p class="text-[11px] font-mono uppercase tracking-[.18em] text-ink-300 mb-2">Señores (quien paga)</p>
            <p class="text-[14px] text-ink-50 font-medium">{deudor.nombre}</p>
            <p class="text-[12px] font-mono text-ink-200">
              NIT/C.C. {deudor.nit || <span class="text-ember">sin NIT en la ficha</span>}
            </p>
            <p class="text-[12px] text-ink-300 mt-1">{deudor.direccion}</p>
            <p class="text-[12px] text-ink-300">{deudor.ciudad}</p>
          </div>
          <div>
            <p class="text-[11px] font-mono uppercase tracking-[.18em] text-ink-300 mb-2">Debe a (quien cobra)</p>
            <p class="text-[14px] text-ink-50 font-medium">{emisor.nombre || <span class="text-ember">sin configurar</span>}</p>
            <p class="text-[12px] font-mono text-ink-200">C.C. {emisor.cedula || '-'}</p>
            <p class="text-[12px] text-ink-300 mt-1">{emisor.direccion}</p>
            <p class="text-[12px] text-ink-300">{emisor.ciudad}</p>
          </div>
        </div>

        <div class="mt-5 pt-4 border-t border-white/5">
          <p class="text-[11px] font-mono uppercase tracking-[.18em] text-ink-300 mb-1.5">La suma de</p>
          <p class="text-[13.5px] text-ink-50 font-medium leading-snug">{montoEnLetras(cuenta.totalCents)}</p>
        </div>

        <div class="mt-4">
          <p class="text-[11px] font-mono uppercase tracking-[.18em] text-ink-300 mb-1.5">Por concepto de</p>
          <p class="text-[13px] text-ink-100 leading-relaxed">{cuenta.concept ?? <span class="text-ember">falta el concepto</span>}</p>
          <p class="mt-2 text-[11.5px] font-mono text-ink-300">
            {[
              cuenta.city && `${cuenta.city}`,
              cuenta.periodStart || cuenta.periodEnd
                ? `periodo ${[formatFechaCorta(cuenta.periodStart), formatFechaCorta(cuenta.periodEnd)].filter((v) => v !== '-').join(' a ')}`
                : null,
              cuenta.contractRef && `contrato ${cuenta.contractRef}`,
              cuenta.dueAt && `pago hasta ${formatFechaCorta(cuenta.dueAt)}`,
            ]
              .filter(Boolean)
              .join('  ·  ')}
          </p>
        </div>
      </div>

      <!-- Líneas -->
      <div class="glass rounded-2xl overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-white/5 text-ink-300 text-left text-[11px] font-mono uppercase tracking-wider">
                <th class="px-4 py-3 font-medium">Detalle</th>
                <th class="px-4 py-3 font-medium text-right">Cant.</th>
                <th class="px-4 py-3 font-medium text-right">Valor unit.</th>
                <th class="px-4 py-3 font-medium text-right">Total</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              {items.map((i) => (
                <tr class="text-ink-100">
                  <td class="px-4 py-3 text-[13px]">{i.description}</td>
                  <td class="px-4 py-3 text-right font-mono text-[13px] text-ink-200">{i.quantity}</td>
                  <td class="px-4 py-3 text-right font-mono text-[13px] text-ink-200">{formatMoney(i.unitCents)}</td>
                  <td class="px-4 py-3 text-right font-mono text-[13px] text-ink-50">{formatMoney(i.totalCents)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="space-y-4">
      <!-- Totales -->
      <div class="glass rounded-2xl p-5">
        <div class="space-y-2 text-[13px]">
          <div class="flex justify-between">
            <span class="text-ink-300">Subtotal</span>
            <span class="font-mono text-ink-100">{formatMoney(cuenta.subtotalCents)}</span>
          </div>
          <!-- El IVA en cero se muestra explícito: su ausencia es el motivo por
               el que este documento existe, no un olvido. -->
          <div class="flex justify-between">
            <span class="text-ink-300">IVA (no responsable)</span>
            <span class="font-mono text-ink-300">{formatMoney(0)}</span>
          </div>
          {aplicadas.map((r) => (
            <div class="flex justify-between gap-3">
              <span class="text-ink-300 text-[12px] leading-tight" title={r.label}>
                {r.labelCorto ?? r.label}
                <span class="font-mono"> {(r.rate * 100).toFixed(2).replace(/\.?0+$/, '')} %</span>
              </span>
              <span class="font-mono text-ink-200 whitespace-nowrap">- {formatMoney(r.valueCents)}</span>
            </div>
          ))}
          <div class="flex justify-between pt-2.5 border-t border-white/5">
            <span class="text-ink-100 font-medium">Total a cobrar</span>
            <span class="font-mono text-[16px] text-cyan">{formatMoney(cuenta.totalCents)}</span>
          </div>
          {aplicadas.length > 0 && (
            <div class="flex justify-between">
              <span class="text-ink-300 text-[12px]">Neto estimado</span>
              <span class="font-mono text-[12px] text-ink-200">{formatMoney(cuenta.netCents)}</span>
            </div>
          )}
        </div>

        {retenciones.length > aplicadas.length && (
          <div class="mt-3 pt-3 border-t border-white/5 space-y-1">
            {retenciones
              .filter((r) => !r.applied)
              .map((r) => (
                <p class="text-[11.5px] text-ink-300">
                  {r.label}: no se practica ({r.motivo})
                </p>
              ))}
          </div>
        )}
      </div>

      <!-- Consignación -->
      <div class="glass rounded-2xl p-5">
        <p class="text-[11px] font-mono uppercase tracking-[.18em] text-ink-300 mb-2">Consignar a</p>
        <p class="text-[13px] font-mono text-ink-50">
          {[emisor.banco, emisor.tipoCuenta, emisor.numeroCuenta].filter(Boolean).join('  ·  ') || (
            <span class="text-ember">sin datos bancarios</span>
          )}
        </p>
        {(cuenta.ssPlanilla || cuenta.ssPeriodo) && (
          <p class="mt-3 text-[12px] text-ink-300">
            PILA: {[cuenta.ssPlanilla, cuenta.ssPeriodo].filter(Boolean).join(' · ')}
          </p>
        )}
      </div>

      <!-- Seguridad social -->
      <div class="glass rounded-2xl p-5">
        <p class="text-[11px] font-mono uppercase tracking-[.18em] text-ink-300 mb-2">Seguridad social</p>
        <div class="space-y-1.5 text-[13px]">
          <div class="flex justify-between">
            <span class="text-ink-300">IBC (40 % del valor)</span>
            <span class="font-mono text-ink-100">{formatMoney(ibc.ibcCents)}</span>
          </div>
          {ibc.pisoCents != null && (
            <div class="flex justify-between">
              <span class="text-ink-300">Piso (1 SMMLV)</span>
              <span class="font-mono text-ink-200">{formatMoney(ibc.pisoCents)}</span>
            </div>
          )}
          <div class="flex justify-between pt-2 border-t border-white/5">
            <span class="text-ink-100">Base de cotización</span>
            <span class="font-mono text-ink-50">{formatMoney(ibc.cotizableCents)}</span>
          </div>
        </div>
        <p class="mt-2.5 text-[11px] text-ink-300 leading-relaxed">
          Informativo (Decreto 1273 de 2018, art. 244 Ley 1955 de 2019). Aquí no se liquidan aportes: eso lo hace la PILA.
          {ibc.pisoCents == null && ' Configura el SMMLV en Ajustes para ver el piso.'}
        </p>
      </div>

      {cuenta.notes && (
        <div class="glass rounded-2xl p-5">
          <p class="text-[11px] font-mono uppercase tracking-[.18em] text-ink-300 mb-2">Notas</p>
          <p class="text-[12.5px] text-ink-200 leading-relaxed">{cuenta.notes}</p>
        </div>
      )}
    </div>
  </div>
</AdminLayout>

<script>
  const post = async (id: number, action: string) => {
    const res = await fetch(`/api/admin/cuentas-cobro?action=${action}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id }),
    })
    if (res.ok) {
      window.location.reload()
      return
    }
    const body = await res.json().catch(() => ({}))
    // El 422 trae la lista de faltantes: mostrarlos todos evita el ciclo de
    // arreglar uno, reintentar y descubrir el siguiente.
    const detalle = Array.isArray(body.errors) ? `\n\n- ${body.errors.join('\n- ')}` : ''
    alert(`${body.error ?? 'No se pudo completar la acción.'}${detalle}`)
  }

  const btnIssue = document.getElementById('btn-issue') as HTMLButtonElement | null
  btnIssue?.addEventListener('click', () => {
    // Emitir congela los datos y asigna la fecha: no es reversible con un
    // UPDATE, se corrige anulando y emitiendo otra.
    if (confirm('¿Emitir la cuenta de cobro? Los datos del emisor y del deudor quedan congelados.')) {
      post(Number(btnIssue.dataset.id), 'issue')
    }
  })

  const btnPaid = document.getElementById('btn-paid') as HTMLButtonElement | null
  btnPaid?.addEventListener('click', () => {
    if (confirm('¿Marcar esta cuenta de cobro como pagada?')) post(Number(btnPaid.dataset.id), 'paid')
  })

  const btnVoid = document.getElementById('btn-void') as HTMLButtonElement | null
  btnVoid?.addEventListener('click', () => {
    if (confirm('¿Anular esta cuenta de cobro?')) post(Number(btnVoid.dataset.id), 'void')
  })
</script>
