---
import AdminLayout from '../../../layouts/AdminLayout.astro'
import { db } from '../../../db'
import { clients, projects } from '../../../db/schema'
import { allCuentasCobro, cuentaCountByStatus, loadEmisorYConfig, topeIvaDelAnio } from '../../../lib/cuentas-cobro-db'
import { CONCEPTOS_DEFAULT, formatFechaCorta, rateOf, TOPE_NO_RESPONSABLE_UVT } from '../../../lib/cuentas-cobro'
// formatFechaCorta y no formatDate: este último usa la zona del servidor, que en
// Vercel es UTC, y fecharía en el día siguiente todo lo emitido tras las 19:00
// hora de Colombia. Ver lib/cuentas-cobro.ts.
import { formatMoney } from '../../../lib/portal/format'

const [rows, counts, tope, { emisor, config }, clientRows, projectRows] = await Promise.all([
  allCuentasCobro(),
  cuentaCountByStatus(),
  topeIvaDelAnio(),
  loadEmisorYConfig(),
  // A diferencia de las facturas del portal, aquí sirve CUALQUIER cliente: una
  // cuenta de cobro no necesita que el deudor tenga portal.
  db.select({ id: clients.id, name: clients.name, company: clients.company, billingInfo: clients.billingInfo }).from(clients),
  db.select({ id: projects.id, title: projects.title, clientId: projects.clientId }).from(projects),
])

const STATUS_LABELS: Record<string, string> = {
  draft: 'Borrador',
  sent: 'Emitida',
  paid: 'Pagada',
  overdue: 'Vencida',
  void: 'Anulada',
}

const STATUS_STYLE: Record<string, string> = {
  draft: 'bg-white/[.04] text-ink-300 border-white/10',
  sent: 'bg-cyan/10 text-cyan border-cyan/25',
  paid: 'bg-lime/10 text-lime border-lime/25',
  overdue: 'bg-ember/10 text-ember border-ember/25',
  void: 'bg-white/[.04] text-ink-300 border-white/10',
}

const pendientes = rows.filter((r) => r.status === 'sent' || r.status === 'overdue')
const pendienteCents = pendientes.reduce((s, r) => s + r.totalCents, 0)
const cobradoCents = rows.filter((r) => r.status === 'paid').reduce((s, r) => s + r.totalCents, 0)

// El emisor incompleto no bloquea el panel, pero sí impide emitir: mejor
// decirlo arriba que dejar que lo descubra al pulsar "Emitir".
const emisorFaltante = [
  ['nombre', emisor.nombre],
  ['cédula', emisor.cedula],
  ['dirección', emisor.direccion],
  ['ciudad', emisor.ciudad],
  ['banco', emisor.banco],
  ['número de cuenta', emisor.numeroCuenta],
]
  .filter(([, v]) => !v)
  .map(([k]) => k)

const TOPE_STYLE: Record<string, string> = {
  ok: 'text-ink-200',
  aviso: 'text-cyan',
  alerta: 'text-ember',
  superado: 'text-ember',
}

const TOPE_BAR: Record<string, string> = {
  ok: 'bg-ink-300/40',
  aviso: 'bg-cyan',
  alerta: 'bg-ember',
  superado: 'bg-ember',
}

// Catálogo de retenciones con la tarifa ya resuelta, para que el formulario
// muestre el porcentaje real configurado y no uno escrito a mano en la vista.
const conceptos = CONCEPTOS_DEFAULT.map((c) => {
  const def = config.conceptos.find((x) => x.id === c.id) ?? c
  return {
    id: def.id,
    label: def.label,
    rate: rateOf(def, config.declarante),
    baseUvt: def.baseUvt,
    minimoCents: Math.round(def.baseUvt * config.uvtCents),
  }
})
---

<AdminLayout title="Cuentas de cobro">
  <div class="grid gap-3 sm:grid-cols-3 mb-4">
    <div class="glass rounded-2xl p-4">
      <p class="text-[11px] font-mono uppercase tracking-[.18em] text-ink-300">Por cobrar</p>
      <p class="mt-2 text-[22px] font-medium tracking-tight text-ink-50 font-mono">{formatMoney(pendienteCents)}</p>
      <p class="mt-0.5 text-[12px] text-ink-300">
        {pendientes.length} cuenta(s)
        {counts.overdue ? <span class="text-ember"> · {counts.overdue} vencida(s)</span> : null}
      </p>
    </div>
    <div class="glass rounded-2xl p-4">
      <p class="text-[11px] font-mono uppercase tracking-[.18em] text-ink-300">Cobrado</p>
      <p class="mt-2 text-[22px] font-medium tracking-tight text-lime font-mono">{formatMoney(cobradoCents)}</p>
      <p class="mt-0.5 text-[12px] text-ink-300">{counts.paid ?? 0} cuenta(s)</p>
    </div>
    <div class="glass rounded-2xl p-4">
      <p class="text-[11px] font-mono uppercase tracking-[.18em] text-ink-300">Borradores</p>
      <p class="mt-2 text-[22px] font-medium tracking-tight text-ink-50 font-mono">{counts.draft ?? 0}</p>
      <p class="mt-0.5 text-[12px] text-ink-300">Sin emitir</p>
    </div>
  </div>

  <!--
    Semáforo del tope de responsabilidad de IVA. No es una métrica decorativa:
    superadas las 3.500 UVT del art. 437 par. 3 ET dejo de ser no responsable y
    paso a estar obligado a facturación electrónica, con lo que este documento
    deja de ser el soporte correcto. Eso lo tiene que avisar el panel, no
    descubrirlo el contador en marzo.
  -->
  <div class="glass rounded-2xl p-4 mb-6">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <p class="text-[11px] font-mono uppercase tracking-[.18em] text-ink-300">
        Emitido este año contra el tope de {TOPE_NO_RESPONSABLE_UVT} UVT
      </p>
      <p class={`text-[13px] font-mono ${TOPE_STYLE[tope.nivel]}`}>
        {formatMoney(tope.emitidoCents)} <span class="text-ink-300">/ {formatMoney(tope.topeCents)}</span>
        <span class="ml-2">{(tope.ratio * 100).toFixed(1)} %</span>
      </p>
    </div>
    <div class="mt-2.5 h-1.5 rounded-full bg-white/[.06] overflow-hidden">
      <div class={`h-full rounded-full ${TOPE_BAR[tope.nivel]}`} style={`width: ${Math.min(100, tope.ratio * 100)}%`} />
    </div>
    {tope.nivel !== 'ok' && (
      <p class="mt-2.5 text-[12px] text-ink-100">
        {tope.nivel === 'superado'
          ? 'Tope superado: dejas de ser no responsable de IVA y pasas a estar obligado a facturación electrónica. La cuenta de cobro ya no es el soporte correcto. Habla con tu contador antes de emitir otra.'
          : 'Te acercas al tope de ingresos para seguir siendo no responsable de IVA (art. 437 par. 3 ET). Conviene revisarlo con tu contador.'}
      </p>
    )}
  </div>

  {emisorFaltante.length > 0 && (
    <div class="mb-5 rounded-xl border border-ember/25 bg-ember/[.07] px-4 py-3 text-[13px] text-ink-200">
      Faltan datos del emisor ({emisorFaltante.join(', ')}). Sin ellos no se puede emitir: son justo los que el pagador
      necesita para generar su documento soporte ante la DIAN.
      <a href="/admin/settings" class="text-cyan hover:underline"> Complétalos en Ajustes</a>.
    </div>
  )}

  <div class="flex justify-between items-center mb-5 gap-3">
    <a href="/admin/finances" class="text-[12px] text-ink-300 hover:text-cyan transition-colors">← Finanzas</a>
    <button
      id="btn-new"
      class="inline-flex items-center gap-2 h-9 px-4 text-[13px] font-medium rounded-full bg-cyan text-ink-950 hover:bg-cyan-glow transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
      Nueva cuenta de cobro
    </button>
  </div>

  {rows.length === 0 ? (
    <div class="glass rounded-2xl p-10 text-center">
      <p class="text-ink-200">Todavía no hay cuentas de cobro.</p>
    </div>
  ) : (
    <div class="glass rounded-2xl overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-white/5 text-ink-300 text-left text-[11px] font-mono uppercase tracking-wider">
              <th class="px-4 py-3 font-medium">Nº</th>
              <th class="px-4 py-3 font-medium">Deudor</th>
              <th class="px-4 py-3 font-medium">Emitida</th>
              <th class="px-4 py-3 font-medium text-right">Total</th>
              <th class="px-4 py-3 font-medium text-right">Neto</th>
              <th class="px-4 py-3 font-medium">Estado</th>
              <th class="px-4 py-3 font-medium" />
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5">
            {rows.map((cc) => (
              <tr class="text-ink-100 hover:bg-white/[.02] transition-colors">
                <td class="px-4 py-3 font-mono text-[13px] text-ink-50">
                  <a href={`/admin/cuentas-cobro/${cc.id}`} class="hover:text-cyan transition-colors">{cc.number}</a>
                </td>
                <td class="px-4 py-3">
                  <div class="text-[13px] text-ink-50">{cc.company ?? cc.clientName}</div>
                  {cc.concept && <div class="text-[11px] text-ink-300 truncate max-w-[280px]">{cc.concept}</div>}
                </td>
                <td class="px-4 py-3 text-[13px] text-ink-200">{formatFechaCorta(cc.issuedAt)}</td>
                <td class="px-4 py-3 text-right font-mono text-[13px] text-ink-50">{formatMoney(cc.totalCents)}</td>
                <td class="px-4 py-3 text-right font-mono text-[13px]">
                  {cc.retentionsCents > 0
                    ? <span class="text-ink-200">{formatMoney(cc.netCents)}</span>
                    : <span class="text-ink-300">-</span>}
                </td>
                <td class="px-4 py-3">
                  <span class:list={['px-2 py-0.5 rounded-full border text-[11px] font-mono', STATUS_STYLE[cc.status]]}>
                    {STATUS_LABELS[cc.status]}
                  </span>
                </td>
                <td class="px-4 py-3 text-right whitespace-nowrap">
                  <a
                    href={`/api/admin/cuentas-cobro/${cc.id}/pdf`}
                    target="_blank"
                    rel="noopener"
                    class="h-7 px-3 inline-flex items-center rounded-full bg-white/[.03] border border-white/10 text-[12px] text-ink-200 hover:text-cyan hover:border-cyan/25 transition-colors"
                  >
                    PDF
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  )}

  <dialog id="dlg" class="backdrop:bg-ink-950/70 backdrop:backdrop-blur-sm bg-transparent p-0 m-auto">
    <!--
      La estructura es cabecera fija / cuerpo con scroll / pie fijo, y no un
      formulario largo suelto: el pie lleva los totales, y un importe que se va
      de la pantalla mientras tecleas las líneas es justo el dato que necesitas
      mirar al teclearlas.
    -->
    <form id="form" class="glass-strong rounded-2xl w-[min(94vw,720px)] max-h-[88vh] flex flex-col text-left overflow-hidden">
      <header class="px-5 pt-5 pb-4 border-b border-white/5 shrink-0">
        <h2 class="text-[16px] font-medium text-ink-50">Nueva cuenta de cobro</h2>
        <p class="text-[12px] text-ink-300 mt-0.5">Se crea como borrador. Los datos del emisor se congelan al emitirla.</p>
      </header>

      <div class="flex-1 overflow-y-auto px-5 py-5 space-y-6">
        <!-- Deudor y datos del documento -->
        <section>
          <h3 class="text-[10.5px] font-mono uppercase tracking-[.18em] text-ink-300 mb-3">Deudor y documento</h3>

          <div class="grid gap-3 sm:grid-cols-2">
            <div class="sm:col-span-2">
              <div class="flex items-baseline justify-between mb-1.5 gap-2">
                <label for="clientId" class="text-[12px] font-medium text-ink-100">Deudor</label>
                <button
                  type="button"
                  id="btn-nuevo-cliente"
                  class="inline-flex items-center gap-1 text-[11px] text-cyan hover:text-cyan-glow transition-colors"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                  Crear deudor nuevo
                </button>
              </div>
              <select id="clientId" name="clientId" required class="input-base w-full">
                {clientRows.map((c) => <option value={c.id}>{c.company ?? c.name}</option>)}
              </select>

              <!--
                Aviso accionable, no un texto rojo suelto: dice qué falta y
                lleva al sitio donde se arregla. Se reserva el espacio con
                `hidden` en vez de insertarlo al vuelo para que aparecer no
                empuje el resto del formulario hacia abajo de golpe.
              -->
              <div
                id="nit-warn"
                class="hidden mt-2 rounded-lg bg-ember/[.08] border border-ember/20 px-3 py-2 flex items-start gap-2.5"
              >
                <span class="mt-[5px] w-1.5 h-1.5 rounded-full bg-ember shrink-0" />
                <p class="text-[11.5px] text-ink-100 leading-snug">
                  Sin NIT en la ficha. Puedes crear el borrador, pero no emitirlo.
                  <a id="nit-fix" href="/admin/clients" target="_blank" rel="noopener" class="text-cyan hover:underline">Completar la ficha</a>.
                </p>
              </div>
            </div>

            <div>
              <label for="projectId" class="block text-[12px] font-medium text-ink-100 mb-1.5">Proyecto <span class="text-ink-300 font-normal">(opcional)</span></label>
              <select id="projectId" name="projectId" class="input-base w-full">
                <option value="">Sin proyecto</option>
              </select>
            </div>
            <div>
              <label for="contractRef" class="block text-[12px] font-medium text-ink-100 mb-1.5">Contrato / OC <span class="text-ink-300 font-normal">(opcional)</span></label>
              <input type="text" id="contractRef" name="contractRef" maxlength="120" class="input-base w-full" placeholder="OC-4471" />
            </div>

            <div>
              <label for="city" class="block text-[12px] font-medium text-ink-100 mb-1.5">Ciudad de expedición</label>
              <input type="text" id="city" name="city" required value={emisor.ciudad} maxlength="120" class="input-base w-full" />
            </div>
            <div>
              <label class="block text-[12px] font-medium text-ink-100 mb-1.5">Periodo del servicio <span class="text-ink-300 font-normal">(opcional)</span></label>
              <div class="flex items-center gap-2">
                <input type="date" id="periodStart" name="periodStart" aria-label="Periodo desde" class="input-base w-full" />
                <span class="text-[12px] text-ink-300 shrink-0">a</span>
                <input type="date" id="periodEnd" name="periodEnd" aria-label="Periodo hasta" class="input-base w-full" />
              </div>
            </div>
          </div>
        </section>

        <!-- Concepto -->
        <section class="pt-5 border-t border-white/5">
          <h3 class="text-[10.5px] font-mono uppercase tracking-[.18em] text-ink-300 mb-3">Concepto</h3>
          <textarea
            id="concept"
            name="concept"
            rows="2"
            required
            maxlength="500"
            class="input-base w-full resize-y"
            placeholder="Servicios de desarrollo de software prestados durante agosto de 2026"
          />
          <p class="mt-1.5 text-[11px] text-ink-300 leading-relaxed">
            Es el texto con el que el pagador arma su documento soporte ante la DIAN. Uno genérico hace que contabilidad
            devuelva el documento.
          </p>
        </section>

        <!-- Líneas -->
        <section class="pt-5 border-t border-white/5">
          <h3 class="text-[10.5px] font-mono uppercase tracking-[.18em] text-ink-300 mb-3">Detalle cobrado</h3>

          <div class="overflow-x-auto">
            <div class="min-w-[520px]">
              <div class="grid grid-cols-[1fr_64px_128px_100px_28px] gap-2 px-0.5 pb-1.5 text-[10.5px] font-mono uppercase tracking-wider text-ink-300">
                <span>Detalle</span>
                <span class="text-right">Cant.</span>
                <span class="text-right">Valor unit.</span>
                <span class="text-right">Total</span>
                <span />
              </div>
              <div id="items" class="space-y-2" />
            </div>
          </div>

          <button type="button" id="add-item" class="mt-2.5 h-8 px-3 rounded-full bg-white/[.03] border border-white/10 text-[12px] text-ink-100 hover:bg-white/[.06] transition-colors">
            + Añadir línea
          </button>
        </section>

        <!-- Retenciones -->
        <section class="pt-5 border-t border-white/5">
          <div class="flex items-baseline justify-between gap-2 mb-3">
            <h3 class="text-[10.5px] font-mono uppercase tracking-[.18em] text-ink-300">Retenciones que practica el pagador</h3>
            <span class="text-[10.5px] font-mono text-ink-300">{config.declarante ? 'declarante' : 'no declarante'}</span>
          </div>

          <div class="space-y-1">
            {conceptos.map((c) => (
              <label
                class:list={[
                  'flex items-center gap-2.5 rounded-lg px-2.5 py-2 text-[12.5px] transition-colors',
                  c.rate > 0 ? 'text-ink-100 hover:bg-white/[.03] cursor-pointer' : 'text-ink-300 cursor-not-allowed',
                ]}
              >
                <input type="checkbox" class="ret shrink-0" value={c.id} disabled={c.rate <= 0} />
                <span class="flex-1 leading-snug">{c.label}</span>
                <span class="font-mono text-[11.5px] shrink-0 tabular-nums">
                  {c.rate > 0 ? (
                    <>
                      <span class="text-ink-100">{(c.rate * 100).toFixed(2).replace(/\.?0+$/, '')} %</span>
                      {c.baseUvt > 0 && <span class="text-ink-300"> · desde {c.baseUvt} UVT</span>}
                    </>
                  ) : (
                    <span class="text-ink-300">sin configurar</span>
                  )}
                </span>
              </label>
            ))}
          </div>

          <p class="mt-2 text-[11px] text-ink-300 leading-relaxed">
            Tarifas según <a href="/admin/settings" class="text-cyan hover:underline">Ajustes</a>. La cuenta se emite por
            el bruto; el neto es informativo.
          </p>
        </section>

        <!-- Seguridad social y notas -->
        <section class="pt-5 border-t border-white/5">
          <h3 class="text-[10.5px] font-mono uppercase tracking-[.18em] text-ink-300 mb-3">Seguridad social y notas</h3>
          <div class="grid gap-3 sm:grid-cols-2">
            <div>
              <label for="ssPlanilla" class="block text-[12px] font-medium text-ink-100 mb-1.5">Planilla PILA <span class="text-ink-300 font-normal">(opcional)</span></label>
              <input type="text" id="ssPlanilla" name="ssPlanilla" maxlength="60" class="input-base w-full" placeholder="1234567890" />
            </div>
            <div>
              <label for="ssPeriodo" class="block text-[12px] font-medium text-ink-100 mb-1.5">Periodo cotizado <span class="text-ink-300 font-normal">(opcional)</span></label>
              <input type="month" id="ssPeriodo" name="ssPeriodo" class="input-base w-full" />
            </div>
            <div class="sm:col-span-2">
              <label for="notes" class="block text-[12px] font-medium text-ink-100 mb-1.5">Notas <span class="text-ink-300 font-normal">(opcional)</span></label>
              <textarea id="notes" name="notes" rows="2" maxlength="1000" class="input-base w-full resize-y" />
            </div>
          </div>
        </section>
      </div>

      <footer class="shrink-0 border-t border-white/10 bg-ink-950/50 px-5 py-3.5">
        <p id="error" class="hidden mb-2.5 text-[12px] text-ember" role="alert" />

        <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
          <div class="flex items-end gap-6">
            <div>
              <p class="text-[10.5px] font-mono uppercase tracking-[.16em] text-ink-300">Total a cobrar</p>
              <p id="total" class="font-mono text-[20px] leading-tight text-cyan tabular-nums">$ 0</p>
            </div>
            <div class="hidden sm:block">
              <p class="text-[10.5px] font-mono uppercase tracking-[.16em] text-ink-300">Neto estimado</p>
              <p id="neto" class="font-mono text-[13px] leading-tight text-ink-100 tabular-nums">$ 0</p>
            </div>
            <div class="hidden sm:block">
              <p class="text-[10.5px] font-mono uppercase tracking-[.16em] text-ink-300">IBC (40 %)</p>
              <p id="ibc" class="font-mono text-[13px] leading-tight text-ink-200 tabular-nums">$ 0</p>
            </div>
          </div>

          <div class="flex gap-2 ml-auto">
            <button type="button" id="cancel" class="h-9 px-4 rounded-full bg-white/[.03] border border-white/10 text-ink-100 text-[13px] hover:bg-white/[.06] transition-colors">
              Cancelar
            </button>
            <button type="submit" id="save" class="h-9 px-4 rounded-full bg-cyan text-ink-950 text-[13px] font-semibold hover:bg-cyan-glow transition-colors disabled:opacity-50">
              Crear borrador
            </button>
          </div>
        </div>
      </footer>
    </form>
  </dialog>

  <!--
    Alta rápida del deudor sin salir del flujo. NO escribe en la tabla `clients`
    por su cuenta: envía a POST /api/admin/clients, el mismo endpoint que usa
    /admin/clients, para heredar su validación entera (normalización del
    teléfono a E.164, límites de los pares de facturación, logo solo https). Un
    INSERT propio aquí sería una segunda definición de "cliente válido" que se
    desincronizaría con la primera en cuanto una de las dos cambie.

    El cliente nace SIN portal (portal_enabled es false por defecto y el
    endpoint ni siquiera acepta el campo): dar de alta a quien se le cobra no
    puede ser, de paso, darle acceso a una sesión.
  -->
  <dialog id="dlg-cliente" class="backdrop:bg-ink-950/70 backdrop:backdrop-blur-sm bg-transparent p-0 m-auto">
    <form id="form-cliente" class="glass-strong rounded-2xl p-5 w-[min(94vw,560px)] max-h-[88vh] overflow-y-auto text-left">
      <h2 class="text-[16px] font-medium text-ink-50 mb-1">Nuevo deudor</h2>
      <p class="text-[12px] text-ink-300 mb-4">
        Se crea como cliente normal del CRM y queda disponible en el resto del panel. Sin acceso al portal.
      </p>

      <fieldset class="mb-4">
        <legend class="text-[12px] font-medium text-ink-100 mb-2">Tipo</legend>
        <div class="flex gap-4">
          <label class="flex items-center gap-2 text-[13px] text-ink-100 cursor-pointer">
            <input type="radio" name="tipo" value="empresa" checked /> Empresa
          </label>
          <label class="flex items-center gap-2 text-[13px] text-ink-100 cursor-pointer">
            <input type="radio" name="tipo" value="persona" /> Persona natural
          </label>
        </div>
      </fieldset>

      <div class="grid gap-3">
        <div>
          <label for="c-nombre" class="block text-[12px] font-medium text-ink-100 mb-1.5">
            <span id="c-nombre-label">Razón social</span>
          </label>
          <input type="text" id="c-nombre" required maxlength="120" class="input-base w-full" placeholder="ACME S.A.S." />
          <p class="mt-1 text-[11px] text-ink-300">Es lo que se imprime en el "DEBE A" de la cuenta de cobro.</p>
        </div>

        <div class="grid gap-3 sm:grid-cols-2">
          <div>
            <label for="c-nit" class="block text-[12px] font-medium text-ink-100 mb-1.5">
              <span id="c-nit-label">NIT</span>
            </label>
            <input type="text" id="c-nit" required maxlength="200" class="input-base w-full" placeholder="900123456-7" />
          </div>
          <div>
            <label for="c-ciudad" class="block text-[12px] font-medium text-ink-100 mb-1.5">Ciudad</label>
            <input type="text" id="c-ciudad" maxlength="200" class="input-base w-full" placeholder="Bogotá" />
          </div>
        </div>

        <div>
          <label for="c-direccion" class="block text-[12px] font-medium text-ink-100 mb-1.5">Dirección</label>
          <input type="text" id="c-direccion" maxlength="200" class="input-base w-full" placeholder="Cra 7 # 1-2, oficina 301" />
        </div>

        <div class="grid gap-3 sm:grid-cols-2">
          <div>
            <label for="c-email" class="block text-[12px] font-medium text-ink-100 mb-1.5">Email (opcional)</label>
            <input type="email" id="c-email" maxlength="160" class="input-base w-full" placeholder="pagos@acme.com" />
          </div>
          <div>
            <label for="c-telefono" class="block text-[12px] font-medium text-ink-100 mb-1.5">Teléfono (opcional)</label>
            <input type="tel" id="c-telefono" class="input-base w-full" placeholder="3104641228" />
          </div>
        </div>
      </div>

      <p class="mt-3 text-[11px] text-ink-300">
        El NIT es obligatorio aquí, aunque el CRM admita clientes sin él: sin NIT la cuenta de cobro no se puede emitir,
        y crear un deudor al que no se le puede cobrar solo aplaza el problema.
      </p>

      <p id="c-error" class="hidden mt-3 text-[12px] text-ember" role="alert" />

      <div class="mt-5 flex justify-end gap-2">
        <button type="button" id="c-cancel" class="h-9 px-4 rounded-full bg-white/[.03] border border-white/10 text-ink-100 text-[13px] hover:bg-white/[.06] transition-colors">
          Cancelar
        </button>
        <button type="submit" id="c-save" class="h-9 px-4 rounded-full bg-cyan text-ink-950 text-[13px] font-semibold hover:bg-cyan-glow transition-colors disabled:opacity-50">
          Crear deudor
        </button>
      </div>
    </form>
  </dialog>
</AdminLayout>

<script define:vars={{ projectRows, clientRows, conceptos }}>
  const dlg = document.getElementById('dlg')
  const form = document.getElementById('form')
  const itemsEl = document.getElementById('items')
  const errorEl = document.getElementById('error')

  const fmt = (cents) =>
    new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(cents / 100)

  // Previsualización en vivo. Es cortesía visual: el cálculo que vale es el del
  // servidor (lib/cuentas-cobro.ts), y esta pantalla no puede enviarle totales.
  const recalc = () => {
    let subtotal = 0
    itemsEl.querySelectorAll('.item').forEach((row) => {
      const qty = Number(row.querySelector('.qty').value) || 0
      const price = Number(row.querySelector('.price').value) || 0
      // Mismo redondeo por línea que `itemTotal` en el servidor: a centavo
      // entero aquí, no al final. Si la previsualización sumara en crudo,
      // mostraría un total distinto del que devuelve la API por un peso.
      const linea = Math.round(qty * Math.round(price * 100))
      row.querySelector('.line-total').textContent = linea ? fmt(linea) : '-'
      subtotal += linea
    })

    let retenciones = 0
    document.querySelectorAll('.ret:checked').forEach((cb) => {
      const c = conceptos.find((x) => x.id === cb.value)
      if (c && c.rate > 0 && subtotal >= c.minimoCents) retenciones += Math.round(subtotal * c.rate)
    })

    document.getElementById('total').textContent = fmt(subtotal)
    document.getElementById('neto').textContent = fmt(subtotal - retenciones)
    document.getElementById('ibc').textContent = fmt(Math.round(subtotal * 0.4))
  }

  const addItem = () => {
    const row = document.createElement('div')
    row.className = 'item grid grid-cols-[1fr_64px_128px_100px_28px] gap-2 items-center'
    row.innerHTML = `
      <input type="text" class="desc input-base w-full text-[13px]" placeholder="Concepto de la línea" required />
      <input type="number" class="qty input-base w-full text-[13px] text-right" value="1" min="0.01" step="0.01" required aria-label="Cantidad" />
      <input type="number" class="price input-base w-full text-[13px] text-right" placeholder="0" min="0" step="1" required aria-label="Valor unitario" />
      <span class="line-total font-mono text-[12.5px] text-ink-200 text-right tabular-nums">-</span>
      <button type="button" class="del w-7 h-7 rounded-lg text-ink-300 hover:text-ember hover:bg-white/[.06] transition-colors" aria-label="Quitar línea">×</button>
    `
    row.querySelector('.del').addEventListener('click', () => {
      row.remove()
      recalc()
    })
    row.querySelectorAll('input').forEach((i) => i.addEventListener('input', recalc))
    itemsEl.appendChild(row)
  }

  // Espejo en el navegador de lo que hace parseDeudor en el servidor: las
  // claves de billing_info se escriben a mano y hay que plegar las tildes, no
  // borrarlas, o 'Dirección' se convierte en 'direccin' y no casa con nada.
  const tieneNit = (cliente) => {
    try {
      const info = cliente && cliente.billingInfo ? JSON.parse(cliente.billingInfo) : {}
      return Object.entries(info).some(
        ([k, v]) =>
          /^(nit|documento|cedula|identificacion)$/.test(
            k.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase().replace(/[^a-z]/g, '')
          ) && typeof v === 'string' && v.trim()
      )
    } catch {
      return false
    }
  }

  const syncCliente = () => {
    const clientId = Number(document.getElementById('clientId').value)

    const sel = document.getElementById('projectId')
    sel.innerHTML = '<option value="">Sin proyecto</option>'
    projectRows
      .filter((p) => p.clientId === clientId)
      .forEach((p) => {
        const o = document.createElement('option')
        o.value = p.id
        o.textContent = p.title
        sel.appendChild(o)
      })

    // Aviso temprano del NIT: es el campo que más devoluciones causa, y sin él
    // la emisión va a fallar de todos modos.
    const cliente = clientRows.find((c) => c.id === clientId)
    document.getElementById('nit-warn').classList.toggle('hidden', tieneNit(cliente))
  }

  document.getElementById('btn-new')?.addEventListener('click', () => {
    errorEl.classList.add('hidden')
    itemsEl.innerHTML = ''
    addItem()
    syncCliente()
    recalc()
    dlg.showModal()
    // Sin ningún cliente todavía, el primer paso obligatorio es crear el
    // deudor: abrir un formulario con el selector vacío sería un callejón.
    if (!clientRows.length) abrirDialogoCliente()
  })

  document.getElementById('cancel')?.addEventListener('click', () => dlg.close())
  document.getElementById('add-item')?.addEventListener('click', addItem)
  document.getElementById('clientId')?.addEventListener('change', syncCliente)
  document.querySelectorAll('.ret').forEach((cb) => cb.addEventListener('change', recalc))

  // ── Alta rápida del deudor ────────────────────────────────────────────────

  const dlgCliente = document.getElementById('dlg-cliente')
  const formCliente = document.getElementById('form-cliente')
  const cErrorEl = document.getElementById('c-error')

  const tipoActual = () => document.querySelector('input[name="tipo"]:checked').value

  // Empresa y persona natural piden el mismo dato con distinto nombre. Cambian
  // solo las etiquetas: el payload que se envía es el mismo y lo valida el
  // endpoint de clientes, no esta pantalla.
  const syncTipo = () => {
    const esEmpresa = tipoActual() === 'empresa'
    document.getElementById('c-nombre-label').textContent = esEmpresa ? 'Razón social' : 'Nombre completo'
    document.getElementById('c-nit-label').textContent = esEmpresa ? 'NIT' : 'Cédula'
    document.getElementById('c-nombre').placeholder = esEmpresa ? 'ACME S.A.S.' : 'Juan Pérez'
    document.getElementById('c-nit').placeholder = esEmpresa ? '900123456-7' : '1000000000'
  }

  const abrirDialogoCliente = () => {
    cErrorEl.classList.add('hidden')
    formCliente.reset()
    syncTipo()
    dlgCliente.showModal()
  }

  document.getElementById('btn-nuevo-cliente')?.addEventListener('click', abrirDialogoCliente)
  document.getElementById('c-cancel')?.addEventListener('click', () => dlgCliente.close())
  document.querySelectorAll('input[name="tipo"]').forEach((r) => r.addEventListener('change', syncTipo))

  formCliente?.addEventListener('submit', async (e) => {
    e.preventDefault()
    cErrorEl.classList.add('hidden')
    const save = document.getElementById('c-save')
    save.disabled = true

    const val = (id) => document.getElementById(id).value.trim()
    const esEmpresa = tipoActual() === 'empresa'
    const nombre = val('c-nombre')

    // Para una empresa, `name` y `company` llevan la razón social. El listado
    // pinta `company ?? name` y el PDF imprime `company || name`: si solo se
    // llenara uno, las dos vistas podrían discrepar. Una persona natural deja
    // `company` en null, que es lo que la distingue en el resto del CRM.
    const payload = {
      name: nombre,
      company: esEmpresa ? nombre : null,
      email: val('c-email') || null,
      phone: val('c-telefono') || null,
      // Las etiquetas son las que lee parseDeudor en el servidor (tolera NIT,
      // Documento, Cédula e Identificación) y las mismas que muestra
      // /admin/clients, donde este cliente se podrá editar como cualquier otro.
      billingInfo: {
        [esEmpresa ? 'NIT' : 'Cédula']: val('c-nit'),
        'Dirección': val('c-direccion'),
        Ciudad: val('c-ciudad'),
      },
    }

    const res = await fetch('/api/admin/clients', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    })

    if (!res.ok) {
      const body = await res.json().catch(() => ({}))
      cErrorEl.textContent = body.error ?? 'No se pudo crear el deudor.'
      cErrorEl.classList.remove('hidden')
      save.disabled = false
      return
    }

    const creado = await res.json()

    // Se inserta en la lista en memoria y en el <select> sin recargar: recargar
    // aquí tiraría las líneas y el concepto que ya estuvieran tecleados en la
    // cuenta de cobro de detrás.
    clientRows.push({
      id: creado.id,
      name: creado.name,
      company: creado.company,
      billingInfo: creado.billingInfo,
    })

    const sel = document.getElementById('clientId')
    const opt = document.createElement('option')
    opt.value = creado.id
    opt.textContent = creado.company ?? creado.name
    sel.appendChild(opt)
    sel.value = String(creado.id)

    syncCliente()
    dlgCliente.close()
    save.disabled = false
  })

  form?.addEventListener('submit', async (e) => {
    e.preventDefault()
    errorEl.classList.add('hidden')
    const save = document.getElementById('save')
    save.disabled = true

    const items = [...itemsEl.querySelectorAll('.item')].map((row) => ({
      description: row.querySelector('.desc').value,
      quantity: Number(row.querySelector('.qty').value),
      unitPrice: Number(row.querySelector('.price').value),
    }))

    const fd = new FormData(form)
    const res = await fetch('/api/admin/cuentas-cobro', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        clientId: Number(fd.get('clientId')),
        projectId: fd.get('projectId') ? Number(fd.get('projectId')) : null,
        city: fd.get('city'),
        concept: fd.get('concept'),
        contractRef: fd.get('contractRef'),
        periodStart: fd.get('periodStart') || null,
        periodEnd: fd.get('periodEnd') || null,
        ssPlanilla: fd.get('ssPlanilla'),
        ssPeriodo: fd.get('ssPeriodo'),
        notes: fd.get('notes'),
        retenciones: [...document.querySelectorAll('.ret:checked')].map((cb) => cb.value),
        items,
      }),
    })

    if (res.ok) {
      const body = await res.json().catch(() => ({}))
      window.location.href = body.cuenta ? `/admin/cuentas-cobro/${body.cuenta.id}` : '/admin/cuentas-cobro'
      return
    }
    const body = await res.json().catch(() => ({}))
    errorEl.textContent = body.error ?? 'No se pudo crear la cuenta de cobro.'
    errorEl.classList.remove('hidden')
    save.disabled = false
  })
</script>
