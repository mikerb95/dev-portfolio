---
import AdminLayout from '../../../layouts/AdminLayout.astro'
import { db } from '../../../db'
import { clients, projects } from '../../../db/schema'
import { allCuentasCobro, cuentaCountByStatus, loadEmisorYConfig, topeIvaDelAnio } from '../../../lib/cuentas-cobro-db'
import { CONCEPTOS_DEFAULT, rateOf, TOPE_NO_RESPONSABLE_UVT } from '../../../lib/cuentas-cobro'
import { formatMoney, formatDate } from '../../../lib/portal/format'

const [rows, counts, tope, { emisor, config }, clientRows, projectRows] = await Promise.all([
  allCuentasCobro(),
  cuentaCountByStatus(),
  topeIvaDelAnio(),
  loadEmisorYConfig(),
  // A diferencia de las facturas del portal, aquí sirve CUALQUIER cliente: una
  // cuenta de cobro no necesita que el deudor tenga portal.
  db.select({ id: clients.id, name: clients.name, company: clients.company, billingInfo: clients.billingInfo }).from(clients),
  db.select({ id: projects.id, title: projects.title, clientId: projects.clientId }).from(projects),
])

const STATUS_LABELS: Record<string, string> = {
  draft: 'Borrador',
  sent: 'Emitida',
  paid: 'Pagada',
  overdue: 'Vencida',
  void: 'Anulada',
}

const STATUS_STYLE: Record<string, string> = {
  draft: 'bg-white/[.04] text-ink-300 border-white/10',
  sent: 'bg-cyan/10 text-cyan border-cyan/25',
  paid: 'bg-lime/10 text-lime border-lime/25',
  overdue: 'bg-ember/10 text-ember border-ember/25',
  void: 'bg-white/[.04] text-ink-300 border-white/10',
}

const pendientes = rows.filter((r) => r.status === 'sent' || r.status === 'overdue')
const pendienteCents = pendientes.reduce((s, r) => s + r.totalCents, 0)
const cobradoCents = rows.filter((r) => r.status === 'paid').reduce((s, r) => s + r.totalCents, 0)

// El emisor incompleto no bloquea el panel, pero sí impide emitir: mejor
// decirlo arriba que dejar que lo descubra al pulsar "Emitir".
const emisorFaltante = [
  ['nombre', emisor.nombre],
  ['cédula', emisor.cedula],
  ['dirección', emisor.direccion],
  ['ciudad', emisor.ciudad],
  ['banco', emisor.banco],
  ['número de cuenta', emisor.numeroCuenta],
]
  .filter(([, v]) => !v)
  .map(([k]) => k)

const TOPE_STYLE: Record<string, string> = {
  ok: 'text-ink-200',
  aviso: 'text-cyan',
  alerta: 'text-ember',
  superado: 'text-ember',
}

const TOPE_BAR: Record<string, string> = {
  ok: 'bg-ink-300/40',
  aviso: 'bg-cyan',
  alerta: 'bg-ember',
  superado: 'bg-ember',
}

// Catálogo de retenciones con la tarifa ya resuelta, para que el formulario
// muestre el porcentaje real configurado y no uno escrito a mano en la vista.
const conceptos = CONCEPTOS_DEFAULT.map((c) => {
  const def = config.conceptos.find((x) => x.id === c.id) ?? c
  return {
    id: def.id,
    label: def.label,
    rate: rateOf(def, config.declarante),
    baseUvt: def.baseUvt,
    minimoCents: Math.round(def.baseUvt * config.uvtCents),
  }
})
---

<AdminLayout title="Cuentas de cobro">
  <div class="grid gap-3 sm:grid-cols-3 mb-4">
    <div class="glass rounded-2xl p-4">
      <p class="text-[11px] font-mono uppercase tracking-[.18em] text-ink-300">Por cobrar</p>
      <p class="mt-2 text-[22px] font-medium tracking-tight text-ink-50 font-mono">{formatMoney(pendienteCents)}</p>
      <p class="mt-0.5 text-[12px] text-ink-300">
        {pendientes.length} cuenta(s)
        {counts.overdue ? <span class="text-ember"> · {counts.overdue} vencida(s)</span> : null}
      </p>
    </div>
    <div class="glass rounded-2xl p-4">
      <p class="text-[11px] font-mono uppercase tracking-[.18em] text-ink-300">Cobrado</p>
      <p class="mt-2 text-[22px] font-medium tracking-tight text-lime font-mono">{formatMoney(cobradoCents)}</p>
      <p class="mt-0.5 text-[12px] text-ink-300">{counts.paid ?? 0} cuenta(s)</p>
    </div>
    <div class="glass rounded-2xl p-4">
      <p class="text-[11px] font-mono uppercase tracking-[.18em] text-ink-300">Borradores</p>
      <p class="mt-2 text-[22px] font-medium tracking-tight text-ink-50 font-mono">{counts.draft ?? 0}</p>
      <p class="mt-0.5 text-[12px] text-ink-300">Sin emitir</p>
    </div>
  </div>

  <!--
    Semáforo del tope de responsabilidad de IVA. No es una métrica decorativa:
    superadas las 3.500 UVT del art. 437 par. 3 ET dejo de ser no responsable y
    paso a estar obligado a facturación electrónica, con lo que este documento
    deja de ser el soporte correcto. Eso lo tiene que avisar el panel, no
    descubrirlo el contador en marzo.
  -->
  <div class="glass rounded-2xl p-4 mb-6">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <p class="text-[11px] font-mono uppercase tracking-[.18em] text-ink-300">
        Emitido este año contra el tope de {TOPE_NO_RESPONSABLE_UVT} UVT
      </p>
      <p class={`text-[13px] font-mono ${TOPE_STYLE[tope.nivel]}`}>
        {formatMoney(tope.emitidoCents)} <span class="text-ink-300">/ {formatMoney(tope.topeCents)}</span>
        <span class="ml-2">{(tope.ratio * 100).toFixed(1)} %</span>
      </p>
    </div>
    <div class="mt-2.5 h-1.5 rounded-full bg-white/[.06] overflow-hidden">
      <div class={`h-full rounded-full ${TOPE_BAR[tope.nivel]}`} style={`width: ${Math.min(100, tope.ratio * 100)}%`} />
    </div>
    {tope.nivel !== 'ok' && (
      <p class="mt-2.5 text-[12px] text-ink-100">
        {tope.nivel === 'superado'
          ? 'Tope superado: dejas de ser no responsable de IVA y pasas a estar obligado a facturación electrónica. La cuenta de cobro ya no es el soporte correcto. Habla con tu contador antes de emitir otra.'
          : 'Te acercas al tope de ingresos para seguir siendo no responsable de IVA (art. 437 par. 3 ET). Conviene revisarlo con tu contador.'}
      </p>
    )}
  </div>

  {emisorFaltante.length > 0 && (
    <div class="mb-5 rounded-xl border border-ember/25 bg-ember/[.07] px-4 py-3 text-[13px] text-ink-200">
      Faltan datos del emisor ({emisorFaltante.join(', ')}). Sin ellos no se puede emitir: son justo los que el pagador
      necesita para generar su documento soporte ante la DIAN.
      <a href="/admin/settings" class="text-cyan hover:underline"> Complétalos en Ajustes</a>.
    </div>
  )}

  <div class="flex justify-between items-center mb-5 gap-3">
    <a href="/admin/finances" class="text-[12px] text-ink-300 hover:text-cyan transition-colors">← Finanzas</a>
    <button
      id="btn-new"
      class="inline-flex items-center gap-2 h-9 px-4 text-[13px] font-medium rounded-full bg-cyan text-ink-950 hover:bg-cyan-glow transition-colors"
      disabled={clientRows.length === 0}
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
      Nueva cuenta de cobro
    </button>
  </div>

  {rows.length === 0 ? (
    <div class="glass rounded-2xl p-10 text-center">
      <p class="text-ink-200">Todavía no hay cuentas de cobro.</p>
    </div>
  ) : (
    <div class="glass rounded-2xl overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-white/5 text-ink-300 text-left text-[11px] font-mono uppercase tracking-wider">
              <th class="px-4 py-3 font-medium">Nº</th>
              <th class="px-4 py-3 font-medium">Deudor</th>
              <th class="px-4 py-3 font-medium">Emitida</th>
              <th class="px-4 py-3 font-medium text-right">Total</th>
              <th class="px-4 py-3 font-medium text-right">Neto</th>
              <th class="px-4 py-3 font-medium">Estado</th>
              <th class="px-4 py-3 font-medium" />
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5">
            {rows.map((cc) => (
              <tr class="text-ink-100 hover:bg-white/[.02] transition-colors">
                <td class="px-4 py-3 font-mono text-[13px] text-ink-50">
                  <a href={`/admin/cuentas-cobro/${cc.id}`} class="hover:text-cyan transition-colors">{cc.number}</a>
                </td>
                <td class="px-4 py-3">
                  <div class="text-[13px] text-ink-50">{cc.company ?? cc.clientName}</div>
                  {cc.concept && <div class="text-[11px] text-ink-300 truncate max-w-[280px]">{cc.concept}</div>}
                </td>
                <td class="px-4 py-3 text-[13px] text-ink-200">{formatDate(cc.issuedAt)}</td>
                <td class="px-4 py-3 text-right font-mono text-[13px] text-ink-50">{formatMoney(cc.totalCents)}</td>
                <td class="px-4 py-3 text-right font-mono text-[13px]">
                  {cc.retentionsCents > 0
                    ? <span class="text-ink-200">{formatMoney(cc.netCents)}</span>
                    : <span class="text-ink-300">-</span>}
                </td>
                <td class="px-4 py-3">
                  <span class:list={['px-2 py-0.5 rounded-full border text-[11px] font-mono', STATUS_STYLE[cc.status]]}>
                    {STATUS_LABELS[cc.status]}
                  </span>
                </td>
                <td class="px-4 py-3 text-right whitespace-nowrap">
                  <a
                    href={`/api/admin/cuentas-cobro/${cc.id}/pdf`}
                    target="_blank"
                    rel="noopener"
                    class="h-7 px-3 inline-flex items-center rounded-full bg-white/[.03] border border-white/10 text-[12px] text-ink-200 hover:text-cyan hover:border-cyan/25 transition-colors"
                  >
                    PDF
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  )}

  <dialog id="dlg" class="backdrop:bg-ink-950/70 backdrop:backdrop-blur-sm bg-transparent p-0 m-auto">
    <form id="form" class="glass-strong rounded-2xl p-5 w-[min(94vw,680px)] max-h-[88vh] overflow-y-auto text-left">
      <h2 class="text-[16px] font-medium text-ink-50 mb-1">Nueva cuenta de cobro</h2>
      <p class="text-[12px] text-ink-300 mb-4">Se crea como borrador. Los datos del emisor se congelan al emitirla.</p>

      <div class="grid gap-3 sm:grid-cols-2">
        <div>
          <label for="clientId" class="block text-[12px] font-medium text-ink-100 mb-1.5">Deudor</label>
          <select id="clientId" name="clientId" required class="input-base w-full">
            {clientRows.map((c) => <option value={c.id}>{c.company ?? c.name}</option>)}
          </select>
          <p id="nit-warn" class="hidden mt-1 text-[11px] text-ember">
            Este cliente no tiene NIT en su ficha; sin él no se podrá emitir.
          </p>
        </div>
        <div>
          <label for="projectId" class="block text-[12px] font-medium text-ink-100 mb-1.5">Proyecto (opcional)</label>
          <select id="projectId" name="projectId" class="input-base w-full">
            <option value="">Sin proyecto</option>
          </select>
        </div>
        <div>
          <label for="city" class="block text-[12px] font-medium text-ink-100 mb-1.5">Ciudad de expedición</label>
          <input type="text" id="city" name="city" required value={emisor.ciudad} maxlength="120" class="input-base w-full" />
        </div>
        <div>
          <label for="contractRef" class="block text-[12px] font-medium text-ink-100 mb-1.5">Contrato / OC (opcional)</label>
          <input type="text" id="contractRef" name="contractRef" maxlength="120" class="input-base w-full" />
        </div>
        <div>
          <label for="periodStart" class="block text-[12px] font-medium text-ink-100 mb-1.5">Periodo desde</label>
          <input type="date" id="periodStart" name="periodStart" class="input-base w-full" />
        </div>
        <div>
          <label for="periodEnd" class="block text-[12px] font-medium text-ink-100 mb-1.5">Periodo hasta</label>
          <input type="date" id="periodEnd" name="periodEnd" class="input-base w-full" />
        </div>
      </div>

      <div class="mt-4">
        <label for="concept" class="block text-[12px] font-medium text-ink-100 mb-1.5">Concepto detallado</label>
        <textarea
          id="concept"
          name="concept"
          rows="2"
          required
          maxlength="500"
          class="input-base w-full resize-y"
          placeholder="Servicios de desarrollo de software prestados durante agosto de 2026…"
        />
        <p class="mt-1 text-[11px] text-ink-300">
          Un concepto genérico hace que contabilidad devuelva el documento: es el texto con el que el pagador arma su
          documento soporte ante la DIAN.
        </p>
      </div>

      <div class="mt-4">
        <label class="block text-[12px] font-medium text-ink-100 mb-2">Conceptos cobrados</label>
        <div id="items" class="space-y-2" />
        <button type="button" id="add-item" class="mt-2 h-8 px-3 rounded-full bg-white/[.03] border border-white/10 text-[12px] text-ink-100 hover:bg-white/[.06] transition-colors">
          + Añadir línea
        </button>
      </div>

      <div class="mt-4">
        <label class="block text-[12px] font-medium text-ink-100 mb-2">Retenciones que practica el pagador</label>
        <div class="space-y-1.5">
          {conceptos.map((c) => (
            <label class="flex items-start gap-2.5 text-[12.5px] text-ink-100 cursor-pointer">
              <input type="checkbox" class="ret mt-0.5" value={c.id} disabled={c.rate <= 0} />
              <span>
                {c.label}
                <span class="font-mono text-ink-300">
                  {' '}{c.rate > 0 ? `${(c.rate * 100).toFixed(2).replace(/\.?0+$/, '')} %` : 'sin configurar'}
                  {c.baseUvt > 0 ? ` · desde ${c.baseUvt} UVT` : ''}
                </span>
              </span>
            </label>
          ))}
        </div>
        <p class="mt-1.5 text-[11px] text-ink-300">
          Tarifas según <a href="/admin/settings" class="text-cyan hover:underline">Ajustes</a>
          {config.declarante ? ' (declarante de renta).' : ' (no declarante de renta).'}
          La cuenta se emite por el bruto; el neto es informativo.
        </p>
      </div>

      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        <div>
          <label for="ssPlanilla" class="block text-[12px] font-medium text-ink-100 mb-1.5">Planilla PILA (opcional)</label>
          <input type="text" id="ssPlanilla" name="ssPlanilla" maxlength="60" class="input-base w-full" />
        </div>
        <div>
          <label for="ssPeriodo" class="block text-[12px] font-medium text-ink-100 mb-1.5">Periodo cotizado</label>
          <input type="month" id="ssPeriodo" name="ssPeriodo" class="input-base w-full" />
        </div>
      </div>

      <div class="mt-4">
        <label for="notes" class="block text-[12px] font-medium text-ink-100 mb-1.5">Notas (opcional)</label>
        <textarea id="notes" name="notes" rows="2" maxlength="1000" class="input-base w-full resize-y" />
      </div>

      <div class="mt-4 pt-3 border-t border-white/5 space-y-1">
        <div class="flex justify-between items-baseline">
          <span class="text-[13px] text-ink-200">Total a cobrar</span>
          <span id="total" class="font-mono text-[17px] text-cyan">$ 0</span>
        </div>
        <div class="flex justify-between items-baseline">
          <span class="text-[12px] text-ink-300">Neto estimado tras retenciones</span>
          <span id="neto" class="font-mono text-[13px] text-ink-200">$ 0</span>
        </div>
        <div class="flex justify-between items-baseline">
          <span class="text-[12px] text-ink-300">IBC de seguridad social (40 %)</span>
          <span id="ibc" class="font-mono text-[13px] text-ink-200">$ 0</span>
        </div>
      </div>

      <p id="error" class="hidden mt-3 text-[12px] text-ember" role="alert" />

      <div class="mt-5 flex justify-end gap-2">
        <button type="button" id="cancel" class="h-9 px-4 rounded-full bg-white/[.03] border border-white/10 text-ink-100 text-[13px] hover:bg-white/[.06] transition-colors">
          Cancelar
        </button>
        <button type="submit" id="save" class="h-9 px-4 rounded-full bg-cyan text-ink-950 text-[13px] font-semibold hover:bg-cyan-glow transition-colors disabled:opacity-50">
          Crear borrador
        </button>
      </div>
    </form>
  </dialog>
</AdminLayout>

<script define:vars={{ projectRows, clientRows, conceptos }}>
  const dlg = document.getElementById('dlg')
  const form = document.getElementById('form')
  const itemsEl = document.getElementById('items')
  const errorEl = document.getElementById('error')

  const fmt = (cents) =>
    new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(cents / 100)

  // Previsualización en vivo. Es cortesía visual: el cálculo que vale es el del
  // servidor (lib/cuentas-cobro.ts), y esta pantalla no puede enviarle totales.
  const recalc = () => {
    let subtotal = 0
    itemsEl.querySelectorAll('.item').forEach((row) => {
      const qty = Number(row.querySelector('.qty').value) || 0
      const price = Number(row.querySelector('.price').value) || 0
      subtotal += Math.round(qty * Math.round(price * 100))
    })

    let retenciones = 0
    document.querySelectorAll('.ret:checked').forEach((cb) => {
      const c = conceptos.find((x) => x.id === cb.value)
      if (c && c.rate > 0 && subtotal >= c.minimoCents) retenciones += Math.round(subtotal * c.rate)
    })

    document.getElementById('total').textContent = fmt(subtotal)
    document.getElementById('neto').textContent = fmt(subtotal - retenciones)
    document.getElementById('ibc').textContent = fmt(Math.round(subtotal * 0.4))
  }

  const addItem = () => {
    const row = document.createElement('div')
    row.className = 'item grid grid-cols-[1fr_70px_120px_auto] gap-2 items-center'
    row.innerHTML = `
      <input type="text" class="desc input-base w-full text-[13px]" placeholder="Detalle" required />
      <input type="number" class="qty input-base w-full text-[13px]" value="1" min="0.01" step="0.01" required />
      <input type="number" class="price input-base w-full text-[13px]" placeholder="Valor unit." min="0" step="1" required />
      <button type="button" class="del w-7 h-7 rounded-lg text-ink-300 hover:text-ember hover:bg-white/[.06] transition-colors">×</button>
    `
    row.querySelector('.del').addEventListener('click', () => {
      row.remove()
      recalc()
    })
    row.querySelectorAll('input').forEach((i) => i.addEventListener('input', recalc))
    itemsEl.appendChild(row)
  }

  const syncCliente = () => {
    const clientId = Number(document.getElementById('clientId').value)

    const sel = document.getElementById('projectId')
    sel.innerHTML = '<option value="">Sin proyecto</option>'
    projectRows
      .filter((p) => p.clientId === clientId)
      .forEach((p) => {
        const o = document.createElement('option')
        o.value = p.id
        o.textContent = p.title
        sel.appendChild(o)
      })

    // Aviso temprano del NIT: es el campo que más devoluciones causa, y sin él
    // la emisión va a fallar de todos modos.
    const cliente = clientRows.find((c) => c.id === clientId)
    let tieneNit = false
    try {
      const info = cliente && cliente.billingInfo ? JSON.parse(cliente.billingInfo) : {}
      tieneNit = Object.entries(info).some(
        ([k, v]) =>
          /^(nit|documento|cedula|identificacion)$/.test(
            k.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase().replace(/[^a-z]/g, '')
          ) && typeof v === 'string' && v.trim()
      )
    } catch {
      tieneNit = false
    }
    document.getElementById('nit-warn').classList.toggle('hidden', tieneNit)
  }

  document.getElementById('btn-new')?.addEventListener('click', () => {
    errorEl.classList.add('hidden')
    itemsEl.innerHTML = ''
    addItem()
    syncCliente()
    recalc()
    dlg.showModal()
  })

  document.getElementById('cancel')?.addEventListener('click', () => dlg.close())
  document.getElementById('add-item')?.addEventListener('click', addItem)
  document.getElementById('clientId')?.addEventListener('change', syncCliente)
  document.querySelectorAll('.ret').forEach((cb) => cb.addEventListener('change', recalc))

  form?.addEventListener('submit', async (e) => {
    e.preventDefault()
    errorEl.classList.add('hidden')
    const save = document.getElementById('save')
    save.disabled = true

    const items = [...itemsEl.querySelectorAll('.item')].map((row) => ({
      description: row.querySelector('.desc').value,
      quantity: Number(row.querySelector('.qty').value),
      unitPrice: Number(row.querySelector('.price').value),
    }))

    const fd = new FormData(form)
    const res = await fetch('/api/admin/cuentas-cobro', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        clientId: Number(fd.get('clientId')),
        projectId: fd.get('projectId') ? Number(fd.get('projectId')) : null,
        city: fd.get('city'),
        concept: fd.get('concept'),
        contractRef: fd.get('contractRef'),
        periodStart: fd.get('periodStart') || null,
        periodEnd: fd.get('periodEnd') || null,
        ssPlanilla: fd.get('ssPlanilla'),
        ssPeriodo: fd.get('ssPeriodo'),
        notes: fd.get('notes'),
        retenciones: [...document.querySelectorAll('.ret:checked')].map((cb) => cb.value),
        items,
      }),
    })

    if (res.ok) {
      const body = await res.json().catch(() => ({}))
      window.location.href = body.cuenta ? `/admin/cuentas-cobro/${body.cuenta.id}` : '/admin/cuentas-cobro'
      return
    }
    const body = await res.json().catch(() => ({}))
    errorEl.textContent = body.error ?? 'No se pudo crear la cuenta de cobro.'
    errorEl.classList.remove('hidden')
    save.disabled = false
  })
</script>
