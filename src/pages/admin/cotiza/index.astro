---
import AdminLayout from '../../../layouts/AdminLayout.astro'
import CotizaLayout from '../../../layouts/CotizaLayout.astro'
import { CUPOS_POR_DEFECTO, HORA_USD, NIVELES } from '../../../data/cotiza'
import { formatearMonto, type Moneda } from '../../../data/tarifario'
import { listarEncargos, type FilaListado } from '../../../lib/cotiza/db'
import { formatFechaCorta } from '../../../lib/fecha-co'

// Cotiza (docs/plan-cotiza.md). Con PIN se pinta sin el menú del panel; con
// sesión admin, como cualquier otra página. La decisión la tomó el middleware.
const porPin = Astro.locals.cotizaPin === true
const isDemo = Astro.locals.demo === true
const Layout = porPin ? CotizaLayout : AdminLayout

// Si las migraciones 0045 y 0046 no están aplicadas en esta base (o en la de la demo), la
// página carga igual y lo dice, en vez de un 500.
let filas: FilaListado[] = []
let sinTablas = false
try {
  filas = await listarEncargos()
} catch {
  sinTablas = true
}

const ESTADO: Record<string, { label: string; dot: string; text: string }> = {
  borrador: { label: 'Borrador', dot: 'bg-ink-200', text: 'text-ink-200' },
  enviado: { label: 'Propuesta enviada', dot: 'bg-cyan', text: 'text-cyan' },
  aceptado: { label: 'En curso', dot: 'bg-lime', text: 'text-lime' },
  cerrado: { label: 'Cerrado', dot: 'bg-violet', text: 'text-violet' },
  descartado: { label: 'Descartado', dot: 'bg-ink-400', text: 'text-ink-300' },
}

const c = CUPOS_POR_DEFECTO
const cupos = [
  `${c.reuniones} reuniones de ${c.minutosPorReunion} minutos`,
  `${c.rondasDeCambios} rondas de cambios por entregable`,
  `Atención de ${c.horario.dias}, de ${c.horario.desde} a ${c.horario.hasta}, sin festivos`,
  `Respuesta en ${c.respuestaDiasHabiles} día hábil`,
  `Resumen escrito de cada reunión, con ${c.diasParaCorregirResumen} día hábil para corregirlo`,
  `Urgencias fuera de horario: +${Math.round(c.recargoUrgencia * 100)} %`,
]

const activos = filas.filter((f) => f.estado === 'aceptado')
const porDecidir = filas.reduce((t, f) => t + (f.estado === 'aceptado' && f.propuestos > 0 ? 1 : 0), 0)
---

<Layout title="Cotiza · consultoría">
  <div class="space-y-6 max-w-5xl">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <p class="max-w-[60ch] text-[13.5px] text-ink-200 leading-relaxed">
        Encargos de consultoría en logística, comercio exterior, compras y operaciones. El precio se fija al inicio y
        no se toca: lo incluido se cuenta como cupos y lo nuevo entra como adicional, aprobado antes de hacerlo.
      </p>
      {!isDemo && !sinTablas && (
        <button id="nuevo" class="h-9 px-4 rounded-full bg-cyan text-ink-950 text-[13px] font-semibold hover:bg-cyan-glow transition-colors">
          Nuevo encargo
        </button>
      )}
    </div>

    {sinTablas && (
      <div class="rounded-xl border border-ember/25 bg-ember/[.06] px-4 py-3 text-[13px] text-ink-100">
        Faltan las tablas de Cotiza en esta base: hay que aplicar las migraciones
        <span class="font-mono text-ember">0045 y 0046</span>.
      </div>
    )}

    {!sinTablas && (
      <section class="rounded-2xl glass p-5 md:p-6">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan"></span>
            <h2 class="text-base font-medium">Encargos</h2>
          </div>
          {activos.length > 0 && (
            <span class="text-[12px] font-mono text-ink-300">
              {activos.length} en curso{porDecidir ? ` · ${porDecidir} con adicionales por decidir` : ''}
            </span>
          )}
        </div>
        {filas.length === 0 ? (
          <p class="mt-3 text-[13px] text-ink-200">Aún no hay encargos. Crea el primero con el botón de arriba.</p>
        ) : (
          <ul class="mt-3 divide-y divide-white/5">
            {filas.map((f) => {
              const est = ESTADO[f.estado] ?? ESTADO.borrador
              const moneda = f.moneda as Moneda
              return (
                <li>
                  <a href={`/admin/cotiza/${f.id}`} class="group flex flex-wrap items-center gap-x-4 gap-y-1 py-3 -mx-2 px-2 rounded-lg hover:bg-white/[.03] transition-colors">
                    <div class="min-w-0 flex-1">
                      <div class="text-[13.5px] text-ink-50 truncate group-hover:text-cyan transition-colors">{f.titulo}</div>
                      <div class="text-[11.5px] text-ink-300 truncate">
                        {[f.clienteNombre, f.clienteEmpresa].filter(Boolean).join(' · ') || 'Sin cliente'} · {formatFechaCorta(f.actualizadoEl)}
                      </div>
                    </div>
                    {f.estado === 'aceptado' && (
                      <div class="text-[11.5px] font-mono text-ink-300">
                        reuniones {f.reunionesUsadas}/{c.reuniones}
                        {f.propuestos > 0 && <span class="text-ember"> · por decidir {formatearMonto(f.propuestos, moneda)}</span>}
                      </div>
                    )}
                    <div class="text-right">
                      <div class="font-mono text-[13px] text-ink-100">
                        {f.precio !== null ? formatearMonto(f.precio + f.aprobados, moneda) : '-'}
                      </div>
                      {f.aprobados > 0 && <div class="text-[10.5px] font-mono text-ink-300">incluye {formatearMonto(f.aprobados, moneda)} adicional</div>}
                    </div>
                    <span class={`inline-flex items-center gap-1.5 text-[11px] font-mono ${est.text}`}>
                      <span class={`w-1.5 h-1.5 rounded-full ${est.dot}`}></span>
                      {est.label}
                    </span>
                  </a>
                </li>
              )
            })}
          </ul>
        )}
      </section>
    )}

    <div class="grid gap-6 md:grid-cols-2">
      <section class="rounded-2xl glass p-5 md:p-6">
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-lime"></span>
          <h2 class="text-base font-medium">Tarifa por hora</h2>
        </div>
        <ul class="mt-4 divide-y divide-white/5">
          {NIVELES.map((n) => (
            <li class="py-2.5 flex items-start justify-between gap-4">
              <div class="min-w-0">
                <div class="text-[13px] text-ink-50">{n.nombre}</div>
                <div class="text-[11.5px] text-ink-300">{n.ejemplos}</div>
              </div>
              <div class="shrink-0 font-mono text-[13px] text-ink-100">{formatearMonto(n.horaCop, 'COP')}</div>
            </li>
          ))}
          <li class="py-2.5 flex items-start justify-between gap-4">
            <div class="min-w-0">
              <div class="text-[13px] text-ink-50">En dólares</div>
              <div class="text-[11.5px] text-ink-300">Cualquier asesoría, sin niveles</div>
            </div>
            <div class="shrink-0 font-mono text-[13px] text-ink-100">{formatearMonto(HORA_USD, 'USD')}</div>
          </li>
        </ul>
      </section>

      <section class="rounded-2xl glass p-5 md:p-6">
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-violet"></span>
          <h2 class="text-base font-medium">Incluido en cada encargo</h2>
        </div>
        <ul class="mt-4 space-y-2.5">
          {cupos.map((t) => (
            <li class="text-[13px] text-ink-100">{t}</li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</Layout>

<script>
  document.getElementById('nuevo')?.addEventListener('click', async (ev) => {
    const boton = ev.currentTarget as HTMLButtonElement
    boton.disabled = true
    const res = await fetch('/api/admin/cotiza/encargos', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' })
    const cuerpo = (await res.json().catch(() => null)) as { id?: number; error?: string } | null
    if (res.ok && cuerpo?.id) {
      location.assign(`/admin/cotiza/${cuerpo.id}`)
      return
    }
    boton.disabled = false
    alert(cuerpo?.error ?? 'No se pudo crear el encargo.')
  })
</script>
