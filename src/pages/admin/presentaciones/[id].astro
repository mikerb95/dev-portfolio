---
// Detalle de un deck: metadatos, reemplazo del archivo, borrado y el índice de
// slides con sus notas tal como las leyó el parser.
//
// Ese índice no es decorativo: es la única forma de comprobar, antes de
// proyectar, que el HTML trae los `data-label` y `data-speaker-notes` donde
// deben ir. Descubrir que las notas no se extrajeron con el público delante es
// justo lo que esta pantalla evita.
import AdminLayout from '../../../layouts/AdminLayout.astro'
import { getDeck, getDeckSlides } from '../../../lib/present/decks'

const id = Number(Astro.params.id)
const deck = Number.isInteger(id) ? await getDeck(id) : null

if (!deck) {
  return Astro.rewrite('/404')
}

const slides = await getDeckSlides(deck.id)
const withNotes = slides.filter((s) => s.speakerNotes).length
const withoutLabel = slides.filter((s) => !s.label).length
---

<AdminLayout title={deck.title}>
  <a href="/admin/presentaciones" class="text-[11px] font-mono text-ink-300 hover:text-cyan transition-colors">
    ← Biblioteca
  </a>

  <div class="mt-4 mb-8 flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-medium tracking-tight text-ink-50">{deck.title}</h1>
      {deck.description && <p class="mt-1 text-[13px] text-ink-200 max-w-xl">{deck.description}</p>}
    </div>
    <a
      href={`/admin/presentaciones/${deck.id}/lanzar`}
      class="h-9 px-5 inline-flex items-center rounded-full bg-cyan/15 text-cyan border border-cyan/30 text-[12px] hover:bg-cyan/25 transition-colors"
    >
      Presentar
    </a>
  </div>

  <div class="grid grid-cols-3 gap-3 md:gap-4 mb-8">
    <div class="rounded-2xl glass p-5">
      <div class="text-[10px] font-mono uppercase tracking-[.22em] text-ink-200">Slides</div>
      <div class="mt-2 text-2xl md:text-3xl font-medium tracking-tight text-ink-50">{deck.slideCount}</div>
    </div>
    <div class="rounded-2xl glass p-5">
      <div class="text-[10px] font-mono uppercase tracking-[.22em] text-ink-200">Con notas</div>
      <div class="mt-2 text-2xl md:text-3xl font-medium tracking-tight text-ink-50">{withNotes}</div>
    </div>
    <div class="rounded-2xl glass p-5">
      <div class="text-[10px] font-mono uppercase tracking-[.22em] text-ink-200">Sin rótulo</div>
      <div class={`mt-2 text-2xl md:text-3xl font-medium tracking-tight ${withoutLabel > 0 ? 'text-[#ffb454]' : 'text-ink-50'}`}>
        {withoutLabel}
      </div>
    </div>
  </div>

  {withoutLabel > 0 && (
    <p class="text-[11px] text-ink-200 mb-8 -mt-4">
      Los slides sin <span class="font-mono text-cyan">data-label</span> aparecen como «Sin rótulo» en el
      selector del control remoto.
    </p>
  )}

  <div class="grid gap-4 lg:grid-cols-2">
    {/* Metadatos */}
    <section class="rounded-2xl glass p-5">
      <h2 class="text-[13px] font-medium text-ink-50 mb-4">Metadatos</h2>
      <form id="meta-form" class="grid gap-3">
        <label class="grid gap-1.5">
          <span class="text-[11px] font-mono uppercase tracking-[.18em] text-ink-200">Título</span>
          <input
            name="title"
            value={deck.title}
            required
            class="h-10 px-3 rounded-lg bg-ink-800 border border-white/10 text-[13px] text-ink-50 focus:border-cyan/40 outline-none"
          />
        </label>
        <label class="grid gap-1.5">
          <span class="text-[11px] font-mono uppercase tracking-[.18em] text-ink-200">Descripción</span>
          <input
            name="description"
            value={deck.description ?? ''}
            class="h-10 px-3 rounded-lg bg-ink-800 border border-white/10 text-[13px] text-ink-50 focus:border-cyan/40 outline-none"
          />
        </label>
        <div class="flex items-center gap-3">
          <button
            type="submit"
            class="h-9 px-4 rounded-full bg-white/5 text-ink-100 border border-white/10 text-[12px] hover:bg-white/10 transition-colors"
          >
            Guardar
          </button>
          <span id="meta-msg" class="text-[11px] font-mono text-ink-200"></span>
        </div>
      </form>
    </section>

    {/* Archivo */}
    <section class="rounded-2xl glass p-5">
      <h2 class="text-[13px] font-medium text-ink-50 mb-4">Archivo</h2>
      <p class="text-[11px] font-mono text-ink-300 mb-3 break-all">{deck.blobPath}</p>
      <form id="file-form" class="grid gap-3">
        <input
          id="replace-folder"
          type="file"
          webkitdirectory
          directory
          multiple
          required
          class="h-10 px-3 py-2 rounded-lg bg-ink-800 border border-white/10 text-[12px] text-ink-100 file:mr-3 file:h-6 file:px-2 file:rounded file:border-0 file:bg-cyan/15 file:text-cyan file:text-[11px]"
        />
        <span class="text-[10px] text-ink-300">La carpeta completa, igual que al subirlo.</span>
        <div class="flex items-center gap-3">
          <button
            type="submit"
            class="h-9 px-4 rounded-full bg-white/5 text-ink-100 border border-white/10 text-[12px] hover:bg-white/10 transition-colors"
          >
            Reemplazar archivo
          </button>
          <span id="file-msg" class="text-[11px] font-mono text-ink-200"></span>
        </div>
      </form>

      <div class="mt-5 pt-4 border-t border-white/5 flex items-center gap-3">
        <button
          type="button"
          id="delete-deck"
          class="h-9 px-4 rounded-full bg-white/5 text-[#ff9a9a] border border-[#ff7a7a]/25 text-[12px] hover:bg-[#ff7a7a]/10 transition-colors"
        >
          Borrar deck
        </button>
        <span class="text-[11px] text-ink-300">Los comentarios que dejó el público se conservan.</span>
      </div>
    </section>
  </div>

  {/* Índice de slides */}
  <section class="mt-8">
    <h2 class="text-[13px] font-medium text-ink-50 mb-3">Slides y notas</h2>
    <div class="space-y-2">
      {slides.map((s) => (
        <div class="rounded-xl glass p-4 flex gap-4">
          <span class="font-mono text-[12px] text-cyan shrink-0 pt-0.5">{String(s.idx + 1).padStart(2, '0')}</span>
          <div class="min-w-0 flex-1">
            <div class="text-[13px] text-ink-50">{s.label ?? <span class="text-ink-300 italic">Sin rótulo</span>}</div>
            {s.speakerNotes ? (
              <p class="mt-1.5 text-[12px] text-ink-200 leading-relaxed whitespace-pre-wrap">{s.speakerNotes}</p>
            ) : (
              <p class="mt-1.5 text-[11px] text-ink-300 italic">Sin notas</p>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>
</AdminLayout>

<script is:inline define:vars={{ deckId: deck.id }}>
  const post = async (msgEl, run) => {
    msgEl.textContent = 'guardando…'
    const res = await run()
    const body = await res.json().catch(() => ({}))
    if (res.ok) {
      msgEl.textContent = 'listo ✓'
      location.reload()
    } else {
      msgEl.textContent = body.error ?? 'no se pudo guardar'
    }
  }

  document.getElementById('meta-form').addEventListener('submit', (e) => {
    e.preventDefault()
    const form = e.target
    post(document.getElementById('meta-msg'), () =>
      fetch(`/api/admin/decks/${deckId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          title: form.title.value,
          description: form.description.value,
        }),
      })
    )
  })

  document.getElementById('file-form').addEventListener('submit', (e) => {
    e.preventDefault()
    const chosen = [...(document.getElementById('replace-folder').files || [])]
    if (!chosen.length) {
      document.getElementById('file-msg').textContent = 'selecciona la carpeta'
      return
    }
    const data = new FormData()
    for (const file of chosen) {
      data.append('files', file)
      data.append('paths', file.webkitRelativePath || file.name)
    }
    post(document.getElementById('file-msg'), () =>
      fetch(`/api/admin/decks/${deckId}`, { method: 'PUT', body: data })
    )
  })

  document.getElementById('delete-deck').addEventListener('click', async () => {
    if (!confirm('¿Borrar este deck y su archivo? Los comentarios del público se conservan.')) return
    const res = await fetch(`/api/admin/decks/${deckId}`, { method: 'DELETE' })
    if (res.ok) location.href = '/admin/presentaciones'
  })
</script>
