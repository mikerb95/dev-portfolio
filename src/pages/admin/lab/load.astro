---
import AdminLayout from '../../../layouts/AdminLayout.astro'
---

<AdminLayout title="Load testing">
  <div class="mb-6">
    <p class="text-zinc-400 text-sm max-w-3xl">
      Corridas de <strong class="text-zinc-300">k6</strong> contra un objetivo desechable (local o preview),
      nunca producción. Cada corrida responde tres preguntas que un promedio no responde:
      cuánta carga sostiene el sistema, con cuánta se rompe, y cuánto tarda en volver cuando la carga cesa.
    </p>
    <p class="text-zinc-600 text-xs mt-2 font-mono">
      k6 run lab/k6/carga.js -e TARGET=&lt;url&gt; &nbsp;·&nbsp; lab/k6/estres.js
    </p>
  </div>

  <div id="runs" class="grid gap-5"><p class="text-zinc-600 text-sm">Cargando…</p></div>
</AdminLayout>

<script>
  const esc = (v: unknown) => String(v ?? '').replace(/[&<>"']/g, (c) =>
    ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!)

  type Step = {
    carga: number
    unidad: 'vus' | 'rps'
    n: number
    exitosasRps: number | null
    p50: number | null
    p95: number | null
    p99: number | null
    errorPct: number
    cpuPct: number | null
    heapMb: number | null
    estado: 'ok' | 'degradado' | 'roto'
  }

  const ESTADO: Record<Step['estado'], { fill: string; dot: string; text: string; label: string }> = {
    ok: { fill: '#10b981', dot: 'bg-emerald-500', text: 'text-emerald-400', label: 'ok' },
    degradado: { fill: '#f59e0b', dot: 'bg-amber-500', text: 'text-amber-400', label: 'degradado' },
    roto: { fill: '#ef4444', dot: 'bg-red-500', text: 'text-red-400', label: 'roto' },
  }

  const ms = (v: number | null) => (v == null ? '-' : v >= 1000 ? `${(v / 1000).toFixed(1)}s` : `${Math.round(v)}ms`)
  const n1 = (v: number | null) => (v == null ? '-' : String(Math.round(v * 10) / 10))

  const fecha = (iso: string) =>
    new Date(iso).toLocaleString('es-CO', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' })

  /**
   * Escalera de la corrida en SVG: una barra por escalón con la altura del p95
   * y el color de su estado, más el p50 como línea. Sin librerías (misma regla
   * que el resto del panel) y sin ejes numéricos falsos: la altura es relativa
   * al peor p95 de la propia corrida, que es lo que hace comparables los
   * escalones entre sí, no entre corridas distintas.
   */
  function grafica(steps: Step[]): string {
    if (!steps.length) return '<p class="text-zinc-600 text-sm">Sin escalones registrados.</p>'

    // viewBox ancho y bajo a propósito: el SVG se escala al ancho de la
    // tarjeta, así que la proporción del viewBox es lo que decide su altura
    // final en pantalla y el tamaño relativo de las etiquetas.
    const W = 1200, H = 260, PAD_B = 42, PAD_T = 12
    const maxP95 = Math.max(...steps.map((s) => s.p95 ?? 0), 1)
    const ancho = W / steps.length
    const alto = (v: number | null) => Math.max(1, ((v ?? 0) / maxP95) * (H - PAD_B - PAD_T))

    const barras = steps.map((s, i) => {
      const h = alto(s.p95)
      const x = i * ancho + ancho * 0.18
      const w = ancho * 0.64
      const y = H - PAD_B - h
      const c = ESTADO[s.estado] ?? ESTADO.ok
      const etiqueta = s.unidad === 'vus' ? `${s.carga} VUs` : `${s.carga}/s`
      return `
        <rect x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${w.toFixed(1)}" height="${h.toFixed(1)}" rx="3" fill="${c.fill}" fill-opacity="0.75">
          <title>${esc(etiqueta)} · p50 ${ms(s.p50)} · p95 ${ms(s.p95)} · ${n1(s.errorPct)}% error</title>
        </rect>
        <text x="${(i * ancho + ancho / 2).toFixed(1)}" y="${H - PAD_B + 17}" text-anchor="middle" font-size="13" fill="#71717a">${esc(etiqueta)}</text>
        <text x="${(i * ancho + ancho / 2).toFixed(1)}" y="${H - PAD_B + 33}" text-anchor="middle" font-size="12" fill="${s.errorPct >= 1 ? c.fill : '#3f3f46'}">${n1(s.errorPct)}%</text>`
    }).join('')

    const puntos = steps.map((s, i) => `${(i * ancho + ancho / 2).toFixed(1)},${(H - PAD_B - alto(s.p50)).toFixed(1)}`).join(' ')

    return `
      <svg viewBox="0 0 ${W} ${H}" class="w-full h-auto" role="img" aria-label="Latencia p95 por escalón de carga">
        <line x1="0" y1="${H - PAD_B}" x2="${W}" y2="${H - PAD_B}" stroke="#27272a" stroke-width="1" />
        ${barras}
        <polyline points="${puntos}" fill="none" stroke="#a1a1aa" stroke-width="1.5" stroke-dasharray="3 3" />
      </svg>
      <div class="flex flex-wrap gap-4 text-[11px] text-zinc-500 mt-1">
        <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm bg-zinc-500/70"></span>barra: p95 (máx ${ms(maxP95)})</span>
        <span class="inline-flex items-center gap-1.5"><span class="w-4 border-t border-dashed border-zinc-400"></span>p50</span>
        <span>debajo de cada escalón: % de error</span>
      </div>`
  }

  function metrica(label: string, valor: string, tono = 'text-zinc-300'): string {
    return `
      <div>
        <div class="text-[10px] text-zinc-600 uppercase tracking-wide">${esc(label)}</div>
        <div class="text-sm font-mono ${tono}">${esc(valor)}</div>
      </div>`
  }

  function tarjeta(r: any): string {
    const steps: Step[] = JSON.parse(r.stepsJson ?? '[]')
    const hallazgos: { id: string; titulo: string; descripcion: string }[] = JSON.parse(r.findingsJson ?? '[]')
    const peor = steps.reduce<Step['estado']>((acc, s) => (s.estado === 'roto' ? 'roto' : s.estado === 'degradado' && acc === 'ok' ? 'degradado' : acc), 'ok')
    const c = ESTADO[peor]

    // El quiebre se lee de los escalones y no solo de `breakingPointRps`: ese
    // campo solo existe en req/s (escenario de estrés), y una corrida de carga
    // medida en VUs que sí se rompió mostraría "no llegó", que es justo lo
    // contrario de lo que pasó.
    const primerRoto = steps.find((s) => s.estado === 'roto')
    const quiebre = primerRoto
      ? { txt: primerRoto.unidad === 'vus' ? `${primerRoto.carga} VUs` : `${n1(primerRoto.carga)}/s`, tono: 'text-red-400' }
      : { txt: 'no llegó', tono: 'text-zinc-500' }

    // Solo el escenario de estrés tiene fase de recuperación. En el de carga no
    // hay nada que medir, y pintar "no volvió" sería inventar un fallo.
    const recuperacion = r.scenario !== 'estres'
      ? { txt: 'n/a', tono: 'text-zinc-600' }
      // "No se recuperó" y "se recuperó al instante" son lecturas opuestas y
      // las dos podrían imprimirse como un número pequeño: se distinguen.
      : r.recoveredAfterS == null
        ? { txt: 'no volvió', tono: 'text-red-400' }
        : { txt: `${r.recoveredAfterS}s`, tono: 'text-zinc-300' }

    return `
      <article class="rounded-xl border border-zinc-800 p-5">
        <header class="flex flex-wrap items-start justify-between gap-3 mb-4">
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full ${c.dot}"></span>
              <h2 class="text-sm text-zinc-100 font-medium">${esc(r.scenario === 'estres' ? 'Estrés' : 'Carga')} · ${esc(r.tool)}</h2>
            </div>
            <div class="text-[11px] text-zinc-600 font-mono truncate mt-1">${esc(r.target)}</div>
          </div>
          <div class="text-right shrink-0">
            <div class="text-[11px] text-zinc-500">${esc(fecha(r.ranAt))}</div>
            <div class="text-[11px] ${r.thresholdsOk === false ? 'text-amber-400' : 'text-zinc-600'}">
              ${r.thresholdsOk === false ? 'umbrales incumplidos' : r.thresholdsOk ? 'umbrales cumplidos' : ''}
            </div>
          </div>
        </header>

        <div class="grid grid-cols-3 sm:grid-cols-6 gap-3 mb-5">
          ${metrica('p50', ms(r.p50))}
          ${metrica('p95', ms(r.p95))}
          ${metrica('p99', ms(r.p99))}
          ${metrica('sostenido', r.sustainedRps == null ? '-' : `${n1(r.sustainedRps)}/s`, 'text-emerald-400')}
          ${metrica('quiebre', quiebre.txt, quiebre.tono)}
          ${metrica('recuperación', recuperacion.txt, recuperacion.tono)}
        </div>

        ${grafica(steps)}

        <div class="mt-4 text-[11px] text-zinc-600 font-mono">
          ${esc(String(r.requests ?? 0))} peticiones · ${n1(r.rps)}/s medio · ${n1(r.errorRatePct)}% error ·
          ${esc(String(r.checksPassed ?? 0))}/${esc(String((r.checksPassed ?? 0) + (r.checksFailed ?? 0)))} checks ·
          ${esc(String(r.durationS ?? 0))}s · pico ${esc(String(r.vusMax ?? '-'))} VUs
        </div>

        ${hallazgos.length ? `
          <details class="mt-4 group">
            <summary class="cursor-pointer text-xs text-zinc-400 hover:text-zinc-200">
              ${hallazgos.length} hallazgo${hallazgos.length === 1 ? '' : 's'} de la corrida
            </summary>
            <ul class="mt-3 space-y-3">
              ${hallazgos.map((h) => `
                <li>
                  <div class="text-xs text-zinc-300"><span class="font-mono text-zinc-500">${esc(h.id)}</span> ${esc(h.titulo)}</div>
                  <p class="text-[11px] text-zinc-500 mt-1 leading-relaxed">${esc(h.descripcion)}</p>
                </li>`).join('')}
            </ul>
          </details>` : ''}
      </article>`
  }

  async function load() {
    const el = document.getElementById('runs')!
    try {
      const rows = await (await fetch('/api/admin/lab/load')).json()
      if (!Array.isArray(rows) || !rows.length) {
        el.innerHTML = `<p class="text-zinc-600 text-sm">
          Sin corridas todavía. Corre <span class="font-mono">k6 run lab/k6/carga.js</span> contra un objetivo local
          o dispara el workflow <span class="font-mono">load-test.yml</span> contra un preview.
        </p>`
        return
      }
      el.innerHTML = rows.map(tarjeta).join('')
    } catch {
      el.innerHTML = '<p class="text-red-400 text-sm">No se pudieron cargar las corridas.</p>'
    }
  }

  load()
</script>
