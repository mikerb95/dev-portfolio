---
import AdminLayout from '../../layouts/AdminLayout.astro'
import { db } from '../../db'
import { appSettings } from '../../db/schema'
import { CURRENCIES, BASE_CURRENCY } from '../../lib/money'
import { ALLOWED_GITHUB_LOGINS } from '../../lib/auth'
import { CONCEPTOS_DEFAULT, UVT_2026_CENTS } from '../../lib/cuentas-cobro'

const settingsRows = await db.select().from(appSettings)
const map = Object.fromEntries(settingsRows.map((r) => [r.key, r.value]))

// Datos del emisor y parámetros tributarios de las cuentas de cobro. Viven en
// app_settings y no en el código porque las tarifas y bases de retención
// cambian de un año a otro (y durante 2025-2026 cambiaron dos veces con el
// Decreto 572 de 2025): un contador tiene que poder corregirlas sin un deploy.
// Ver docs/plan-cuentas-de-cobro.md.
const EMISOR_FIELDS: {
  key: string
  label: string
  placeholder?: string
  // Literal y no `string`: es el atributo `type` de un <input>, que TS tipa
  // como una unión cerrada.
  type?: 'text' | 'tel' | 'email'
}[] = [
  { key: 'emisor_nombre', label: 'Nombre completo' },
  { key: 'emisor_cedula', label: 'Cédula' },
  { key: 'emisor_direccion', label: 'Dirección' },
  { key: 'emisor_ciudad', label: 'Ciudad' },
  { key: 'emisor_telefono', label: 'Teléfono', type: 'tel' },
  { key: 'emisor_email', label: 'Email', type: 'email' },
  { key: 'emisor_banco', label: 'Banco' },
  { key: 'emisor_tipo_cuenta', label: 'Tipo de cuenta', placeholder: 'Ahorros / Corriente' },
  { key: 'emisor_numero_cuenta', label: 'Número de cuenta' },
]

const valueOf = (key: string) => map[key] ?? ''

// Las tarifas se teclean en porcentaje; la conversión a fracción la hace
// parseCuentaCobroConfig al leerlas, no esta vista.
const pctDefault = (id: string, campo: 'rateDeclarante' | 'rateNoDeclarante') =>
  String((CONCEPTOS_DEFAULT.find((c) => c.id === id)![campo] * 100).toFixed(2).replace(/\.?0+$/, ''))

const RET_FIELDS: { key: string; label: string; placeholder: string; step: string }[] = [
  { key: 'ret_honorarios_declarante', label: 'Honorarios · declarante (%)', placeholder: pctDefault('honorarios', 'rateDeclarante'), step: '0.01' },
  { key: 'ret_honorarios_no_declarante', label: 'Honorarios · no declarante (%)', placeholder: pctDefault('honorarios', 'rateNoDeclarante'), step: '0.01' },
  { key: 'ret_servicios_declarante', label: 'Servicios · declarante (%)', placeholder: pctDefault('servicios', 'rateDeclarante'), step: '0.01' },
  { key: 'ret_servicios_no_declarante', label: 'Servicios · no declarante (%)', placeholder: pctDefault('servicios', 'rateNoDeclarante'), step: '0.01' },
  { key: 'ret_servicios_base_uvt', label: 'Servicios · base mínima (UVT)', placeholder: '2', step: '1' },
  { key: 'ret_reteica_por_mil', label: 'ReteICA (por mil)', placeholder: 'p. ej. 9.66', step: '0.01' },
]

const esDeclarante = map['emisor_declarante'] === 'true'
const uvtPesos = map['uvt_cents'] ? String(Number(map['uvt_cents']) / 100) : ''
const smmlvPesos = map['smmlv_cents'] ? String(Number(map['smmlv_cents']) / 100) : ''
const uvtDefaultPesos = String(UVT_2026_CENTS / 100)

const fxCurrencies = CURRENCIES.filter((c) => c !== BASE_CURRENCY)
const rateOf = (cur: string) => map[`fx_${cur}_per_USD`] ?? ''

// Estado de seguridad (no se expone el valor de la clave)
const encKey = import.meta.env.ENCRYPTION_KEY as string | undefined
const encKeyOk = !!encKey && encKey.length === 64
---

<AdminLayout title="Ajustes">
  <div class="max-w-2xl space-y-6">
    <!-- Tasas de cambio -->
    <div class="rounded-2xl glass p-5 md:p-6">
      <h2 class="text-base font-medium text-ink-50">Tasas de cambio</h2>
      <p class="text-[12px] text-ink-300 mt-1 mb-4">
        Unidades de cada moneda por <span class="font-mono text-cyan">1 {BASE_CURRENCY}</span>. Se usan para convertir costos a USD base.
        Déjalo vacío si no usas esa moneda.
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
        {fxCurrencies.map((cur) => (
          <div>
            <label class="block text-[11px] font-mono uppercase tracking-wider text-ink-300 mb-1">{cur} / USD</label>
            <input
              data-cur={cur}
              type="number" step="0.0001" min="0"
              value={rateOf(cur)}
              placeholder="-"
              class="rate-input input-base w-full rounded-lg px-3 py-2 text-[13px] font-mono"
            />
          </div>
        ))}
      </div>
      <div class="flex items-center gap-3 mt-4">
        <button id="save-rates" class="h-9 px-4 text-[13px] font-medium rounded-full bg-cyan text-ink-950 hover:bg-cyan-glow transition-colors">Guardar tasas</button>
        <span id="rates-status" class="text-[12px] font-mono text-lime hidden">✓ Guardado</span>
      </div>
    </div>

    <!-- Seguridad -->
    <div class="rounded-2xl glass p-5 md:p-6">
      <h2 class="text-base font-medium text-ink-50 mb-4">Seguridad</h2>

      <div class="flex items-center justify-between py-2.5 border-b border-white/5">
        <div>
          <div class="text-[13px] text-ink-100">Clave de cifrado (ENCRYPTION_KEY)</div>
          <div class="text-[11px] font-mono text-ink-300">Requerida para la bóveda de credenciales y env vars</div>
        </div>
        {encKeyOk
          ? <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-mono bg-lime/10 text-lime border border-lime/30">✓ configurada</span>
          : <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-mono bg-ember/10 text-ember border border-ember/30">✗ falta</span>}
      </div>

      {!encKeyOk && (
        <div class="mt-3 rounded-lg border border-ember/25 bg-ember/[.05] px-3 py-2.5 text-[11.5px] text-ink-100">
          Genera una clave hex de 32 bytes y añádela como <span class="font-mono text-ember">ENCRYPTION_KEY</span> en tu <span class="font-mono">.env</span> y en Vercel:
          <code class="block mt-1.5 font-mono text-[11px] text-cyan bg-black/30 rounded px-2 py-1 select-all">node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"</code>
        </div>
      )}

      <div class="py-2.5 mt-1">
        <div class="text-[13px] text-ink-100 mb-2">Logins de GitHub autorizados</div>
        <div class="flex flex-wrap gap-2">
          {ALLOWED_GITHUB_LOGINS.map((l) => (
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-mono bg-white/5 text-ink-100 border border-white/10">
              <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="currentColor" class="text-ink-300"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.26.82-.577v-2.03c-3.338.726-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.082-.73.082-.73 1.205.085 1.84 1.237 1.84 1.237 1.07 1.835 2.807 1.305 3.492.997.108-.776.42-1.305.762-1.605-2.665-.305-5.467-1.332-5.467-5.93 0-1.31.467-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23A11.5 11.5 0 0 1 12 5.8c1.02.005 2.045.138 3.003.404 2.29-1.552 3.295-1.23 3.295-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.62-5.475 5.92.43.37.81 1.096.81 2.21v3.28c0 .32.21.695.825.575C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12z"/></svg>
              {l}
            </span>
          ))}
        </div>
        <p class="text-[11px] font-mono text-ink-300 mt-2">Edítalos con la variable <span class="text-ink-100">ALLOWED_GITHUB_LOGINS</span> (separados por coma).</p>
      </div>
    </div>

    <!-- Cuentas de cobro: datos del emisor -->
    <div class="rounded-2xl glass p-5 md:p-6">
      <h2 class="text-base font-medium text-ink-50">Emisor de cuentas de cobro</h2>
      <p class="text-[12px] text-ink-300 mt-1 mb-4">
        Van impresos en cada cuenta de cobro y se <span class="text-ink-100">congelan al emitirla</span>: cambiarlos
        aquí no reescribe un documento ya entregado. Son exactamente los datos con los que el pagador genera su
        Documento Soporte ante la DIAN.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {EMISOR_FIELDS.map((f) => (
          <div>
            <label for={f.key} class="block text-[11px] font-mono uppercase tracking-wider text-ink-300 mb-1">{f.label}</label>
            <input
              id={f.key}
              data-key={f.key}
              type={f.type ?? 'text'}
              value={valueOf(f.key)}
              placeholder={f.placeholder ?? '-'}
              class="cc-input input-base w-full rounded-lg px-3 py-2 text-[13px]"
            />
          </div>
        ))}
      </div>

      <label class="flex items-center gap-2.5 mt-4 text-[13px] text-ink-100 cursor-pointer">
        <input id="emisor_declarante" type="checkbox" checked={esDeclarante} />
        Soy declarante de renta
      </label>
      <p class="text-[11px] text-ink-300 mt-1">
        Cambia la tarifa de retención por honorarios (11 % declarante frente a 10 % no declarante) y la de servicios
        (4 % frente a 6 %).
      </p>
    </div>

    <!-- Cuentas de cobro: parámetros tributarios -->
    <div class="rounded-2xl glass p-5 md:p-6">
      <h2 class="text-base font-medium text-ink-50">Retenciones y UVT</h2>
      <p class="text-[12px] text-ink-300 mt-1 mb-4">
        Parametrizado y no incrustado en el código a propósito: las bases mínimas de retención se movieron durante
        2025-2026 con el Decreto 572 de 2025 y sus modificaciones. Un valor vacío usa el que se muestra como marcador.
        <span class="text-ink-100">Valídalos con tu contador antes de emitir la primera cuenta real.</span>
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label for="uvt_pesos" class="block text-[11px] font-mono uppercase tracking-wider text-ink-300 mb-1">UVT del año (pesos)</label>
          <input id="uvt_pesos" type="number" step="1" min="0" value={uvtPesos} placeholder={uvtDefaultPesos} class="input-base w-full rounded-lg px-3 py-2 text-[13px] font-mono" />
        </div>
        <div>
          <label for="smmlv_pesos" class="block text-[11px] font-mono uppercase tracking-wider text-ink-300 mb-1">SMMLV (pesos)</label>
          <input id="smmlv_pesos" type="number" step="1" min="0" value={smmlvPesos} placeholder="para el piso del IBC" class="input-base w-full rounded-lg px-3 py-2 text-[13px] font-mono" />
        </div>
        {RET_FIELDS.map((f) => (
          <div>
            <label for={f.key} class="block text-[11px] font-mono uppercase tracking-wider text-ink-300 mb-1">{f.label}</label>
            <input
              id={f.key}
              data-key={f.key}
              type="number"
              step={f.step}
              min="0"
              value={valueOf(f.key)}
              placeholder={f.placeholder}
              class="cc-input input-base w-full rounded-lg px-3 py-2 text-[13px] font-mono"
            />
          </div>
        ))}
      </div>

      <div class="flex items-center gap-3 mt-4">
        <button id="save-cc" class="h-9 px-4 text-[13px] font-medium rounded-full bg-cyan text-ink-950 hover:bg-cyan-glow transition-colors">
          Guardar emisor y retenciones
        </button>
        <span id="cc-status" class="text-[12px] font-mono text-lime hidden">✓ Guardado</span>
      </div>
    </div>

    <!-- Info -->
    <div class="rounded-2xl glass p-5 md:p-6">
      <h2 class="text-base font-medium text-ink-50 mb-2">Moneda base</h2>
      <p class="text-[12px] text-ink-300">Todos los totales del panel se muestran en <span class="font-mono text-cyan">{BASE_CURRENCY}</span>.</p>
    </div>
  </div>
</AdminLayout>

<script>
  document.getElementById('save-rates')?.addEventListener('click', async () => {
    const settings: Record<string, string | null> = {}
    document.querySelectorAll<HTMLInputElement>('.rate-input').forEach((el) => {
      const cur = el.dataset.cur
      if (cur) settings[`fx_${cur}_per_USD`] = el.value.trim() || null
    })
    const res = await fetch('/api/admin/settings', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ settings }),
    })
    const status = document.getElementById('rates-status')!
    if (res.ok) {
      status.classList.remove('hidden')
      setTimeout(() => status.classList.add('hidden'), 2500)
    } else {
      alert('Error al guardar las tasas.')
    }
  })

  document.getElementById('save-cc')?.addEventListener('click', async () => {
    const settings: Record<string, string | null> = {}
    document.querySelectorAll<HTMLInputElement>('.cc-input').forEach((el) => {
      const key = el.dataset.key
      if (key) settings[key] = el.value.trim() || null
    })

    // La UVT y el SMMLV se teclean en pesos y se guardan en centavos, que es la
    // unidad en la que trabaja todo el módulo. La conversión pasa aquí, una vez.
    const aCentavos = (id: string) => {
      const raw = (document.getElementById(id) as HTMLInputElement | null)?.value.trim()
      const n = raw ? Number(raw) : NaN
      return Number.isFinite(n) && n > 0 ? String(Math.round(n * 100)) : null
    }
    settings['uvt_cents'] = aCentavos('uvt_pesos')
    settings['smmlv_cents'] = aCentavos('smmlv_pesos')
    settings['emisor_declarante'] = (document.getElementById('emisor_declarante') as HTMLInputElement).checked
      ? 'true'
      : 'false'

    const res = await fetch('/api/admin/settings', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ settings }),
    })
    const status = document.getElementById('cc-status')!
    if (res.ok) {
      status.classList.remove('hidden')
      setTimeout(() => status.classList.add('hidden'), 2500)
    } else {
      alert('Error al guardar los datos del emisor.')
    }
  })
</script>
