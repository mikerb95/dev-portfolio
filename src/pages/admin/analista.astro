---
// Pantalla del analista del micro-SIEM, pensada para proyectar en una charla
// ante público que no es técnico. Mismo agente que `npm run analista`, con la
// bitácora de pasos, las cifras y el bloqueo con aprobación a la vista.
//
// No usa AdminLayout a propósito: el sidebar del panel enseñaría a la sala la
// lista de módulos privados (finanzas, bóveda, clientes). Toma los tokens del
// sitio desde global.css y nada más.
//
// Solo funciona con `npm run dev` (ver api/admin/analista/index.ts).
import '../../styles/global.css'

const disponible = import.meta.env.DEV
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Analista de seguridad · CodeByMike</title>
  </head>
  <body class="grain bg-ink-950 text-ink-50 h-screen overflow-hidden">
    {!disponible ? (
      <main class="h-full grid place-items-center px-6 text-center">
        <div class="max-w-lg">
          <p class="font-mono text-[12px] uppercase tracking-[.22em] text-ink-200">Analista del micro-SIEM</p>
          <h1 class="mt-4 font-serif text-5xl text-ink-50">Solo en local</h1>
          <p class="mt-4 text-ink-100 text-lg leading-relaxed">
            El agente corre en la máquina del administrador, no en producción. Arranca el sitio con
            <code class="font-mono text-cyan">npm run dev</code> y abre esta página ahí.
          </p>
          <a href="/admin" class="mt-8 inline-flex h-10 items-center px-5 rounded-full border border-white/10 bg-white/[.03] text-sm hover:bg-white/[.06]">Volver al panel</a>
        </div>
      </main>
    ) : (
      <div class="analista h-full grid grid-rows-[auto_minmax(0,1fr)_auto]">
        <header class="px-6 md:px-10 pt-6 pb-5 flex flex-wrap items-end justify-between gap-4 border-b border-white/5">
          <div>
            <p class="font-mono text-[12px] uppercase tracking-[.24em] text-ink-200">codebymike.net · micro-SIEM</p>
            <h1 class="mt-1 text-[34px] md:text-[42px] leading-none tracking-tight font-medium">
              Analista <span class="font-serif italic font-normal text-cyan-glow">de seguridad</span>
            </h1>
          </div>
          <div class="flex flex-wrap items-center gap-2 text-[13px]">
            <span class="chip">
              <span class="w-2 h-2 rounded-full bg-lime pulse-dot"></span>
              Datos reales del sitio
            </span>
            <span class="chip">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
              Las IPs no salen de esta máquina
            </span>
          </div>
        </header>

        <main class="min-h-0 grid grid-cols-1 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-5 px-6 md:px-10 py-6">
          <section class="panel min-h-0 flex flex-col" aria-labelledby="t-bitacora">
            <div class="flex items-center justify-between px-6 pt-5 pb-3">
              <h2 id="t-bitacora" class="etiqueta">Lo que está haciendo</h2>
              <span id="contador" class="font-mono text-[13px] text-ink-200"></span>
            </div>
            <ol id="bitacora" class="min-h-0 flex-1 overflow-y-auto px-6 pb-6 space-y-3" aria-live="polite">
              <li class="vacio text-ink-200 text-[17px] leading-relaxed pt-2">
                Aquí vas a ver, paso a paso, qué decide revisar el agente y qué encuentra. Nadie le dice el orden: lo elige él.
              </li>
            </ol>
          </section>

          <section class="panel min-h-0 flex flex-col" aria-labelledby="t-respuesta">
            <div class="flex items-center justify-between px-8 pt-5 pb-3">
              <h2 id="t-respuesta" class="etiqueta">Su análisis</h2>
              <span id="estadisticas" class="font-mono text-[13px] text-ink-200"></span>
            </div>
            <div id="respuesta" class="min-h-0 flex-1 overflow-y-auto px-8 pb-8" aria-live="polite">
              <div class="intro">
                <p class="font-serif text-[46px] leading-[1.05] text-ink-50">¿Qué está pasando en mi sitio?</p>
                <p class="mt-4 text-[19px] leading-relaxed text-ink-100 max-w-2xl">
                  Cada vez que alguien intenta atacar codebymike.net, el sitio lo anota. Este agente de IA lee ese registro, decide
                  qué investigar y explica lo que encontró.
                </p>
                <ol class="mt-8 grid gap-3 sm:grid-cols-3">
                  <li class="paso-intro"><span class="num">1</span>Lee el registro de ataques con herramientas de solo lectura.</li>
                  <li class="paso-intro"><span class="num">2</span>Elige qué revisar a fondo, como lo haría un analista.</li>
                  <li class="paso-intro"><span class="num">3</span>Puede proponer un bloqueo, pero siempre lo decide una persona.</li>
                </ol>
              </div>
            </div>
          </section>
        </main>

        <footer class="px-6 md:px-10 pb-6">
          <div id="sugerencias" class="flex flex-wrap gap-2 mb-3">
            <button type="button" class="sugerencia" data-pregunta="Revisa la última semana y dime qué merece mi atención.">¿Qué pasó esta semana?</button>
            <button type="button" class="sugerencia" data-pregunta="¿Alguien ha intentado entrar a cuentas o paneles del sitio en la última semana? Explica cómo lo hizo.">¿Intentaron entrar a mis cuentas?</button>
            <button type="button" class="sugerencia" data-pregunta="¿Cuál ha sido el origen más insistente de la última semana y qué buscaba?">¿Quién es el más insistente?</button>
            <button type="button" class="sugerencia" data-pregunta="De lo que viste, ¿hay algún origen que valga la pena bloquear? Si lo hay, propón el bloqueo.">Propón un bloqueo</button>
          </div>
          <form id="form" class="flex gap-3">
            <label for="pregunta" class="sr-only">Pregunta para el analista</label>
            <input
              id="pregunta"
              name="pregunta"
              autocomplete="off"
              maxlength="500"
              placeholder="Pregúntale algo al analista…"
              class="flex-1 min-w-0 h-14 px-6 rounded-2xl bg-white/[.03] border border-white/10 text-[18px] text-ink-50 placeholder:text-ink-300 outline-none focus:border-cyan/50 focus:bg-white/[.05] transition-colors"
            />
            <button id="enviar" type="submit" class="h-14 px-7 rounded-2xl bg-cyan text-ink-950 font-semibold text-[16px] hover:bg-cyan-glow disabled:opacity-40 disabled:cursor-not-allowed transition-colors">
              Preguntar
            </button>
            <button id="nueva" type="button" class="h-14 px-5 rounded-2xl border border-white/10 bg-white/[.03] text-ink-100 text-[15px] hover:bg-white/[.06] disabled:opacity-40 transition-colors" title="Empezar una conversación nueva">
              Nueva
            </button>
          </form>
        </footer>

        <dialog id="aprobacion" class="aprobacion" aria-labelledby="t-aprobacion">
          <div class="flex items-center gap-2 font-mono text-[12px] uppercase tracking-[.22em] text-ember">
            <span class="w-2 h-2 rounded-full bg-ember pulse-dot"></span>
            Necesita tu aprobación
          </div>
          <h2 id="t-aprobacion" class="mt-4 font-serif text-[44px] leading-[1.05]">
            Bloquear a <span id="ap-origen" class="italic text-ember"></span>
          </h2>
          <p class="mt-5 text-[13px] font-mono uppercase tracking-[.18em] text-ink-200">Su argumento</p>
          <p id="ap-motivo" class="mt-2 rounded-xl bg-white/[.03] border border-white/10 px-5 py-4 text-[19px] leading-relaxed text-ink-50"></p>
          <p class="mt-4 text-[15px] leading-relaxed text-ink-200">
            Si lo apruebas, ese origen no podrá entrar al sitio durante 1 hora. Si reincide, el castigo sube a 24 horas y
            después a 7 días. Nunca es permanente.
          </p>
          <div class="mt-7 flex justify-end gap-3">
            <button type="button" id="ap-rechazar" class="h-12 px-6 rounded-xl border border-white/10 bg-white/[.03] text-ink-50 text-[16px] hover:bg-white/[.07] transition-colors">Rechazar</button>
            <button type="button" id="ap-aprobar" class="h-12 px-6 rounded-xl bg-ember text-ink-950 font-semibold text-[16px] hover:brightness-110 transition">Aprobar bloqueo</button>
          </div>
        </dialog>
      </div>
    )}

    <style>
      .analista { font-size: 17px; }
      .chip {
        display: inline-flex; align-items: center; gap: .5rem;
        height: 2.25rem; padding: 0 .9rem; border-radius: 999px;
        background: rgb(255 255 255 / .03); border: 1px solid rgb(255 255 255 / .08);
        color: var(--color-ink-100);
      }
      .panel {
        border-radius: 1.25rem;
        background: linear-gradient(180deg, rgb(255 255 255 / .025), rgb(255 255 255 / .01));
        border: 1px solid rgb(255 255 255 / .06);
        box-shadow: var(--shadow-inset);
      }
      :global(.etiqueta) {
        font-family: var(--font-mono); font-size: 12px; letter-spacing: .22em;
        text-transform: uppercase; color: var(--color-ink-200);
      }
      .paso-intro {
        display: flex; gap: .75rem; align-items: flex-start;
        padding: 1rem 1.1rem; border-radius: 1rem;
        background: rgb(255 255 255 / .025); border: 1px solid rgb(255 255 255 / .06);
        color: var(--color-ink-100); font-size: 16px; line-height: 1.45;
      }
      .paso-intro .num {
        flex: none; display: grid; place-items: center; width: 1.75rem; height: 1.75rem;
        border-radius: 999px; background: rgb(0 242 255 / .1); color: var(--color-cyan);
        font-family: var(--font-mono); font-size: 13px;
      }
      .sugerencia {
        height: 2.5rem; padding: 0 1rem; border-radius: 999px;
        background: rgb(255 255 255 / .03); border: 1px solid rgb(255 255 255 / .08);
        color: var(--color-ink-100); font-size: 15px; transition: background .2s, border-color .2s, color .2s;
      }
      .sugerencia:hover:not(:disabled) { background: rgb(0 242 255 / .08); border-color: rgb(0 242 255 / .3); color: var(--color-ink-50); }
      .sugerencia:disabled { opacity: .4; cursor: not-allowed; }

      .aprobacion {
        margin: auto; width: min(640px, calc(100vw - 2rem));
        padding: 2.25rem 2.25rem 2rem; border-radius: 1.5rem;
        background: var(--color-ink-850); color: var(--color-ink-50);
        border: 1px solid rgb(255 107 61 / .3);
        box-shadow: 0 0 0 1px rgb(255 107 61 / .08), 0 30px 80px -20px rgb(255 107 61 / .35);
      }
      .aprobacion::backdrop { background: rgb(7 7 10 / .72); backdrop-filter: blur(6px); }

      /* Piezas que pinta el script (fuera del scope de Astro). */
      :global(.item) {
        display: grid; grid-template-columns: 1.25rem minmax(0, 1fr); gap: .85rem;
        padding: .95rem 1rem; border-radius: 1rem;
        background: rgb(255 255 255 / .02); border: 1px solid rgb(255 255 255 / .05);
      }
      :global(.item-entra) { animation: entra .45s cubic-bezier(.2, .8, .2, 1) both; }
      :global(.item .punto) { width: .6rem; height: .6rem; margin-top: .5rem; border-radius: 999px; background: var(--color-cyan); }
      :global(.item.hecho .punto) { background: var(--color-lime); }
      :global(.item.alerta .punto) { background: var(--color-ember); }
      :global(.item.nota) { background: transparent; border-color: transparent; padding-top: .35rem; padding-bottom: .35rem; }
      :global(.item.nota .punto) { background: var(--color-violet); width: .45rem; height: .45rem; margin-top: .6rem; justify-self: center; }
      :global(.item.pregunta) { background: rgb(0 242 255 / .06); border-color: rgb(0 242 255 / .18); }
      :global(.item .titulo) { font-size: 17px; color: var(--color-ink-50); line-height: 1.35; }
      :global(.item .tecnico) { margin-top: .15rem; font-family: var(--font-mono); font-size: 12px; color: var(--color-ink-300); }
      :global(.item .cifra) { margin-top: .45rem; font-size: 15px; color: var(--color-cyan-glow); }
      :global(.item.nota .titulo) { font-family: var(--font-serif); font-style: italic; font-size: 19px; color: var(--color-ink-100); }

      :global(.barra) { display: flex; height: .55rem; margin-top: .7rem; border-radius: 999px; overflow: hidden; background: rgb(255 255 255 / .05); gap: 2px; }
      :global(.barra span) { display: block; height: 100%; transform-origin: left; animation: crece .7s cubic-bezier(.2, .8, .2, 1) both; }
      :global(.leyenda) { margin-top: .6rem; display: grid; gap: .3rem; font-size: 14px; color: var(--color-ink-100); }
      :global(.leyenda div) { display: flex; align-items: center; gap: .5rem; }
      :global(.leyenda i) { flex: none; width: .55rem; height: .55rem; border-radius: 999px; }
      :global(.leyenda b) { margin-left: auto; font-weight: 500; font-family: var(--font-mono); font-size: 13px; color: var(--color-ink-200); }

      :global(.ranking) { margin-top: .7rem; display: grid; gap: .4rem; }
      :global(.ranking div) { display: grid; grid-template-columns: 5.5rem minmax(0, 1fr) 3rem; align-items: center; gap: .6rem; font-size: 13px; }
      :global(.ranking .alias) { font-family: var(--font-mono); color: var(--color-ink-100); }
      :global(.ranking .pista) { height: .45rem; border-radius: 999px; background: rgb(255 255 255 / .05); overflow: hidden; }
      :global(.ranking .pista span) { display: block; height: 100%; border-radius: 999px; background: var(--color-cyan); transform-origin: left; animation: crece .7s cubic-bezier(.2, .8, .2, 1) both; }
      :global(.ranking .pista span.bloq) { background: var(--color-ink-300); }
      :global(.ranking b) { text-align: right; font-family: var(--font-mono); font-weight: 400; color: var(--color-ink-200); }

      :global(.pensando) { display: flex; align-items: center; gap: .75rem; padding: .6rem 1rem; color: var(--color-ink-200); font-size: 16px; }
      :global(.pensando .ondas) { display: inline-flex; gap: 4px; }
      :global(.pensando .ondas span) { width: 6px; height: 6px; border-radius: 999px; background: var(--color-cyan); animation: onda 1.2s ease-in-out infinite; }
      :global(.pensando .ondas span:nth-child(2)) { animation-delay: .15s; }
      :global(.pensando .ondas span:nth-child(3)) { animation-delay: .3s; }

      :global(.esperando) { padding-top: 1rem; }
      :global(.esperando .reloj) { font-family: var(--font-mono); font-size: 64px; line-height: 1; color: var(--color-ink-50); letter-spacing: -.02em; }

      :global(.veredicto) { font-family: var(--font-serif); font-size: 42px; line-height: 1.1; color: var(--color-ink-50); }
      :global(.seccion) { margin-top: 1.9rem; display: flex; align-items: center; gap: .6rem; font-family: var(--font-mono); font-size: 13px; letter-spacing: .2em; text-transform: uppercase; color: var(--color-cyan); }
      :global(.seccion::before) { content: ''; width: .5rem; height: .5rem; border-radius: 999px; background: currentColor; }
      :global(.parrafo) { margin-top: .8rem; font-size: 19px; line-height: 1.6; color: var(--color-ink-100); max-width: 62ch; }
      :global(.lista) { margin-top: .8rem; display: grid; gap: .6rem; max-width: 62ch; }
      :global(.lista li) { position: relative; padding-left: 1.4rem; font-size: 19px; line-height: 1.55; color: var(--color-ink-100); }
      :global(.lista li::before) { content: ''; position: absolute; left: 0; top: .72em; width: .6rem; height: 2px; border-radius: 2px; background: var(--color-lime); }
      :global(.fallo) { margin-top: 1rem; padding: 1rem 1.2rem; border-radius: 1rem; background: rgb(255 107 61 / .08); border: 1px solid rgb(255 107 61 / .25); color: var(--color-ink-50); font-size: 17px; }

      @keyframes entra { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
      @keyframes crece { from { transform: scaleX(0); } to { transform: scaleX(1); } }
      @keyframes onda { 0%, 100% { opacity: .25; transform: translateY(0); } 50% { opacity: 1; transform: translateY(-4px); } }
      @media (prefers-reduced-motion: reduce) {
        :global(.item-entra), :global(.barra span), :global(.ranking .pista span), :global(.pensando .ondas span) { animation: none; }
      }
    </style>

    <script>
      type Evento =
        | { tipo: 'sesion'; id: string }
        | { tipo: 'paso'; id: string; herramienta: string; entrada: Record<string, unknown> }
        | { tipo: 'dato'; herramienta: string; datos: any }
        | { tipo: 'texto'; texto: string }
        | { tipo: 'aprobacion'; origen: string; motivo: string }
        | { tipo: 'decision'; origen: string; aprobado: boolean }
        | { tipo: 'fin'; ok: boolean; motivo: string; turnos: number; segundos: number; costoUsd: number }
        | { tipo: 'error'; mensaje: string }

      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null
      const form = $<HTMLFormElement>('form')
      if (form) iniciar(form)

      function iniciar(form: HTMLFormElement) {
        const input = $<HTMLInputElement>('pregunta')!
        const enviar = $<HTMLButtonElement>('enviar')!
        const nueva = $<HTMLButtonElement>('nueva')!
        const bitacora = $<HTMLOListElement>('bitacora')!
        const respuesta = $<HTMLDivElement>('respuesta')!
        const contador = $<HTMLSpanElement>('contador')!
        const estadisticas = $<HTMLSpanElement>('estadisticas')!
        const dialogo = $<HTMLDialogElement>('aprobacion')!
        const sugerencias = [...document.querySelectorAll<HTMLButtonElement>('.sugerencia')]

        // Nombres pensados para quien no es del oficio. Lo que no esté aquí se
        // muestra tal cual.
        const CATEGORIAS: Record<string, string> = {
          honeypot: 'Cayeron en una trampa (señuelo)',
          recon_cms: 'Buscando WordPress y paneles',
          secrets_probing: 'Buscando contraseñas y archivos secretos',
          path_traversal: 'Intentando leer archivos del servidor',
          injection: 'Intentando inyectar código',
          auth_probing: 'Intentando entrar a cuentas',
          bad_bot: 'Bots maliciosos',
          protocol_anomaly: 'Peticiones malformadas',
          blocklist: 'Rebotados por estar ya bloqueados',
          rate_limit: 'Frenados por insistir demasiado',
        }
        const COLORES = ['var(--color-cyan)', 'var(--color-lime)', 'var(--color-violet)', 'var(--color-ember)', 'var(--color-ink-300)']

        const horasDe = (e: Record<string, unknown>) => (typeof e.horas === 'number' ? e.horas : 24)
        const ventana = (h: number) => (h >= 168 ? 'de la última semana' : h >= 48 ? `de los últimos ${Math.round(h / 24)} días` : `de las últimas ${h} horas`)
        const PASOS: Record<string, (e: Record<string, unknown>) => string> = {
          resumen_actividad: (e) => `Mirando el panorama ${ventana(horasDe(e))}`,
          top_origenes: (e) => `Buscando quién insiste más ${ventana(horasDe(e))}`,
          eventos_de_origen: (e) => `Siguiendo los pasos de ${String(e.origen ?? 'un origen')}`,
          anomalias: () => 'Buscando comportamientos fuera de lo normal',
          bloqueos_vigentes: () => 'Revisando quién ya está bloqueado',
          bloquear_origen: (e) => `Bloqueando a ${String(e.origen ?? 'un origen')}`,
        }

        const num = new Intl.NumberFormat('es-CO')
        const fecha = new Intl.DateTimeFormat('es-CO', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })

        function el<K extends keyof HTMLElementTagNameMap>(tag: K, clase = '', texto?: string) {
          const n = document.createElement(tag)
          if (clase) n.className = clase
          if (texto !== undefined) n.textContent = texto
          return n
        }

        function item(tipo: string, titulo: string, tecnico?: string) {
          const li = el('li', `item item-entra ${tipo}`)
          li.append(el('span', 'punto'))
          const cuerpo = el('div')
          cuerpo.append(el('div', 'titulo', titulo))
          if (tecnico) cuerpo.append(el('div', 'tecnico', tecnico))
          li.append(cuerpo)
          bitacora.append(li)
          li.scrollIntoView({ block: 'end', behavior: 'smooth' })
          return { li, cuerpo }
        }

        // ── Estado de una pregunta ──────────────────────────────────────────
        let pasos: { herramienta: string; li: HTMLLIElement; cuerpo: HTMLDivElement; conDato: boolean }[] = []
        let ultimaNota: { li: HTMLLIElement; texto: string } | null = null
        let pensando: HTMLLIElement | null = null
        let reloj: number | undefined
        let inicio = 0
        let ocupado = false

        function mostrarPensando() {
          pensando?.remove()
          pensando = el('li', 'pensando')
          const ondas = el('span', 'ondas')
          ondas.append(el('span'), el('span'), el('span'))
          pensando.append(ondas, el('span', '', 'Pensando…'))
          bitacora.append(pensando)
        }

        function resumirDato(herramienta: string, datos: any, cuerpo: HTMLElement) {
          if (herramienta === 'resumen_actividad') {
            cuerpo.append(el('div', 'cifra', `${num.format(datos.hits ?? 0)} intentos · ${num.format(datos.origenes ?? 0)} orígenes distintos`))
            const porCategoria = new Map<string, number>()
            for (const d of datos.desglose ?? []) porCategoria.set(d.categoria, (porCategoria.get(d.categoria) ?? 0) + Number(d.hits ?? 0))
            const orden = [...porCategoria.entries()].sort((a, b) => b[1] - a[1])
            const top = orden.slice(0, 4)
            const resto = orden.slice(4).reduce((s, [, n]) => s + n, 0)
            if (resto > 0) top.push(['otros', resto])
            const total = top.reduce((s, [, n]) => s + n, 0)
            if (!total) return
            const barra = el('div', 'barra')
            const leyenda = el('div', 'leyenda')
            top.forEach(([cat, n], i) => {
              const seg = el('span')
              seg.style.width = `${(n / total) * 100}%`
              seg.style.background = COLORES[i]!
              seg.style.animationDelay = `${i * 80}ms`
              barra.append(seg)
              const fila = el('div')
              const dot = el('i')
              dot.style.background = COLORES[i]!
              fila.append(dot, el('span', '', cat === 'otros' ? 'Otros' : CATEGORIAS[cat] ?? cat), el('b', '', num.format(n)))
              leyenda.append(fila)
            })
            cuerpo.append(barra, leyenda)
          } else if (herramienta === 'top_origenes') {
            const filas = (datos as any[]).slice(0, 5)
            if (!filas.length) return void cuerpo.append(el('div', 'cifra', 'Nadie en esta ventana'))
            const max = Math.max(...filas.map((f) => Number(f.hits)))
            cuerpo.append(el('div', 'cifra', `El más activo: ${filas[0].origen}, con ${num.format(filas[0].hits)} intentos`))
            const ranking = el('div', 'ranking')
            filas.forEach((f, i) => {
              const fila = el('div')
              const pista = el('span', 'pista')
              const lleno = el('span', f.bloqueadoHasta ? 'bloq' : '')
              lleno.style.width = `${(Number(f.hits) / max) * 100}%`
              lleno.style.animationDelay = `${i * 70}ms`
              pista.append(lleno)
              fila.append(el('span', 'alias', f.origen), pista, el('b', '', num.format(f.hits)))
              ranking.append(fila)
            })
            cuerpo.append(ranking)
          } else if (herramienta === 'eventos_de_origen') {
            const ev = (datos.eventos ?? []) as any[]
            if (!ev.length) return void cuerpo.append(el('div', 'cifra', 'Sin movimientos en esta ventana'))
            const tiempos = ev.map((e) => new Date(e.at).getTime()).filter(Number.isFinite)
            const categorias = [...new Set(ev.map((e) => CATEGORIAS[e.categoria] ?? e.categoria))].slice(0, 2)
            cuerpo.append(el('div', 'cifra', `${num.format(ev.length)} movimientos, del ${fecha.format(Math.min(...tiempos))} al ${fecha.format(Math.max(...tiempos))}`))
            cuerpo.append(el('div', 'tecnico', categorias.join(' · ')))
          } else if (herramienta === 'anomalias') {
            const n = (datos as any[]).length
            cuerpo.append(el('div', 'cifra', n ? `${n} ${n === 1 ? 'alerta' : 'alertas'} del detector de anomalías` : 'Nada fuera de lo normal'))
          } else if (herramienta === 'bloqueos_vigentes') {
            const n = (datos as any[]).length
            cuerpo.append(el('div', 'cifra', n ? `${n} ${n === 1 ? 'origen bloqueado' : 'orígenes bloqueados'} ahora mismo` : 'Nadie bloqueado ahora mismo'))
          } else if (herramienta === 'bloquear_origen' && datos.hasta) {
            cuerpo.append(el('div', 'cifra', `Bloqueado hasta el ${fecha.format(new Date(datos.hasta))}`))
          }
        }

        function pintarRespuesta(texto: string) {
          respuesta.replaceChildren()
          const lineas = texto.split('\n').map((l) => l.trim())
          let lista: HTMLUListElement | null = null
          let veredicto = false
          for (const linea of lineas) {
            if (!linea) { lista = null; continue }
            if (!veredicto) {
              respuesta.append(el('p', 'veredicto item-entra', linea.replace(/^veredicto:\s*/i, '')))
              veredicto = true
              continue
            }
            if (linea.startsWith('## ')) {
              lista = null
              respuesta.append(el('h3', 'seccion item-entra', linea.slice(3)))
            } else if (/^(-|\*|•|\d+[.)])\s+/.test(linea)) {
              if (!lista) { lista = el('ul', 'lista item-entra'); respuesta.append(lista) }
              lista.append(el('li', '', linea.replace(/^(-|\*|•|\d+[.)])\s+/, '')))
            } else {
              lista = null
              respuesta.append(el('p', 'parrafo item-entra', linea))
            }
          }
          respuesta.scrollTop = 0
        }

        function mostrarEspera() {
          respuesta.replaceChildren()
          const caja = el('div', 'esperando')
          caja.append(el('p', 'etiqueta', 'Investigando'))
          const cifra = el('p', 'reloj mt-3', '0:00')
          caja.append(cifra, el('p', 'parrafo', 'El agente está leyendo el registro. Mira a la izquierda cómo decide qué revisar.'))
          respuesta.append(caja)
          inicio = Date.now()
          reloj = window.setInterval(() => {
            const s = Math.floor((Date.now() - inicio) / 1000)
            cifra.textContent = `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`
          }, 250)
        }

        function bloquear(si: boolean) {
          ocupado = si
          input.disabled = si
          enviar.disabled = si
          nueva.disabled = si
          sugerencias.forEach((b) => (b.disabled = si))
        }

        function manejar(e: Evento) {
          if (e.tipo === 'paso') {
            ultimaNota = null
            const titulo = (PASOS[e.herramienta] ?? (() => e.herramienta))(e.entrada)
            const { li, cuerpo } = item('', titulo, e.herramienta)
            pasos.push({ herramienta: e.herramienta, li, cuerpo, conDato: false })
            contador.textContent = `${pasos.length} ${pasos.length === 1 ? 'paso' : 'pasos'}`
            mostrarPensando()
          } else if (e.tipo === 'dato') {
            const paso = pasos.find((p) => p.herramienta === e.herramienta && !p.conDato)
            if (!paso) return
            paso.conDato = true
            paso.li.classList.add('hecho')
            resumirDato(e.herramienta, e.datos, paso.cuerpo)
          } else if (e.tipo === 'texto') {
            // Un texto seguido de más pasos es el agente pensando en voz alta;
            // el último, al terminar, es la respuesta (se mueve al panel).
            const { li } = item('nota', e.texto.split('\n')[0]!.slice(0, 220))
            ultimaNota = { li, texto: e.texto }
            mostrarPensando()
          } else if (e.tipo === 'aprobacion') {
            item('alerta', `Propone bloquear a ${e.origen}`, 'Esperando tu decisión')
            $('ap-origen')!.textContent = e.origen
            $('ap-motivo')!.textContent = e.motivo
            dialogo.showModal()
          } else if (e.tipo === 'decision') {
            item(e.aprobado ? 'hecho' : '', e.aprobado ? `Aprobaste el bloqueo de ${e.origen}` : `Rechazaste el bloqueo de ${e.origen}`)
          } else if (e.tipo === 'fin') {
            pensando?.remove()
            window.clearInterval(reloj)
            if (ultimaNota) {
              ultimaNota.li.remove()
              pintarRespuesta(ultimaNota.texto)
            } else if (!e.ok) {
              respuesta.replaceChildren(el('p', 'fallo', 'El agente no terminó su análisis. Intenta de nuevo con una pregunta más concreta.'))
            }
            const consultas = pasos.length
            estadisticas.textContent = `${consultas} ${consultas === 1 ? 'consulta' : 'consultas'} · ${e.segundos} s · US$${e.costoUsd.toFixed(2)}`
          } else if (e.tipo === 'error') {
            pensando?.remove()
            window.clearInterval(reloj)
            respuesta.append(el('p', 'fallo', `Algo falló: ${e.mensaje}`))
          }
        }

        async function preguntar(pregunta: string, reiniciar = false) {
          if (ocupado || !pregunta.trim()) return
          bloquear(true)
          pasos = []
          ultimaNota = null
          bitacora.replaceChildren()
          contador.textContent = ''
          estadisticas.textContent = ''
          item('pregunta', pregunta)
          mostrarPensando()
          mostrarEspera()
          input.value = ''
          try {
            const res = await fetch('/api/admin/analista', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ pregunta, nueva: reiniciar }),
            })
            if (!res.ok || !res.body) {
              const cuerpo = await res.json().catch(() => ({}))
              throw new Error(cuerpo.error ?? `HTTP ${res.status}`)
            }
            const lector = res.body.pipeThrough(new TextDecoderStream()).getReader()
            let bufer = ''
            while (true) {
              const { value, done } = await lector.read()
              if (done) break
              bufer += value
              let corte: number
              while ((corte = bufer.indexOf('\n\n')) >= 0) {
                const bloque = bufer.slice(0, corte)
                bufer = bufer.slice(corte + 2)
                for (const linea of bloque.split('\n')) {
                  if (linea.startsWith('data: ')) manejar(JSON.parse(linea.slice(6)) as Evento)
                }
              }
            }
          } catch (err) {
            manejar({ tipo: 'error', mensaje: err instanceof Error ? err.message : String(err) })
          } finally {
            pensando?.remove()
            window.clearInterval(reloj)
            if (dialogo.open) dialogo.close()
            bloquear(false)
            input.focus()
          }
        }

        async function decidir(aprobado: boolean) {
          dialogo.close()
          await fetch('/api/admin/analista/decision', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ aprobado }),
          }).catch(() => {})
        }

        // "Nueva" no llama al servidor: marca que la próxima pregunta reinicia
        // la conversación (seudónimos y memoria del agente incluidos).
        let siguienteNueva = false
        const tomarNueva = () => {
          const v = siguienteNueva
          siguienteNueva = false
          return v
        }
        form.addEventListener('submit', (ev) => {
          ev.preventDefault()
          preguntar(input.value, tomarNueva())
        })
        sugerencias.forEach((b) => b.addEventListener('click', () => preguntar(b.dataset.pregunta ?? '', tomarNueva())))
        nueva.addEventListener('click', () => {
          siguienteNueva = true
          pasos = []
          bitacora.replaceChildren(el('li', 'text-ink-200 text-[17px] pt-2', 'Conversación nueva. El agente empieza sin recordar lo anterior.'))
          contador.textContent = ''
          estadisticas.textContent = ''
          input.focus()
        })
        $('ap-aprobar')!.addEventListener('click', () => decidir(true))
        $('ap-rechazar')!.addEventListener('click', () => decidir(false))
        // Esc cierra el diálogo: se trata como rechazo, nunca como aprobación.
        dialogo.addEventListener('cancel', (ev) => {
          ev.preventDefault()
          decidir(false)
        })
      }
    </script>
  </body>
</html>
