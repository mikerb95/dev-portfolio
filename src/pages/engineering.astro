---
import BaseLayout from '../layouts/BaseLayout.astro'
import CardPopover from '../components/CardPopover.astro'
import InstrumentoVisita from '../components/engineering/InstrumentoVisita.astro'
import { db } from '../db'
import { webVitals, ciRuns, monitorChecks, monitorDaily, monitorIncidents, monitors } from '../db/schema'
import { and, desc, eq, gte, isNotNull, sql } from 'drizzle-orm'
import {
  p75,
  percentile,
  rateVital,
  ratingDistribution,
  thresholdFraction,
  formatVital,
  VITAL_META,
  THRESHOLDS,
  type VitalMetric,
  type VitalRating,
} from '../lib/vitals'
import { getDictionary, getLocaleFromUrl, interpolate, intlLocale, localizedHref } from '../i18n'
import { safeQuery } from '../lib/safe-query'
import { alturaDia, claveDia, diasDisponibilidad, enEscala, histograma, tablaCuantiles, topeEscala } from '../lib/motion/medicion'

const locale = getLocaleFromUrl(Astro.url.pathname)
const t = getDictionary(locale)
const e = t.engineering
const L = (path: string) => localizedHref(path, locale)

export const prerender = false

// Panel público de ingeniería. Reúne señales VERIFICABLES y en vivo:
// - Core Web Vitals p75 de usuarios reales (RUM, tabla web_vitals).
// - Resultado del pipeline CI real (tabla ci_runs): tests, cobertura, duración.
// - Disponibilidad agregada de la infraestructura de monitoreo.
// Nada de badges decorativos: cada número sale de datos de producción, y cada
// card explica al hover/focus de dónde sale y contra qué se compara.

const DAY_MS = 86_400_000
const now = Date.now()
const VITALS_DAYS = 30
const vitalsSince = new Date(now - VITALS_DAYS * DAY_MS)
const trendSince = new Date(now - 7 * DAY_MS)

// ── Core Web Vitals (RUM) ────────────────────────────────────────────────
const METRIC_ORDER: VitalMetric[] = ['LCP', 'INP', 'CLS', 'FCP', 'TTFB']
const vitalRows = await safeQuery(
  () =>
    db
      .select({ metric: webVitals.metric, value: webVitals.value, path: webVitals.path, createdAt: webVitals.createdAt })
      .from(webVitals)
      .where(gte(webVitals.createdAt, vitalsSince))
      .limit(20000),
  [] as Pick<typeof webVitals.$inferSelect, 'metric' | 'value' | 'path' | 'createdAt'>[],
  'engineering/web-vitals',
)

const byMetric = new Map<VitalMetric, { value: number; path: string | null; createdAt: Date | null }[]>()
for (const r of vitalRows) {
  const arr = byMetric.get(r.metric) ?? []
  arr.push(r)
  byMetric.set(r.metric, arr)
}

const vitals = METRIC_ORDER.map((m) => {
  const rows = byMetric.get(m) ?? []
  const values = rows.map((r) => r.value)
  const v = p75(values)
  const v50 = percentile(values, 0.5)
  const v95 = percentile(values, 0.95)
  const dist = ratingDistribution(m, values)

  const recentValues = rows.filter((r) => r.createdAt && r.createdAt >= trendSince).map((r) => r.value)
  const vRecent = p75(recentValues)
  const trend = v != null && vRecent != null && recentValues.length >= 5 ? vRecent - v : null

  // Peor ruta (mínimo 5 muestras para no señalar ruido).
  const byPath = new Map<string, number[]>()
  for (const r of rows) {
    if (!r.path) continue
    const arr = byPath.get(r.path) ?? []
    arr.push(r.value)
    byPath.set(r.path, arr)
  }
  let worstPath: { path: string; p75: number } | null = null
  for (const [path, vals] of byPath) {
    if (vals.length < 5) continue
    const p = p75(vals)
    if (p != null && (worstPath == null || p > worstPath.p75)) worstPath = { path, p75: p }
  }

  const [goodT, niT] = THRESHOLDS[m]
  return {
    metric: m,
    label: VITAL_META[m].label,
    p75: v,
    p50: v50,
    p95: v95,
    display: v === null ? '-' : formatVital(m, v),
    rating: (v === null ? null : rateVital(m, v)) as VitalRating | null,
    samples: values.length,
    dist,
    trend,
    trendDisplay: trend == null ? null : formatVital(m, Math.abs(trend)),
    worstPath,
    goodThreshold: goodT,
    niThreshold: niT,
    thresholdPct: v == null ? null : Math.min(100, Math.round(thresholdFraction(m, v) * 100)),
  }
})
const totalSamples = vitalRows.length

// Lo que viaja al instrumento del hero y a los medidores: por métrica, una
// tabla de 21 cuantiles (para ubicar la visita del que mira) y un histograma
// de 24 barras sobre la escala del medidor. Ninguno expone muestras sueltas.
const HISTO_BARRAS = 24
const tablasVitals: Partial<Record<VitalMetric, number[]>> = {}
const histosVitals: Partial<Record<VitalMetric, number[]>> = {}
const p75Vitals: Partial<Record<VitalMetric, number | null>> = {}
for (const m of METRIC_ORDER) {
  const values = (byMetric.get(m) ?? []).map((r) => r.value)
  tablasVitals[m] = tablaCuantiles(values)
  histosVitals[m] = histograma(values, topeEscala(m), HISTO_BARRAS)
  p75Vitals[m] = p75(values)
}

// ── Pipeline CI (datos reales de GitHub Actions) ─────────────────────────
// healthOk solo lo escribe el paso "Reportar run al panel LAB" de ci.yml
// (verify-production), y siempre lo manda como booleano si ese paso llegó a
// correr. scripts/mutation-scan.mjs postea al mismo endpoint con el mismo
// kind:'ci_run' (para reusar el mecanismo, ver comentario ahí) pero solo
// trae sha/conclusion/mutationScore/durationMs - nunca healthOk. Filtrar por
// isNotNull separa un run real del pipeline de un ping semanal de Stryker,
// que si no se cuela como "último pipeline verde" sin tests ni cobertura.
const recentRuns = await safeQuery(
  () => db.select().from(ciRuns).where(isNotNull(ciRuns.healthOk)).orderBy(desc(ciRuns.createdAt)).limit(20),
  [] as (typeof ciRuns.$inferSelect)[],
  'engineering/ci-runs',
)
const lastSuccess = recentRuns.find((r) => r.conclusion === 'success') ?? null
const greenStreak = (() => {
  let n = 0
  for (const r of recentRuns) {
    if (r.conclusion === 'failure') break
    if (r.conclusion === 'success') n++
  }
  return n
})()
const successCount = recentRuns.filter((r) => r.conclusion === 'success').length
const successRate = recentRuns.length > 0 ? Math.round((successCount / recentRuns.length) * 100) : null
const durationSeries = [...recentRuns].reverse().map((r) => ({ ms: r.durationMs, ok: r.conclusion === 'success' }))
const maxDuration = Math.max(1, ...durationSeries.map((d) => d.ms ?? 0))
const prevCoverage = recentRuns.filter((r) => r.coveragePct != null)[1]?.coveragePct ?? null
const coverageDelta =
  lastSuccess?.coveragePct != null && prevCoverage != null
    ? Math.round(lastSuccess.coveragePct - prevCoverage)
    : null

// ── Disponibilidad agregada (90 días) ────────────────────────────────────
// Del resumen diario (monitor_daily, una fila por monitor y día que escribe el
// cron de rollup), NUNCA del crudo: agregar 90 días de monitor_checks en una
// página pública escaneaba decenas de miles de filas por render, y Turso
// factura filas escaneadas (ver docs/runbook-cuota-turso.md). Así son ~90
// filas por monitor, las mismas que ya lee /status.
const UPTIME_DIAS = 90
const uptimeSince = new Date(now - UPTIME_DIAS * DAY_MS)
const monitoresActivos = await safeQuery(
  () =>
    db
      .select({ id: monitors.id, name: monitors.name })
      .from(monitors)
      .where(and(eq(monitors.active, true), eq(monitors.paused, false)))
      .orderBy(monitors.name),
  [] as { id: number; name: string }[],
  'engineering/monitores-activos',
)
const dailyRows = await safeQuery(
  () =>
    db
      .select({
        monitorId: monitorDaily.monitorId,
        dia: monitorDaily.day,
        total: monitorDaily.total,
        ok: monitorDaily.ok,
        sumMs: monitorDaily.sumMs,
      })
      .from(monitorDaily)
      .innerJoin(monitors, eq(monitors.id, monitorDaily.monitorId))
      .where(
        and(
          gte(monitorDaily.day, claveDia(now - (UPTIME_DIAS - 1) * DAY_MS)),
          eq(monitors.active, true),
          eq(monitors.paused, false),
        ),
      ),
  [] as { monitorId: number; dia: string; total: number; ok: number; sumMs: number }[],
  'engineering/monitor-daily',
)
const uptimeAgg = dailyRows.reduce((acc, r) => ({ total: acc.total + r.total, ok: acc.ok + r.ok }), { total: 0, ok: 0 })
const monCount = { n: monitoresActivos.length }
const uptime90 = uptimeAgg.total > 0 ? Math.round((uptimeAgg.ok / uptimeAgg.total) * 10000) / 100 : null

// Desglose por monitor: uptime % y latencia media en la ventana.
const monitorRows = monitoresActivos.map((m) => {
  const filas = dailyRows.filter((r) => r.monitorId === m.id)
  const total = filas.reduce((a, r) => a + r.total, 0)
  const ok = filas.reduce((a, r) => a + r.ok, 0)
  const sumMs = filas.reduce((a, r) => a + r.sumMs, 0)
  return {
    name: m.name,
    uptime: total > 0 ? Math.round((ok / total) * 10000) / 100 : null,
    avgMs: total > 0 ? Math.round(sumMs / total) : null,
  }
})

// La tira: un día por barra, con los huecos a la vista.
const tira = diasDisponibilidad(dailyRows, now, UPTIME_DIAS)

// Incidentes en la ventana: conteo y MTTR (solo los ya resueltos).
const incidentRows = await safeQuery(
  () =>
    db
      .select({ startedAt: monitorIncidents.startedAt, resolvedAt: monitorIncidents.resolvedAt })
      .from(monitorIncidents)
      .where(gte(monitorIncidents.startedAt, uptimeSince)),
  [] as { startedAt: Date; resolvedAt: Date | null }[],
  'engineering/incidentes',
)
const resolvedIncidents = incidentRows.filter((i) => i.resolvedAt != null)
const diasConIncidente = new Set(incidentRows.map((i) => claveDia(i.startedAt.getTime())))
const mttrMin =
  resolvedIncidents.length > 0
    ? Math.round(
        resolvedIncidents.reduce((acc, i) => acc + (i.resolvedAt!.getTime() - i.startedAt.getTime()), 0) /
          resolvedIncidents.length /
          60000,
      )
    : null

// Presupuesto de error traducido a tiempo: 90 días completos menos el % de uptime.
const downtimeMin =
  uptime90 != null ? Math.round(UPTIME_DIAS * 24 * 60 * (1 - uptime90 / 100)) : null
const fmtDowntime = (min: number | null) => {
  if (min == null) return '-'
  if (min < 60) return `${min} min`
  const h = Math.floor(min / 60)
  const m = min % 60
  return m > 0 ? `${h} h ${m} min` : `${h} h`
}
// Cadencia real de sondeo: se calcula sobre las últimas 24h (no sobre los 90 días
// completos) porque no todos los monitores llevan la ventana entera activos, lo que
// sesgaría el promedio hacia abajo.
const cadenceSince = new Date(now - 24 * 60 * 60 * 1000)
const [cadenceAgg] = await safeQuery(
  () =>
    db
      .select({ total: sql<number>`count(*)` })
      .from(monitorChecks)
      .where(gte(monitorChecks.at, cadenceSince)),
  [] as { total: number }[],
  'engineering/cadencia',
)
const checkCadenceMin =
  monCount?.n && cadenceAgg?.total ? Math.round((24 * 60) / (cadenceAgg.total / monCount.n)) : null

const fmtDuration = (ms: number | null) => {
  if (ms == null) return '-'
  if (ms < 1000) return `${ms} ms`
  const s = ms / 1000
  return s < 60 ? `${s.toFixed(1)} s` : `${Math.floor(s / 60)}m ${Math.round(s % 60)}s`
}
const fmtDate = new Intl.DateTimeFormat(intlLocale(locale), {
  day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', timeZone: 'America/Bogota',
})

const ratingCls: Record<VitalRating, string> = {
  good: 'text-lime border-lime/30 bg-lime/10',
  'needs-improvement': 'text-ember border-ember/30 bg-ember/10',
  poor: 'text-ember border-ember/40 bg-ember/15',
}
const ratingLabel: Record<VitalRating, string> = {
  good: e.vitals.good,
  'needs-improvement': e.vitals.needsImprovement,
  poor: e.vitals.poor,
}

const VITAL_EXPLAIN: Record<VitalMetric, string> = e.vitals.explain

// ── Lo que pintan las secciones con motion ───────────────────────────────
// Todo el estado FINAL sale del servidor (alturas, posición de la aguja,
// colores): el script solo anima desde cero hasta aquí, así que sin JS o con
// movimiento reducido la página ya está completa.
const medidores = vitals.map((v) => {
  const tope = topeEscala(v.metric)
  const barras = histosVitals[v.metric] ?? []
  return {
    ...v,
    tope,
    topeDisplay: formatVital(v.metric, tope),
    barras: barras.map((h, i) => {
      const centro = ((i + 0.5) / barras.length) * tope
      return { h, rating: rateVital(v.metric, centro) }
    }),
    aguja: v.p75 == null ? null : enEscala(v.p75, tope) * 100,
    corteBueno: (v.goodThreshold / tope) * 100,
    corteMejorable: (v.niThreshold / tope) * 100,
  }
})
const barraCls: Record<VitalRating, string> = {
  good: 'bg-lime/55',
  'needs-improvement': 'bg-ember/45',
  poor: 'bg-ember/75',
}

const conclusionCls: Record<string, string> = {
  success: 'bg-lime/70',
  failure: 'bg-ember/85',
  rolled_back: 'bg-violet/80',
}
const conclusionTxt = e.pipeline.conclusiones as Record<string, string>
const runsTira = [...recentRuns].reverse().map((r) => ({
  h: r.durationMs != null ? Math.max(0.06, r.durationMs / maxDuration) : 0.06,
  cls: conclusionCls[r.conclusion] ?? 'bg-ink-300',
  titulo: [
    r.sha.slice(0, 7),
    r.createdAt ? fmtDate.format(r.createdAt) : null,
    fmtDuration(r.durationMs),
    conclusionTxt[r.conclusion] ?? r.conclusion,
  ]
    .filter(Boolean)
    .join(' · '),
}))

const fmtDia = new Intl.DateTimeFormat(intlLocale(locale), { day: 'numeric', month: 'short', timeZone: 'UTC' })
const pctFmt = new Intl.NumberFormat(intlLocale(locale), { maximumFractionDigits: 2 })
const tiraDias = tira.map((d) => {
  const dia = fmtDia.format(new Date(`${d.dia}T12:00:00Z`))
  return {
    ...d,
    alto: alturaDia(d.pct),
    incidente: diasConIncidente.has(d.dia),
    lectura:
      d.pct == null
        ? interpolate(e.uptime.tiraHueco, { day: dia })
        : interpolate(e.uptime.tiraLectura, {
            day: dia,
            pct: `${pctFmt.format(d.pct)}%`,
            n: d.total.toLocaleString(intlLocale(locale)),
          }),
    color: d.pct == null ? '' : d.pct >= 99.5 ? 'bg-lime/75' : d.pct >= 98 ? 'bg-ember/60' : 'bg-ember',
  }
})
const ultimoConDatos = [...tiraDias].reverse().find((d) => d.pct != null)
const statusMini = tiraDias.slice(-30)
---

<BaseLayout title={e.title} description={e.description} image="/og-engineering.png">
  <!-- overflow-x: clip y no hidden: recorta lo que asome por los lados (los
       paneles de detalle cerrados siguen ocupando caja) sin crear un
       contenedor de scroll, que rompería el scroll suave y lo fijado. -->
  <div class="overflow-x-clip">
  <div class="max-w-[1280px] mx-auto px-6 md:px-12 lg:px-20 pt-32 pb-24">
    <a href={L('/')} class="inline-flex items-center gap-2 text-[11px] font-mono uppercase tracking-[.2em] text-ink-300 hover:text-cyan transition-colors mb-12">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
      {t.common.back}
    </a>

    <header class="mb-24 grid lg:grid-cols-[minmax(0,1fr)_minmax(0,540px)] gap-12 lg:gap-16 items-center">
      <div>
        <div data-hero-sigue class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-6">
          <span class="text-cyan">/engineering</span>
          <span class="h-px flex-1 bg-gradient-to-r from-white/15 to-transparent max-w-[80px]"></span>
          <span>{e.eyebrow}</span>
        </div>
        <h1 class="text-5xl md:text-6xl xl:text-7xl font-medium tracking-[-.035em] leading-[.98] mb-8 [&>span]:[text-wrap:balance]">
          <span data-hero-linea class="block text-ink-50">{e.h1Line1}</span>{' '}
          <span data-hero-linea class="block text-cyan">{e.h1Line2}</span>
        </h1>
        <p data-hero-sigue class="text-[16px] text-ink-100 max-w-xl leading-relaxed">
          {e.introA}<em>{e.introEmphasis}</em>{e.introB}
          <span class="text-ink-300"> {e.introHint}</span>
        </p>
      </div>
      <InstrumentoVisita tablas={tablasVitals} histos={histosVitals} p75s={p75Vitals} muestras={totalSamples} dias={VITALS_DAYS} />
    </header>

    <!-- ── /01 Core Web Vitals (RUM) ── -->
    <section class="mb-28" aria-labelledby="sec-vitals">
      <div data-etiqueta class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-6">
        <span class="text-cyan">/01</span>
        <span class="h-px flex-1 bg-gradient-to-r from-white/15 to-transparent max-w-[80px]"></span>
        <span>{e.secciones.vitals.label}</span>
      </div>
      <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4 mb-10">
        <h2 id="sec-vitals" data-titular class="text-3xl md:text-5xl font-medium tracking-[-.025em] text-ink-50 leading-[1.05] max-w-2xl">
          {e.secciones.vitals.titulo}
        </h2>
        <div class="max-w-md">
          <p class="text-[14px] text-ink-300 leading-relaxed">{e.secciones.vitals.sub}</p>
          <p class="text-[11px] font-mono text-ink-400 mt-2">
            {interpolate(e.vitals.meta, { days: VITALS_DAYS, samples: totalSamples.toLocaleString(intlLocale(locale)) })}
          </p>
        </div>
      </div>

      {totalSamples === 0 ? (
        <div class="rounded-2xl glass p-8 text-center">
          <p class="text-[13px] text-ink-300">{e.vitals.empty}</p>
        </div>
      ) : (
        <div class="grid grid-cols-2 lg:grid-cols-5 gap-3" data-foco data-entrada data-medidores>
          {medidores.map((v, i) => (
            <CardPopover id={`vital-${v.metric}`} class={i === 0 ? 'col-span-2 lg:col-span-1' : ''}>
              <div class="medidor foco rounded-2xl glass p-4 cursor-default" data-medidor={v.metric} data-tope={v.tope}>
                <div class="flex items-center justify-between mb-3">
                  <span class="text-[12px] font-mono font-semibold text-ink-50">{v.metric}</span>
                  {v.rating && (
                    <span class={`px-1.5 py-0.5 rounded-full text-[9px] font-mono uppercase tracking-wider border ${ratingCls[v.rating]}`}>
                      {ratingLabel[v.rating]}
                    </span>
                  )}
                </div>
                <div class="text-2xl font-medium tracking-tight text-ink-50 tabular-nums" data-odometro>{v.display}</div>
                <div class="text-[10px] text-ink-400 mt-1 leading-tight">{v.label}</div>

                <div class="medidor-escala" aria-hidden="true">
                  <div class="medidor-barras">
                    {v.barras.map((b) => (
                      <span class={barraCls[b.rating]} style={`height:${Math.max(b.h > 0 ? 6 : 0, b.h * 100)}%`}></span>
                    ))}
                  </div>
                  <div class="medidor-zonas">
                    <span class="bg-lime/70" style={`width:${v.corteBueno}%`}></span>
                    <span class="bg-ember/50" style={`width:${v.corteMejorable - v.corteBueno}%`}></span>
                    <span class="bg-ember/85 flex-1"></span>
                  </div>
                  {v.aguja != null && (
                    <span class="medidor-aguja" style={`left:${v.aguja}%`} data-aguja><span>p75</span></span>
                  )}
                  <span class="medidor-tu" data-tu><span>{e.instrumento.tu}</span></span>
                </div>
                <div class="flex justify-between text-[9.5px] font-mono text-ink-400 mt-1.5">
                  <span>0</span>
                  <span>{v.topeDisplay}</span>
                </div>
              </div>
              <Fragment slot="panel">
                <div class="flex items-center justify-between mb-2">
                  <span class="font-mono text-[12px] uppercase tracking-wider text-ink-50">{v.metric}</span>
                  <span class="font-mono text-[11px] text-ink-400">{v.samples.toLocaleString(intlLocale(locale))} {e.vitals.samplesWord}</span>
                </div>
                <p class="text-ink-200 mb-3">{v.label} - {VITAL_EXPLAIN[v.metric]}</p>

                {v.p75 != null && (
                  <>
                    <div class="flex justify-between text-[11px] font-mono text-ink-400 mb-3">
                      <span>{interpolate(e.vitals.goodThreshold, { value: formatVital(v.metric, v.goodThreshold) })}</span>
                      <span>{interpolate(e.vitals.poorThreshold, { value: formatVital(v.metric, v.niThreshold) })}</span>
                    </div>

                    <div class="grid grid-cols-3 gap-2 mb-3 text-center">
                      <div>
                        <div class="font-mono tabular-nums text-ink-50">{formatVital(v.metric, v.p50 ?? 0)}</div>
                        <div class="text-[10px] font-mono uppercase text-ink-400">p50</div>
                      </div>
                      <div>
                        <div class="font-mono tabular-nums text-cyan">{v.display}</div>
                        <div class="text-[10px] font-mono uppercase text-ink-400">p75</div>
                      </div>
                      <div>
                        <div class="font-mono tabular-nums text-ink-50">{formatVital(v.metric, v.p95 ?? 0)}</div>
                        <div class="text-[10px] font-mono uppercase text-ink-400">p95</div>
                      </div>
                    </div>

                    <div class="text-[11px] text-ink-400 mb-3">
                      {v.dist.good}% {e.vitals.good.toLowerCase()} · {v.dist.needsImprovement}% {e.vitals.needsImprovement.toLowerCase()} · {v.dist.poor}% {e.vitals.poor.toLowerCase()}
                    </div>

                    {v.trend != null && v.trendDisplay && (
                      <div class="text-[12px] text-ink-300 mb-2">
                        {e.vitals.trendLabel} {v.trend < 0 ? '▼' : v.trend > 0 ? '▲' : '='} {v.trendDisplay} {e.vitals.trendVs}
                        <span class={v.trend < 0 ? 'text-lime' : v.trend > 0 ? 'text-ember' : 'text-ink-400'}>
                          {' '}({v.trend < 0 ? e.vitals.trendImproves : v.trend > 0 ? e.vitals.trendWorsens : e.vitals.trendStable})
                        </span>
                      </div>
                    )}

                    {v.worstPath && (
                      <div class="text-[12px] text-ink-300">
                        {interpolate(e.vitals.worstPath, {
                          path: v.worstPath.path,
                          value: formatVital(v.metric, v.worstPath.p75),
                        })}
                      </div>
                    )}
                  </>
                )}
                <div class="text-[11px] text-ink-500 mt-3 pt-2 border-t border-white/5">
                  {e.vitals.measuredWith}
                </div>
                <div class="live-strip flex items-center gap-1.5 text-[11px] font-mono text-ink-400 mt-2" data-live="vitals">
                  <span class="live-dot"></span>
                  <span class="live-text">{e.pipeline.liveChecking}</span>
                </div>
              </Fragment>
            </CardPopover>
          ))}
        </div>
      )}
    </section>

    <!-- ── /02 Pipeline CI/CD ── -->
    <section class="mb-28" aria-labelledby="sec-pipeline">
      <div data-etiqueta class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-6">
        <span class="text-cyan">/02</span>
        <span class="h-px flex-1 bg-gradient-to-r from-white/15 to-transparent max-w-[80px]"></span>
        <span>{e.secciones.pipeline.label}</span>
      </div>
      <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4 mb-10">
        <h2 id="sec-pipeline" data-titular class="text-3xl md:text-5xl font-medium tracking-[-.025em] text-ink-50 leading-[1.05] max-w-2xl">
          {e.secciones.pipeline.titulo}
        </h2>
        <p class="text-[14px] text-ink-300 leading-relaxed max-w-md">{e.secciones.pipeline.sub}</p>
      </div>

      <CardPopover id="ci-pipeline">
        <div class="rounded-2xl glass p-6 md:p-8 cursor-default" data-pipeline>
          {lastSuccess ? (
            <div class="grid lg:grid-cols-[minmax(0,1.55fr)_minmax(0,1fr)] gap-10 lg:gap-14">
              <div>
                <h3 class="text-[12px] font-mono uppercase tracking-[.2em] text-ink-200 mb-8">{e.pipeline.heading}</h3>
                <div class="pipe" data-pipe>
                  <span class="pipe-riel" aria-hidden="true"></span>
                  <span class="pipe-avance" aria-hidden="true" data-pipe-avance></span>
                  <span class="pipe-paquete" aria-hidden="true" data-pipe-paquete></span>
                  <ol class="pipe-etapas">
                    <li class="pipe-etapa" data-etapa>
                      <span class="pipe-nodo" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span>
                      <span class="pipe-nombre">{e.pipeline.etapas.commit}</span>
                      <span class="pipe-detalle">{lastSuccess.sha.slice(0, 7)}</span>
                    </li>
                    <li class="pipe-etapa" data-etapa>
                      <span class="pipe-nodo" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span>
                      <span class="pipe-nombre">{e.pipeline.etapas.tests}</span>
                      <span class="pipe-detalle">
                        {interpolate(e.pipeline.testsDetalle, {
                          n: lastSuccess.testsPassed ?? '-',
                          cov: lastSuccess.coveragePct != null ? `${Math.round(lastSuccess.coveragePct)}%` : '-',
                        })}
                      </span>
                    </li>
                    <li class="pipe-etapa" data-etapa>
                      <span class="pipe-nodo" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span>
                      <span class="pipe-nombre">{e.pipeline.etapas.deploy}</span>
                      <span class="pipe-detalle">Vercel</span>
                    </li>
                    <li class={`pipe-etapa ${lastSuccess.healthOk === false ? 'pipe-falla' : ''}`} data-etapa>
                      <span class="pipe-nodo" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span>
                      <span class="pipe-nombre">{e.pipeline.etapas.health}</span>
                      <span class="pipe-detalle">{lastSuccess.healthOk ? e.pipeline.healthOk : e.pipeline.healthFail}</span>
                    </li>
                  </ol>
                  <span class="pipe-rollback" data-pipe-rollback>
                    <span class="pipe-rollback-punto" aria-hidden="true"></span>
                    {e.pipeline.etapas.rollback}
                  </span>
                </div>

                <div class="mt-10 flex flex-wrap items-baseline gap-x-4 gap-y-1">
                  <span class="text-4xl md:text-5xl font-medium tracking-tight text-ink-50 tabular-nums" data-odometro>{fmtDuration(lastSuccess.durationMs)}</span>
                  <span class="text-[12px] font-mono text-ink-400">{e.pipeline.totalLabel}</span>
                </div>
                <div class="mt-3 text-[11px] font-mono text-ink-400">
                  {greenStreak > 1 ? interpolate(e.pipeline.streak, { n: greenStreak }) : e.pipeline.lastRun}
                  {lastSuccess.createdAt && <> · {fmtDate.format(lastSuccess.createdAt)}</>}
                </div>
              </div>

              <div class="lg:border-l lg:border-white/5 lg:pl-12 flex flex-col">
                <div class="grid grid-cols-3 gap-4">
                  <div>
                    <div class="text-3xl font-medium text-lime tabular-nums" data-odometro>{lastSuccess.testsPassed ?? '-'}</div>
                    <div class="text-[10px] font-mono uppercase tracking-wider text-ink-400 mt-1">{e.pipeline.testsLabel}</div>
                  </div>
                  <div>
                    <div class="text-3xl font-medium text-ink-50 tabular-nums" data-odometro>{lastSuccess.coveragePct != null ? `${Math.round(lastSuccess.coveragePct)}%` : '-'}</div>
                    <div class="text-[10px] font-mono uppercase tracking-wider text-ink-400 mt-1">{e.pipeline.coverageLabel}</div>
                  </div>
                  <div>
                    <div class="text-3xl font-medium text-ink-50 tabular-nums" data-odometro>{successRate != null ? `${successRate}%` : '-'}</div>
                    <div class="text-[10px] font-mono uppercase tracking-wider text-ink-400 mt-1">{e.pipeline.exitoLabel}</div>
                  </div>
                </div>

                {runsTira.length > 1 && (
                  <div class="mt-auto pt-10">
                    <div class="text-[10px] font-mono uppercase tracking-wider text-ink-400 mb-3">
                      {interpolate(e.pipeline.runsStrip, { n: runsTira.length })}
                    </div>
                    <div class="runs" data-runs>
                      {runsTira.map((r) => (
                        <span class={r.cls} style={`height:${r.h * 100}%`} title={r.titulo}></span>
                      ))}
                    </div>
                    <div class="flex flex-wrap gap-x-4 gap-y-1 mt-3 text-[10.5px] font-mono text-ink-400">
                      <span class="inline-flex items-center gap-1.5"><i class="w-2 h-2 rounded-sm bg-lime/70"></i>{conclusionTxt.success}</span>
                      <span class="inline-flex items-center gap-1.5"><i class="w-2 h-2 rounded-sm bg-ember/85"></i>{conclusionTxt.failure}</span>
                      <span class="inline-flex items-center gap-1.5"><i class="w-2 h-2 rounded-sm bg-violet/80"></i>{conclusionTxt.rolled_back}</span>
                    </div>
                  </div>
                )}
              </div>
            </div>
          ) : (
            <p class="text-[13px] text-ink-300 py-4">{e.pipeline.empty}</p>
          )}
        </div>
        <Fragment slot="panel">
          <div class="flex items-center justify-between mb-2">
            <span class="font-mono text-[12px] uppercase tracking-wider text-ink-50">{e.pipeline.panelTitle}</span>
            {successRate != null && <span class="font-mono text-[11px] text-ink-400">{interpolate(e.pipeline.successRate, { pct: successRate, n: recentRuns.length })}</span>}
          </div>
          <p class="text-ink-200 mb-3">{e.pipeline.desc}</p>
          {coverageDelta != null && (
            <div class="text-[12px] text-ink-300 mb-2">
              {interpolate(e.pipeline.coverageDelta, { value: `${coverageDelta > 0 ? '+' : ''}${coverageDelta}` })}
            </div>
          )}
          {lastSuccess?.healthOk != null && (
            <div class="text-[12px] text-ink-300 mb-2">
              {e.pipeline.healthCheckLabel} <span class={lastSuccess.healthOk ? 'text-lime' : 'text-ember'}>{lastSuccess.healthOk ? e.pipeline.healthOk : e.pipeline.healthFail}</span>
            </div>
          )}
          {lastSuccess?.sha && (
            <div class="text-[12px] font-mono text-ink-300 mb-1">
              {e.pipeline.commitLabel} <span class="text-ink-100">{lastSuccess.sha.slice(0, 7)}</span>
            </div>
          )}
          {lastSuccess?.url && (
            <a href={lastSuccess.url} target="_blank" rel="noopener" class="text-[12px] font-mono text-cyan hover:underline">
              {e.pipeline.viewRunCta}
            </a>
          )}
          <div class="live-strip flex items-center gap-1.5 text-[11px] font-mono text-ink-400 mt-3 pt-2 border-t border-white/5" data-live="ci">
            <span class="live-dot"></span>
            <span class="live-text">{e.pipeline.liveChecking}</span>
          </div>
        </Fragment>
      </CardPopover>
    </section>

    <!-- ── /03 Disponibilidad ── -->
    <section class="mb-28" aria-labelledby="sec-uptime">
      <div data-etiqueta class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-6">
        <span class="text-cyan">/03</span>
        <span class="h-px flex-1 bg-gradient-to-r from-white/15 to-transparent max-w-[80px]"></span>
        <span>{e.secciones.uptime.label}</span>
      </div>
      <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4 mb-10">
        <h2 id="sec-uptime" data-titular class="text-3xl md:text-5xl font-medium tracking-[-.025em] text-ink-50 leading-[1.05] max-w-2xl">
          {e.secciones.uptime.titulo}
        </h2>
        <p class="text-[14px] text-ink-300 leading-relaxed max-w-md">{e.secciones.uptime.sub}</p>
      </div>

      <CardPopover id="uptime">
        <div class="rounded-2xl glass p-6 md:p-8 cursor-default grid lg:grid-cols-[minmax(0,260px)_minmax(0,1fr)] gap-10 lg:gap-14" data-disponibilidad>
          <div>
            <h3 class="text-[12px] font-mono uppercase tracking-[.2em] text-ink-200 mb-5">{e.uptime.heading}</h3>
            <div class="text-5xl font-medium tabular-nums text-lime tracking-tight" data-odometro>{uptime90 != null ? `${uptime90}%` : '-'}</div>
            <div class="text-[11px] font-mono text-ink-400 mt-3">
              {interpolate(e.uptime.meta, {
                services: monCount.n,
                checks: uptimeAgg.total.toLocaleString(intlLocale(locale)),
              })}
            </div>
            {downtimeMin != null && (
              <div class="text-[12px] text-ink-300 mt-2">{interpolate(e.uptime.presupuesto, { time: fmtDowntime(downtimeMin) })}</div>
            )}
            <a href={L('/status')} class="inline-block text-[11px] font-mono text-cyan hover:underline mt-5">{e.uptime.viewStatusCta}</a>
          </div>

          <div class="min-w-0">
            <div class="tira-lectura" data-tira-lectura aria-hidden="true">{ultimoConDatos?.lectura ?? ''}</div>
            <div class="tira" data-tira role="img" aria-label={`${e.uptime.heading}: ${uptime90 != null ? `${uptime90}%` : '-'}`}>
              <span class="tira-barrido" aria-hidden="true" data-tira-barrido></span>
              {tiraDias.map((d) => (
                <span
                  class={`tira-dia ${d.pct == null ? 'hueco' : ''} ${d.incidente ? 'con-incidente' : ''}`}
                  data-lectura={d.lectura}
                >
                  <span class={`tira-barra ${d.color}`} style={`height:${d.pct == null ? 100 : Math.max(4, d.alto * 100)}%`}></span>
                </span>
              ))}
            </div>
            <div class="flex justify-between text-[10px] font-mono text-ink-400 mt-2">
              <span>{e.uptime.tiraDesde}</span>
              <span class="inline-flex items-center gap-3">
                <span class="inline-flex items-center gap-1.5"><i class="tira-leyenda-hueco"></i>{interpolate(e.uptime.tiraHueco, { day: '' }).replace(/^\s*·\s*/, '')}</span>
                {diasConIncidente.size > 0 && (
                  <span class="inline-flex items-center gap-1.5"><i class="w-1.5 h-1.5 rounded-full bg-ember"></i>{e.uptime.incidentWord}</span>
                )}
                <span>{e.uptime.tiraHoy}</span>
              </span>
            </div>
          </div>
        </div>
        <Fragment slot="panel">
          <div class="flex items-center justify-between mb-2">
            <span class="font-mono text-[12px] uppercase tracking-wider text-ink-50">{e.uptime.panelTitle}</span>
            {checkCadenceMin != null && <span class="font-mono text-[11px] text-ink-400">{interpolate(e.uptime.cadence, { n: checkCadenceMin })}</span>}
          </div>
          <p class="text-ink-200 mb-2">
            {interpolate(e.uptime.explain, { pct: uptime90 != null ? `${uptime90}%` : '-', time: fmtDowntime(downtimeMin) })}
          </p>
          {(incidentRows.length > 0 || mttrMin != null) && (
            <div class="text-[12px] text-ink-300 mb-3">
              {incidentRows.length} {incidentRows.length === 1 ? e.uptime.incidentWord : e.uptime.incidentWordPlural} {incidentRows.length === 1 ? e.uptime.registeredWord : e.uptime.registeredWordPlural}
              {mttrMin != null && ` · ${interpolate(e.uptime.mttr, { n: mttrMin })}`}
            </div>
          )}
          {monitorRows.length > 0 && (
            <div class="space-y-1.5">
              {monitorRows.map((m) => (
                <div class="flex items-center gap-2 text-[12px]">
                  <span class="font-mono text-ink-100 truncate flex-1">{m.name}</span>
                  <div class="w-16 h-1 rounded-full bg-white/5 overflow-hidden shrink-0">
                    <div class="h-full bg-lime/70" style={`width:${m.uptime ?? 0}%`}></div>
                  </div>
                  <span class="font-mono tabular-nums text-ink-400 w-12 text-right shrink-0">{m.uptime != null ? `${m.uptime}%` : '-'}</span>
                  <span class="font-mono tabular-nums text-ink-500 w-14 text-right shrink-0">{m.avgMs != null ? `${m.avgMs}ms` : '-'}</span>
                </div>
              ))}
            </div>
          )}
          <div class="live-strip flex items-center gap-1.5 text-[11px] font-mono text-ink-400 mt-3 pt-2 border-t border-white/5" data-live="uptime">
            <span class="live-dot"></span>
            <span class="live-text">{e.pipeline.liveChecking}</span>
          </div>
        </Fragment>
      </CardPopover>
    </section>

    <!-- ── /04 Compruébalo tú mismo ── -->
    <section aria-labelledby="sec-verify">
      <div data-etiqueta class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-6">
        <span class="text-cyan">/04</span>
        <span class="h-px flex-1 bg-gradient-to-r from-white/15 to-transparent max-w-[80px]"></span>
        <span>{e.secciones.verify.label}</span>
      </div>
      <h2 id="sec-verify" data-titular class="text-3xl md:text-5xl font-medium tracking-[-.025em] text-ink-50 leading-[1.05] mb-10">
        {e.verifiable.heading}
      </h2>
      <div class="grid sm:grid-cols-3 gap-3" data-foco data-entrada>
        <a href={L('/security')} class="fuente foco rounded-2xl glass p-5 group">
          <div class="fuente-vista" aria-hidden="true">
            <svg viewBox="0 0 120 64" class="fuente-escudo">
              <path d="M60 6 L86 15 V32 C86 45 75 54 60 59 C45 54 34 45 34 32 V15 Z" />
              <path d="M49 32 l7.5 7.5 L72 24" class="fuente-escudo-ok" />
            </svg>
            <span class="fuente-escaneo"></span>
          </div>
          <div class="text-[13px] text-ink-50 mb-1 group-hover:text-cyan transition-colors">{e.verifiable.security.title}</div>
          <div class="text-[11px] text-ink-400 leading-relaxed">{e.verifiable.security.body}</div>
        </a>
        <a href={L('/status')} class="fuente foco rounded-2xl glass p-5 group">
          <div class="fuente-vista fuente-status" aria-hidden="true">
            {statusMini.map((d, i) => (
              <span class={d.pct == null ? 'hueco' : d.color} style={`height:${d.pct == null ? 100 : Math.max(8, d.alto * 100)}%;--i:${i};transform-origin:50% 100%`}></span>
            ))}
          </div>
          <div class="text-[13px] text-ink-50 mb-1 group-hover:text-cyan transition-colors">{e.verifiable.status.title}</div>
          <div class="text-[11px] text-ink-400 leading-relaxed">{e.verifiable.status.body}</div>
        </a>
        <a href={L('/tools')} class="fuente foco rounded-2xl glass p-5 group">
          <div class="fuente-vista fuente-terminal" aria-hidden="true">
            <span><b>$</b> npm test</span>
            {lastSuccess?.testsPassed != null ? (
              <span class="text-lime">✓ {lastSuccess.testsPassed} tests</span>
            ) : (
              <span class="text-ink-400">…</span>
            )}
            <span><b>$</b> <i class="fuente-cursor"></i></span>
          </div>
          <div class="text-[13px] text-ink-50 mb-1 group-hover:text-cyan transition-colors">{e.verifiable.tools.title}</div>
          <div class="text-[11px] text-ink-400 leading-relaxed">{e.verifiable.tools.body}</div>
        </a>
      </div>
      <p class="text-[11px] text-ink-500 mt-6 leading-relaxed max-w-2xl">
        {e.verifiable.footnote}
      </p>
    </section>
  </div>
  </div>
</BaseLayout>

<style>
  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: var(--color-lime);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-lime) 60%, transparent);
    animation: live-pulse 2s ease-out infinite;
    flex-shrink: 0;
  }
  .live-strip.is-error .live-dot {
    background: var(--color-ember);
    animation: none;
  }
  @keyframes live-pulse {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-lime) 55%, transparent);
    }
    70% {
      box-shadow: 0 0 0 5px transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .live-dot {
      animation: none;
    }
  }

  /* ── Medidores de Web Vitals ── */
  .medidor-escala {
    position: relative;
    height: 58px;
    margin-top: 18px;
  }
  .medidor-barras {
    position: absolute;
    inset: 12px 0 6px;
    display: flex;
    align-items: flex-end;
    gap: 2px;
  }
  .medidor-barras span {
    flex: 1;
    border-radius: 1.5px 1.5px 0 0;
  }
  .medidor-zonas {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    display: flex;
    gap: 2px;
    border-radius: 2px;
    overflow: hidden;
  }
  .medidor-aguja {
    position: absolute;
    top: 0;
    bottom: -3px;
    width: 1.5px;
    margin-left: -0.75px;
    background: #e7fdff;
    box-shadow: 0 0 8px #00f2ff;
  }
  .medidor-aguja span {
    position: absolute;
    top: -5px;
    left: 5px;
    font-family: var(--font-mono);
    font-size: 8.5px;
    color: #9bfaff;
  }
  .medidor-tu {
    position: absolute;
    bottom: -3px;
    left: 0;
    width: 9px;
    height: 9px;
    margin-left: -4.5px;
    border-radius: 9999px;
    background: #00f2ff;
    box-shadow:
      0 0 0 3px rgba(0, 242, 255, 0.2),
      0 0 12px #00f2ff;
    opacity: 0;
  }
  .medidor-tu span {
    position: absolute;
    bottom: 12px;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 8.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #9bfaff;
    text-shadow: 0 0 4px #0a0a0d, 0 0 2px #0a0a0d;
  }

  /* ── Pipeline: riel de nodo a nodo ── */
  .pipe {
    position: relative;
  }
  .pipe-riel,
  .pipe-avance {
    position: absolute;
    top: 14px;
    left: 14px;
    right: calc((100% - 36px) / 4 - 14px);
    height: 1px;
    pointer-events: none;
  }
  .pipe-riel {
    background: rgba(255, 255, 255, 0.12);
  }
  .pipe-avance {
    height: 2px;
    margin-top: -0.5px;
    background: linear-gradient(90deg, #00f2ff, #c9ff5b);
    box-shadow: 0 0 10px rgba(0, 242, 255, 0.45);
  }
  .pipe.vertical .pipe-riel {
    width: 1px;
  }
  .pipe.vertical .pipe-avance {
    width: 2px;
    margin: 0 0 0 -0.5px;
    background: linear-gradient(180deg, #00f2ff, #c9ff5b);
  }
  .pipe-paquete {
    position: absolute;
    left: 0;
    top: 0;
    width: 12px;
    height: 12px;
    margin: -6px 0 0 -6px;
    border-radius: 9999px;
    background: #fff;
    box-shadow:
      0 0 0 4px rgba(0, 242, 255, 0.25),
      0 0 18px 4px #00f2ff;
    opacity: 0;
    z-index: 2;
    pointer-events: none;
  }
  .pipe-etapas {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }
  .pipe-etapa {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .pipe-nodo {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    margin-bottom: 10px;
    border-radius: 9999px;
    background: #0e0e12;
    border: 1.5px solid rgba(201, 255, 91, 0.65);
    color: #c9ff5b;
    transition:
      border-color 0.3s ease,
      color 0.3s ease,
      box-shadow 0.3s ease;
  }
  .pipe-nodo svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pipe-nombre {
    font-size: 13.5px;
    color: #e7e7ec;
    line-height: 1.3;
  }
  .pipe-detalle {
    font-family: var(--font-mono);
    font-size: 11px;
    color: #85858f;
  }
  .pipe-etapa.pipe-falla .pipe-nodo {
    border-color: #ff6b3d;
    color: #ff6b3d;
  }
  .pipe-etapa[data-estado='pendiente'] .pipe-nodo {
    border-color: rgba(255, 255, 255, 0.14);
    color: transparent;
  }
  .pipe-etapa[data-estado='pendiente'] .pipe-nombre,
  .pipe-etapa[data-estado='pendiente'] .pipe-detalle {
    opacity: 0.4;
  }
  .pipe-etapa[data-estado='corriendo'] .pipe-nodo {
    border-color: #00f2ff;
    color: transparent;
    box-shadow: 0 0 0 5px rgba(0, 242, 255, 0.14);
    animation: pipe-giro 0.7s linear infinite;
    border-top-color: transparent;
  }
  .pipe-nombre,
  .pipe-detalle {
    transition: opacity 0.3s ease;
  }
  @keyframes pipe-giro {
    to {
      transform: rotate(360deg);
    }
  }
  .pipe-rollback {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 22px;
    margin-left: calc((100% - 36px) / 4 * 3 + 36px);
    padding: 4px 10px;
    border: 1px dashed rgba(255, 107, 61, 0.45);
    border-radius: 9999px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: rgba(255, 107, 61, 0.9);
    white-space: nowrap;
  }
  .pipe-rollback-punto {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: #ff6b3d;
  }
  @media (max-width: 1023px) and (min-width: 640px) {
    .pipe-rollback {
      margin-left: 0;
    }
  }
  @media (max-width: 639px) {
    .pipe-etapas {
      grid-template-columns: minmax(0, 1fr);
      gap: 22px;
    }
    .pipe-etapa {
      display: grid;
      grid-template-columns: 28px minmax(0, 1fr);
      column-gap: 14px;
      row-gap: 2px;
    }
    .pipe-nodo {
      grid-row: span 2;
      margin: 0;
    }
    .pipe-rollback {
      margin-left: 42px;
    }
  }

  .runs {
    display: flex;
    align-items: flex-end;
    gap: 4px;
    height: 64px;
  }
  .runs span {
    flex: 1;
    min-height: 3px;
    border-radius: 2px 2px 0 0;
    transition: filter 0.2s ease;
  }
  .runs span:hover {
    filter: brightness(1.45);
  }

  /* ── Tira de 90 días ── */
  .tira-lectura {
    height: 16px;
    margin-bottom: 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: #c4c4cc;
  }
  .tira {
    position: relative;
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 104px;
    cursor: crosshair;
  }
  .tira-dia {
    position: relative;
    flex: 1;
    min-width: 0;
    height: 100%;
    display: flex;
    align-items: flex-end;
  }
  .tira-barra {
    display: block;
    width: 100%;
    border-radius: 1.5px;
  }
  .tira-dia.hueco .tira-barra,
  .tira-leyenda-hueco,
  .fuente-status .hueco {
    background: repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.08) 0 2px, transparent 2px 5px);
  }
  .tira-leyenda-hueco {
    display: inline-block;
    width: 9px;
    height: 9px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .tira-dia.con-incidente::after {
    content: '';
    position: absolute;
    top: -9px;
    left: 50%;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 9999px;
    background: #ff6b3d;
  }
  .tira-dia.activa .tira-barra {
    filter: brightness(1.5);
    box-shadow: 0 0 0 1px #e7fdff;
  }
  .tira-barrido {
    position: absolute;
    top: -8px;
    bottom: -8px;
    left: 0;
    width: 2px;
    margin-left: -1px;
    background: #e7fdff;
    box-shadow: 0 0 14px 2px #00f2ff;
    opacity: 0;
    pointer-events: none;
    z-index: 1;
  }
  @media (max-width: 639px) {
    .tira {
      gap: 1px;
      height: 84px;
    }
  }

  /* ── Fuentes: vistas previas de lo que abre cada enlace ── */
  .fuente {
    display: block;
    transition: border-color 0.3s ease;
  }
  .fuente-vista {
    position: relative;
    height: 68px;
    margin-bottom: 16px;
    border-radius: 10px;
    background: #0a0a0d;
    border: 1px solid rgba(255, 255, 255, 0.06);
    overflow: hidden;
  }
  .fuente-escudo {
    width: 100%;
    height: 100%;
  }
  .fuente-escudo path {
    fill: none;
    stroke: rgba(0, 242, 255, 0.55);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }
  .fuente-escudo .fuente-escudo-ok {
    stroke: #c9ff5b;
    stroke-width: 2.5;
    stroke-linecap: round;
  }
  .fuente-escaneo {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, #00f2ff 50%, transparent);
    box-shadow: 0 0 10px #00f2ff;
    opacity: 0.8;
  }
  .fuente-status {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    padding: 12px;
  }
  .fuente-status span {
    flex: 1;
    border-radius: 1px;
  }
  .fuente-terminal {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 3px;
    padding: 0 14px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: #c4c4cc;
  }
  .fuente-terminal b {
    font-weight: 400;
    color: #00f2ff;
  }
  .fuente-cursor {
    display: inline-block;
    width: 6px;
    height: 11px;
    vertical-align: -2px;
    background: #00f2ff;
  }
  /* Las vistas solo se mueven con la tarjeta en pantalla (la clase la pone un
     IntersectionObserver) y nunca con movimiento reducido. */
  @media (prefers-reduced-motion: no-preference) {
    .fuente-vista.en-vista .fuente-escaneo {
      animation: fuente-escaneo 2.8s ease-in-out infinite;
    }
    .fuente-vista.en-vista .fuente-cursor {
      animation: fuente-parpadeo 1s steps(1) infinite;
    }
    .fuente-vista.en-vista .fuente-escudo-ok {
      stroke-dasharray: 40;
      animation: fuente-trazo 2.8s ease-in-out infinite;
    }
    .fuente:hover .fuente-status span {
      animation: fuente-latido 0.9s ease-in-out;
      animation-delay: calc(var(--i, 0) * 18ms);
    }
  }
  @keyframes fuente-escaneo {
    0%,
    100% {
      top: 8%;
    }
    50% {
      top: 92%;
    }
  }
  @keyframes fuente-parpadeo {
    50% {
      opacity: 0;
    }
  }
  @keyframes fuente-trazo {
    0% {
      stroke-dashoffset: 40;
    }
    40%,
    100% {
      stroke-dashoffset: 0;
    }
  }
  @keyframes fuente-latido {
    50% {
      transform: scaleY(0.4);
    }
  }
</style>

<script>
  // Prueba de vida: al abrir cualquier popover, el navegador consulta
  // /api/engineering/live y muestra cuándo llegó la última muestra/sondeo/run,
  // con un tick por segundo. Así el visitante VE que los datos no están
  // harcodeados: la consulta sale de su propio navegador contra la DB.
  type LiveData = {
    ts: number
    vitals: { lastAt: number | null; lastMetric: string | null; count24h: number }
    uptime: {
      lastAt: number | null
      lastOk: boolean | null
      lastStatusCode: number | null
      lastMs: number | null
      lastName: string | null
      count24h: number
    }
    ci: { lastAt: number | null; lastConclusion: string | null; lastSha: string | null }
  }

  import { getDictionary, getLocaleFromUrl, interpolate, intlLocale } from '../i18n'

  const locale = getLocaleFromUrl(location.pathname)
  const el = getDictionary(locale).engineering.live

  let data: LiveData | null = null
  let fetchedAt = 0
  let inflight: Promise<void> | null = null
  let ticker: number | null = null

  const nf = new Intl.NumberFormat(intlLocale(locale))

  function ago(ts: number | null): string {
    if (ts == null) return el.never
    const s = Math.max(0, Math.round((Date.now() - ts) / 1000))
    if (s < 60) return interpolate(el.agoSeconds, { n: s })
    const m = Math.floor(s / 60)
    if (m < 60) return interpolate(el.agoMinutes, { n: m })
    const h = Math.floor(m / 60)
    return h < 48 ? interpolate(el.agoHours, { n: h }) : interpolate(el.agoDays, { n: Math.floor(h / 24) })
  }

  function render() {
    const strips = document.querySelectorAll<HTMLElement>('.live-strip')
    strips.forEach((strip) => {
      const text = strip.querySelector<HTMLElement>('.live-text')
      if (!text) return
      if (!data) return
      strip.classList.remove('is-error')
      const kind = strip.dataset.live
      if (kind === 'vitals') {
        const v = data.vitals
        text.textContent =
          v.lastAt == null
            ? interpolate(el.vitalsNone, { ago: ago(fetchedAt) })
            : interpolate(el.vitalsSome, {
                ago: ago(fetchedAt),
                metric: v.lastMetric ?? '',
                sampleAgo: ago(v.lastAt),
                count: nf.format(v.count24h),
              })
      } else if (kind === 'uptime') {
        const u = data.uptime
        text.textContent =
          u.lastAt == null
            ? interpolate(el.uptimeNone, { ago: ago(fetchedAt) })
            : interpolate(el.uptimeSome, {
                ago: ago(fetchedAt),
                checkAgo: ago(u.lastAt),
                name: u.lastName ?? '?',
                status: String(u.lastStatusCode ?? '-'),
                ms: String(u.lastMs ?? '-'),
                count: nf.format(u.count24h),
              })
      } else if (kind === 'ci') {
        const c = data.ci
        text.textContent =
          c.lastAt == null
            ? interpolate(el.ciNone, { ago: ago(fetchedAt) })
            : interpolate(el.ciSome, {
                ago: ago(fetchedAt),
                runAgo: ago(c.lastAt),
                conclusion: c.lastConclusion ?? '?',
                sha: c.lastSha ?? '',
              })
      }
    })
  }

  function markError() {
    document.querySelectorAll<HTMLElement>('.live-strip').forEach((strip) => {
      strip.classList.add('is-error')
      const text = strip.querySelector<HTMLElement>('.live-text')
      if (text) text.textContent = getDictionary(locale).engineering.pipeline.liveError
    })
  }

  function refresh() {
    // Reutiliza la respuesta durante 20s para no martillar la DB al pasear el cursor.
    if (inflight) return inflight
    if (data && Date.now() - fetchedAt < 20_000) return Promise.resolve()
    inflight = fetch('/api/engineering/live', { headers: { Accept: 'application/json' } })
      .then((r) => {
        if (!r.ok) throw new Error(String(r.status))
        return r.json()
      })
      .then((json: LiveData) => {
        data = json
        fetchedAt = Date.now()
        render()
      })
      .catch(() => markError())
      .finally(() => {
        inflight = null
      })
    return inflight
  }

  function startTicker() {
    if (ticker != null) return
    ticker = window.setInterval(() => {
      const anyOpen = document.querySelector('.card-pop.is-open')
      if (!anyOpen) {
        if (ticker != null) window.clearInterval(ticker)
        ticker = null
        return
      }
      render()
    }, 1000)
  }

  document.querySelectorAll<HTMLElement>('.card-pop').forEach((el) => {
    const activate = () => {
      refresh()
      startTicker()
    }
    el.addEventListener('mouseenter', activate)
    el.addEventListener('focusin', activate)
    el.addEventListener('click', activate)
  })
</script>

<script>
  // Mismo lenguaje de motion que las demás landings (Lenis + GSAP, montaje
  // compartido en src/lib/motion/landing.ts) más las piezas propias de esta
  // página. El instrumento se monta también con movimiento reducido: medir la
  // visita no es animación, solo se salta la repetición.
  import { montarLanding } from '../lib/motion/landing'
  import { montarInstrumento } from '../lib/motion/instrumento'
  import { montarSecciones } from '../lib/motion/engineering'
  import { revelarEtiqueta } from '../lib/motion/efectos'

  const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const instrumento = document.querySelector<HTMLElement>('[data-instrumento]')
  if (instrumento) {
    try {
      montarInstrumento(instrumento, { reducido })
    } catch (err) {
      console.warn('[engineering] instrumento deshabilitado', err)
      delete instrumento.dataset.fase
    }
  }
  montarLanding()
  montarSecciones({ reducido })
  if (!reducido) {
    try {
      document.querySelectorAll<HTMLElement>('[data-etiqueta]').forEach(revelarEtiqueta)
    } catch (err) {
      console.warn('[engineering] etiquetas sin motion', err)
    }
  }
</script>
