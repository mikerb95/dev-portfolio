---
// Página sin datos vivos: se genera en el build, no por request.
export const prerender = true

import BaseLayout from '../layouts/BaseLayout.astro'
import TrazadorPeticiones from '../components/architecture/TrazadorPeticiones.astro'
import { getDictionary, getLocaleFromUrl, localizedHref } from '../i18n'
import { CASO_DE_DECISION, NODOS_POR_CAPA } from '../lib/motion/trazado'

// Página estática: arquitectura del propio sitio. Un diagrama de capas y las
// decisiones de diseño con su trade-off. Es lo que un ingeniero senior busca
// (criterio de diseño, no solo features) y casi nadie muestra visualmente.
// Contenido en el diccionario (t.architecture); mismo patrón que /security.

const locale = getLocaleFromUrl(Astro.url.pathname)
const t = getDictionary(locale)
const a = t.architecture
const L = (path: string) => localizedHref(path, locale)

const { layers, externals, decisions, limits } = a
const tz = a.trazador
// Cada pieza enlaza a su versión viva y a la nota que la cuenta: la página es
// el índice narrativo del sitio (etapa 10 del roadmap). El slug de la nota ya
// viene en el idioma de la página desde el diccionario.
const notaHref = (slug: string) => (locale === 'en' ? `/en/notes/${slug}` : `/notes/${slug}`)
type Nodo = { name: string; detail: string; href?: string; note?: string }
---

<BaseLayout title={a.title} description={a.description} image="/og-default.png">
  <div class="max-w-[1280px] mx-auto px-6 md:px-12 lg:px-20 pt-32 pb-24">
    <a href={L('/')} class="inline-flex items-center gap-2 text-[11px] font-mono uppercase tracking-[.2em] text-ink-300 hover:text-cyan transition-colors mb-12">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
      {t.common.back}
    </a>

    <header class="mb-14">
      <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-6">
        <span class="text-cyan">/architecture</span>
        <span class="h-px flex-1 bg-gradient-to-r from-white/15 to-transparent max-w-[80px]"></span>
        <span>{a.eyebrow}</span>
      </div>
      <h1 class="text-5xl md:text-6xl font-medium tracking-[-.035em] leading-[.98] mb-8 [&>span]:[text-wrap:balance]">
        <span data-hero-linea class="block text-ink-50">{a.h1Line1}</span>{' '}
        <span data-hero-linea class="block text-cyan">{a.h1Line2}</span>
      </h1>
      <p data-hero-sigue class="text-[16px] text-ink-100 max-w-2xl leading-relaxed">
        {a.intro}
      </p>
    </header>

    <!-- El camino de una petición: el diagrama con recorridos reales. -->
    <TrazadorPeticiones />

    <!-- Pieza por pieza: el detalle de cada nodo del diagrama, con su versión
         viva y su nota. Cada pieza tiene ancla: los nodos del trazador
         enlazan aquí. -->
    <section class="mb-16" aria-labelledby="arch-piezas">
      <h2 id="arch-piezas" class="text-[13px] font-mono uppercase tracking-[.2em] text-ink-200 mb-5" data-titular>{tz.anatomiaHeading}</h2>
      <div class="space-y-3" data-entrada>
        {layers.map((layer, i) => (
          <div class="arch-capa rounded-2xl glass p-5 md:p-6">
            <div class="flex flex-col md:flex-row md:items-start gap-4">
              <div class="md:w-40 shrink-0">
                <div class="text-[10px] font-mono uppercase tracking-[.2em] text-cyan mb-1">{layer.tag}</div>
                <div class="text-[14px] text-ink-50 font-medium leading-tight">{layer.title}</div>
              </div>
              <div class="flex-1 grid sm:grid-cols-2 lg:grid-cols-3 gap-2.5">
                {(layer.nodes as readonly Nodo[]).map((n, j) => (
                  <div id={`pieza-${NODOS_POR_CAPA[i][j]}`} class="arch-pieza rounded-xl border border-white/5 bg-white/[.02] px-3.5 py-2.5">
                    <div class="text-[12.5px] text-ink-50">{n.name}</div>
                    {/* ink-200 y no ink-400: con el contraste de antes, el detalle no pasaba WCAG AA. */}
                    <div class="text-[11.5px] text-ink-200 mt-0.5 leading-snug">{n.detail}</div>
                    {(n.href || n.note) && (
                      <div class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-[11px] font-mono">
                        {n.href && <a href={L(n.href)} class="text-cyan hover:underline">{a.verVivo} ↗</a>}
                        {n.note && <a href={notaHref(n.note)} class="text-ink-100 hover:text-cyan">{a.leerNota} →</a>}
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Servicios externos -->
    <section class="mb-16">
      <h2 class="text-[13px] font-mono uppercase tracking-[.2em] text-ink-200 mb-5" data-titular>{a.externalsHeading}</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3" data-entrada>
        {externals.map((e) => (
          <div class="rounded-2xl arch-tarjeta p-4">
            <div class="text-[13px] text-ink-50 font-mono">{e.name}</div>
            <div class="text-[11.5px] text-ink-200 mt-1.5 leading-relaxed">{e.role}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- Decisiones de diseño -->
    <section>
      <h2 class="text-[13px] font-mono uppercase tracking-[.2em] text-ink-200 mb-5" data-titular>{a.decisionsHeading}</h2>
      <div class="space-y-3" data-entrada>
        {decisions.map((d, i) => {
          const ver = CASO_DE_DECISION[i]
          return (
            <div class="rounded-2xl arch-tarjeta p-5 md:p-6">
              <div class="flex items-start gap-3">
                <span class="text-cyan font-mono text-[13px] mt-0.5 shrink-0">→</span>
                <div>
                  <div class="text-[15px] text-ink-50 font-medium mb-1.5">{d.q}</div>
                  <p class="text-[13px] text-ink-200 leading-relaxed">{d.a}</p>
                  {ver && (
                    <a
                      href={`#caso-${ver.caso}`}
                      class="arch-ver mt-3 inline-flex items-center gap-2 text-[11.5px] font-mono text-cyan"
                      data-ver-caso={ver.caso}
                      data-ver-fallo={ver.fallo ?? undefined}
                    >
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l13-7.5z"/></svg>
                      {tz.verPasar}: {tz.casos[ver.caso].titulo}{ver.fallo && <span class="text-ember">{' '}· {tz.fallos[ver.fallo]} {tz.caida}</span>}
                    </a>
                  )}
                </div>
              </div>
            </div>
          )
        })}
      </div>
    </section>

    <!-- Límites conocidos: lo que este diseño todavía no resuelve -->
    <section class="mt-16" aria-labelledby="arch-limites">
      <h2 id="arch-limites" class="text-[13px] font-mono uppercase tracking-[.2em] text-ink-200 mb-5" data-titular>{a.limitsHeading}</h2>
      <ul class="grid gap-2.5 max-w-3xl" data-entrada>
        {limits.map((l) => (
          <li class="flex gap-3 text-[13.5px] text-ink-100 leading-relaxed">
            <span class="text-ember font-mono shrink-0" aria-hidden="true">!</span>
            <span>{l}</span>
          </li>
        ))}
      </ul>
      <p class="text-[12px] text-ink-400 mt-8 leading-relaxed max-w-2xl">
        {a.footnoteA}<a href={L('/security')} class="text-cyan hover:underline">{a.footnoteLinkLabel}</a>{a.footnoteB}
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  /* Ancla de las piezas: deja sitio a la barra fija y marca la pieza a la que
     se llegó desde un nodo del trazador. */
  .arch-pieza { scroll-margin-top: 110px; transition: border-color .4s, background .4s; }
  .arch-pieza:target { border-color: rgba(0, 242, 255, .45); background: rgba(0, 242, 255, .05); }
  .arch-tarjeta {
    background: linear-gradient(180deg, rgba(255, 255, 255, .04), rgba(255, 255, 255, .015));
    border: 1px solid rgba(255, 255, 255, .06);
  }
  .arch-ver:hover { text-decoration: underline; }
</style>

<script>
  // Mismo lenguaje que las demás páginas con motion (Lenis + GSAP, montaje
  // común en src/lib/motion/landing.ts) más el trazador de peticiones.
  import { montarLanding } from '../lib/motion/landing'
  import { montarTrazador } from '../lib/motion/arquitectura'

  const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  montarLanding({ anclas: true })
  const trazador = document.querySelector<HTMLElement>('[data-trazador]')
  if (trazador) {
    try {
      montarTrazador(trazador, { reducido })
    } catch (err) {
      // Fail-open: las listas de pasos del servidor siguen ahí, completas.
      console.warn('[architecture] trazador sin motion', err)
      trazador.classList.remove('tz-vivo')
    }
  }
</script>
