---
import type { Senal, Tono } from '../lib/pulso-panel'

// Panel de detalle de una señal de la cinta del hero.
//
// Se renderiza en SSR junto a la cinta, oculto: al apuntar una señal solo se
// alterna una clase. La alternativa (pedir la serie por fetch al abrir) metería
// una petición y un estado de carga en el gesto más trivial de la página, y el
// dato ya viajaba en la misma consulta que la cifra.
//
// El ancho es fijo y el panel se ancla bajo la señal apuntada (lo posiciona el
// script del index): un panel a todo lo ancho obliga al ojo a buscar de qué
// cifra habla, y a esta distancia del gesto eso ya es demasiado trabajo.
interface Props {
  senal: Senal
}

const { senal } = Astro.props
const { panel } = senal

// Un tono por significado, no por gusto: verde cumple, violeta roza el umbral,
// naranja lo incumple, cian es volumen sin juicio de valor, y el gris es la
// ausencia de dato (que nunca debe parecer un cero bajo).
const TONOS: Record<Tono, string> = {
  ok: 'bg-lime/70',
  info: 'bg-cyan/55',
  medio: 'bg-violet/70',
  mal: 'bg-ember/80',
  vacio: 'bg-ink-600',
}
---

<div class="pulso-panel" data-panel={senal.id} hidden>
  <!-- Hilo y muesca: nacen en la señal apuntada y bajan hasta el panel. Sin
       ellos el panel es una caja que aparece cerca; con ellos es la misma
       señal desplegada, que es lo que de verdad está pasando. -->
  <span class="pulso-hilo" aria-hidden="true"></span>
  <span class="pulso-muesca" aria-hidden="true"></span>

  <!-- `glass-strong` y no `glass`: el panel cae sobre la sección siguiente, y
       con el cristal ligero se leían los titulares del bento a través de la
       descripción. -->
  <div class="pulso-card rounded-xl glass-strong px-4 py-3.5 shadow-[0_24px_60px_-20px_rgba(0,0,0,.9)]">
    <div class="flex items-start justify-between gap-4">
      <div class="min-w-0 flex items-center gap-2">
        <span class={`h-1.5 w-1.5 rounded-full shrink-0 ${TONOS[panel.barras[panel.barras.length - 1]?.tono ?? 'info']}`}></span>
        <span class="pulso-titulo text-[10px] font-mono uppercase tracking-[.16em] text-cyan truncate">{panel.titulo}</span>
      </div>
      <a
        href={senal.href}
        aria-label={`${senal.valor} ${senal.etiqueta}`}
        class="shrink-0 text-right group/val leading-none"
      >
        <span class="pulso-valor block text-[19px] tabular-nums tracking-[-.02em] text-ink-50 group-hover/val:text-cyan transition-colors" data-valor={senal.valor}>
          {senal.valor}
        </span>
      </a>
    </div>

    <p class="pulso-desc mt-2 text-[12px] leading-snug text-ink-200">{panel.descripcion}</p>

    <div class="pulso-barras relative mt-3">
      <div class="flex items-end gap-[3px] h-12">
        {panel.barras.map((b, i) => (
          <div
            class={`pbar flex-1 rounded-[2px] ${TONOS[b.tono]}`}
            style={`height:${(b.alto * 100).toFixed(1)}%;--i:${i}`}
            data-label={b.etiqueta}
            role="img"
            aria-label={b.etiqueta}
          />
        ))}
      </div>
      <!-- Barrido de osciloscopio: cruza el gráfico una sola vez al abrir,
           en el mismo sentido en que se lee la serie. -->
      <span class="pulso-scan" aria-hidden="true"></span>
      <span class="pulso-tooltip absolute hidden -top-1 -translate-x-1/2 -translate-y-full px-2 py-1 rounded-md bg-black/85 ring-1 ring-white/10 text-[10px] font-mono text-ink-50 whitespace-nowrap pointer-events-none z-10"></span>
    </div>

    <div class="flex justify-between text-[9px] font-mono text-ink-300/70 mt-1.5">
      <span>{panel.ejeIzq}</span>
      <span>{panel.ejeDer}</span>
    </div>

    <div class="mt-3 flex flex-wrap items-baseline gap-x-4 gap-y-1 border-t border-white/[.06] pt-2.5">
      {panel.resumen.map((r) => (
        <span class="pulso-dato inline-flex items-baseline gap-1.5">
          <span class="text-[9px] font-mono uppercase tracking-[.12em] text-ink-300">{r.k}</span>
          <span class="text-[12px] tabular-nums text-ink-50">{r.v}</span>
        </span>
      ))}
    </div>

    <p class="pulso-dato mt-2 text-[9px] font-mono leading-relaxed text-ink-300/70">{panel.fuente}</p>
  </div>
</div>
