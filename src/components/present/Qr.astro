---
// QR generado en el SERVIDOR, como SVG inline. `qrcode` ya estaba en las
// dependencias del repo (lo usa /cobrar), así que esto no añade peso: cero JS
// en el cliente y el código aparece con el primer pintado — importante en el
// lobby, donde el público ya está apuntando el celular a la pantalla.
import QRCode from 'qrcode'

interface Props {
  data: string
  /** Lado del SVG en px. El lobby lo quiere enorme; la pantalla de cierre, no. */
  size?: number
  /** Color de los módulos. El fondo siempre blanco: los lectores lo agradecen. */
  dark?: string
  label?: string
}

const { data, size = 320, dark = '#050508', label } = Astro.props

// Corrección de errores media: sobrevive a un reflejo en el proyector o a que
// alguien pase por delante, sin inflar la densidad del código.
const svg = await QRCode.toString(data, {
  type: 'svg',
  errorCorrectionLevel: 'M',
  margin: 1,
  width: size,
  color: { dark, light: '#ffffff' },
})
---

<figure class="qr" style={`--qr-size:${size}px`} aria-label={label ?? `Código QR hacia ${data}`}>
  <div class="qr-frame" set:html={svg} />
  {label && <figcaption class="qr-label mono">{label}</figcaption>}
</figure>

<style>
  .qr {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }
  .qr-frame {
    width: var(--qr-size);
    height: var(--qr-size);
    padding: 0.75rem;
    background: #fff;
    border-radius: 14px;
    line-height: 0;
  }
  .qr-frame :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
  .qr-label {
    font-size: 0.8rem;
    color: var(--ink-200);
    letter-spacing: 0.08em;
  }
</style>
