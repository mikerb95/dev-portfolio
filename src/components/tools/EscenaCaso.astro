---
// Escena viva de cada caso de estudio de /tools: la herramienta haciendo lo
// que su texto afirma. El monitor ve una página que responde 200 con el
// contenido equivocado, el P&L normaliza ciclos y monedas, el seguimiento
// esconde lo interno al cliente, la bóveda cifra y rechaza un byte alterado, el
// pipeline revierte solo, el caos rompe una ruta sin tocar /admin y el SIEM
// escala un bloqueo.
//
// Los datos son de ejemplo (y el pie de la ventana lo dice), pero las cifras
// que se derivan de ellos salen de las funciones reales del panel, y el
// cifrado de la bóveda es AES-256-GCM de verdad, hecho en el build con una
// clave de un solo uso que se descarta.
//
// El marcado es la escena ya terminada; el script (src/lib/motion/
// tools-escenas.ts) la repite en bucle solo mientras se ve. Decorativa:
// aria-hidden, el contenido está en el texto del caso.
import { randomBytes } from 'node:crypto'
import { getDictionary, getLocaleFromUrl, formatNumber, interpolate } from '../../i18n'
import { encryptWith, decryptWith } from '../../lib/crypto'
import { MAX_TTL_S } from '../../lib/chaos'
import { mmss } from '../../lib/motion/circuito'
import { alterarCifrado, datosAnomalia, datosPnl, datosSlo, INGRESOS_EJEMPLO, SLO_OBJETIVO } from '../../lib/motion/tools-datos'

export type EscenaKind = 'monitors' | 'pnl' | 'seguimiento' | 'vault' | 'pipeline' | 'chaos' | 'security'
interface Props {
  kind: EscenaKind
}
const { kind } = Astro.props

const locale = getLocaleFromUrl(Astro.url.pathname)
const d = getDictionary(locale)
const m = d.tools.motion
const n = (v: number, dec = 0) => formatNumber(v, locale, { minimumFractionDigits: dec, maximumFractionDigits: dec })

// ── Monitores ───────────────────────────────────────────────────────────
const hosts = d.toolMock.monitorHosts
const latencias = ['182 ms', '240 ms', '311 ms']
const slo = datosSlo()
const barras = (caidas: number[]) => Array.from({ length: 30 }, (_, i) => (caidas.includes(i) ? 'caida' : 'ok'))
const tiras = [barras([]), barras([11]), barras([6, 22])]

// ── P&L ─────────────────────────────────────────────────────────────────
const pnl = datosPnl()
const origen = (f: (typeof pnl.filas)[number]) =>
  f.billingCycle === 'free' ? m.pnl.ciclos.free : `${f.currency} ${n(f.cost)} · ${m.pnl.ciclos[f.billingCycle as 'annual' | 'monthly']}`
const ingreso = (estado: string) => INGRESOS_EJEMPLO.find((f) => f.status === estado)?.amount ?? 0
const divisor = (f: (typeof pnl.filas)[number]) =>
  f.billingCycle === 'annual' ? (f.currency === 'COP' ? '÷12 ÷4.000' : '÷12') : f.billingCycle === 'monthly' ? '×1' : '×0'

// ── Bóveda ──────────────────────────────────────────────────────────────
// Cifrado real con la función del panel y una clave que no sale de este build.
const SECRETO_NOMBRE = 'RESEND_API_KEY'
const claveUnUso = randomBytes(32)
const guardado = encryptWith(claveUnUso, m.boveda.valorEjemplo)
const [ivHex, tagHex, ctHex] = guardado.split(':')
const { alterado, indice } = alterarCifrado(guardado)
// La escena afirma que un byte alterado no se descifra. Si algún día no fuera
// así, el build falla en vez de publicar una demostración falsa.
let rechazado = false
try {
  decryptWith(claveUnUso, alterado)
} catch {
  rechazado = true
}
if (!rechazado || decryptWith(claveUnUso, guardado) !== m.boveda.valorEjemplo) {
  throw new Error('EscenaCaso: el cifrado de la bóveda no se comporta como afirma la escena')
}
const ctIndice = indice - ivHex.length - tagHex.length - 2

// ── Pipeline ────────────────────────────────────────────────────────────
const ETAPAS = ['push', 'tests', 'build', 'deploy', 'health check']
const historial = [
  { sha: 'f51d0ac', res: 'revertido', t: '4 min' },
  { sha: 'a3f9e21', res: 'exito', t: '2 min' },
  { sha: '8c04b77', res: 'exito', t: '2 min' },
]

// ── Caos ────────────────────────────────────────────────────────────────
const ttl = mmss(MAX_TTL_S)

// ── Seguridad ───────────────────────────────────────────────────────────
const anomalia = datosAnomalia()
const maxHora = Math.max(...anomalia.horas, anomalia.techo) * 1.1
const eventos = [
  { sev: 'high', ip: '203.0.x.x', pais: 'CN' },
  { sev: 'medium', ip: '198.51.x.x', pais: 'US' },
  { sev: 'critical', ip: '192.0.x.x', pais: 'BR' },
  { sev: 'high', ip: '203.0.x.x', pais: 'CN' },
].map((e, i) => ({ ...e, cat: m.security.eventos[i] }))
const ESCALERA = ['1 h', '24 h', '7 d']
---

<div class={`es es-${kind}`} data-escena={kind} aria-hidden="true">
  {kind === 'monitors' && (
    <Fragment>
      {hosts.map((h, i) => (
        <div class="es-mon-fila" data-fila={i} data-estado="ok">
          <div class="es-mon-cab">
            <span class="es-dot"></span>
            <span class="es-host">{h}</span>
            <span class="es-inc" data-incidente data-cerrado={m.monitors.cerrado}>{m.monitors.incidente}</span>
            <span class="es-ms" data-ms>{latencias[i]}</span>
          </div>
          <div class="es-checks">
            <span class="es-check" data-check="http">HTTP <b>200</b></span>
            <span class="es-check" data-check="contenido">{m.monitors.contenido} <b data-marca>✓</b></span>
            <span class="es-check" data-check="lat">{m.monitors.latencia} <b>✓</b></span>
          </div>
          <div class="es-tira">
            {tiras[i].map((b, j) => <span class={`es-barra es-barra-${b}`} data-hoy={j === 29 ? '' : undefined}></span>)}
          </div>
        </div>
      ))}
      <div class="es-slo">
        <div class="es-slo-cab">
          <span>{interpolate(m.monitors.slo, { obj: n(SLO_OBJETIVO, 1) })}</span>
          <span>burn rate <b data-burn data-despues={`${n(slo.despues.burnRate ?? 0, 2)}×`}>{n(slo.antes.burnRate ?? 0, 2)}×</b></span>
        </div>
        <div class="es-slo-barra">
          <span data-presupuesto data-antes={slo.antes.budgetRemainingPct} data-despues={slo.despues.budgetRemainingPct} style={`width:${slo.antes.budgetRemainingPct}%`}></span>
        </div>
        <div class="es-slo-pie">
          <span>{m.monitors.presupuesto}</span>
          <b data-restante data-despues={`${n(slo.despues.budgetRemainingPct ?? 0, 1)} %`}>{n(slo.antes.budgetRemainingPct ?? 0, 1)} %</b>
        </div>
      </div>
      <div class="es-toast" data-toast>
        <span class="es-toast-app">ntfy</span>
        <span><b>{hosts[2]}</b> · {m.monitors.toast}</span>
      </div>
    </Fragment>
  )}

  {kind === 'pnl' && (
    <Fragment>
      <div class="es-pnl-cab"><span>{m.pnl.proyecto}</span><span class="es-mono es-tenue">USD</span></div>
      <div class="es-pnl-filas">
        {pnl.filas.map((f, i) => (
          <div class="es-pnl-fila" data-fila>
            <span class="es-pnl-nombre">{m.pnl.servicios[i]}</span>
            <span class="es-pnl-origen es-mono">{origen(f)}</span>
            <span class="es-pnl-div es-mono" data-div>{divisor(f)}</span>
            <span class="es-pnl-mes es-mono" data-mes={n(f.mensualUSD, 2)}>{n(f.mensualUSD, 2)}</span>
          </div>
        ))}
        <div class="es-pnl-fila es-pnl-total">
          <span>{m.pnl.costoMensual}</span>
          <span></span>
          <span></span>
          <span class="es-mono" data-total={n(pnl.antes.costoMensualUSD, 2)}>{n(pnl.antes.costoMensualUSD, 2)}</span>
        </div>
      </div>
      <div class="es-pnl-ing">
        <div class="es-etq">{m.pnl.ingresos}</div>
        <div class="es-pnl-barra">
          <span class="es-seg-cob" data-parte="cobrado" style={`width:${pnl.partes.cobrado * 100}%`}></span>
          <span class="es-seg-pen" data-parte="pendiente" style={`width:${pnl.partes.pendiente * 100}%`}></span>
          <span class="es-seg-pro" data-parte="proyectado" style={`width:${pnl.partes.proyectado * 100}%`}></span>
        </div>
        <div class="es-pnl-ley es-mono">
          <span><i class="es-cob"></i>{m.pnl.cobrado} {n(ingreso('cobrado'))}</span>
          <span data-ley-pendiente><i class="es-pen"></i>{m.pnl.pendiente} {n(ingreso('pendiente'))}</span>
          <span><i class="es-pro"></i>{m.pnl.proyectado} {n(ingreso('proyectado'))}</span>
        </div>
      </div>
      <div class="es-pnl-margen">
        <span class="es-etq">{m.pnl.margen}</span>
        <span class="es-pill es-pill-ok" data-pagada>✓ {m.pnl.pagada}</span>
        <b class="es-pnl-cifra" data-margen data-despues={n(pnl.despues.margenEstimado, 2)}>{n(pnl.antes.margenEstimado, 2)}</b>
      </div>
      <p class="es-nota">{m.pnl.nota}: <code>monthlyEquivalent · projectPnL</code></p>
    </Fragment>
  )}

  {kind === 'seguimiento' && (
    <Fragment>
      <div class="es-seg-cab">
        <span class="es-etq">{m.seg.vista}</span>
        <span class="es-toggle" data-toggle>
          <span class="es-toggle-luz" data-toggle-luz></span>
          <span class="es-toggle-op is-on" data-op="panel">{m.seg.panel}</span>
          <span class="es-toggle-op" data-op="cliente">{m.seg.cliente}</span>
        </span>
      </div>
      <ol class="es-seg-lista">
        <li class="es-seg-item es-seg-prox" data-item>
          <span class="es-seg-punto es-pulso"></span>
          <span class="es-seg-texto">{m.seg.proximo.t}</span>
          <span class="es-vis es-vis-cliente">{m.seg.vis.cliente}</span>
          <span class="es-seg-fecha es-mono">{m.seg.proximo.d}</span>
        </li>
        {m.seg.items.map((it, i) => {
          const vis = i === 0 ? 'publico' : i === 1 ? 'interno' : 'cliente'
          return (
            <li class="es-seg-item" data-item data-interno={vis === 'interno' ? '' : undefined}>
              <span class="es-seg-punto"></span>
              <span class="es-seg-texto">{it.t}</span>
              <span class={`es-vis es-vis-${vis}`}>{m.seg.vis[vis]}</span>
              <span class="es-seg-fecha es-mono">{it.d}</span>
              {vis === 'interno' && <span class="es-seg-oculto" data-oculto>{m.seg.oculto}</span>}
            </li>
          )
        })}
      </ol>
    </Fragment>
  )}

  {kind === 'vault' && (
    <Fragment>
      <div class="es-bov-form">
        <span class="es-etq">{m.boveda.nombre}</span>
        <code class="es-bov-campo">{SECRETO_NOMBRE}</code>
        <span class="es-etq">{m.boveda.valor}</span>
        <code class="es-bov-campo"><span data-claro data-texto={m.boveda.valorEjemplo}>{m.boveda.valorEjemplo}</span><i class="es-cursor" data-cursor></i></code>
        <span class="es-bov-guardar" data-guardar>{m.boveda.guardar}</span>
      </div>
      <div class="es-bov-paso" data-paso><span>AES-256-GCM</span></div>
      <div class="es-etq">{m.boveda.enBase}</div>
      <code class="es-bov-cifra" data-cifra>
        <span class="es-iv" data-parte>{ivHex}</span>:<span class="es-tag" data-parte>{tagHex}</span>:<span class="es-ct" data-parte><span data-ct-a>{ctHex.slice(0, ctIndice)}</span><span class="es-byte" data-byte data-alterado={alterado[indice]}>{ctHex[ctIndice]}</span><span data-ct-b>{ctHex.slice(ctIndice + 1)}</span></span>
      </code>
      <div class="es-bov-partes es-mono">
        <span><i class="es-iv-c"></i>iv · 12 B</span>
        <span><i class="es-tag-c"></i>tag · 16 B</span>
        <span><i class="es-ct-c"></i>ct</span>
      </div>
      <div class="es-bov-alt" data-alt>
        <span class="es-mono es-tenue">{m.boveda.alterado}</span>
        <span class="es-mono">{m.boveda.descifrar} →</span>
        <span class="es-pill es-pill-mal" data-rechazo>✕ {m.boveda.rechazo}</span>
      </div>
      <div class="es-bov-llave">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="7.5" cy="15.5" r="5.5"></circle><path d="m21 2-9.6 9.6"></path><path d="m15.5 7.5 3 3L22 7l-3-3"></path></svg>
        {m.boveda.llave}
      </div>
      <p class="es-nota">{m.boveda.real}: <code>encryptWith · decryptWith</code></p>
    </Fragment>
  )}

  {kind === 'pipeline' && (
    <Fragment>
      <div class="es-ci-run es-mono">
        <span class="es-tenue">run</span> <b data-run-sha>f51d0ac</b>
        <span class="es-ci-prod">{m.pipeline.enVivo}: <b data-prod>a3f9e21</b></span>
      </div>
      <ol class="es-ci-etapas" data-etapas>
        <span class="es-ci-linea" aria-hidden="true"><span data-ci-luz></span></span>
        {ETAPAS.map((e, i) => (
          <li class="es-ci-etapa" data-etapa data-estado={i === ETAPAS.length - 1 ? 'fallo' : 'listo'}>
            <span class="es-ci-nodo"></span>
            <span class="es-ci-nombre es-mono">{e}</span>
          </li>
        ))}
      </ol>
      <div class="es-ci-rollback es-mono" data-rollback>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7v6h6"></path><path d="M21 17a9 9 0 0 0-9-9 9 9 0 0 0-6 2.3L3 13"></path></svg>
        {interpolate(m.pipeline.revirtiendo, { sha: 'a3f9e21' })}
      </div>
      <div class="es-etq">{m.pipeline.historial}</div>
      <ol class="es-ci-hist" data-historial data-exito={m.pipeline.exito} data-revertido={m.pipeline.revertido}>
        {historial.map((h) => (
          <li class="es-ci-fila es-mono">
            <span class={`es-dot es-dot-${h.res}`}></span>
            <span>{h.sha}</span>
            <span class="es-tenue">deploy → health check</span>
            <span class={`es-pill ${h.res === 'exito' ? 'es-pill-ok' : 'es-pill-mal'}`}>{m.pipeline[h.res as 'exito' | 'revertido']}</span>
            <span class="es-tenue">{h.t}</span>
          </li>
        ))}
      </ol>
    </Fragment>
  )}

  {kind === 'chaos' && (
    <Fragment>
      <div class="es-caos-flags">
        <div class="es-caos-flag" data-flag data-on="">
          <span class="es-switch"><span></span></span>
          <span>HTTP 500</span>
          <span class="es-mono es-tenue">/tienda</span>
          <span class="es-mono es-caos-ttl" data-ttl={ttl}>TTL {ttl}</span>
        </div>
        <div class="es-caos-flag">
          <span class="es-switch"><span></span></span>
          <span>{m.caos.latencia}</span>
          <span class="es-mono es-tenue">/api/*</span>
          <span class="es-mono es-caos-ttl">TTL -</span>
        </div>
      </div>
      <div class="es-caos-carriles">
        <div class="es-caos-carril" data-carril="tienda" data-estado="mal">
          <span class="es-mono es-caos-ruta">/tienda</span>
          <span class="es-caos-resp" data-resp>
            {Array.from({ length: 7 }, () => <span class="es-resp es-resp-mal">500</span>)}
          </span>
        </div>
        <div class="es-caos-carril" data-carril="admin">
          <span class="es-mono es-caos-ruta">/admin <i class="es-candado">🔒</i></span>
          <span class="es-caos-resp" data-resp>
            {Array.from({ length: 7 }, () => <span class="es-resp es-resp-ok">200</span>)}
          </span>
        </div>
        <span class="es-caos-prot es-mono">/admin · {m.caos.protegida}</span>
      </div>
      <div class="es-caos-det es-mono" data-detectado>● {m.caos.detectado}</div>
      <div class="es-caos-pie">
        <span class="es-mono es-tenue">{interpolate(m.caos.ttlNota, { ttl })}</span>
        <span class="es-panico" data-panico>■ {m.caos.panico}</span>
      </div>
    </Fragment>
  )}

  {kind === 'security' && (
    <Fragment>
      <ol class="es-sec-eventos" data-eventos>
        {eventos.map((e) => (
          <li class="es-sec-ev" data-ip={e.ip}>
            <span class={`es-sev es-sev-${e.sev}`}></span>
            <span class="es-sec-cat">{e.cat}</span>
            <span class="es-mono es-tenue">{e.ip}</span>
            <span class="es-mono es-tenue">{e.pais}</span>
          </li>
        ))}
      </ol>
      <div class="es-sec-z">
        <div class="es-etq">{m.security.linea}</div>
        <div class="es-sec-graf" data-grafica>
          <span class="es-sec-techo" style={`bottom:${(anomalia.techo / maxHora) * 100}%`}><i class="es-mono">μ + 3σ</i></span>
          {anomalia.horas.map((h, i) => (
            <span
              class:list={['es-sec-col', { 'es-sec-pico': i === anomalia.horas.length - 1 }]}
              data-col
              style={`height:${(h / maxHora) * 100}%`}
            ></span>
          ))}
          <span class="es-sec-marca es-mono" data-marca-anomalia>{m.security.anomalia} · z = {n(anomalia.z, 1)}</span>
        </div>
      </div>
      <div class="es-sec-esc">
        <span class="es-etq">{m.security.escalera} <span class="es-mono es-tenue">203.0.x.x</span></span>
        <ol class="es-sec-pasos">
          {ESCALERA.map((p) => <li class="es-sec-paso is-on" data-escalon><span class="es-mono">{p}</span></li>)}
        </ol>
        <span class="es-mono es-tenue es-sec-nunca">{m.security.nunca}</span>
      </div>
    </Fragment>
  )}
</div>

<style is:global>
  /* Prefijo `es-` y global: el script mueve estas escenas de su caso a la
     ventana fija y les cambia estados por atributo. */
  .es {
    --es-cyan: #00f2ff;
    --es-lime: #c9ff5b;
    --es-ember: #ff6b3d;
    --es-amber: #fbbf24;
    position: relative;
    display: grid;
    align-content: start;
    gap: 12px;
    font-size: 12.5px;
    color: #e7e7ec;
  }
  .es-mono { font-family: var(--font-mono, ui-monospace, monospace); }
  .es-tenue { color: #6b6b78; }
  .es-etq { font-family: var(--font-mono, ui-monospace, monospace); font-size: 9.5px; letter-spacing: 0.16em; text-transform: uppercase; color: #6b6b78; }
  .es-nota { margin: 0; font-size: 10.5px; color: #6b6b78; }
  .es-nota code { font-family: var(--font-mono, ui-monospace, monospace); color: #85858f; }
  .es-dot { width: 6px; height: 6px; border-radius: 99px; background: var(--es-lime); flex: none; }
  .es-pill { display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 99px; font-family: var(--font-mono, ui-monospace, monospace); font-size: 10px; border: 1px solid; white-space: nowrap; }
  .es-pill-ok { color: var(--es-lime); border-color: rgba(201, 255, 91, 0.3); background: rgba(201, 255, 91, 0.08); }
  .es-pill-mal { color: var(--es-ember); border-color: rgba(255, 107, 61, 0.35); background: rgba(255, 107, 61, 0.08); }
  .es-caja { border-radius: 10px; background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.06); }

  /* Monitores */
  .es-mon-fila { display: grid; gap: 7px; padding: 10px 11px; border-radius: 10px; background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.06); transition: border-color 0.3s ease, background-color 0.3s ease; }
  .es-mon-fila[data-estado='error'] { border-color: rgba(255, 107, 61, 0.45); background: rgba(255, 107, 61, 0.05); }
  .es-mon-fila[data-estado='error'] .es-dot { background: var(--es-ember); box-shadow: 0 0 10px var(--es-ember); }
  .es-mon-cab { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .es-host { font-family: var(--font-mono, ui-monospace, monospace); font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .es-ms { margin-left: auto; font-family: var(--font-mono, ui-monospace, monospace); font-size: 11px; color: #85858f; white-space: nowrap; }
  .es-inc { display: none; padding: 1px 7px; border-radius: 99px; font-family: var(--font-mono, ui-monospace, monospace); font-size: 9.5px; color: var(--es-ember); border: 1px solid rgba(255, 107, 61, 0.35); white-space: nowrap; }
  .es-inc.is-on { display: inline-block; }
  .es-inc.is-cerrado { color: var(--es-lime); border-color: rgba(201, 255, 91, 0.3); }
  .es-checks { display: flex; flex-wrap: wrap; gap: 5px; }
  .es-check { padding: 2px 7px; border-radius: 6px; background: rgba(255, 255, 255, 0.04); font-family: var(--font-mono, ui-monospace, monospace); font-size: 10px; color: #85858f; }
  .es-check b { color: var(--es-lime); font-weight: 500; }
  .es-check.is-mal { background: rgba(255, 107, 61, 0.12); color: #f3c6b8; }
  .es-check.is-mal b { color: var(--es-ember); }
  .es-tira { display: flex; gap: 2px; height: 12px; }
