---
// Pinta un diagrama de actividades UML completo: particiones, transiciones,
// guardas y figuras. El SVG sale ya renderizado desde el servidor - no hay
// JavaScript de diagramas en el cliente.
import { layout, type UmlActivityModel } from '../../lib/uml-activity'
import ActivityShape from './ActivityShape.astro'

interface Props {
  model: UmlActivityModel
}

const { model } = Astro.props
const l = layout(model)

// Cada diagrama necesita su propio id de marcador: dos SVG en la misma página
// compartiendo `url(#flecha)` hacen que el segundo se quede sin punta si el
// primero se retira del DOM.
const uid = `act-${model.id}`
---

<svg
  class="uml-scope block"
  viewBox={`0 0 ${l.w} ${l.h}`}
  width={l.w}
  height={l.h}
  role="img"
  aria-label={`Diagrama de actividades: ${model.titulo}`}
  style={`max-width: ${l.w}px`}
>
  <defs>
    {/* Punta ABIERTA: en UML el flujo de control lleva una V sin rellenar. Un
        triángulo macizo pertenece a otras relaciones y diría otra cosa. */}
    <marker id={`${uid}-punta`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M 1 1 L 9 5 L 1 9" fill="none" stroke="var(--uml-line)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    </marker>
  </defs>

  <rect x="0" y="0" width={l.w} height={l.h} fill="var(--uml-bg)" />

  {/* Particiones: cabecera con el nombre y una divisoria vertical. La calle es
      lo que afirma QUIÉN ejecuta cada acción, así que se dibuja debajo de todo
      pero nunca se omite. */}
  {
    l.particiones.map((p, i) => (
      <g>
        <rect x={p.x1} y="0" width={p.x2 - p.x1} height="46" fill="var(--uml-header)" />
        <text class="uml-particion" x={(p.x1 + p.x2) / 2} y={p.rol ? 19 : 27} text-anchor="middle">
          {p.label}
        </text>
        {p.rol && (
          <text class="uml-particion uml-rol" x={(p.x1 + p.x2) / 2} y="34" text-anchor="middle">
            {p.rol}
          </text>
        )}
        {i > 0 && <line x1={p.x1} y1="0" x2={p.x1} y2={l.h} stroke="var(--uml-border)" stroke-width="1" />}
      </g>
    ))
  }
  <line x1="0" y1="46" x2={l.w} y2="46" stroke="var(--uml-border)" stroke-width="1" />

  {
    l.edges.map((e) => (
      <g>
        <path
          d={e.d}
          fill="none"
          stroke="var(--uml-line)"
          stroke-width="1.4"
          stroke-dasharray={e.kind === 'object' ? '5 4' : undefined}
          marker-end={`url(#${uid}-punta)`}
        />
        {e.guarda && (
          <text class="uml-guarda" x={e.guardAt.x} y={e.guardAt.y} text-anchor={e.guardAlign} dominant-baseline="central">
            [{e.guarda}]
          </text>
        )}
      </g>
    ))
  }

  {l.nodes.map((n) => <ActivityShape node={n} />)}
</svg>
