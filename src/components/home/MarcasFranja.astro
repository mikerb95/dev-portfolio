---
// Franja de marcas de la portada: los logos de los clientes en una fila, entre
// la cinta del pulso y el bento. Es una prueba de confianza, no una sección
// protagonista: ocupa lo justo para leerse y dejar pasar al resto de la página.
//
// Cada logo enlaza al sitio de la marca; lo que se hizo con ella va en el
// `title` (tooltip nativo) y en el nombre accesible, sin fichas ni JS.
import { getDictionary, getLocaleFromUrl } from '../../i18n'
import { MARCAS } from '../../data/marcas'
import { tamOptico } from '../../lib/marcas-logos'

// Alto base del logo cuadrado; los alargados salen más bajos y más anchos.
const BASE = 54
const BASE_MOVIL = 40

const locale = getLocaleFromUrl(Astro.url.pathname)
const t = getDictionary(locale).home.marcas

const items = MARCAS.map((m) => {
  const a = tamOptico(m.proporcion, BASE)
  const b = tamOptico(m.proporcion, BASE_MOVIL)
  const ficha = t.fichas[m.slug]
  return {
    ...m,
    ficha,
    estilo: `--w:${a.ancho.toFixed(1)}px;--h:${a.alto.toFixed(1)}px;--wm:${b.ancho.toFixed(1)}px;--hm:${b.alto.toFixed(1)}px`,
  }
})
---

<section id="marcas" class="px-6 md:px-12 lg:px-20 py-12 md:py-14" aria-labelledby="marcas-titulo">
  <div class="max-w-[1280px] mx-auto">
    <h2 id="marcas-titulo" class="text-[11px] font-mono uppercase tracking-[.18em] text-ink-300 text-center mb-8 md:mb-10">
      {t.titulo}
    </h2>
    <ul class="marcas-fila">
      {items.map((m) => (
        <li>
          <a
            class="marca"
            href={m.url}
            target="_blank"
            rel="noopener"
            title={m.ficha}
            aria-label={`${m.nombre}: ${m.ficha}`}
            style={m.estilo}
          >
            <img src={m.logo} alt="" width={Math.round(m.proporcion * 100)} height="100" decoding="async" loading="lazy" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .marcas-fila {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    row-gap: 2rem;
    align-items: center;
    justify-items: center;
  }
  @media (min-width: 768px) {
    .marcas-fila {
      display: flex;
      justify-content: space-between;
      gap: 2.5rem;
    }
  }

  .marca {
    display: block;
    width: var(--wm);
    height: var(--hm);
    border-radius: 6px;
    opacity: 0.55;
    filter: grayscale(1);
    transition:
      opacity 0.25s ease,
      filter 0.25s ease;
  }
  @media (min-width: 768px) {
    .marca {
      width: var(--w);
      height: var(--h);
    }
  }
  .marca:hover,
  .marca:focus-visible {
    opacity: 1;
    filter: none;
  }
  .marca:focus-visible {
    outline: 2px solid rgb(34 211 238 / 0.7);
    outline-offset: 6px;
  }
  .marca img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
