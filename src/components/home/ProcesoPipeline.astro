---
// "Cómo trabajo" como un pipeline de CI que se recorre con el scroll.
//
// La sección se fija en pantalla (escritorio) y el scroll hace avanzar un
// paquete de luz por la pista: al alcanzar cada etapa, esta pasa de "en cola" a
// "en curso", y la anterior a "listo", como los jobs de un pipeline real. Al
// final el trazado sale a producción. Es la misma metáfora del HUD lateral
// ("pipeline") y del resto del sitio, no un carrusel de cuatro tarjetas.
//
// En móvil la pista es vertical y avanza con el scroll sin fijar la sección.
// Sin JS, o con movimiento reducido, las cuatro etapas se muestran completas y
// quietas: la animación cuenta el proceso, pero el texto es el contenido.
import { getDictionary, getLocaleFromUrl } from '../../i18n'

const t = getDictionary(getLocaleFromUrl(Astro.url.pathname)).home.proceso
---

<section id="proceso" class="section-tint border-t border-white/5">
  <div class="proceso-escena px-6 md:px-12 lg:px-20 py-24">
    <div class="max-w-[1280px] mx-auto w-full">
      <div data-etiqueta class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-6">
        <span class="text-cyan">/03</span>
        <span class="h-px flex-1 bg-gradient-to-r from-white/15 to-transparent max-w-[80px]"></span>
        <span>{t.sectionLabel}</span>
      </div>
      <h2 data-titular class="font-sans text-4xl md:text-5xl font-medium tracking-[-.025em] text-mask max-w-2xl leading-[1.05]">
        {t.title}
      </h2>

      <div
        class="proceso-pista"
        data-estados={JSON.stringify(t.estados)}
        data-consola={t.consola}
        data-desplegado={t.desplegado}
      >
        <svg class="proceso-svg" aria-hidden="true">
          <defs>
            <radialGradient id="proceso-halo">
              <stop offset="0%" stop-color="#9bfaff" stop-opacity="0.95"></stop>
              <stop offset="35%" stop-color="#00f2ff" stop-opacity="0.45"></stop>
              <stop offset="100%" stop-color="#00f2ff" stop-opacity="0"></stop>
            </radialGradient>
          </defs>
          <path class="proceso-base"></path>
          <path class="proceso-brillo"></path>
          <path class="proceso-avance"></path>
          <g class="proceso-paquete">
            <circle r="16" fill="url(#proceso-halo)"></circle>
            <circle r="3.5" fill="#fff"></circle>
          </g>
        </svg>

        <ol class="proceso-etapas">
          {t.steps.map((s, i) => (
            <li class="proceso-etapa">
              <span class="proceso-nodo" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
              </span>
              <div class="proceso-meta">
                <span class="text-cyan">/{String(i + 1).padStart(2, '0')}</span>
                <span>{s.time}</span>
                <span class="proceso-estado" aria-hidden="true"></span>
              </div>
              <h3 class="proceso-titulo">{s.t}</h3>
              <p class="proceso-desc">{s.d}</p>
            </li>
          ))}
        </ol>

        <span class="proceso-salida" aria-hidden="true">
          <span class="proceso-salida-punto"></span>
          {t.desplegado}
        </span>
      </div>

      <p class="proceso-consola" aria-hidden="true">
        <span class="text-ink-300">$</span>
        <span class="proceso-consola-txt"></span>
        <span class="proceso-cursor"></span>
      </p>
    </div>
  </div>
</section>

<style>
  .proceso-escena {
    position: relative;
  }
  @media (min-width: 1024px) {
    .proceso-escena {
      min-height: 100vh;
      display: flex;
      align-items: center;
    }
  }

  .proceso-pista {
    position: relative;
    margin-top: 4rem;
  }
  .proceso-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .proceso-base {
    fill: none;
    stroke: rgba(255, 255, 255, 0.12);
    stroke-width: 1.5;
    stroke-dasharray: 2 6;
    stroke-linecap: round;
  }
  .proceso-avance,
  .proceso-brillo {
    fill: none;
    stroke: var(--color-cyan);
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .proceso-avance {
    stroke-width: 2;
  }
  /* Resplandor: la misma ruta más gruesa y translúcida por debajo. Un filtro
     de desenfoque haría lo mismo, pero se recalcula en cada fotograma. */
  .proceso-brillo {
    stroke-width: 9;
    stroke-opacity: 0.14;
  }
  .proceso-paquete {
    opacity: 0;
  }

  .proceso-etapas {
    position: relative;
    display: grid;
    gap: 2.75rem;
    padding-left: 3rem;
  }
  @media (min-width: 1024px) {
    .proceso-etapas {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 2.5rem;
      padding-left: 0;
      padding-top: 3.25rem;
    }
  }

  .proceso-etapa {
    position: relative;
  }
  .proceso-nodo {
    position: absolute;
    left: -3rem;
    top: 0.1rem;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    margin-left: 0;
    border-radius: 999px;
    background: var(--color-ink-950);
    border: 1.5px solid rgba(255, 255, 255, 0.22);
    color: transparent;
    transition:
      border-color 0.4s ease,
      background-color 0.4s ease,
      color 0.4s ease,
      box-shadow 0.4s ease;
  }
  @media (min-width: 1024px) {
    .proceso-nodo {
      left: 0;
      top: -3.25rem;
      transform: translateY(-50%);
    }
  }
  .proceso-nodo svg {
    width: 12px;
    height: 12px;
  }

  .proceso-meta {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ink-300);
  }
  .proceso-estado {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .proceso-titulo {
    margin-top: 1.1rem;
    font-size: 1.6rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-ink-50);
    transition: color 0.5s ease;
  }
  .proceso-desc {
    margin-top: 0.6rem;
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--color-ink-200);
    max-width: 30ch;
    transition:
      color 0.5s ease,
      opacity 0.5s ease;
  }

  /* ── Estados (los pone el script; sin script no hay atributo y todo se ve
     como terminado, legible y sin atenuar) ── */
  .proceso-etapa[data-estado='pendiente'] .proceso-titulo {
    color: var(--color-ink-300);
  }
  .proceso-etapa[data-estado='pendiente'] .proceso-desc {
    opacity: 0.35;
  }
  .proceso-etapa[data-estado='corriendo'] .proceso-nodo {
    border-color: var(--color-cyan);
    background: rgba(0, 242, 255, 0.12);
    box-shadow: 0 0 0 6px rgba(0, 242, 255, 0.08), 0 0 22px rgba(0, 242, 255, 0.45);
    animation: procesoLatido 1.4s ease-in-out infinite;
  }
  .proceso-etapa[data-estado='corriendo'] .proceso-titulo {
    color: #fff;
  }
  .proceso-etapa[data-estado='corriendo'] .proceso-desc {
    color: var(--color-ink-100);
  }
  .proceso-etapa[data-estado='corriendo'] .proceso-estado {
    color: var(--color-cyan);
  }
  .proceso-etapa[data-estado='corriendo'] .proceso-estado::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: currentColor;
    animation: pulseDot 1s ease-in-out infinite;
  }
  .proceso-etapa[data-estado='listo'] .proceso-nodo {
    border-color: var(--color-lime);
    background: var(--color-lime);
    color: var(--color-ink-950);
  }
  .proceso-etapa[data-estado='listo'] .proceso-estado {
    color: var(--color-lime);
  }
  @keyframes procesoLatido {
    0%,
    100% {
      box-shadow: 0 0 0 5px rgba(0, 242, 255, 0.1), 0 0 18px rgba(0, 242, 255, 0.4);
    }
    50% {
      box-shadow: 0 0 0 10px rgba(0, 242, 255, 0.03), 0 0 30px rgba(0, 242, 255, 0.6);
    }
  }

  /* Salida a producción al final de la pista: solo en fila (escritorio), que
     es donde la pista tiene un final a la derecha. */
  .proceso-salida {
    display: none;
  }
  @media (min-width: 1024px) {
    .proceso-salida {
      position: absolute;
      right: 0;
      top: -1.9rem;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--color-ink-300);
      transition: color 0.5s ease;
    }
  }
  .proceso-salida-punto {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: currentColor;
  }
  .proceso-pista[data-fin] .proceso-salida {
    color: var(--color-lime);
  }

  .proceso-consola {
    display: none;
  }
  :global(.proceso-vivo) .proceso-consola {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 3.5rem;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    color: var(--color-ink-200);
  }
  .proceso-cursor {
    width: 7px;
    height: 14px;
    background: var(--color-cyan);
    animation: pulseDot 1s steps(2) infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .proceso-etapa[data-estado='corriendo'] .proceso-nodo {
      animation: none;
    }
  }
</style>

<script>
  import gsap from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { estadosEtapas, trazadoHorizontal, trazadoVertical, type Trazado } from '../../lib/motion/pipeline'
  import { interpolate } from '../../i18n/format'

  gsap.registerPlugin(ScrollTrigger)

  const seccion = document.getElementById('proceso')
  const escena = seccion?.querySelector<HTMLElement>('.proceso-escena')
  const pista = seccion?.querySelector<HTMLElement>('.proceso-pista')
  const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  if (seccion && escena && pista && !reducido) {
    try {
      montar(seccion, escena, pista)
    } catch (err) {
      // Fail-open: sin animación las etapas quedan con su estilo neutro, que
      // es el legible.
      console.warn('[proceso] pipeline sin animar', err)
      pista.querySelectorAll('.proceso-etapa').forEach((e) => e.removeAttribute('data-estado'))
    }
  }

  function montar(seccion: HTMLElement, escena: HTMLElement, pista: HTMLElement) {
    const svg = pista.querySelector<SVGSVGElement>('.proceso-svg')!
    const base = svg.querySelector<SVGPathElement>('.proceso-base')!
    const avance = svg.querySelector<SVGPathElement>('.proceso-avance')!
    const brillo = svg.querySelector<SVGPathElement>('.proceso-brillo')!
    const paquete = svg.querySelector<SVGGElement>('.proceso-paquete')!
    const etapas = Array.from(pista.querySelectorAll<HTMLElement>('.proceso-etapa'))
    const nodos = etapas.map((e) => e.querySelector<HTMLElement>('.proceso-nodo')!)
    const consola = seccion.querySelector<HTMLElement>('.proceso-consola-txt')
    const textos = JSON.parse(pista.dataset.estados ?? '{}') as Record<string, string>
    const plantilla = pista.dataset.consola ?? ''
    const desplegado = pista.dataset.desplegado ?? ''

    seccion.classList.add('proceso-vivo')

    let trazado: Trazado = { d: '', total: 0, nodos: [] }
    let progreso = 0

    // Se mide contra la pista: los centros de los nodos pasan a coordenadas del
    // SVG, que ocupa exactamente la misma caja.
    const medir = () => {
      const caja = pista.getBoundingClientRect()
      const centros = nodos.map((n) => {
        const r = n.getBoundingClientRect()
        return { x: r.left + r.width / 2 - caja.left, y: r.top + r.height / 2 - caja.top }
      })
      const enFila = window.matchMedia('(min-width: 1024px)').matches
      trazado = enFila
        ? trazadoHorizontal(centros, -24, caja.width)
        : trazadoVertical(centros, centros[0].y - 24, centros[centros.length - 1].y + 8)
      for (const p of [base, avance, brillo]) p.setAttribute('d', trazado.d)
      avance.style.strokeDasharray = brillo.style.strokeDasharray = `${trazado.total}`
      pintar()
    }

    let ultimoEstado = ''
    const pintar = () => {
      const recorrido = trazado.total * progreso
      const offset = `${trazado.total - recorrido}`
      avance.style.strokeDashoffset = brillo.style.strokeDashoffset = offset

      if (trazado.total > 0) {
        const p = avance.getPointAtLength(Math.max(0, Math.min(recorrido, trazado.total)))
        paquete.setAttribute('transform', `translate(${p.x.toFixed(1)} ${p.y.toFixed(1)})`)
        // El paquete solo existe mientras viaja: parado en el origen o en la
        // meta sería un punto más, no un paquete en tránsito.
        paquete.style.opacity = progreso > 0.005 && progreso < 0.995 ? '1' : '0'
      }

      const estados = estadosEtapas(recorrido, trazado)
      const firma = estados.join()
      if (firma === ultimoEstado) return
      ultimoEstado = firma
      estados.forEach((e, i) => {
        etapas[i].dataset.estado = e
        const etiqueta = etapas[i].querySelector('.proceso-estado')
        if (etiqueta) etiqueta.textContent = textos[e] ?? ''
      })
      const fin = estados.every((e) => e === 'listo')
      pista.toggleAttribute('data-fin', fin)
      if (consola) {
        const n = estados.filter((e) => e !== 'pendiente').length
        consola.textContent = fin
          ? `${interpolate(plantilla, { n: estados.length, total: estados.length })} · ✓ ${desplegado}`
          : `${interpolate(plantilla, { n, total: estados.length })} · ${textos[estados[Math.max(0, n - 1)]] ?? ''}`
      }
    }

    medir()
    // Las fuentes cambian el alto de los títulos y con él la posición de los
    // nodos en móvil: se vuelve a medir cuando terminan de cargar.
    document.fonts?.ready.then(medir)

    const estado = { p: 0 }
    const mm = gsap.matchMedia()
    mm.add(
      {
        fila: '(min-width: 1024px) and (min-height: 640px)',
        columna: '(max-width: 1023px), (max-height: 639px)',
      },
      (ctx) => {
        const { fila } = ctx.conditions as { fila: boolean }
        medir()
        gsap.to(estado, {
          p: 1,
          ease: 'none',
          onUpdate: () => {
            progreso = estado.p
            pintar()
          },
          scrollTrigger: fila
            ? {
                // Fijada durante un recorrido y medio de pantalla: lo bastante
                // para leer cada etapa al pasar, no tanto como para que el
                // scroll parezca atascado.
                trigger: escena,
                start: 'top top',
                end: () => `+=${Math.round(window.innerHeight * 1.5)}`,
                pin: true,
                scrub: 0.8,
                invalidateOnRefresh: true,
                onRefresh: medir,
              }
            : {
                trigger: pista,
                start: 'top 75%',
                end: 'bottom 45%',
                scrub: 0.8,
                onRefresh: medir,
              },
        })
      },
    )
  }
</script>
