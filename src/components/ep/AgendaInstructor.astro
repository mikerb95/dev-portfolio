---
// Bitácora pública de la agenda del instructor (Microsoft Bookings). /ep es
// prerenderizada, así que los datos llegan desde /api/ep-agenda en el
// navegador; lo que se pinta en el build es solo el esqueleto y el método.
// Lógica y razones en src/lib/ep-agenda.ts.
//
// El orden responde a lo que un aprendiz viene a preguntar: ¿hay cita ahora?
// (la frase grande), ¿cómo va la semana? (el calendario con el horario real
// del instructor) y, solo si quiere el detalle, las tablas, plegadas.
import { AVISO_APRENDICES, RETRASO_APRENDICES_MIN, URL_RESERVA } from '../../lib/ep-agenda'

const LEYENDA = [
  { estado: 'libre', texto: 'Libre ahora' },
  { estado: 'se-abrio', texto: 'Se abrió y la tomaron' },
  { estado: 'sin-abrir', texto: 'Nunca se abrió' },
  { estado: 'por-abrir', texto: 'Aún no se puede reservar' },
  { estado: 'sin-datos', texto: 'Antes del monitor' },
]
---

<section id="agenda" class="rounded-2xl glass p-6 md:p-7 mb-4 scroll-mt-28" data-agenda>
  <div class="flex items-center gap-2 mb-5">
    <span class="w-1.5 h-1.5 rounded-full bg-cyan"></span>
    <span class="text-[11px] font-mono uppercase tracking-[.15em] text-ink-100">Agenda del instructor</span>
  </div>

  <!-- Lo que se viene a preguntar: ¿hay cita ahora? -->
  <div class="grid lg:grid-cols-[minmax(0,1fr)_auto] gap-x-8 gap-y-4 lg:items-end mb-8">
    <div>
      <p class="flex items-center gap-3 text-2xl md:text-3xl font-medium tracking-[-.02em] text-ink-50">
        <span data-agenda-punto class="w-2.5 h-2.5 rounded-full bg-ink-400 shrink-0"></span>
        <span data-agenda-titular>Revisando la agenda…</span>
      </p>
      <p data-agenda-libres class="hidden mt-2 text-[14px] font-mono text-lime"></p>
      <a
        data-agenda-reservar
        href={URL_RESERVA}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden mt-3 h-9 px-4 items-center gap-2 rounded-full bg-lime text-ink-950 text-[13px] font-medium hover:opacity-90 transition-opacity"
      >
        Reservar en Bookings ↗
      </a>
      <p data-agenda-revision class="mt-3 text-[12px] font-mono text-ink-300"></p>
    </div>
    <div class="rounded-xl bg-white/[.03] px-4 py-3 max-w-sm">
      <p class="text-[12px] text-ink-100 leading-relaxed">
        Aviso al celular cuando se abre una cita: instala la app <span class="text-ink-50">ntfy</span> y suscríbete a{' '}
        <span class="font-mono text-cyan whitespace-nowrap">{AVISO_APRENDICES.topic}</span>.
      </p>
      <p class="mt-1 text-[11px] text-ink-300 leading-relaxed">
        El aviso llega {RETRASO_APRENDICES_MIN} min después de que la cita se abre. Esta página la muestra en cuanto el monitor la ve.
      </p>
    </div>
  </div>

  <!-- ¿Cómo va la semana? Una casilla por cita del horario real del instructor. -->
  <div data-agenda-calendario class="grid gap-8 mb-6"></div>

  <ul class="flex flex-wrap gap-x-5 gap-y-2 mb-8 text-[11px] text-ink-200">
    {LEYENDA.map((l) => (
      <li class="inline-flex items-center gap-2">
        <span class={`ep-celda ep-celda--${l.estado} w-3 h-3`}></span>
        {l.texto}
      </li>
    ))}
  </ul>

  <!-- El detalle, para quien lo quiera. -->
  <div class="grid gap-2">
    <details class="ep-pliegue group rounded-xl bg-white/[.02]">
      <summary class="cursor-pointer list-none px-4 py-3 text-[13px] text-ink-100 flex items-center justify-between gap-3">
        Semanas que ya terminaron
        <span class="text-ink-300 transition-transform group-open:rotate-90">›</span>
      </summary>
      <ul data-agenda-semanas class="px-4 pb-4 grid gap-3 text-[13px] text-ink-200 leading-relaxed max-w-3xl">
        <li class="text-ink-300">Cargando…</li>
      </ul>
    </details>

    <details class="ep-pliegue group rounded-xl bg-white/[.02]">
      <summary class="cursor-pointer list-none px-4 py-3 text-[13px] text-ink-100 flex items-center justify-between gap-3">
        Historial cita por cita
        <span class="text-ink-300 transition-transform group-open:rotate-90">›</span>
      </summary>
      <div class="px-4 pb-4 overflow-x-auto">
        <table class="w-full min-w-[620px] text-[12px]">
          <thead>
            <tr class="text-left text-[10px] font-mono uppercase tracking-wider text-ink-300">
              <th class="py-2 pr-3 font-normal">Cita</th>
              <th class="py-2 pr-3 font-normal">Se abrió</th>
              <th class="py-2 pr-3 font-normal">Cómo</th>
              <th class="py-2 pr-3 font-normal">Se tomó</th>
              <th class="py-2 pr-3 font-normal text-right">Estuvo libre</th>
              <th class="py-2 font-normal">Estado</th>
            </tr>
          </thead>
          <tbody data-agenda-episodios>
            <tr><td colspan="6" class="py-3 text-ink-300">Cargando…</td></tr>
          </tbody>
        </table>
      </div>
    </details>

    <details class="ep-pliegue group rounded-xl bg-white/[.02]">
      <summary class="cursor-pointer list-none px-4 py-3 text-[13px] text-ink-100 flex items-center justify-between gap-3">
        ¿Cómo funciona?
        <span class="text-ink-300 transition-transform group-open:rotate-90">›</span>
      </summary>
      <div class="px-4 pb-4 grid gap-2 text-[12px] text-ink-200 leading-relaxed max-w-3xl">
        <p>
          Las reuniones de seguimiento se agendan en el sistema de reservas del instructor, que solo muestra los
          espacios libres en el momento en que alguien lo abre. Un programa lo consulta solo y anota cuándo aparece
          cada cita libre y cuándo deja de estarlo.
        </p>
        <p>
          Se consulta cada 10 minutos, y cada minuto los lunes, martes y miércoles de 8:00 a 12:00 y de 0:00 a 1:00,
          que es cuando se abren las citas nuevas (8 días antes de cada una). La precisión es de un minuto: una cita
          tomada en segundos aparece como "1 min".
        </p>
        <p>
          Solo se registra cuándo aparece y desaparece cada cita: el sistema no dice quién reserva y aquí tampoco. Una
          cita que "nunca se abrió" no se vio libre en ninguna consulta: pudo estar reservada o bloqueada. Las
          casillas "antes del monitor" son citas que se abrieron cuando el programa todavía no existía.
        </p>
      </div>
    </details>
  </div>
</section>

<!-- Global a propósito: el script crea las casillas del calendario, y un
     estilo acotado de Astro no llega a nodos que no salieron de la plantilla. -->
<style is:global>
  .ep-celda {
    display: inline-block;
    border-radius: 4px;
  }
  .ep-celda--libre {
    background: var(--color-lime);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-lime) 25%, transparent);
  }
  .ep-celda--se-abrio {
    background: color-mix(in srgb, var(--color-cyan) 55%, transparent);
  }
  .ep-celda--sin-abrir {
    background: color-mix(in srgb, var(--color-ember) 55%, transparent);
  }
  .ep-celda--por-abrir {
    border: 1px dashed rgb(255 255 255 / 0.22);
  }
  .ep-celda--sin-datos {
    background: rgb(255 255 255 / 0.07);
  }
  .ep-pliegue summary::-webkit-details-marker {
    display: none;
  }
</style>

<script>
  import {
    fmtCita,
    fmtDuracion,
    proximaRevision,
    type EstadoCelda,
    type Episodio,
    type Semana,
    type SemanaCalendario,
  } from '../../lib/ep-agenda'

  type Datos = {
    ok: boolean
    revisadoEn: number | null
    conError: boolean
    libres: number[]
    semanas: Semana[]
    calendario: SemanaCalendario[]
    episodios: Episodio[]
  }

  const COMO: Record<string, string> = { apertura: 'Al abrirse la semana', liberada: 'Alguien la liberó', previa: 'Ya libre al iniciar' }
  const ESTADO: Record<string, string> = { ocupada: 'Tomada', vencio: 'Venció sin tomarse' }
  const TEXTO_CELDA: Record<EstadoCelda, string> = {
    libre: 'libre ahora',
    'se-abrio': 'se abrió y la tomaron',
    'sin-abrir': 'nunca se abrió',
    'por-abrir': 'aún no se puede reservar',
    'sin-datos': 'se abrió antes del monitor',
  }
  const ORDEN_CONTEO: EstadoCelda[] = ['libre', 'se-abrio', 'sin-abrir', 'por-abrir', 'sin-datos']
  const CONTEO: Record<EstadoCelda, [string, string]> = {
    libre: ['libre ahora', 'libres ahora'],
    'se-abrio': ['se abrió y la tomaron', 'se abrieron y las tomaron'],
    'sin-abrir': ['nunca se abrió', 'nunca se abrieron'],
    'por-abrir': ['aún no se puede reservar', 'aún no se pueden reservar'],
    'sin-datos': ['se abrió antes del monitor', 'se abrieron antes del monitor'],
  }
  const DIA_MS = 86_400_000
  const plural = (n: number, uno: string, varios: string) => `${n} ${n === 1 ? uno : varios}`

  const raiz = document.querySelector<HTMLElement>('[data-agenda]')
  const $ = <T extends HTMLElement>(sel: string) => raiz?.querySelector<T>(sel) ?? null

  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, clase = '', texto?: string) => {
    const n = document.createElement(tag)
    if (clase) n.className = clase
    if (texto !== undefined) n.textContent = texto
    return n
  }
  const celda = (texto: string, clase = '') => el('td', `py-2 pr-3 border-t border-white/[.06] ${clase}`, texto)
  const fila = (celdas: HTMLElement[]) => {
    const tr = el('tr')
    tr.append(...celdas)
    return tr
  }
  const vacia = (tbody: HTMLElement | null, cols: number, texto: string) => {
    if (!tbody) return
    const td = celda(texto, 'text-ink-300')
    td.colSpan = cols
    tbody.replaceChildren(fila([td]))
  }

  // fmtCita da "mar 10 nov, 8:00": de ahí salen el día y la hora sin otro formateador.
  const soloDia = (ms: number) => fmtCita(ms).split(',')[0]
  const soloHora = (ms: number) => fmtCita(ms).split(', ')[1]
  const fmtSemana = (lunes: number) => {
    const [d1, m1] = soloDia(lunes).split(' ').slice(1)
    const [d2, m2] = soloDia(lunes + 4 * DIA_MS).split(' ').slice(1)
    return m1 === m2 ? `${d1} al ${d2} ${m2}` : `${d1} ${m1} al ${d2} ${m2}`
  }
  const hace = (ms: number) => {
    const min = Math.max(0, Math.round((Date.now() - ms) / 60_000))
    return min < 1 ? 'hace menos de 1 min' : `hace ${fmtDuracion(min)}`
  }

  function pintarTitular(d: Datos) {
    const punto = $('[data-agenda-punto]')
    const titular = $('[data-agenda-titular]')
    const libres = $('[data-agenda-libres]')
    const reservar = $('[data-agenda-reservar]')
    const revision = $('[data-agenda-revision]')

    // Más de 20 min sin consultar es una avería del monitor, no una semana sin
    // citas: el titular no puede decir "no hay" si nadie está mirando.
    const fresco = d.revisadoEn !== null && Date.now() - d.revisadoEn < 20 * 60_000 && !d.conError
    const hay = d.libres.length > 0

    if (titular) {
      titular.textContent = !fresco
        ? 'El monitor no está revisando ahora'
        : hay
          ? d.libres.length === 1 ? 'Hay 1 cita libre' : `Hay ${d.libres.length} citas libres`
          : 'No hay citas libres'
    }
    if (punto) punto.className = `w-2.5 h-2.5 rounded-full shrink-0 ${!fresco ? 'bg-ember' : hay ? 'bg-lime' : 'bg-ink-400'}`
    if (libres) {
      libres.classList.toggle('hidden', !hay)
      libres.textContent = d.libres.map(fmtCita).join(' · ')
    }
    if (reservar) {
      reservar.classList.toggle('hidden', !hay)
      reservar.classList.toggle('inline-flex', hay)
    }
    if (revision) {
      revision.textContent = d.revisadoEn
        ? `Revisado ${hace(d.revisadoEn)} · próxima revisión a las ${soloHora(proximaRevision(Date.now()))}`
        : 'El monitor aún no ha hecho su primera revisión'
    }
  }

  function pintarCalendario(semanas: SemanaCalendario[]) {
    const cont = $('[data-agenda-calendario]')
    if (!cont) return
    cont.replaceChildren(
      ...semanas.map((s) => {
        const bloque = el('div')
        const cab = el('div', 'mb-3')
        cab.append(el('p', 'text-[14px] font-mono text-ink-50 mb-1.5', `Semana del ${fmtSemana(s.lunes)}`))
        // Un conteo por color, con la misma casilla de la leyenda: así cada
        // número se lee igual que el calendario de abajo, sin porcentajes ni
        // "N de M" que obliguen a adivinar de qué total se habla.
        const conteos = el('p', 'flex flex-wrap gap-x-4 gap-y-1 text-[12px] text-ink-200')
        for (const estado of ORDEN_CONTEO) {
          const n = s.citas.filter((c) => c.estado === estado).length
          if (n === 0) continue
          const item = el('span', 'inline-flex items-center gap-1.5')
          item.append(el('span', `ep-celda ep-celda--${estado} w-2.5 h-2.5`), `${n} ${n === 1 ? CONTEO[estado][0] : CONTEO[estado][1]}`)
          conteos.append(item)
        }
        cab.append(conteos)

        // Columnas = horas del horario de esa semana; filas = días con citas.
        const minutoDia = (c: number) => c - (Math.floor((c - 5 * 3_600_000) / DIA_MS) * DIA_MS + 5 * 3_600_000)
        const horas = [...new Set(s.citas.map((c) => minutoDia(c.cita)))].sort((a, b) => a - b)
        const dias = [...new Set(s.citas.map((c) => c.cita - minutoDia(c.cita)))].sort((a, b) => a - b)
        const porClave = new Map(s.citas.map((c) => [c.cita, c.estado]))

        const grid = el('div', 'grid gap-1 items-center')
        grid.style.gridTemplateColumns = `3.25rem repeat(${horas.length}, minmax(0, 2.25rem))`
        grid.append(el('span'))
        for (const h of horas) grid.append(el('span', 'text-[9px] sm:text-[10px] font-mono text-ink-300 text-center', soloHora(dias[0] + h)))
        for (const d of dias) {
          grid.append(el('span', 'text-[11px] font-mono text-ink-200', soloDia(d).split(' ').slice(0, 2).join(' ')))
          for (const h of horas) {
            const estado = porClave.get(d + h)
            if (!estado) {
              grid.append(el('span'))
              continue
            }
            const c = el('span', `ep-celda ep-celda--${estado} h-6 w-full`)
            c.title = `${fmtCita(d + h)} · ${TEXTO_CELDA[estado]}`
            c.setAttribute('role', 'img')
            c.setAttribute('aria-label', c.title)
            grid.append(c)
          }
        }
        bloque.append(cab, grid)
        return bloque
      })
    )
  }

  // Primero lo que no se pudo ver (antes del monitor), después lo que sí: así
  // cada número dice de qué total sale y no hay ceros sueltos.
  function fraseSemana(s: Semana): string {
    const antes = s.total - s.delHorario
    const partes = [`El instructor tenía ${plural(s.total, 'cita', 'citas')} en su horario.`]
    if (antes > 0) {
      partes.push(
        antes === s.total
          ? 'Todas se abrieron antes de que existiera el monitor, así que no se sabe qué pasó con ellas.'
          : `${plural(antes, 'se abrió', 'se abrieron')} antes de que existiera el monitor, así que no se sabe qué pasó con ${antes === 1 ? 'ella' : 'ellas'}.`
      )
    }
    if (s.delHorario === 0) return partes.join(' ')

    const de = antes === 0 ? 'De todas' : s.delHorario === 1 ? 'De la restante' : `De las ${s.delHorario} restantes`
    const libres =
      s.seAbrieron === 0
        ? ''
        : s.seAbrieron === 1
          ? `1 se vio libre${s.medianaLibreMin === null ? '' : ` y duró así ${fmtDuracion(s.medianaLibreMin)}`}`
          : `${s.seAbrieron} se vieron libres${s.medianaLibreMin === null ? '' : ` y por lo general duraron así ${fmtDuracion(s.medianaLibreMin)}`}`
    const nunca =
      s.sinAbrirse === 0 ? '' : s.seAbrieron === 0 ? 'ninguna se abrió nunca' : plural(s.sinAbrirse, 'nunca se abrió', 'nunca se abrieron')
    partes.push(`${de}, ${[libres, nunca].filter(Boolean).join(' y ')}.`)
    return partes.join(' ')
  }

  function pintarTablas(d: Datos) {
    const semanas = $('[data-agenda-semanas]')
    if (semanas) {
      // Solo semanas cerradas: las que siguen en curso ya están en el
      // calendario, y un resumen a medias ("1 cita vigilada") confunde más de
      // lo que informa.
      const terminadas = d.semanas.filter((s) => s.lunes + 7 * DIA_MS <= Date.now())
      semanas.replaceChildren(
        ...(terminadas.length === 0
          ? [el('li', 'text-ink-300', 'Todavía no termina ninguna semana con el monitor funcionando. Cuando termine cada una, aquí queda su resumen.')]
          : terminadas.map((s) => {
              const li = el('li')
              li.append(el('span', 'font-mono text-ink-50', `Semana del ${fmtSemana(s.lunes)}. `), fraseSemana(s))
              return li
            }))
      )
    }

    const episodios = $('[data-agenda-episodios]')
    if (episodios) {
      if (d.episodios.length === 0) vacia(episodios, 6, 'Ninguna cita se ha visto libre todavía.')
      else
        episodios.replaceChildren(
          ...d.episodios.map((e) => {
            const fin = e.cerradaEn ?? Date.now()
            const estado = e.cierre ? ESTADO[e.cierre] ?? e.cierre : 'Libre ahora'
            return fila([
              celda(fmtCita(e.cita), 'font-mono text-ink-50 whitespace-nowrap'),
              celda(fmtCita(e.abiertaEn), 'font-mono text-ink-100 whitespace-nowrap'),
              celda(COMO[e.como] ?? e.como, 'text-ink-200'),
              celda(e.cerradaEn ? fmtCita(e.cerradaEn) : '-', 'font-mono text-ink-100 whitespace-nowrap'),
              celda(fmtDuracion((fin - e.abiertaEn) / 60_000), 'text-right font-mono text-ink-100'),
              celda(estado, `pr-0 ${e.cierre ? 'text-ink-200' : 'text-lime'}`),
            ])
          })
        )
    }
  }

  async function cargar() {
    try {
      const res = await fetch('/api/ep-agenda')
      const d = (await res.json()) as Datos
      if (!d.ok) throw new Error('sin datos')
      pintarTitular(d)
      pintarCalendario(d.calendario ?? [])
      pintarTablas(d)
    } catch {
      const titular = $('[data-agenda-titular]')
      if (titular) titular.textContent = 'No se pudo leer la agenda'
      $('[data-agenda-semanas]')?.replaceChildren(el('li', 'text-ink-300', 'No se pudo leer la bitácora.'))
      vacia($('[data-agenda-episodios]'), 6, 'No se pudo leer la bitácora.')
    }
  }

  if (raiz) {
    cargar()
    // Quien deja la página abierta esperando una cita la ve aparecer sin
    // recargar. El endpoint va con un minuto de CDN, así que esto no le suma
    // lecturas a Turso por más pestañas abiertas que haya.
    setInterval(() => {
      if (document.visibilityState === 'visible') cargar()
    }, 60_000)
  }
</script>
