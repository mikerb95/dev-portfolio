---
// "La decisión, en corto" al inicio de cada artículo: las mismas tres líneas
// de su ficha en el hero de /notes, para quien quiere el resumen antes de
// leer. Quieta y completa desde el servidor; con JS, al entrar en pantalla la
// opción descartada se tacha y la elegida aparece, el mismo gesto de la ficha.
import { getDictionary, getLocaleFromUrl } from '../../i18n'

interface Props {
  decision: { problem: string; rejected: string; chosen: string }
  color: string
}

const { decision, color } = Astro.props
const locale = getLocaleFromUrl(Astro.url.pathname)
const t = getDictionary(locale).notes.motion
---

<aside class="dc" aria-label={t.lectura.decision} style={`--dc:${color}`}>
  <p class="dc-cab">{t.lectura.decision}</p>
  <dl class="dc-filas">
    <div class="dc-fila">
      <dt>{t.ficha.problema}</dt>
      <dd class="dc-problema">{decision.problem}</dd>
    </div>
    <div class="dc-fila">
      <dt>{t.ficha.descartado}</dt>
      <dd><s class="dc-descartado">{decision.rejected}</s></dd>
    </div>
    <div class="dc-fila">
      <dt class="dc-rot-dec">{t.ficha.decidido}</dt>
      <dd class="dc-decidido">{decision.chosen}</dd>
    </div>
  </dl>
</aside>

<style>
  .dc {
    position: relative;
    margin: 0 0 48px;
    padding: 20px 22px 22px;
    border-radius: 18px;
    background:
      radial-gradient(90% 120% at 0% 0%, color-mix(in srgb, var(--dc) 7%, transparent), transparent 60%),
      rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.07);
  }
  .dc-cab {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 16px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #c4c4cc;
  }
  .dc-cab::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--dc);
    box-shadow: 0 0 10px var(--dc);
  }
  .dc-filas { display: grid; gap: 12px; margin: 0; }
  .dc-fila {
    display: grid;
    grid-template-columns: 104px minmax(0, 1fr);
    gap: 14px;
    align-items: baseline;
  }
  .dc-fila dt {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #85858f;
  }
  .dc-fila dd { margin: 0; font-size: 15px; line-height: 1.5; }
  .dc-problema { color: #e7e7ec; }
  .dc-rot-dec { color: var(--dc) !important; }
  .dc-descartado {
    text-decoration: none;
    color: #85858f;
    background-image: linear-gradient(#c4c4cc, #c4c4cc);
    background-repeat: no-repeat;
    background-position: 0 58%;
    background-size: 100% 1.5px;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    transition: background-size 0.6s cubic-bezier(0.65, 0, 0.35, 1) 0.35s, color 0.6s 0.35s;
  }
  .dc-decidido {
    color: #e7e7ec;
    transition: opacity 0.6s 0.9s, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.9s, filter 0.6s 0.9s;
  }

  /* `pendiente` lo pone el script solo si va a animar; `vista`, al entrar. */
  .dc.pendiente .dc-descartado { background-size: 0% 1.5px; color: #e7e7ec; }
  .dc.pendiente .dc-decidido { opacity: 0; transform: translateY(6px); filter: blur(4px); }
  .dc.pendiente.vista .dc-descartado { background-size: 100% 1.5px; color: #85858f; }
  .dc.pendiente.vista .dc-decidido { opacity: 1; transform: none; filter: none; }

  @media (max-width: 639px) {
    .dc-fila { grid-template-columns: minmax(0, 1fr); gap: 4px; }
  }
</style>
