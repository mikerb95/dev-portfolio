---
// Renderiza un proceso BPMN como SVG servido desde el servidor: cero JS en el
// cliente, cero dependencias. La geometría la calcula src/lib/bpmn-layout.ts y
// cada figura la pinta BpmnShape; aquí se montan la piscina y los flujos.
import { layout, type BpmnOrientacion, type BpmnProcess } from '../lib/bpmn-layout'
import BpmnShape from './BpmnShape.astro'

interface Props {
  proceso: BpmnProcess
  /** `vertical` transpone la piscina: cada carril es una columna. */
  orientacion?: BpmnOrientacion
  /** Sin marco ni fondo propios: para el documento imprimible y la exportación. */
  desnudo?: boolean
  /** Paleta sobre papel blanco en vez de la del sitio. */
  claro?: boolean
}

const { proceso, orientacion = 'horizontal', desnudo = false, claro = false } = Astro.props
// El grosor de la banda de título ya viene calculado: al transponer pasa de ser
// una franja lateral con el texto girado a una cabecera superior con el texto
// normal, que crece si algún nombre necesita dos líneas.
const { width, height, lanes, nodes, edges, laneHeader: headerGrosor } = layout(proceso, orientacion)
const vertical = orientacion === 'vertical'

// Sufijo único por diagrama: varios SVG en la misma página no pueden compartir
// los ids de <marker>, o el segundo se queda sin puntas de flecha.
const uid = proceso.id
---

<figure class:list={['bpmn', 'bpmn-scope', { desnudo, 'bpmn-claro': claro }]}>
  <div class="bpmn-scroll">
    <svg
      width={width}
      height={height}
      viewBox={`0 0 ${width} ${height}`}
      role="img"
      aria-label={`Diagrama BPMN: ${proceso.titulo}`}
      xmlns="http://www.w3.org/2000/svg"
    >
      <defs>
        <marker
          id={`seq-${uid}`}
          viewBox="0 0 10 10"
          refX="9.5"
          refY="5"
          markerWidth="7"
          markerHeight="7"
          orient="auto-start-reverse"
        >
          <path d="M 0 0.5 L 10 5 L 0 9.5 z" fill="var(--bpmn-line)" />
        </marker>
        <marker
          id={`msg-${uid}`}
          viewBox="0 0 10 10"
          refX="9.5"
          refY="5"
          markerWidth="8"
          markerHeight="8"
          orient="auto-start-reverse"
        >
          <path d="M 0.5 1 L 9.5 5 L 0.5 9" fill="none" stroke="var(--bpmn-msg)" stroke-width="1.3" />
        </marker>
      </defs>

      {/* ── Piscina y carriles ───────────────────────────────────────────
          El carril es un rectángulo con su cabecera en un extremo; qué extremo
          y hacia dónde crece lo decide la orientación, pero la geometría (x, y,
          ancho, alto) ya viene resuelta del layout. */}
      <g class="bpmn-pool">
        {lanes.map((lane, i) => (
          <g>
            <rect
              x={vertical ? lane.x : headerGrosor}
              y={vertical ? headerGrosor : lane.y}
              width={vertical ? lane.width : lane.width - headerGrosor}
              height={vertical ? lane.height - headerGrosor : lane.height}
              fill={i % 2 === 0 ? 'var(--bpmn-lane-a)' : 'var(--bpmn-lane-b)'}
            />
            <rect
              x={lane.x}
              y={lane.y}
              width={vertical ? lane.width : headerGrosor}
              height={vertical ? headerGrosor : lane.height}
              fill="var(--bpmn-header)"
            />
            {/* En horizontal la cabecera es una franja estrecha y alta: el único
                sitio donde cabe el nombre es girado 90°. */}
            <text
              class="bpmn-lane-label"
              x={vertical ? lane.x + lane.width / 2 : headerGrosor / 2}
              y={vertical ? headerGrosor / 2 : lane.y + lane.height / 2}
              transform={vertical ? undefined : `rotate(-90 ${headerGrosor / 2} ${lane.y + lane.height / 2})`}
              text-anchor="middle"
              dominant-baseline="central"
            >
              {lane.labelLines.map((linea, j) => (
                <tspan
                  x={vertical ? lane.x + lane.width / 2 : headerGrosor / 2}
                  dy={j === 0 ? -((lane.labelLines.length - 1) * 12) / 2 : 12}
                >
                  {linea}
                </tspan>
              ))}
            </text>
            {i > 0 && (
              <line
                x1={lane.x}
                y1={lane.y}
                x2={vertical ? lane.x : width}
                y2={vertical ? height : lane.y}
                stroke="var(--bpmn-border)"
                stroke-width="1"
              />
            )}
          </g>
        ))}
        {/* Divisoria entre las cabeceras y el área de trabajo. */}
        <line
          x1={vertical ? 0 : headerGrosor}
          y1={vertical ? headerGrosor : 0}
          x2={vertical ? width : headerGrosor}
          y2={vertical ? headerGrosor : height}
          stroke="var(--bpmn-border)"
          stroke-width="1.2"
        />
        <rect
          x="0.6"
          y="0.6"
          width={width - 1.2}
          height={height - 1.2}
          fill="none"
          stroke="var(--bpmn-border)"
          stroke-width="1.2"
          rx="3"
        />
      </g>

      {/*
        ── Flujos ───────────────────────────────────────────────────────
        Cada flecha se pinta dos veces: primero un trazo grueso del color del
        fondo (el "forro") y encima el trazo real. Como van en pares y en
        orden, al cruzarse una línea interrumpe visiblemente a la de debajo en
        vez de fundirse con ella — el mismo recurso de los mapas de metro. Sin
        esto, dos trazos que se tocan se leen como uno solo.
      */}
      <g class="bpmn-edges">
        {edges.map((e) => (
          <g>
            <path
              d={e.path}
              fill="none"
              stroke="var(--bpmn-lane-a)"
              stroke-width={e.kind === 'message' ? 5 : 5.5}
              stroke-linecap="round"
            />
            <path
              d={e.path}
              fill="none"
              stroke={e.kind === 'message' ? 'var(--bpmn-msg)' : 'var(--bpmn-line)'}
              stroke-width={e.kind === 'message' ? 1.3 : 1.5}
              stroke-dasharray={e.kind === 'message' ? '6 4' : undefined}
              marker-end={`url(#${e.kind === 'message' ? 'msg' : 'seq'}-${uid})`}
            />
          </g>
        ))}
      </g>

      {/* Las etiquetas de rama van por encima de TODAS las flechas: si se
          dibujaran junto a la suya, la siguiente flecha las taparía. */}
      <g class="bpmn-edge-labels">
        {edges.map((e) =>
          e.label && e.labelAt ? (
            <text
              class="bpmn-flow-label"
              x={e.labelAt.x}
              y={e.labelAt.y}
              text-anchor="middle"
              dominant-baseline="central"
            >
              {e.label}
            </text>
          ) : null,
        )}
      </g>

      {/* ── Figuras ────────────────────────────────────────────────────── */}
      <g class="bpmn-nodes">
        {nodes.map((n) => <BpmnShape node={n} />)}
      </g>
    </svg>
  </div>
</figure>

<style>
  .bpmn {
    margin: 0;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: 0.75rem;
    background: var(--bpmn-lane-a);
    overflow: hidden;
  }

  /* Sin marco: el documento imprimible y los SVG exportados ponen el suyo (o
     ninguno), y el borde claro sobre papel blanco se ve como un recuadro
     sobrante alrededor de la piscina, que ya tiene el suyo. */
  .bpmn.desnudo {
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  .bpmn-scroll {
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: thin;
    scrollbar-color: #3a3a48 transparent;
  }

  .bpmn.desnudo .bpmn-scroll {
    overflow: visible;
  }

  .bpmn.desnudo svg {
    width: 100%;
    height: auto;
  }

  svg {
    display: block;
  }
</style>
