---
// Renderiza un proceso BPMN como SVG servido desde el servidor: cero JS en el
// cliente, cero dependencias. La geometría la calcula src/lib/bpmn-layout.ts y
// cada figura la pinta BpmnShape; aquí se montan la piscina y los flujos.
import { GEO, layout, type BpmnProcess } from '../lib/bpmn-layout'
import BpmnShape from './BpmnShape.astro'

interface Props {
  proceso: BpmnProcess
}

const { proceso } = Astro.props
const { width, height, lanes, nodes, edges } = layout(proceso)

// Sufijo único por diagrama: varios SVG en la misma página no pueden compartir
// los ids de <marker>, o el segundo se queda sin puntas de flecha.
const uid = proceso.id
---

<figure class="bpmn bpmn-scope">
  <div class="bpmn-scroll">
    <svg
      width={width}
      height={height}
      viewBox={`0 0 ${width} ${height}`}
      role="img"
      aria-label={`Diagrama BPMN: ${proceso.titulo}`}
      xmlns="http://www.w3.org/2000/svg"
    >
      <defs>
        <marker
          id={`seq-${uid}`}
          viewBox="0 0 10 10"
          refX="9.5"
          refY="5"
          markerWidth="7"
          markerHeight="7"
          orient="auto-start-reverse"
        >
          <path d="M 0 0.5 L 10 5 L 0 9.5 z" fill="var(--bpmn-line)" />
        </marker>
        <marker
          id={`msg-${uid}`}
          viewBox="0 0 10 10"
          refX="9.5"
          refY="5"
          markerWidth="8"
          markerHeight="8"
          orient="auto-start-reverse"
        >
          <path d="M 0.5 1 L 9.5 5 L 0.5 9" fill="none" stroke="var(--bpmn-msg)" stroke-width="1.3" />
        </marker>
      </defs>

      {/* ── Piscina y carriles ─────────────────────────────────────────── */}
      <g class="bpmn-pool">
        {lanes.map((lane, i) => (
          <g>
            <rect
              x={GEO.laneHeaderW}
              y={lane.y}
              width={width - GEO.laneHeaderW}
              height={lane.height}
              fill={i % 2 === 0 ? 'var(--bpmn-lane-a)' : 'var(--bpmn-lane-b)'}
            />
            <rect x="0" y={lane.y} width={GEO.laneHeaderW} height={lane.height} fill="var(--bpmn-header)" />
            <text
              class="bpmn-lane-label"
              x={GEO.laneHeaderW / 2}
              y={lane.y + lane.height / 2}
              transform={`rotate(-90 ${GEO.laneHeaderW / 2} ${lane.y + lane.height / 2})`}
              text-anchor="middle"
              dominant-baseline="central"
            >
              {lane.label}
            </text>
            {i > 0 && <line x1="0" y1={lane.y} x2={width} y2={lane.y} stroke="var(--bpmn-border)" stroke-width="1" />}
          </g>
        ))}
        <line
          x1={GEO.laneHeaderW}
          y1="0"
          x2={GEO.laneHeaderW}
          y2={height}
          stroke="var(--bpmn-border)"
          stroke-width="1.2"
        />
        <rect
          x="0.6"
          y="0.6"
          width={width - 1.2}
          height={height - 1.2}
          fill="none"
          stroke="var(--bpmn-border)"
          stroke-width="1.2"
          rx="3"
        />
      </g>

      {/* ── Flujos ─────────────────────────────────────────────────────── */}
      <g class="bpmn-edges">
        {edges.map((e) => (
          <g>
            <path
              d={e.path}
              fill="none"
              stroke={e.kind === 'message' ? 'var(--bpmn-msg)' : 'var(--bpmn-line)'}
              stroke-width={e.kind === 'message' ? 1.3 : 1.5}
              stroke-dasharray={e.kind === 'message' ? '6 4' : undefined}
              marker-end={`url(#${e.kind === 'message' ? 'msg' : 'seq'}-${uid})`}
            />
            {e.label && e.labelAt && (
              <g>
                <rect
                  x={e.labelAt.x - (e.label.length * 5.1) / 2 - 4}
                  y={e.labelAt.y - 8}
                  width={e.label.length * 5.1 + 8}
                  height="15"
                  rx="3"
                  fill="var(--bpmn-label-bg)"
                />
                <text
                  class="bpmn-flow-label"
                  x={e.labelAt.x}
                  y={e.labelAt.y}
                  text-anchor="middle"
                  dominant-baseline="central"
                >
                  {e.label}
                </text>
              </g>
            )}
          </g>
        ))}
      </g>

      {/* ── Figuras ────────────────────────────────────────────────────── */}
      <g class="bpmn-nodes">
        {nodes.map((n) => <BpmnShape node={n} />)}
      </g>
    </svg>
  </div>
</figure>

<style>
  .bpmn {
    margin: 0;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: 0.75rem;
    background: var(--bpmn-lane-a);
    overflow: hidden;
  }

  .bpmn-scroll {
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: thin;
    scrollbar-color: #3a3a48 transparent;
  }

  svg {
    display: block;
  }
</style>
