---
// Burbuja flotante de WhatsApp, presente en todas las páginas públicas.
// Sin API ni widget de terceros: es un enlace wa.me con mensaje precargado,
// igual que /paginas-web y /contact.
//
// En todo el sitio la burbuja abre un menú con dos opciones: escribirle a Mike
// (primera, la de siempre) o resolver dudas con el asesor con IA
// (docs/plan-asistente.md, capacidad 3). Al principio solo estaba en las
// páginas comerciales; Mike lo pidió global el 1 oct 2026. El asesor recibe
// la página para entender preguntas ambiguas y saber que fuera de las
// comerciales la visita puede ser técnica o de un reclutador.
//
// Convive con LanguageSuggestModal, que ocupa la misma esquina inferior
// derecha: cuando esa modal está visible el script del modal marca
// `data-lang-suggest="open"` en <html> y publica su altura en
// `--lang-suggest-h`; la burbuja (y el menú y el chat, que cuelgan de la misma
// variable) se sube por encima de la tarjeta y gana z-index para no quedar
// tapada ni superpuesta.
import { delocalizePath, getDictionary, getLocaleFromUrl } from '../i18n'
import { waLink } from '../lib/phone'
import { MAX_PREGUNTAS, PAGINAS, type Pagina } from '../lib/asesor/prompt'

const locale = getLocaleFromUrl(Astro.url.pathname)
const t = getDictionary(locale)
const a = t.asesor

const PHONE = '+573104641228'
const href = waLink(PHONE, t.whatsapp.message)

const ruta = delocalizePath(Astro.url.pathname).replace(/\/+$/, '') || '/'
const pagina: Pagina = (PAGINAS as readonly string[]).includes(ruta.slice(1)) ? (ruta.slice(1) as Pagina) : 'sitio'
const sugerencias =
  pagina === 'capacitacion-ia' ? a.sugerenciasCapacitacion : pagina === 'sitio' ? a.sugerenciasGeneral : a.sugerenciasWeb
// El globo que sale de la burbuja: en la landing de páginas web va directo al
// precio, que es lo que esa visita viene a averiguar.
const globo = pagina === 'paginas-web' ? a.globoWeb : a.globoGeneral

// Lo que el script necesita del diccionario, en un solo atributo.
const textos = JSON.stringify({
  agotado: a.agotado,
  errorLimite: a.errorLimite,
  errorFallo: a.errorFallo,
  errorNoDisponible: a.errorNoDisponible,
  noDisponible: a.noDisponible,
  pensando: a.pensando,
  calculado: a.calculado,
  verMensaje: a.verMensaje,
  ocultarMensaje: a.ocultarMensaje,
  contactoListo: a.contactoListo,
  contactoEnviar: a.contactoEnviar,
  contactoEnviando: a.contactoEnviando,
  contactoErrorMedio: a.contactoErrorMedio,
  contactoErrorTelefono: a.contactoErrorTelefono,
  contactoErrorCorreo: a.contactoErrorCorreo,
  contactoErrorAutoriza: a.contactoErrorAutoriza,
  contactoErrorFallo: a.contactoErrorFallo,
  vivoAvisado: a.vivoAvisado,
  vivoMikeEntro: a.vivoMikeEntro,
  vivoMike: a.vivoMike,
  vivoNuevo: a.vivoNuevo,
  vivoSubtitulo: a.vivoSubtitulo,
})
---

<div
  id="asesor"
  class="asesor"
  data-locale={locale}
  data-pagina={pagina}
  data-wa-base={`https://wa.me/${PHONE.replace(/\D/g, '')}`}
  data-max={MAX_PREGUNTAS}
  data-textos={textos}
>
  <button
    id="wa-fab"
    type="button"
    class="wa-fab group fixed right-4 sm:right-5 z-40 inline-flex items-center gap-2 h-12 pl-3 pr-1.5 rounded-full bg-[#25D366] text-[#062e16] shadow-[0_8px_28px_rgba(37,211,102,.35)] hover:brightness-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#25D366] cursor-pointer"
    aria-label={a.menuAria}
    aria-expanded="false"
    aria-controls="asesor-menu"
    data-analytics="whatsapp-fab"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true" class="shrink-0">
      <path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.6.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.47 0 1.46 1.06 2.87 1.21 3.07.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35Z"></path>
      <path d="M12.04 2C6.6 2 2.18 6.42 2.18 11.86c0 1.74.46 3.44 1.32 4.94L2 22l5.36-1.4a9.83 9.83 0 0 0 4.68 1.19h.01c5.43 0 9.85-4.42 9.85-9.86 0-2.63-1.02-5.11-2.88-6.97A9.79 9.79 0 0 0 12.04 2Zm0 17.94h-.01a8.2 8.2 0 0 1-4.17-1.14l-.3-.18-3.1.81.83-3.02-.2-.31a8.13 8.13 0 0 1-1.25-4.34c0-4.52 3.68-8.2 8.2-8.2a8.14 8.14 0 0 1 5.79 2.4 8.14 8.14 0 0 1 2.4 5.8c0 4.52-3.68 8.18-8.19 8.18Z"></path>
    </svg>
    <span class="hidden sm:inline -ml-2 text-[13px] font-medium whitespace-nowrap max-w-0 opacity-0 overflow-hidden transition-all duration-300 group-hover:ml-0 group-hover:max-w-[10rem] group-hover:opacity-100">
      {t.whatsapp.label}
    </span>
    <span class="wa-fab-raya" aria-hidden="true"></span>
    <span class="wa-fab-ia" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="19" height="19" fill="currentColor"><path class="wa-chispa-grande" d="M10.5 5.5C11.1 9.4 13.6 12.4 18 13 13.6 13.6 11.1 16.6 10.5 20.5 9.9 16.6 7.4 13.6 3 13 7.4 12.4 9.9 9.4 10.5 5.5Z"></path><path class="wa-chispa-chica" d="M18.5 2.5C18.8 4 19.3 5.2 21.5 5.5 19.3 5.8 18.8 7 18.5 8.5 18.2 7 17.7 5.8 15.5 5.5 17.7 5.2 18.2 4 18.5 2.5Z"></path></svg>
    </span>
  </button>

  <div id="asesor-globo" class="asesor-globo fixed right-4 sm:right-5 z-[45]" hidden>
    <button type="button" id="asesor-globo-abrir" class="asesor-globo-texto cursor-pointer" aria-label={globo} data-analytics="asesor-globo">
      <span aria-hidden="true">
        {globo.split(' ').map((p, i) => (
          <>
            <span class="asesor-globo-palabra" style={`--i:${i}`}>{p}</span>{' '}
          </>
        ))}
      </span>
    </button>
    <button type="button" id="asesor-globo-cerrar" class="asesor-globo-cerrar cursor-pointer" aria-label={a.globoCerrar}>
      <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>
  </div>

  <div id="asesor-menu" class="asesor-menu fixed right-4 sm:right-5 z-[60] w-[min(20rem,calc(100vw-2rem))]" hidden>
    <div class="rounded-2xl border border-ink-500/70 bg-ink-800/95 backdrop-blur-md p-1.5 shadow-[0_18px_50px_-12px_rgba(0,0,0,.7)]">
      <a
        href={href}
        target="_blank"
        rel="noopener"
        class="asesor-opcion flex items-center gap-3 rounded-xl px-3 py-3 bg-[#25D366]/12 hover:bg-[#25D366]/20 focus-visible:outline-2 focus-visible:outline-[#25D366]"
        data-analytics="asesor-menu-whatsapp"
      >
        <span class="grid place-items-center h-9 w-9 shrink-0 rounded-full bg-[#25D366] text-[#062e16]" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.6.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.47 0 1.46 1.06 2.87 1.21 3.07.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35Z"></path><path d="M12.04 2C6.6 2 2.18 6.42 2.18 11.86c0 1.74.46 3.44 1.32 4.94L2 22l5.36-1.4a9.83 9.83 0 0 0 4.68 1.19h.01c5.43 0 9.85-4.42 9.85-9.86 0-2.63-1.02-5.11-2.88-6.97A9.79 9.79 0 0 0 12.04 2Zm0 17.94h-.01a8.2 8.2 0 0 1-4.17-1.14l-.3-.18-3.1.81.83-3.02-.2-.31a8.13 8.13 0 0 1-1.25-4.34c0-4.52 3.68-8.2 8.2-8.2a8.14 8.14 0 0 1 5.79 2.4 8.14 8.14 0 0 1 2.4 5.8c0 4.52-3.68 8.18-8.19 8.18Z"></path></svg>
        </span>
        <span class="min-w-0">
          <span class="block text-[14px] font-semibold text-ink-50">{a.opcionWhatsapp}</span>
          <span class="block text-[12px] text-ink-200">{a.opcionWhatsappNota}</span>
        </span>
      </a>
      <button
        type="button"
        id="asesor-abrir"
        class="asesor-opcion mt-1 flex w-full items-center gap-3 rounded-xl px-3 py-3 text-left hover:bg-ink-700 focus-visible:outline-2 focus-visible:outline-cyan disabled:opacity-60 disabled:hover:bg-transparent cursor-pointer disabled:cursor-default"
        data-analytics="asesor-menu-ia"
      >
        <span class="asesor-chispa grid place-items-center h-9 w-9 shrink-0 rounded-full border border-cyan/40 text-cyan" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M10.5 5.5C11.1 9.4 13.6 12.4 18 13 13.6 13.6 11.1 16.6 10.5 20.5 9.9 16.6 7.4 13.6 3 13 7.4 12.4 9.9 9.4 10.5 5.5Z"></path><path d="M18.5 2.5C18.8 4 19.3 5.2 21.5 5.5 19.3 5.8 18.8 7 18.5 8.5 18.2 7 17.7 5.8 15.5 5.5 17.7 5.2 18.2 4 18.5 2.5Z"></path></svg>
        </span>
        <span class="min-w-0">
          <span class="block text-[14px] font-semibold text-ink-50">{a.opcionIa}</span>
          <span id="asesor-abrir-nota" class="block text-[12px] text-ink-200">{a.opcionIaNota}</span>
        </span>
      </button>
    </div>
  </div>

  <section
    id="asesor-chat"
    class="asesor-chat fixed right-4 sm:right-5 z-[60] flex flex-col w-[min(23.5rem,calc(100vw-2rem))] rounded-2xl border border-ink-500/70 bg-ink-850/97 backdrop-blur-md shadow-[0_24px_70px_-16px_rgba(0,0,0,.8)] overflow-hidden"
    role="dialog"
    aria-labelledby="asesor-titulo"
    data-lenis-prevent
    hidden
  >
    <header class="flex items-start gap-3 px-4 pt-3.5 pb-3 border-b border-ink-600/80">
      <span class="asesor-pulso mt-1.5 h-2 w-2 shrink-0 rounded-full bg-cyan" aria-hidden="true"></span>
      <div class="min-w-0 flex-1">
        <h2 id="asesor-titulo" class="text-[14px] font-semibold text-ink-50 leading-tight">{a.titulo}</h2>
        <p id="asesor-subtitulo" class="text-[12px] text-ink-200 leading-snug">{a.subtitulo}</p>
      </div>
      <button type="button" id="asesor-reiniciar" class="grid place-items-center h-8 w-8 rounded-lg text-ink-200 hover:text-ink-50 hover:bg-ink-700 focus-visible:outline-2 focus-visible:outline-cyan cursor-pointer" aria-label={a.reiniciar} title={a.reiniciar} hidden>
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7"></path><path d="M3 4v5h5"></path></svg>
      </button>
      <button type="button" id="asesor-cerrar" class="-mr-1 grid place-items-center h-8 w-8 rounded-lg text-ink-200 hover:text-ink-50 hover:bg-ink-700 focus-visible:outline-2 focus-visible:outline-cyan cursor-pointer" aria-label={a.cerrar}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </header>

    <div id="asesor-log" class="asesor-log relative flex-1 overflow-y-auto overscroll-contain px-4 py-4 space-y-3" aria-live="polite">
      <p class="asesor-burbuja asesor-burbuja--ia">{a.saludo}</p>
    </div>

    <div id="asesor-sugerencias" class="flex flex-wrap gap-1.5 px-4 pb-3">
      {sugerencias.map((s) => (
        <button type="button" class="asesor-chip rounded-full border border-ink-500 px-3 py-1.5 text-[12.5px] text-ink-100 hover:border-cyan/60 hover:text-ink-50 focus-visible:outline-2 focus-visible:outline-cyan cursor-pointer" data-sugerencia={s}>
          {s}
        </button>
      ))}
    </div>

    <div id="asesor-cierre" class="border-t border-ink-600/80 px-4 pt-3 pb-3" hidden>
      <a
        id="asesor-enviar-mike"
        href={href}
        target="_blank"
        rel="noopener"
        class="flex items-center justify-center gap-2 rounded-xl bg-[#25D366] px-4 py-3 text-[14px] font-semibold text-[#062e16] hover:brightness-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#25D366]"
        data-analytics="asesor-enviar-mike"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.6.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.47 0 1.46 1.06 2.87 1.21 3.07.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35Z"></path><path d="M12.04 2C6.6 2 2.18 6.42 2.18 11.86c0 1.74.46 3.44 1.32 4.94L2 22l5.36-1.4a9.83 9.83 0 0 0 4.68 1.19h.01c5.43 0 9.85-4.42 9.85-9.86 0-2.63-1.02-5.11-2.88-6.97A9.79 9.79 0 0 0 12.04 2Zm0 17.94h-.01a8.2 8.2 0 0 1-4.17-1.14l-.3-.18-3.1.81.83-3.02-.2-.31a8.13 8.13 0 0 1-1.25-4.34c0-4.52 3.68-8.2 8.2-8.2a8.14 8.14 0 0 1 5.79 2.4 8.14 8.14 0 0 1 2.4 5.8c0 4.52-3.68 8.18-8.19 8.18Z"></path></svg>
        {a.enviarMike}
      </a>
      <div class="mt-1.5 flex flex-wrap items-center justify-between gap-x-3 gap-y-0.5 text-[11.5px]">
        <span class="text-ink-200">{a.enviarMikeNota}</span>
        <button type="button" id="asesor-ver" class="inline-flex items-center gap-1 text-ink-100 hover:text-ink-50 focus-visible:outline-2 focus-visible:outline-cyan rounded cursor-pointer" aria-expanded="false" aria-controls="asesor-vista">
          <span id="asesor-ver-texto">{a.verMensaje}</span>
          <svg class="asesor-ver-flecha" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
        </button>
      </div>
      <div id="asesor-vista" class="asesor-vista" inert>
        <div class="min-h-0 overflow-hidden">
          <p id="asesor-vista-texto" class="asesor-wa"></p>
        </div>
      </div>
    </div>

    <form id="asesor-form" class="border-t border-ink-600/80 px-3 pt-3 pb-2.5">
      <div class="flex items-end gap-2">
        <label for="asesor-input" class="sr-only">{a.placeholder}</label>
        <textarea
          id="asesor-input"
          rows="1"
          maxlength="500"
          placeholder={a.placeholder}
          class="asesor-input min-h-10 max-h-28 flex-1 resize-none rounded-xl border border-ink-500 bg-ink-800 px-3 py-2.5 text-[16px] sm:text-[14px] text-ink-50 placeholder:text-ink-200 focus:border-cyan/70 focus:outline-none"
        ></textarea>
        <button type="submit" id="asesor-enviar" class="grid place-items-center h-10 w-10 shrink-0 rounded-xl bg-cyan text-ink-900 hover:brightness-110 disabled:opacity-40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan cursor-pointer disabled:cursor-default" aria-label={a.enviar}>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </button>
      </div>
      <div class="mt-2 flex items-center justify-between gap-3 text-[11.5px] whitespace-nowrap">
        <button type="button" id="asesor-contacto-abrir" class="text-ink-100 hover:text-ink-50 hover:underline underline-offset-2 cursor-pointer disabled:opacity-50 disabled:no-underline disabled:cursor-default" data-analytics="asesor-contacto-abrir">{a.contactoAbrir}</button>
        <a href={href} target="_blank" rel="noopener" class="text-[#5ee08f] hover:underline underline-offset-2" data-analytics="asesor-hablar-mike">{a.hablarMike}</a>
      </div>
    </form>
  </section>

  <!-- Formulario de contacto: el script lo mueve al final de la conversación
       cuando el asesor lo ofrece o la persona toca "Que Mike me contacte". Es
       el mismo nodo siempre, así lo escrito no se pierde al repintar el chat. -->
  <form id="asesor-contacto" class="asesor-contacto" novalidate hidden>
    <p class="asesor-contacto-titulo">{a.contactoTitulo}</p>
    <label class="asesor-campo">
      <span>{a.contactoNombre}</span>
      <input name="nombre" type="text" autocomplete="name" maxlength="120" required />
    </label>
    <label class="asesor-campo">
      <span>{a.contactoTelefono}</span>
      <input name="telefono" type="tel" autocomplete="tel" inputmode="tel" maxlength="40" />
    </label>
    <label class="asesor-campo">
      <span>{a.contactoCorreo}</span>
      <input name="correo" type="email" autocomplete="email" maxlength="200" />
    </label>
    <label class="asesor-campo">
      <span>{a.contactoEmpresa}</span>
      <input name="empresa" type="text" autocomplete="organization" maxlength="120" />
    </label>
    <p class="asesor-contacto-ayuda">{a.contactoAyuda}</p>
    <label class="asesor-autoriza">
      <input name="autoriza" type="checkbox" required />
      <span>{a.contactoAutoriza}</span>
    </label>
    <p class="asesor-contacto-error" role="alert" hidden></p>
    <button type="submit" class="asesor-contacto-enviar">{a.contactoEnviar}</button>
  </form>
</div>

<style>
  .wa-fab,
  .asesor {
    /* Separación base del borde inferior; la modal de idioma la aumenta. */
    --wa-gap: 1.25rem;
    --wa-bottom: var(--wa-gap);
  }
  .wa-fab {
    bottom: var(--wa-bottom);
    transition:
      bottom 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      filter 0.2s ease;
  }

  /* Modal de idioma abierta: la burbuja se sube por encima de la tarjeta
     (que mide --lang-suggest-h) y sube de plano para no quedar detrás. */
  :global(html[data-lang-suggest='open']) .wa-fab,
  :global(html[data-lang-suggest='open']) .asesor {
    --wa-bottom: calc(var(--wa-gap) + var(--lang-suggest-h, 9rem) + 0.75rem);
  }
  :global(html[data-lang-suggest='open']) .wa-fab {
    z-index: 70;
  }

  /* Menú y chat cuelgan justo encima de la burbuja (48 px + aire). */
  .asesor-menu,
  .asesor-chat {
    bottom: calc(var(--wa-bottom) + 3.75rem);
    transform-origin: bottom right;
  }
  .asesor-chat {
    height: min(36rem, calc(100dvh - var(--wa-bottom) - 6rem));
  }
  /* Con la modal de idioma abierta, el chat no la sigue hacia arriba (en el
     celular terminaba encima de la barra de navegación): se queda abajo, por
     encima de la modal y de la burbuja, y se cierra con su propia X. */
  :global(html[data-lang-suggest='open']) .asesor-chat {
    bottom: var(--wa-gap);
    height: min(36rem, calc(100dvh - var(--wa-gap) - 6rem));
    z-index: 80;
  }
  .asesor-menu:not([hidden]),
  .asesor-chat:not([hidden]) {
    animation: asesor-entrar 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes asesor-entrar {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.97);
    }
  }

  /* El menú sale de la burbuja: la tarjeta crece desde la esquina del botón
     verde y las dos opciones entran una tras otra, WhatsApp primero, que es
     también el orden de importancia. */
  .asesor-menu:not([hidden]) {
    animation: asesor-desplegar 0.42s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes asesor-desplegar {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.6);
    }
  }
  .asesor-menu:not([hidden]) .asesor-opcion {
    animation: asesor-opcion 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .asesor-menu:not([hidden]) .asesor-opcion:nth-child(1) {
    animation-delay: 0.08s;
  }
  .asesor-menu:not([hidden]) .asesor-opcion:nth-child(2) {
    animation-delay: 0.16s;
  }
  @keyframes asesor-opcion {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  /* El botón de WhatsApp sube al aparecer, un instante después de la
     respuesta que lo trajo. */
  #asesor-cierre:not([hidden]) {
    animation: asesor-opcion 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both;
  }

  /* Vista previa del mensaje: se pliega con una fila de rejilla de 0fr a 1fr,
     que anima la altura real del contenido sin medirlo con JS. */
  .asesor-vista {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .asesor-vista[data-abierta] {
    grid-template-rows: 1fr;
  }
  .asesor-ver-flecha {
    transition: transform 0.3s ease;
  }
  #asesor-ver[aria-expanded='true'] .asesor-ver-flecha {
    transform: rotate(180deg);
  }
  /* El mensaje se ve como saldrá en WhatsApp: burbuja verde de envío, con la
     esquina de la "cola" arriba a la derecha. */
  .asesor-wa {
    margin-top: 0.6rem;
    max-height: 7rem;
    overflow-y: auto;
    padding: 0.55rem 0.75rem;
    border-radius: 0.8rem;
    border-top-right-radius: 0.2rem;
    background: #005c4b;
    color: #e9edef;
    font-size: 12.5px;
    line-height: 1.45;
    white-space: pre-line;
    overflow-wrap: anywhere;
  }

  /* Precio calculado: dígitos tabulares siempre, así el odómetro y el texto
     final miden lo mismo y la línea no salta al terminar de rodar. Las
     columnas usan el interlineado de la burbuja y no el 1.1 global. */
  .asesor-log :global(.asesor-precio) {
    /* Cada dígito del odómetro es una columna aparte, y el navegador podía
       partir la cifra entre dos renglones mientras rodaba ("$70" / "0.000"). */
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    color: var(--color-cyan-glow);
  }
  .asesor-log :global(.asesor-precio .odo-col) {
    height: 1.5em;
  }
  .asesor-log :global(.asesor-precio .odo-tira) {
    line-height: 1.5;
    /* La tira es una columna de dígitos que se apilan al partirse; sin esto
       hereda el nowrap de la cifra, queda en una sola línea y cada dígito
       aparece corrido hacia arriba. */
    white-space: normal;
  }
  .asesor-log :global(.asesor-marca) {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: -0.35rem;
    padding-left: 0.35rem;
    font-size: 11.5px;
    color: var(--color-ink-100);
  }
  .asesor-log :global(.asesor-marca-punto) {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--color-cyan);
    box-shadow: 0 0 0 3px rgba(0, 242, 255, 0.14);
  }

  .asesor-log :global(.asesor-burbuja) {
    max-width: 88%;
    width: fit-content;
    padding: 0.6rem 0.8rem;
    border-radius: 1rem;
    font-size: 14px;
    line-height: 1.5;
    white-space: pre-line;
    overflow-wrap: anywhere;
  }
  .asesor-log :global(.asesor-burbuja--ia) {
    background: var(--color-ink-750);
    border: 1px solid var(--color-ink-600);
    color: var(--color-ink-50);
    border-bottom-left-radius: 0.35rem;
  }
  .asesor-log :global(.asesor-burbuja--yo) {
    margin-left: auto;
    background: rgba(0, 242, 255, 0.1);
    border: 1px solid rgba(0, 242, 255, 0.28);
    color: var(--color-ink-50);
    border-bottom-right-radius: 0.35rem;
  }
  /* Asesor en vivo. Mike escribe con el verde de envío de WhatsApp, el mismo
     de la vista previa del mensaje: es la persona a la que la burbuja lleva. */
  .asesor-log :global(.asesor-burbuja--mike) {
    background: #005c4b;
    border: 1px solid rgba(37, 211, 102, 0.35);
    color: #e9edef;
    border-bottom-left-radius: 0.35rem;
  }
  .asesor-log :global(.asesor-quien) {
    display: block;
    margin-bottom: 0.1rem;
    font-size: 11.5px;
    font-weight: 600;
    color: #5ee08f;
  }
  .asesor-log :global(.asesor-sistema) {
    font-size: 12px;
    line-height: 1.45;
    color: var(--color-ink-200);
    text-align: center;
    padding: 0 0.75rem;
    animation: asesor-opcion 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  /* Con Mike dentro, el punto del encabezado pasa del cian del asesor al verde. */
  .asesor-chat[data-mike] .asesor-pulso {
    background: #25d366;
    animation-name: asesor-pulso-mike;
  }
  @keyframes asesor-pulso-mike {
    70% {
      box-shadow: 0 0 0 7px rgba(37, 211, 102, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(37, 211, 102, 0);
    }
  }
  /* Mike escribió con el chat cerrado: un punto sobre la burbuja. */
  .wa-fab[data-nuevo]::after {
    content: '';
    position: absolute;
    top: -2px;
    right: -2px;
    width: 14px;
    height: 14px;
    border-radius: 999px;
    background: var(--color-ember);
    border: 2px solid var(--color-ink-950);
    animation: asesor-latido 1.6s ease-in-out infinite;
  }
  @keyframes asesor-latido {
    50% {
      transform: scale(1.18);
    }
  }
  .asesor-log :global(.asesor-nota) {
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--color-ember);
    text-align: center;
    padding: 0 0.5rem;
  }

  /* Tres puntos mientras responde. */
  .asesor-log :global(.asesor-pensando) {
    display: inline-flex;
    gap: 0.3rem;
    align-items: center;
  }
  .asesor-log :global(.asesor-pensando i) {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--color-cyan-dim);
    animation: asesor-punto 1.1s ease-in-out infinite;
  }
  .asesor-log :global(.asesor-pensando i:nth-child(2)) {
    animation-delay: 0.15s;
  }
  .asesor-log :global(.asesor-pensando i:nth-child(3)) {
    animation-delay: 0.3s;
  }
  @keyframes asesor-punto {
    0%,
    80%,
    100% {
      opacity: 0.25;
      transform: translateY(0);
    }
    40% {
      opacity: 1;
      transform: translateY(-3px);
    }
  }

  .asesor-pulso {
    box-shadow: 0 0 0 0 rgba(0, 242, 255, 0.5);
    animation: asesor-pulso 2.4s ease-out infinite;
  }
  @keyframes asesor-pulso {
    70% {
      box-shadow: 0 0 0 7px rgba(0, 242, 255, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(0, 242, 255, 0);
    }
  }

  /* Formulario de contacto dentro de la conversación: una tarjeta como las
     burbujas del asesor, con campos del mismo estilo que la caja de texto. */
  .asesor-contacto {
    display: grid;
    gap: 0.55rem;
    padding: 0.85rem;
    border-radius: 1rem;
    border: 1px solid rgba(0, 242, 255, 0.22);
    background: var(--color-ink-750);
    animation: asesor-opcion 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .asesor-contacto[hidden] {
    display: none;
  }
  .asesor-contacto-titulo {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--color-ink-50);
  }
  .asesor-campo {
    display: grid;
    gap: 0.2rem;
    font-size: 11.5px;
    color: var(--color-ink-200);
  }
  .asesor-campo input {
    width: 100%;
    border-radius: 0.65rem;
    border: 1px solid var(--color-ink-500);
    background: var(--color-ink-800);
    padding: 0.45rem 0.65rem;
    /* 16 px en el celular: con menos, iOS hace zoom al enfocar el campo. */
    font-size: 16px;
    color: var(--color-ink-50);
  }
  @media (min-width: 640px) {
    .asesor-campo input {
      font-size: 13.5px;
    }
  }
  .asesor-campo input:focus {
    outline: none;
    border-color: rgba(0, 242, 255, 0.7);
  }
  .asesor-contacto-ayuda {
    font-size: 11.5px;
    color: var(--color-ink-200);
  }
  .asesor-autoriza {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    font-size: 11px;
    line-height: 1.45;
    color: var(--color-ink-100);
  }
  .asesor-autoriza input {
    margin-top: 0.15rem;
    accent-color: var(--color-cyan);
    flex-shrink: 0;
  }
  .asesor-contacto-error {
    font-size: 12px;
    color: var(--color-ember);
  }
  .asesor-contacto-enviar {
    border-radius: 0.75rem;
    background: var(--color-cyan);
    color: var(--color-ink-900);
    font-size: 13.5px;
    font-weight: 600;
    padding: 0.6rem 1rem;
    cursor: pointer;
  }
  .asesor-contacto-enviar:disabled {
    opacity: 0.5;
    cursor: default;
  }
  .asesor-log :global(.asesor-listo) {
    font-size: 13px;
    color: var(--color-ink-50);
    padding: 0.6rem 0.8rem;
    border-radius: 1rem;
    border: 1px solid rgba(0, 242, 255, 0.22);
    background: rgba(0, 242, 255, 0.06);
  }

  /* Burbuja doble: el verde y el logo siguen diciendo WhatsApp, y el círculo
     oscuro con la chispa cian (la misma de la opción del menú) dice que
     adentro también hay un asistente con IA. Cada tanto la estrella grande
     late con brillo y la chica titila después, como un destello. */
  .wa-fab-raya {
    width: 1px;
    height: 1.4rem;
    background: rgba(6, 46, 22, 0.3);
  }
  .wa-fab-ia {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    border-radius: 999px;
    background: var(--color-ink-900);
    color: var(--color-cyan);
    box-shadow: inset 0 0 0 1px rgba(0, 242, 255, 0.35);
    transition: box-shadow 0.3s ease;
  }
  .wa-chispa-grande {
    transform-origin: 10.5px 13px;
    animation: wa-chispa-grande 7s ease-in-out infinite;
  }
  .wa-chispa-chica {
    transform-origin: 18.5px 5.5px;
    animation: wa-chispa-chica 7s ease-in-out infinite;
  }
  @keyframes wa-chispa-grande {
    0%,
    80%,
    100% {
      transform: scale(1);
      filter: none;
    }
    87% {
      transform: scale(1.2) rotate(8deg);
      filter: drop-shadow(0 0 3px var(--color-cyan));
    }
  }
  @keyframes wa-chispa-chica {
    0%,
    84%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    88% {
      transform: scale(0.3);
      opacity: 0.3;
    }
    93% {
      transform: scale(1.35);
      opacity: 1;
    }
  }
  /* Con el globo afuera, el círculo de IA se enciende: es de donde habla. */
  .wa-fab[data-globo] .wa-fab-ia {
    box-shadow:
      inset 0 0 0 1px rgba(0, 242, 255, 0.6),
      0 0 0 3px rgba(0, 242, 255, 0.22);
  }

  /* Globo que sale de la burbuja invitando al asistente. Nace de la esquina
     del círculo de IA (la cola apunta a su centro: 6 px de relleno + 18 px de
     radio desde el borde derecho) y las palabras aparecen con el mismo gesto
     de "texto que se genera" de las respuestas del asesor
     (lib/motion/texto-generado.ts), en CSS para no cargar GSAP en todas las
     páginas solo por un aviso. */
  .asesor-globo {
    bottom: calc(var(--wa-bottom) + 3.6rem);
    width: max-content;
    max-width: min(16.5rem, calc(100vw - 2rem));
    transform-origin: calc(100% - 1.5rem) 100%;
  }
  :global(html[data-lang-suggest='open']) .asesor-globo {
    z-index: 70;
  }
  .asesor-globo:not([hidden]) {
    animation: asesor-globo-entrar 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .asesor-globo[data-saliendo] {
    animation: asesor-globo-salir 0.22s ease-in forwards;
  }
  @keyframes asesor-globo-entrar {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.55);
    }
  }
  @keyframes asesor-globo-salir {
    to {
      opacity: 0;
      transform: translateY(6px) scale(0.85);
    }
  }
  .asesor-globo-texto {
    position: relative;
    display: block;
    padding: 0.65rem 2.1rem 0.7rem 0.9rem;
    border-radius: 1rem;
    border-bottom-right-radius: 0.4rem;
    border: 1px solid rgba(0, 242, 255, 0.32);
    background: var(--color-ink-800);
    color: var(--color-ink-50);
    font-size: 13.5px;
    line-height: 1.4;
    text-align: left;
    box-shadow: 0 14px 40px -12px rgba(0, 0, 0, 0.75);
    transition: border-color 0.2s ease;
  }
  .asesor-globo-texto:hover {
    border-color: rgba(0, 242, 255, 0.6);
  }
  .asesor-globo-texto:focus-visible {
    outline: 2px solid var(--color-cyan);
    outline-offset: 2px;
  }
  .asesor-globo-texto::after {
    content: '';
    position: absolute;
    right: calc(1.5rem - 6px);
    bottom: -6px;
    width: 11px;
    height: 11px;
    background: inherit;
    border-right: inherit;
    border-bottom: inherit;
    border-bottom-right-radius: 2px;
    transform: rotate(45deg);
  }
  .asesor-globo-palabra {
    display: inline-block;
  }
  .asesor-globo:not([hidden]) .asesor-globo-palabra {
    animation: asesor-globo-palabra 0.3s ease-out both;
    animation-delay: calc(0.3s + var(--i) * 70ms);
  }
  @keyframes asesor-globo-palabra {
    from {
      opacity: 0;
      filter: blur(4px);
    }
  }
  .asesor-globo-cerrar {
    position: absolute;
    top: 0.4rem;
    right: 0.4rem;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 0.45rem;
    color: var(--color-ink-200);
  }
  .asesor-globo-cerrar:hover {
    color: var(--color-ink-50);
    background: var(--color-ink-700);
  }
  .asesor-globo-cerrar:focus-visible {
    outline: 2px solid var(--color-cyan);
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-fab,
    .wa-fab-ia,
    .asesor-vista,
    .asesor-ver-flecha {
      transition: none;
    }
    .asesor-menu:not([hidden]),
    .asesor-menu:not([hidden]) .asesor-opcion,
    #asesor-cierre:not([hidden]),
    .asesor-chat:not([hidden]),
    .asesor-pulso,
    .asesor-contacto,
    .wa-fab[data-nuevo]::after,
    .wa-chispa-grande,
    .wa-chispa-chica,
    .asesor-globo:not([hidden]),
    .asesor-globo[data-saliendo],
    .asesor-globo:not([hidden]) .asesor-globo-palabra,
    .asesor-log :global(.asesor-sistema),
    .asesor-log :global(.asesor-pensando i) {
      animation: none;
    }
  }
</style>

<script>
  import { pintarRespuesta } from '../lib/motion/palabras'
  import { EVENTO_TRASPASO, type EstadoTraspaso } from '../lib/asesor/traspaso'

  // 'mike' y 'sistema' solo existen en el navegador (asesor en vivo,
  // lib/asesor/vivo.ts): nunca se le reenvían al modelo.
  type Rol = 'usuario' | 'asesor' | 'mike' | 'sistema'
  type Mensaje = { rol: Rol; texto: string }
  type Estado = {
    mensajes: Mensaje[]
    calculos: unknown[]
    whatsapp: string | null
    /** Cifras calculadas de cada respuesta, por índice del mensaje: pintan la marca. */
    marcas: Record<string, string[]>
    /** Formulario de contacto: escondido, a la vista, o ya enviado (con el nombre). */
    contacto: 'no' | 'visible' | 'enviado'
    contactoNombre?: string
    /** Token del asesor en vivo: la conversación se guarda para que Mike la lea. */
    conversacion?: string
    /** Mike entró: las preguntas ya no van al modelo sino a él. */
    mike?: boolean
    /** Id del último mensaje de Mike recibido, para pedir solo lo nuevo. */
    ultimoMike?: number
  }
  type Textos = Record<
    | 'agotado'
    | 'errorLimite'
    | 'errorFallo'
    | 'errorNoDisponible'
    | 'noDisponible'
    | 'pensando'
    | 'calculado'
    | 'verMensaje'
    | 'ocultarMensaje'
    | 'contactoListo'
    | 'contactoEnviar'
    | 'contactoEnviando'
    | 'contactoErrorMedio'
    | 'contactoErrorTelefono'
    | 'contactoErrorCorreo'
    | 'contactoErrorAutoriza'
    | 'contactoErrorFallo'
    | 'vivoAvisado'
    | 'vivoMikeEntro'
    | 'vivoMike'
    | 'vivoNuevo'
    | 'vivoSubtitulo',
    string
  >
  type Motion = typeof import('../lib/motion/asesor')

  const sinMovimiento = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches

  // El motion del chat se descarga al abrirlo, no con la página: la burbuja
  // está en todo el sitio y casi nadie abre el chat. Si la descarga falla, el
  // chat sigue igual, solo que sin animar.
  let motion: Promise<Motion | null> | null = null
  const cargarMotion = () => (motion ??= import('../lib/motion/asesor').catch(() => null))

  // Sondeo del asesor en vivo, fuera de iniciar(): uno solo por página aunque
  // iniciar() corra otra vez con astro:page-load.
  let sondeo: ReturnType<typeof setTimeout> | null = null
  let sondeando = false
  // Oyente del traspaso desde el cotizador de la portada: uno solo, el de la
  // página actual (con view transitions, el anterior apuntaría a elementos
  // que ya no están en el documento).
  let traspasoAnterior: ((ev: Event) => void) | null = null

  function iniciar() {
    const raiz = document.getElementById('asesor')
    if (!raiz || raiz.dataset.listo) return
    raiz.dataset.listo = '1'

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T
    const fab = $<HTMLButtonElement>('wa-fab')
    const menu = $('asesor-menu')
    const abrir = $<HTMLButtonElement>('asesor-abrir')
    const abrirNota = $('asesor-abrir-nota')
    const chat = $('asesor-chat')
    const cerrar = $<HTMLButtonElement>('asesor-cerrar')
    const log = $('asesor-log')
    const sugerencias = $('asesor-sugerencias')
    const cierre = $('asesor-cierre')
    const enviarMike = $<HTMLAnchorElement>('asesor-enviar-mike')
    const form = $<HTMLFormElement>('asesor-form')
    const input = $<HTMLTextAreaElement>('asesor-input')
    const enviar = $<HTMLButtonElement>('asesor-enviar')
    const reiniciar = $<HTMLButtonElement>('asesor-reiniciar')
    const ver = $<HTMLButtonElement>('asesor-ver')
    const verTexto = $('asesor-ver-texto')
    const vista = $('asesor-vista')
    const contactoForm = $<HTMLFormElement>('asesor-contacto')
    const contactoAbrir = $<HTMLButtonElement>('asesor-contacto-abrir')
    const contactoError = contactoForm.querySelector<HTMLElement>('.asesor-contacto-error')!
    const contactoBoton = contactoForm.querySelector<HTMLButtonElement>('.asesor-contacto-enviar')!
    const vistaTexto = $('asesor-vista-texto')
    const subtitulo = $('asesor-subtitulo')
    const subtituloIa = subtitulo.textContent ?? ''
    const globoEl = $('asesor-globo')
    const globoAbrir = $<HTMLButtonElement>('asesor-globo-abrir')
    const globoCerrar = $<HTMLButtonElement>('asesor-globo-cerrar')

    const locale = raiz.dataset.locale ?? 'es'
    const pagina = raiz.dataset.pagina
    const waBase = raiz.dataset.waBase ?? ''
    const max = Number(raiz.dataset.max ?? 8)
    const t = JSON.parse(raiz.dataset.textos ?? '{}') as Textos
    const saludo = log.innerHTML
    const clave = `asesor:${locale}`

    // La conversación se recuerda solo en esta pestaña, para no perderla al
    // pasar de /paginas-web a /contact. Nunca sale del navegador salvo en la
    // propia pregunta. Si el almacenamiento falla, el chat funciona igual.
    const vacio = (): Estado => ({ mensajes: [], calculos: [], whatsapp: null, marcas: {}, contacto: 'no' })
    let estado: Estado = vacio()
    try {
      const guardado = JSON.parse(sessionStorage.getItem(clave) ?? 'null') as Estado | null
      if (guardado && Array.isArray(guardado.mensajes)) estado = { ...vacio(), ...guardado }
    } catch {
      // Sin almacenamiento: conversación nueva.
    }
    const guardar = () => {
      try {
        sessionStorage.setItem(clave, JSON.stringify(estado))
      } catch {
        // Sin almacenamiento: se pierde al recargar, nada más.
      }
    }

    let disponible: boolean | null = null
    let ocupado = false

    const preguntas = () => estado.mensajes.filter((m) => m.rol === 'usuario').length

    // Texto plano siempre (textContent): lo que escribe el modelo nunca se
    // interpreta como HTML. Solo se quitan los ** de negrita de markdown.
    const sinNegritas = (texto: string) => texto.replace(/\*\*(.+?)\*\*/g, '$1')
    const burbuja = (m: Mensaje) => {
      // Los avisos del sistema van en div y no en p: el desplazamiento busca la
      // última burbuja con :last-of-type y un p de más la taparía.
      if (m.rol === 'sistema') {
        const d = document.createElement('div')
        d.className = 'asesor-sistema'
        d.textContent = m.texto
        return d
      }
      const p = document.createElement('p')
      if (m.rol === 'mike') {
        p.className = 'asesor-burbuja asesor-burbuja--mike'
        const quien = document.createElement('span')
        quien.className = 'asesor-quien'
        quien.textContent = t.vivoMike
        p.append(quien, m.texto)
        return p
      }
      p.className = `asesor-burbuja asesor-burbuja--${m.rol === 'usuario' ? 'yo' : 'ia'}`
      p.textContent = m.rol === 'asesor' ? sinNegritas(m.texto) : m.texto
      return p
    }
    // La marca es un div y no un p: el desplazamiento busca la última burbuja
    // con :last-of-type, y otro p detrás la taparía.
    const marca = () => {
      const d = document.createElement('div')
      d.className = 'asesor-marca'
      const punto = document.createElement('span')
      punto.className = 'asesor-marca-punto'
      punto.setAttribute('aria-hidden', 'true')
      d.append(punto, t.calculado)
      return d
    }
    const nota = (texto: string) => {
      const p = document.createElement('p')
      p.className = 'asesor-nota'
      p.textContent = texto
      log.append(p)
      bajar()
    }
    const bajar = () => {
      log.scrollTop = log.scrollHeight
    }

    function pintar() {
      log.innerHTML = saludo
      estado.mensajes.forEach((m, i) => {
        const p = burbuja(m)
        const cifras = m.rol === 'asesor' ? estado.marcas[i] : undefined
        if (cifras?.length) pintarRespuesta(p, sinNegritas(m.texto), cifras)
        log.append(p)
        if (cifras?.length) log.append(marca())
      })
      const hechas = preguntas()
      // El límite no se muestra mientras se conversa (decisión de Mike): solo
      // aparece el aviso si alguien de verdad llega al final.
      const quedan = Math.max(0, max - hechas)
      sugerencias.hidden = hechas > 0
      reiniciar.hidden = hechas === 0
      chat.toggleAttribute('data-mike', !!estado.mike)
      subtitulo.textContent = estado.mike ? t.vivoSubtitulo : subtituloIa
      if (estado.whatsapp) {
        enviarMike.href = `${waBase}?text=${encodeURIComponent(estado.whatsapp)}`
        vistaTexto.textContent = estado.whatsapp
        cierre.hidden = false
      } else {
        cierre.hidden = true
        verVista(false)
      }
      // El formulario va al final de la conversación; si ya se envió, queda
      // la confirmación en su lugar.
      contactoAbrir.disabled = estado.contacto === 'enviado'
      if (estado.contacto === 'visible') {
        contactoForm.hidden = false
        log.append(contactoForm)
      } else {
        contactoForm.hidden = true
        if (estado.contacto === 'enviado') {
          const listo = document.createElement('div')
          listo.className = 'asesor-listo'
          listo.textContent = t.contactoListo.replace('{nombre}', estado.contactoNombre ?? '')
          log.append(listo)
        }
      }
      // Con Mike dentro el tope de preguntas al modelo ya no aplica.
      const agotado = !estado.mike && quedan === 0
      input.disabled = agotado || ocupado
      enviar.disabled = agotado || ocupado
      if (agotado) nota(t.agotado)
      // Una respuesta larga se muestra desde su comienzo, no desde el final:
      // si no, quien lee en el celular cae en la última frase.
      const ultima = log.querySelector<HTMLElement>('.asesor-burbuja:last-of-type')
      // El aviso del asesor en vivo va detrás de la respuesta y no cuenta.
      const ultimoRol = estado.mensajes.filter((m) => m.rol !== 'sistema').at(-1)?.rol
      if (ultimoRol === 'asesor' && ultima && !agotado) {
        log.scrollTop = Math.max(0, ultima.offsetTop - 12)
      } else {
        bajar()
      }
    }

    function verVista(si: boolean) {
      ver.setAttribute('aria-expanded', String(si))
      verTexto.textContent = si ? t.ocultarMensaje : t.verMensaje
      vista.toggleAttribute('data-abierta', si)
      // Plegada, la vista no se enfoca ni se lee: es contenido escondido.
      vista.inert = !si
    }

    function abrirMenu(si: boolean) {
      if (si) ocultarGlobo(true)
      menu.hidden = !si
      fab.setAttribute('aria-expanded', String(si))
      if (si && disponible === null) consultarDisponible()
    }
    function abrirChat(si: boolean) {
      chat.hidden = !si
      if (si) {
        ocultarGlobo(true)
        avisoFab(false)
        abrirMenu(false)
        if (!sinMovimiento()) void cargarMotion()
        pintar()
        if (!input.disabled) input.focus()
      } else {
        fab.focus()
      }
    }

    async function consultarDisponible() {
      try {
        const r = await fetch('/api/asesor', { headers: { Accept: 'application/json' } })
        const d = (await r.json()) as { disponible?: boolean }
        disponible = d.disponible === true
      } catch {
        disponible = false
      }
      if (!disponible) {
        abrir.disabled = true
        abrirNota.textContent = t.noDisponible
      }
    }

    // Con Mike dentro, lo que escribe la persona le llega a él y no al modelo.
    async function escribirleAMike(limpio: string) {
      ocupado = true
      estado.mensajes.push({ rol: 'usuario', texto: limpio })
      input.value = ''
      ajustarAlto()
      pintar()
      let error: string | null = null
      try {
        const r = await fetch('/api/asesor/conversacion', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ t: estado.conversacion, texto: limpio }),
        })
        if (r.status === 404) {
          // La conversación venció: lo que siga lo responde otra vez el asesor.
          estado.conversacion = undefined
          estado.mike = false
        }
        if (!r.ok) error = r.status === 429 ? t.errorLimite : t.errorFallo
      } catch {
        error = t.errorFallo
      }
      if (error) {
        estado.mensajes.pop()
        input.value = limpio
      }
      ocupado = false
      guardar()
      pintar()
      if (error) nota(error)
      if (!input.disabled) input.focus()
    }

    async function preguntar(texto: string) {
      const limpio = texto.trim().slice(0, 500)
      if (!limpio || ocupado) return
      if (estado.mike && estado.conversacion) return escribirleAMike(limpio)
      if (preguntas() >= max) return
      ocupado = true
      estado.mensajes.push({ rol: 'usuario', texto: limpio })
      input.value = ''
      ajustarAlto()
      pintar()
      const pensando = document.createElement('p')
      pensando.className = 'asesor-burbuja asesor-burbuja--ia'
      pensando.setAttribute('aria-label', t.pensando)
      pensando.innerHTML = '<span class="asesor-pensando"><i></i><i></i><i></i></span>'
      log.append(pensando)
      bajar()

      let error: string | null = null
      // Índice de la respuesta del asesor, si llegó: detrás puede ir un aviso.
      let respuesta: number | null = null
      try {
        const r = await fetch('/api/asesor', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            locale,
            pagina,
            mensajes: estado.mensajes.filter((m) => m.rol === 'usuario' || m.rol === 'asesor'),
            calculos: estado.calculos,
            contactoDado: estado.contacto === 'enviado',
            conversacion: estado.conversacion,
          }),
        })
        if (r.ok) {
          const d = (await r.json()) as {
            texto?: string
            whatsapp?: string | null
            contacto?: boolean
            calculos?: unknown[]
            cifras?: string[]
            conversacion?: string
            mike?: boolean
          }
          if (d.mike) {
            // Mike entró justo antes de esta pregunta: le llegó a él.
            entroMike()
          } else {
            if (d.contacto && estado.contacto === 'no') estado.contacto = 'visible'
            estado.mensajes.push({ rol: 'asesor', texto: d.texto ?? '' })
            respuesta = estado.mensajes.length - 1
            estado.calculos = d.calculos ?? []
            if (d.cifras?.length) estado.marcas[respuesta] = d.cifras
            if (d.whatsapp) estado.whatsapp = d.whatsapp
            if (d.conversacion && !estado.conversacion) {
              estado.conversacion = d.conversacion
              estado.mensajes.push({ rol: 'sistema', texto: t.vivoAvisado })
              arrancarSondeo()
            }
          }
        } else {
          error = r.status === 429 ? t.errorLimite : r.status === 503 ? t.errorNoDisponible : t.errorFallo
        }
      } catch {
        error = t.errorFallo
      }

      if (error) {
        // La pregunta fallida sale del historial (para que la siguiente siga
        // alternando) y vuelve a la caja de texto para reintentar.
        estado.mensajes.pop()
        input.value = limpio
      }
      ocupado = false
      guardar()
      // El módulo de motion se espera ANTES de pintar: si se pintara primero,
      // la respuesta completa asomaría un fotograma antes de empezar a
      // escribirse. Ya se pidió al abrir el chat, así que casi nunca espera.
      const m = respuesta !== null && !sinMovimiento() ? await cargarMotion() : null
      pintar()
      if (m && respuesta !== null) {
        const ultima = estado.mensajes[respuesta]
        const burbujas = log.querySelectorAll<HTMLElement>('.asesor-burbuja--ia')
        const p = burbujas[burbujas.length - 1]
        const siguiente = p?.nextElementSibling
        const laMarca = siguiente?.classList.contains('asesor-marca') ? (siguiente as HTMLElement) : null
        if (p) m.animarRespuesta(p, sinNegritas(ultima.texto), estado.marcas[respuesta] ?? [], laMarca)
      }
      if (error) nota(error)
      if (!input.disabled) input.focus()
    }

    function entroMike() {
      if (estado.mike) return
      estado.mike = true
      estado.mensajes.push({ rol: 'sistema', texto: t.vivoMikeEntro })
    }

    const textoFab = fab.getAttribute('aria-label') ?? ''
    function avisoFab(si: boolean) {
      fab.toggleAttribute('data-nuevo', si)
      fab.setAttribute('aria-label', si ? `${textoFab} · ${t.vivoNuevo}` : textoFab)
    }

    // Asesor en vivo: pregunta cada 4 s si Mike escribió mientras el chat está
    // abierto, y cada 15 s con el chat cerrado (la burbuja avisa con un punto).
    // Con la pestaña oculta no pregunta. Sin conversación guardada, se detiene.
    async function sondear() {
      // Una consulta a la vez: la que está en curso ya programa la siguiente.
      if (sondeando) return
      sondeo = null
      const token = estado.conversacion
      if (!token) return
      sondeando = true
      if (!document.hidden && !ocupado) {
        try {
          const r = await fetch(`/api/asesor/conversacion?desde=${estado.ultimoMike ?? 0}`, {
            headers: { Accept: 'application/json', 'X-Asesor-Token': token },
          })
          if (r.status === 404) {
            // Venció (48 h) o se reinició: el chat vuelve a ser solo del asesor.
            estado.conversacion = undefined
            estado.mike = false
            guardar()
            if (!chat.hidden) pintar()
            return
          }
          if (r.ok && estado.conversacion === token) {
            const d = (await r.json()) as { mike: boolean; mensajes: { id: number; texto: string }[] }
            const antes = estado.mensajes.length
            if (d.mike) entroMike()
            for (const m of d.mensajes) {
              estado.mensajes.push({ rol: 'mike', texto: m.texto })
              estado.ultimoMike = m.id
            }
            if (estado.mensajes.length !== antes) {
              guardar()
              if (chat.hidden) {
                if (d.mensajes.length) avisoFab(true)
              } else if (!ocupado) pintar()
            }
          }
        } catch {
          // Sin red: se reintenta en el siguiente turno.
        } finally {
          sondeando = false
        }
      } else {
        sondeando = false
      }
      if (sondeo === null) sondeo = setTimeout(sondear, chat.hidden ? 15_000 : 4_000)
    }
    function arrancarSondeo() {
      if (sondeando) return
      if (sondeo !== null) clearTimeout(sondeo)
      sondeo = setTimeout(sondear, 4_000)
    }
    if (estado.conversacion) arrancarSondeo()

    // El cotizador del hero de la portada (RF-037) ya hizo la primera vuelta
    // con el asesor; "Seguir preguntando" la entrega aquí entera (pregunta,
    // respuesta, cálculos, cifras marcadas y el token del asesor en vivo) y
    // el chat se abre como si esa vuelta hubiera ocurrido dentro.
    if (traspasoAnterior) document.removeEventListener(EVENTO_TRASPASO, traspasoAnterior)
    traspasoAnterior = (ev: Event) => {
      const d = (ev as CustomEvent<EstadoTraspaso>).detail
      if (!d || !Array.isArray(d.mensajes) || !d.mensajes.length) return
      estado = { ...vacio(), ...d }
      if (d.conversacion) {
        estado.mensajes.push({ rol: 'sistema', texto: t.vivoAvisado })
        arrancarSondeo()
      }
      guardar()
      abrirChat(true)
    }
    document.addEventListener(EVENTO_TRASPASO, traspasoAnterior)

    document.addEventListener('visibilitychange', () => {
      if (!document.hidden && estado.conversacion) {
        if (sondeo !== null) clearTimeout(sondeo)
        void sondear()
      }
    })

    function ajustarAlto() {
      input.style.height = 'auto'
      input.style.height = `${Math.min(input.scrollHeight, 112)}px`
    }

    // Globo de invitación al asistente: sale de la burbuja a los 6 s en cada
    // página (Mike lo pidió así el 2 oct 2026) y se va solo a los 8 s. No sale
    // si la persona ya está conversando, si Mike le escribió (la burbuja ya
    // avisa con su punto), ni encima de la modal de idioma. Si la pestaña está
    // oculta cuando toca, espera a que vuelva: nadie lo vería.
    let globoReloj: ReturnType<typeof setTimeout> | null = null
    const GLOBO_ESPERA = 6_000
    const GLOBO_VISIBLE = 8_000
    function programarSalidaGlobo(ms: number) {
      if (globoReloj !== null) clearTimeout(globoReloj)
      globoReloj = setTimeout(() => ocultarGlobo(false), ms)
    }
    function mostrarGlobo() {
      if (document.hidden) {
        document.addEventListener('visibilitychange', () => setTimeout(mostrarGlobo, 1_500), { once: true })
        return
      }
      const ocupada =
        !menu.hidden ||
        !chat.hidden ||
        preguntas() > 0 ||
        estado.conversacion ||
        fab.hasAttribute('data-nuevo') ||
        document.documentElement.dataset.langSuggest === 'open'
      if (ocupada) return
      // En la portada, el cotizador del hero ya es la invitación a la IA y el
      // globo le tapaba el botón "Ver estimado" (RF-037): mientras la tarjeta
      // esté a la vista, el globo espera; sale cuando la persona baja.
      if (document.querySelector('#cotizador[data-visible]')) {
        globoReloj = setTimeout(mostrarGlobo, GLOBO_ESPERA)
        return
      }
      globoEl.hidden = false
      fab.toggleAttribute('data-globo', true)
      programarSalidaGlobo(GLOBO_VISIBLE)
    }
    /** `ya`: sin animación de salida, porque lo reemplaza el menú o el chat. */
    function ocultarGlobo(ya: boolean) {
      if (globoReloj !== null) clearTimeout(globoReloj)
      globoReloj = null
      if (globoEl.hidden) return
      fab.removeAttribute('data-globo')
      if (ya || sinMovimiento()) {
        globoEl.hidden = true
        globoEl.removeAttribute('data-saliendo')
        return
      }
      globoEl.setAttribute('data-saliendo', '')
      setTimeout(() => {
        globoEl.hidden = true
        globoEl.removeAttribute('data-saliendo')
      }, 220)
    }
    setTimeout(mostrarGlobo, GLOBO_ESPERA)
    // Con el puntero encima no se va: puede estar a mitad de leerlo.
    globoEl.addEventListener('pointerenter', () => {
      if (globoReloj !== null) clearTimeout(globoReloj)
    })
    globoEl.addEventListener('pointerleave', () => {
      if (!globoEl.hidden && !globoEl.hasAttribute('data-saliendo')) programarSalidaGlobo(3_000)
    })
    globoAbrir.addEventListener('click', () => abrirChat(true))
    globoCerrar.addEventListener('click', () => ocultarGlobo(false))

    fab.addEventListener('click', () => {
      if (!chat.hidden) return abrirChat(false)
      // Mike escribió: la burbuja lleva directo a su mensaje, sin pasar por el menú.
      if (fab.hasAttribute('data-nuevo')) return abrirChat(true)
      abrirMenu(menu.hidden)
    })
    abrir.addEventListener('click', () => abrirChat(true))
    contactoAbrir.addEventListener('click', () => {
      if (estado.contacto === 'enviado') return
      estado.contacto = 'visible'
      guardar()
      pintar()
      contactoForm.scrollIntoView({ block: 'nearest' })
      contactoForm.querySelector<HTMLInputElement>('input[name="nombre"]')?.focus()
    })
    contactoForm.addEventListener('submit', async (ev) => {
      ev.preventDefault()
      const datos = new FormData(contactoForm)
      const texto = (k: string) => String(datos.get(k) ?? '').trim()
      const mostrarError = (m: string) => {
        contactoError.textContent = m
        contactoError.hidden = false
      }
      contactoError.hidden = true
      // Lo mismo que valida el servidor, para no hacer esperar a nadie por un
      // error obvio. El servidor vuelve a validar todo.
      if (!texto('nombre') || (!texto('telefono') && !texto('correo'))) return mostrarError(t.contactoErrorMedio)
      if (!datos.get('autoriza')) return mostrarError(t.contactoErrorAutoriza)
      contactoBoton.disabled = true
      contactoBoton.textContent = t.contactoEnviando
      try {
        const r = await fetch('/api/asesor/contacto', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            locale,
            pagina,
            nombre: texto('nombre'),
            telefono: texto('telefono') || undefined,
            correo: texto('correo') || undefined,
            empresa: texto('empresa') || undefined,
            autoriza: true,
            resumen: estado.whatsapp ?? undefined,
            preguntas: estado.mensajes.filter((m) => m.rol === 'usuario').map((m) => m.texto),
          }),
        })
        if (r.ok) {
          estado.contacto = 'enviado'
          estado.contactoNombre = texto('nombre').split(/\s+/)[0]
          contactoForm.reset()
          guardar()
          pintar()
          return
        }
        const d = (await r.json().catch(() => ({}))) as { error?: string }
        mostrarError(
          r.status === 429
            ? t.errorLimite
            : d.error === 'telefono'
              ? t.contactoErrorTelefono
              : d.error === 'correo'
                ? t.contactoErrorCorreo
                : d.error === 'sin_medio'
                  ? t.contactoErrorMedio
                  : d.error === 'autorizacion'
                    ? t.contactoErrorAutoriza
                    : t.contactoErrorFallo
        )
      } catch {
        mostrarError(t.contactoErrorFallo)
      } finally {
        contactoBoton.disabled = false
        contactoBoton.textContent = t.contactoEnviar
      }
    })
    ver.addEventListener('click', () => verVista(ver.getAttribute('aria-expanded') !== 'true'))
    cerrar.addEventListener('click', () => abrirChat(false))
    reiniciar.addEventListener('click', () => {
      estado = vacio()
      guardar()
      pintar()
      input.focus()
    })
    sugerencias.addEventListener('click', (ev) => {
      const b = (ev.target as HTMLElement).closest<HTMLButtonElement>('[data-sugerencia]')
      if (b) void preguntar(b.dataset.sugerencia ?? '')
    })
    form.addEventListener('submit', (ev) => {
      ev.preventDefault()
      void preguntar(input.value)
    })
    input.addEventListener('input', ajustarAlto)
    input.addEventListener('keydown', (ev) => {
      // Enter envía; Shift+Enter hace salto de línea.
      if (ev.key === 'Enter' && !ev.shiftKey && !ev.isComposing) {
        ev.preventDefault()
        void preguntar(input.value)
      }
    })
    document.addEventListener('keydown', (ev) => {
      if (ev.key !== 'Escape') return
      if (!globoEl.hidden) ocultarGlobo(false)
      if (!chat.hidden) abrirChat(false)
      else if (!menu.hidden) {
        abrirMenu(false)
        fab.focus()
      }
    })
    document.addEventListener('click', (ev) => {
      if (menu.hidden) return
      const dentro = (ev.target as Node) instanceof Node && (menu.contains(ev.target as Node) || fab.contains(ev.target as Node))
      if (!dentro) abrirMenu(false)
    })
  }

  iniciar()
  document.addEventListener('astro:page-load', iniciar)
</script>
