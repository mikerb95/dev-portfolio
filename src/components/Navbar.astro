---
import { delocalizePath, getDictionary, getLocaleFromUrl, hasTranslation, localizedHref } from '../i18n'
import LangSwitch from './LangSwitch.astro'

interface Props {
  /**
   * URL de esta misma página en el otro idioma, cuando la página la conoce
   * mejor que el registro de rutas (notas: el slug también se traduce).
   * Sin ella se deduce del pathname.
   */
  languageHref?: string
}

const { languageHref: languageHrefOverride } = Astro.props;
const rawPath = Astro.url.pathname;
// Comparar la sección activa contra la ruta SIN prefijo de idioma: con /en/
// delante, `currentPath.startsWith(link.href)` nunca matchea nada y todo el
// nav queda "apagado" en inglés.
const currentPath = delocalizePath(rawPath);
const locale = getLocaleFromUrl(rawPath);
const t = getDictionary(locale);
const otherLocale = locale === 'es' ? 'en' : 'es';
// El conmutador de idioma apunta a la misma página en el otro idioma solo
// si existe; si no, a la home de ese idioma. Antes construía `/en/<ruta>`
// siempre, y en las páginas sin traducir eso era un 404.
const languageHref =
  languageHrefOverride ??
  (hasTranslation(rawPath, otherLocale)
    ? localizedHref(rawPath, otherLocale)
    : localizedHref('/', otherLocale));

// La navegación admite dos formas: enlace suelto y grupo desplegable. Los dos
// servicios comerciales (diseño web y capacitación) viven agrupados porque son
// lo mismo desde el punto de vista del visitante: cosas que se contratan. El
// resto de la barra es material técnico y sigue plano.
//
// `localizedHref` y no `localizePath`: la capacitación existe solo en español,
// y el primero cae al español cuando no hay traducción mientras el segundo
// publicaría un /en/ que da 404.
type NavItem = { canonical: string; label: string; href: string; match: string };
type NavEntry = NavItem | { label: string; id: string; items: NavItem[] };

/**
 * `match` es el prefijo que enciende el enlace, y por defecto es la propia
 * ruta. Se separa porque una entrada puede representar más de una ruta: la de
 * capacitación apunta a la landing, pero también tiene que quedar encendida
 * mientras el visitante recorre el banco de recursos en /capacitacion.
 */
const item = (canonical: string, label: string, match = canonical): NavItem => ({
  canonical,
  label,
  href: localizedHref(canonical, locale),
  match,
});

const navEntries: NavEntry[] = [
  item("/tools", t.nav.tools),
  item("/engineering", t.nav.engineering),
  {
    label: t.nav.servicios,
    id: "servicios",
    items: [
      item("/paginas-web", t.nav.diseno),
      item("/capacitacion-ia", t.nav.capacitacion, "/capacitacion"),
    ],
  },
  item("/lab", t.nav.lab),
  item("/notes", t.nav.notes),
  item("/security", t.nav.security),
  item("/log", t.nav.log),
];

const esGrupo = (e: NavEntry): e is Extract<NavEntry, { items: NavItem[] }> => "items" in e;

// Un grupo se marca activo si lo está cualquiera de sus hijos: si no, entrar a
// /capacitacion-ia apagaría la barra entera y el visitante perdería de vista
// dónde está.
const estaActivo = (i: NavItem) => currentPath.startsWith(i.match);
const grupoActivo = (e: Extract<NavEntry, { items: NavItem[] }>) => e.items.some(estaActivo);
---

<header
  class="fixed top-4 inset-x-4 z-50 max-w-[1280px] mx-auto"
  aria-label={locale === 'en' ? 'Navigation' : 'Navegación'}
>
  <div
    class="glass-strong rounded-full pl-5 pr-2 py-2 flex items-center justify-between shadow-[0_8px_32px_rgba(0,0,0,.55)]"
  >
    <!-- Brand -->
    <a href={localizedHref('/', locale)} class="flex items-center gap-3 select-none">
      <img
        src="https://github.com/mikerb95.png"
        alt="Mike (@mikerb95)"
        width="28"
        height="28"
        loading="eager"
        referrerpolicy="no-referrer"
        class="w-7 h-7 rounded-full object-cover shadow-[0_0_18px_rgba(0,242,255,.5)]"
      />
      <span class="font-mono text-[12px] tracking-[.2em] uppercase text-ink-50">
        Code<span class="text-cyan">By</span>Mike
      </span>
    </a>

    <!-- Desktop nav -->
    <nav
      class="hidden lg:flex items-center gap-1 text-[12px] font-mono text-ink-100"
    >
      {
        navEntries.map((entry) => {
          if (!esGrupo(entry)) {
            const isActive = estaActivo(entry);
            return (
              <a
                href={entry.href}
                class={`px-3 py-2 rounded-full transition-colors hover:bg-white/5 ${isActive ? "text-cyan" : "text-ink-100"}`}
              >
                {entry.label}
              </a>
            );
          }

          const isActive = grupoActivo(entry);
          return (
            /* El grupo es un <button>, no un enlace: no lleva a ninguna parte,
               abre un menú. Un <a href="#"> aquí es lo que hace que un lector
               de pantalla anuncie "enlace" algo que no navega. */
            <div class="relative" data-nav-group>
              <button
                type="button"
                aria-expanded="false"
                aria-controls={`nav-group-${entry.id}`}
                class={`px-3 py-2 rounded-full transition-colors hover:bg-white/5 inline-flex items-center gap-1.5 ${isActive ? "text-cyan" : "text-ink-100"}`}
                data-nav-group-trigger
              >
                {entry.label}
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="10"
                  height="10"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  class="transition-transform duration-200"
                  data-nav-group-chevron
                >
                  <path d="m6 9 6 6 6-6"></path>
                </svg>
              </button>

              <div
                id={`nav-group-${entry.id}`}
                class="hidden absolute left-1/2 -translate-x-1/2 top-full pt-2 min-w-[190px]"
                data-nav-group-panel
              >
                <div class="glass-strong rounded-2xl p-1.5 shadow-[0_8px_32px_rgba(0,0,0,.55)] flex flex-col gap-0.5">
                  {entry.items.map((sub) => (
                    <a
                      href={sub.href}
                      class={`px-3 py-2 rounded-xl whitespace-nowrap transition-colors hover:bg-white/5 ${estaActivo(sub) ? "text-cyan" : "text-ink-100"}`}
                    >
                      {sub.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          );
        })
      }
    </nav>

    <!-- Right side -->
    <div class="flex items-center gap-2">
      <LangSwitch locale={locale} languageHref={languageHref} class="hidden sm:inline-flex" />
      <a
        href="/login?callbackUrl=%2Fentrar"
        aria-label={t.nav.loginAria}
        class="inline-flex items-center gap-2 h-8 px-3 text-[12px] font-medium rounded-full bg-white/5 text-ink-100 hover:bg-white/10 transition-colors"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path
            d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6.1 0-1.3-.5-2.4-1.3-3.2.1-.3.5-1.5-.1-3.2 0 0-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1c-.6 1.7-.2 2.9-.1 3.2A4.9 4.9 0 0 0 4 9.9c0 4.7 2.7 5.8 5.5 6.1-.6.5-1 1.4-1 2.8V21"
          ></path>
        </svg>
        <span class="hidden lg:inline">{t.nav.loginAria}</span>
      </a>
      <a
        href={localizedHref('/contact', locale)}
        class="inline-flex items-center gap-2 h-8 px-3 text-[12px] font-medium rounded-full bg-cyan text-ink-950 hover:brightness-110 transition-all"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>
        </svg>
        {t.nav.contactCta}
      </a>

      <!-- Mobile menu button -->
      <button
        id="navbar-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="navbar-mobile-panel"
        aria-label={t.nav.openMenu}
        data-open-label={t.nav.openMenu}
        data-close-label={t.nav.closeMenu}
        class="lg:hidden inline-flex items-center justify-center w-9 h-9 rounded-full bg-white/5 text-ink-100 hover:bg-white/10 transition-colors"
      >
        <svg
          id="navbar-toggle-icon-open"
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg
          id="navbar-toggle-icon-close"
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="hidden"
        >
          <path d="M18 6 6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile nav panel -->
  <div
    id="navbar-mobile-panel"
    class="hidden lg:hidden glass-strong rounded-3xl mt-2 p-3 flex flex-col gap-1"
  >
    {
      /* En móvil el desplegable no aporta: el panel ya es una lista vertical y
         esconder dos enlaces detrás de un toque solo añade fricción. El grupo
         se muestra como una sección con rótulo. */
      navEntries.map((entry) => {
        if (!esGrupo(entry)) {
          return (
            <a
              href={entry.href}
              class={`px-4 py-2.5 rounded-full text-[13px] font-mono transition-colors hover:bg-white/5 ${estaActivo(entry) ? "text-cyan" : "text-ink-100"}`}
            >
              {entry.label}
            </a>
          );
        }

        return (
          <div class="flex flex-col gap-1">
            <div class="px-4 pt-2 pb-1 text-[10px] font-mono uppercase tracking-[.22em] text-ink-300">
              {entry.label}
            </div>
            {entry.items.map((sub) => (
              <a
                href={sub.href}
                class={`px-4 py-2.5 rounded-full text-[13px] font-mono transition-colors hover:bg-white/5 ${estaActivo(sub) ? "text-cyan" : "text-ink-100"}`}
              >
                {sub.label}
              </a>
            ))}
          </div>
        );
      })
    }
    <div class="h-px bg-white/10 my-1"></div>
    <div class="flex items-center justify-between px-4 py-2">
      <span class="text-[13px] font-mono text-ink-200">{t.nav.languageSwitch}</span>
      <LangSwitch locale={locale} languageHref={languageHref} size="md" />
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById("navbar-toggle");
  const panel = document.getElementById("navbar-mobile-panel");
  const iconOpen = document.getElementById("navbar-toggle-icon-open");
  const iconClose = document.getElementById("navbar-toggle-icon-close");

  const openLabel = toggle?.dataset.openLabel ?? "Abrir menú";
  const closeLabel = toggle?.dataset.closeLabel ?? "Cerrar menú";

  toggle?.addEventListener("click", () => {
    const isOpen = panel?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(isOpen));
    toggle.setAttribute("aria-label", isOpen ? closeLabel : openLabel);
    iconOpen?.classList.toggle("hidden", isOpen);
    iconClose?.classList.toggle("hidden", !isOpen);
  });

  // ── Desplegables de la barra de escritorio ──
  //
  // Hover Y click, no uno solo: con hover a secas el menú es inalcanzable por
  // teclado y en pantallas táctiles, y con click a secas se siente pesado en
  // escritorio. El estado real vive en aria-expanded, y la clase `hidden` se
  // deriva de él, para que no puedan contradecirse.
  const grupos = document.querySelectorAll<HTMLElement>("[data-nav-group]");

  const cerrar = (grupo: HTMLElement) => {
    const trigger = grupo.querySelector<HTMLButtonElement>("[data-nav-group-trigger]");
    const panelGrupo = grupo.querySelector<HTMLElement>("[data-nav-group-panel]");
    const chevron = grupo.querySelector<SVGElement>("[data-nav-group-chevron]");
    trigger?.setAttribute("aria-expanded", "false");
    panelGrupo?.classList.add("hidden");
    chevron?.classList.remove("rotate-180");
  };

  const abrir = (grupo: HTMLElement) => {
    // Solo uno abierto a la vez: dos menús superpuestos se tapan entre sí.
    grupos.forEach((otro) => otro !== grupo && cerrar(otro));
    const trigger = grupo.querySelector<HTMLButtonElement>("[data-nav-group-trigger]");
    const panelGrupo = grupo.querySelector<HTMLElement>("[data-nav-group-panel]");
    const chevron = grupo.querySelector<SVGElement>("[data-nav-group-chevron]");
    trigger?.setAttribute("aria-expanded", "true");
    panelGrupo?.classList.remove("hidden");
    chevron?.classList.add("rotate-180");
  };

  const estaAbierto = (grupo: HTMLElement) =>
    grupo
      .querySelector<HTMLButtonElement>("[data-nav-group-trigger]")
      ?.getAttribute("aria-expanded") === "true";

  grupos.forEach((grupo) => {
    const trigger = grupo.querySelector<HTMLButtonElement>("[data-nav-group-trigger]");

    trigger?.addEventListener("click", () => {
      estaAbierto(grupo) ? cerrar(grupo) : abrir(grupo);
    });

    grupo.addEventListener("mouseenter", () => abrir(grupo));
    grupo.addEventListener("mouseleave", () => cerrar(grupo));

    // El foco saliendo del grupo lo cierra: es lo que hace que tabular por la
    // barra no vaya dejando menús abiertos detrás.
    grupo.addEventListener("focusout", (e) => {
      const destino = (e as FocusEvent).relatedTarget;
      if (!(destino instanceof Node) || !grupo.contains(destino)) cerrar(grupo);
    });
  });

  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    grupos.forEach((grupo) => {
      if (!estaAbierto(grupo)) return;
      cerrar(grupo);
      // El foco vuelve al disparador: si se queda en un enlace que acaba de
      // ocultarse, el teclado pierde el hilo de dónde estaba.
      grupo.querySelector<HTMLButtonElement>("[data-nav-group-trigger]")?.focus();
    });
  });

  document.addEventListener("click", (e) => {
    const destino = e.target;
    if (!(destino instanceof Node)) return;
    grupos.forEach((grupo) => !grupo.contains(destino) && cerrar(grupo));
  });

  panel?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      panel.classList.add("hidden");
      toggle?.setAttribute("aria-expanded", "false");
      toggle?.setAttribute("aria-label", openLabel);
      iconOpen?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
    });
  });
</script>
