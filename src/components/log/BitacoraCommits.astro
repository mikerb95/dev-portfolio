---
// Bitácora de /log: dónde se fue el mes (una barra por proyecto que es
// también su filtro), el tipo de cambio de cada commit leído de su prefijo
// convencional, y la lista por días con la franja de sesiones de cada día, la
// misma que dibuja el reloj. Las filas, la barra y los filtros los arma el
// navegador con los datos de GitHub; aquí solo va el esqueleto de carga.
import { getDictionary, type Locale } from '../../i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const l = getDictionary(locale).log
const bi = l.motion.bitacora
---

<section class="lg-bitacora" data-bitacora>
  <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[.18em] text-ink-200 mb-6">
    <span class="text-cyan">/feed</span>
    <span class="h-px flex-1 bg-gradient-to-r from-white/15 to-transparent max-w-[80px]"></span>
    <span>{l.feedEyebrow}</span>
  </div>
  <h2 class="text-[32px] sm:text-[40px] font-medium tracking-[-.03em] leading-[1.02] text-ink-50 mb-4" data-titular>{bi.titular}</h2>
  <p class="text-[14px] text-ink-200 max-w-2xl leading-relaxed mb-9">{bi.cuerpo}</p>

  <div class="lg-mezcla" data-mezcla hidden>
    <div class="lg-mezcla-rot">{bi.mezcla}</div>
    <div class="lg-mezcla-barra" data-mezcla-barra></div>
    <div class="lg-mezcla-lista" data-mezcla-lista></div>
  </div>

  <div class="lg-tipos" role="group" aria-label={bi.filtroTipo} data-tipos hidden></div>

  <div class="lg-resultado" aria-live="polite">
    <span data-resultado></span>
    <button type="button" class="lg-limpiar" data-limpiar hidden>{bi.limpiar}</button>
  </div>

  <div id="feed-wrap" class="relative">
    <div id="log-feed" class="lg-feed">
      {Array.from({ length: 6 }).map(() => (
        <div class="lg-esqueleto">
          <span style="width:84px"></span>
          <span style="flex:1"></span>
          <span style="width:56px"></span>
        </div>
      ))}
    </div>

    <!-- Desvanecido inferior mientras queden commits por montar. -->
    <div
      id="feed-fade"
      class="pointer-events-none absolute inset-x-0 bottom-0 h-28 rounded-b-2xl opacity-0 transition-opacity duration-300"
      style="background:linear-gradient(to bottom, rgba(18,18,22,0) 0%, rgba(18,18,22,.6) 52%, #121216 100%)"
    ></div>

    <div id="feed-loader" class="pointer-events-none absolute inset-x-0 bottom-4 flex justify-center opacity-0 transition-opacity duration-300">
      <span class="feed-loader-pill"><span class="dot"></span><span class="dot"></span><span class="dot"></span></span>
    </div>
  </div>

  <!-- Tras unas cuantas tandas automáticas se pregunta antes de seguir: un mes
       de commits no debería desplazarse para siempre sin pedirlo. -->
  <div id="feed-more" class="hidden mt-6">
    <div class="rounded-2xl glass p-7 flex flex-col items-center text-center gap-4">
      <div class="flex items-center gap-2 text-[10px] font-mono uppercase tracking-[.22em] text-ink-200">
        <span class="w-1.5 h-1.5 rounded-full bg-cyan"></span>
        {l.loadPause}
      </div>
      <p class="text-[14.5px] text-ink-100 max-w-md leading-relaxed">
        {l.loadPauseBodyPrefix} <span id="feed-more-count" class="text-ink-50 font-medium">-</span> {l.loadPauseBodySuffix}
      </p>
      <button
        id="feed-more-btn"
        type="button"
        class="inline-flex items-center gap-2 h-10 px-5 text-[13px] font-medium rounded-full bg-cyan text-ink-950 hover:bg-cyan-glow transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
        {l.loadMoreBtn}
      </button>
      <div class="text-[10px] font-mono uppercase tracking-[.18em] text-ink-300">
        <span id="feed-more-remaining">-</span> {l.remainingCommits}
      </div>
    </div>
  </div>
</section>

<style>
  /* ── Mezcla por proyecto ─────────────────────────────────────────────── */
  .lg-mezcla { margin-bottom: 26px; }
  .lg-mezcla-rot,
  .lg-resultado {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #85858f;
  }
  .lg-mezcla-rot { margin-bottom: 12px; }
  .lg-mezcla-barra {
    display: flex;
    gap: 2px;
    height: 14px;
    border-radius: 6px;
    overflow: hidden;
  }
  .lg-mezcla-barra :global(button) {
    min-width: 3px;
    border: 0;
    padding: 0;
    cursor: pointer;
    background: var(--c);
    transform-origin: left center;
    transition: opacity 0.25s ease, filter 0.25s ease;
  }
  .lg-mezcla-barra :global(button[data-privado]) {
    background: repeating-linear-gradient(135deg, #4d4d5d 0 1px, #24242f 1px 4px);
    cursor: default;
  }
  .lg-mezcla-lista {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 6px;
    margin-top: 12px;
  }
  .lg-mezcla-lista :global(button) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 30px;
    padding: 0 11px;
    border-radius: 99px;
    border: 1px solid transparent;
    background: transparent;
    font-size: 12.5px;
    color: #c4c4cc;
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease, opacity 0.25s ease;
  }
  .lg-mezcla-lista :global(button:hover) { background: rgba(255, 255, 255, 0.04); }
  .lg-mezcla-lista :global(button[aria-pressed='true']) {
    background: color-mix(in srgb, #00f2ff 9%, transparent);
    border-color: color-mix(in srgb, #00f2ff 30%, transparent);
    color: #e7e7ec;
  }
  .lg-mezcla-lista :global(button[data-privado]) { cursor: default; color: #85858f; }
  .lg-mezcla-lista :global(button[data-privado]:hover) { background: transparent; }
  .lg-mezcla-lista :global(i) { width: 7px; height: 7px; border-radius: 99px; background: var(--c); flex: none; }
  .lg-mezcla-lista :global(button[data-privado] i) {
    background: repeating-linear-gradient(135deg, #85858f 0 1px, #24242f 1px 3px);
  }
  .lg-mezcla-lista :global(b) { font-family: var(--font-mono, ui-monospace, monospace); font-size: 10.5px; font-weight: 400; color: #85858f; }
  /* Con un proyecto elegido, los demás se apagan en la barra y en la lista. */
  [data-mezcla][data-activo] .lg-mezcla-barra :global(button:not([aria-pressed='true'])),
  [data-mezcla][data-activo] .lg-mezcla-lista :global(button:not([aria-pressed='true'])) { opacity: 0.35; }

  /* ── Tipos de cambio ─────────────────────────────────────────────────── */
  .lg-tipos { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 18px; }
  .lg-tipos :global(button) {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 30px;
    padding: 0 12px;
    border-radius: 99px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.02);
    font-size: 12px;
    color: #c4c4cc;
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }
  .lg-tipos :global(button:hover) { background: rgba(255, 255, 255, 0.05); }
  .lg-tipos :global(button[aria-pressed='true']) {
    color: #e7e7ec;
    border-color: color-mix(in srgb, var(--c, #00f2ff) 45%, transparent);
    background: color-mix(in srgb, var(--c, #00f2ff) 10%, transparent);
  }
  .lg-tipos :global(button:disabled) { opacity: 0.35; cursor: default; }
  .lg-tipos :global(i) { width: 6px; height: 6px; border-radius: 99px; background: var(--c, #85858f); }
  .lg-tipos :global(b) { font-family: var(--font-mono, ui-monospace, monospace); font-size: 10.5px; font-weight: 400; color: #85858f; }

  .lg-resultado { display: flex; align-items: center; gap: 14px; min-height: 22px; margin-bottom: 12px; }
  .lg-limpiar {
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: #00f2ff;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }
  .lg-limpiar:hover { text-decoration: underline; }

  /* ── Lista ───────────────────────────────────────────────────────────── */
  /* clip y no hidden: hidden convierte la lista en contenedor de scroll y
     las cabeceras de día dejarían de quedarse pegadas arriba. */
  .lg-feed {
    border-radius: 18px;
    overflow: clip;
    border: 1px solid rgba(255, 255, 255, 0.07);
    background: #0d0d12;
  }
  .lg-esqueleto { display: flex; gap: 16px; padding: 15px 20px; border-bottom: 1px solid rgba(255, 255, 255, 0.03); }
  .lg-esqueleto span { height: 11px; border-radius: 4px; background: rgba(255, 255, 255, 0.05); animation: lg-latido 1.6s ease-in-out infinite; }
  @keyframes lg-latido { 50% { opacity: 0.45; } }

  .lg-feed :global(.lg-dia) {
    position: sticky;
    top: 84px;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 6px 18px;
    padding: 11px 20px;
    background: #101016;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }
  .lg-feed :global(.lg-dia-fecha) {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #c4c4cc;
  }
  .lg-feed :global(.lg-dia-fecha::first-letter) { text-transform: uppercase; }
  .lg-feed :global(.lg-dia-dato) {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 10px;
    color: #85858f;
  }
  /* La franja del día: sus sesiones en 24 h, las mismas barras del reloj. */
  .lg-feed :global(.lg-dia-franja) { width: 144px; height: 10px; display: block; }
  @media (max-width: 639px) {
    .lg-feed :global(.lg-dia) { grid-template-columns: minmax(0, 1fr); padding: 10px 14px; }
    .lg-feed :global(.lg-dia-franja) { width: 110px; }
  }

  .lg-feed :global(.lg-fila) {
    display: grid;
    grid-template-columns: 116px minmax(0, 1fr) auto 62px 44px;
    align-items: baseline;
    gap: 16px;
    padding: 11px 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.03);
    transition: background-color 0.2s ease;
  }
  .lg-feed :global(.lg-fila:hover) { background: color-mix(in srgb, var(--c, #00f2ff) 4%, transparent); }
  .lg-feed :global(.lg-fila[data-nuevo]) { background: color-mix(in srgb, #00f2ff 8%, transparent); }
  .lg-feed :global(.lg-tipo) {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 10.5px;
    color: #85858f;
    white-space: nowrap;
  }
  .lg-feed :global(.lg-tipo i) { width: 6px; height: 6px; border-radius: 99px; background: var(--c); flex: none; transform: translateY(-1px); }
  .lg-feed :global(.lg-msg) { font-size: 13px; line-height: 1.45; color: #e7e7ec; overflow-wrap: anywhere; }
  .lg-feed :global(.lg-alcance) {
    display: inline-block;
    margin-right: 7px;
    padding: 0 6px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.05);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 10.5px;
    color: #c4c4cc;
  }
  .lg-feed :global(.lg-repo),
  .lg-feed :global(.lg-hora),
  .lg-feed :global(.lg-sha) {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 10.5px;
    color: #4d4d5d;
    white-space: nowrap;
  }
  .lg-feed :global(.lg-repo) { color: #85858f; }
  .lg-feed :global(.lg-sha) { color: #85858f; text-decoration: none; }
  .lg-feed :global(.lg-sha:hover) { color: #00f2ff; text-decoration: underline; }
  .lg-feed :global(.lg-hora) { text-align: right; }
  .lg-feed :global(.lg-nuevo) {
    margin-left: 8px;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 9.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #00f2ff;
  }
  /* Móvil: tipo y hora arriba, el mensaje, y el proyecto con el sha debajo. */
  @media (max-width: 767px) {
    .lg-feed :global(.lg-fila) {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'tipo hora' 'msg msg' 'repo sha';
      gap: 5px 12px;
      padding: 12px 14px;
    }
    .lg-feed :global(.lg-tipo) { grid-area: tipo; }
    .lg-feed :global(.lg-hora) { grid-area: hora; }
    .lg-feed :global(.lg-msg) { grid-area: msg; }
    .lg-feed :global(.lg-repo) { grid-area: repo; }
    .lg-feed :global(.lg-sha) { grid-area: sha; text-align: right; }
  }
  .lg-feed :global(.lg-vacio) { padding: 40px 20px; text-align: center; font-family: var(--font-mono, ui-monospace, monospace); font-size: 12px; color: #4d4d5d; }

  .feed-loader-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 7px 13px;
    border-radius: 9999px;
    background: rgba(8, 8, 12, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .feed-loader-pill .dot {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: #00f2ff;
    animation: feed-bounce 1s ease-in-out infinite;
  }
  .feed-loader-pill .dot:nth-child(2) { animation-delay: 0.15s; }
  .feed-loader-pill .dot:nth-child(3) { animation-delay: 0.3s; }
  @keyframes feed-bounce {
    0%, 80%, 100% { transform: translateY(0); opacity: 0.4; }
    40% { transform: translateY(-5px); opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .feed-loader-pill .dot,
    .lg-esqueleto span { animation: none; opacity: 0.7; }
  }
</style>
