---
import { DOCS_PAGINAS } from '../data/docs-paginas'

// Las pestañas salen de la lista tipada: el menú y el sitemap no pueden
// discrepar sobre qué páginas existen.
const tabs = [
  { href: '/docs', label: 'Visión general' },
  ...DOCS_PAGINAS.map((p) => ({ href: `/docs/${p.slug}`, label: p.label })),
]

const current = Astro.url.pathname
// Coincidencia exacta, o un separador detrás para una eventual subruta. Las
// dos trampas que cubre: con un `startsWith` pelado, estar en
// /docs/casos-de-uso-extendidos encendía también /docs/casos-de-uso, que es
// prefijo suyo; y sin el caso aparte de /docs, la pestaña de la visión general
// se enciende en TODA subpágina, porque es prefijo de todas.
const isActive = (href: string) =>
  href === '/docs' ? current === '/docs' : current === href || current.startsWith(`${href}/`)
---

<nav class="docs-nav mb-6 flex flex-wrap gap-1.5" aria-label="Subpáginas de documentación">
  {tabs.map((t) => (
    <a
      href={t.href}
      class={`shrink-0 px-3.5 py-1.5 rounded-full text-[14px] font-medium border transition-colors whitespace-nowrap ${
        isActive(t.href)
          ? 'bg-cyan/10 text-cyan border-cyan/30'
          : 'text-ink-200 border-white/10 hover:bg-white/5 hover:text-ink-50'
      }`}
    >
      {t.label}
    </a>
  ))}
</nav>
