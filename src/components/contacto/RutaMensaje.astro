---
// "Qué pasa con tu mensaje": la ruta real de un envío de /contact, junto al
// formulario. Cuatro tramos que corresponden a lo que hace /api/contact
// (el navegador revisa, el servidor revisa y frena ráfagas, guarda en la
// tabla de mensajes, manda el push), y al final el celular con el aviso tal
// como llega: el texto sale de avisoContacto, la misma función del endpoint.
//
// El servidor pinta la ruta quieta y el celular con un aviso de ejemplo
// vacío; el navegador la enciende según lo que se escribe y, al enviar,
// según lo que responda el servidor de verdad (src/lib/motion/contacto.ts).
import { getDictionary, getLocaleFromUrl, interpolate } from '../../i18n'
import { CAMPOS_REQUERIDOS } from '../../lib/motion/contacto-datos'

const loc = getLocaleFromUrl(Astro.url.pathname)
const r = getDictionary(loc).contact.ruta
---

<div class="rm" data-ruta aria-label={r.aria} role="group">
  <div class="rm-titulo">{r.titulo}</div>

  <ol class="rm-tramos">
    {r.tramos.map((t, i) => (
      <li class="rm-tramo" data-tramo={String(i)} data-estado="espera">
        <span class="rm-nodo" aria-hidden="true">
          <svg class="rm-ok" viewBox="0 0 16 16" width="10" height="10"><path d="M3.5 8.5 6.5 11.5 12.5 4.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          <span class="rm-x">×</span>
        </span>
        <span class="rm-texto">
          <span class="rm-t">{t.t}</span>
          <span class="rm-d" data-tramo-d>{t.d}</span>
          {i === 0 && (
            <span class="rm-pips" aria-hidden="true">
              {CAMPOS_REQUERIDOS.map((c) => <i data-pip={c}></i>)}
              <em data-pips-txt>{interpolate(r.camposListos, { n: 0, total: CAMPOS_REQUERIDOS.length })}</em>
            </span>
          )}
        </span>
      </li>
    ))}
    <span class="rm-paquete" aria-hidden="true"></span>
  </ol>

  <!-- Celular. Decorativo para lectores de pantalla: el resultado del envío
       se anuncia en el estado del formulario, que es aria-live. -->
  <div class="rm-cel" aria-hidden="true" data-cel>
    <div class="rm-cel-pantalla">
      <div class="rm-cel-barra"><span data-cel-hora>--:--</span><span class="rm-cel-isla"></span><span>5G</span></div>
      <div class="rm-cel-reloj" data-cel-reloj>--:--</div>
      <div class="rm-cel-fecha" data-cel-fecha>&nbsp;</div>
      <div class="rm-cel-etq" data-cel-etq>{r.celular.asi}</div>
      <div class="rm-aviso" data-aviso data-estado="borrador">
        <div class="rm-aviso-cab">
          <span class="rm-aviso-app"><i></i>{r.celular.app}</span>
          <span>{r.celular.ahora}</span>
        </div>
        <div class="rm-aviso-t" data-aviso-t>Nuevo mensaje de {r.celular.nombreVacio}</div>
        <div class="rm-aviso-c" data-aviso-c>{r.celular.cuerpoVacio}</div>
      </div>
      {r.celular.idioma && <div class="rm-cel-nota">{r.celular.idioma}</div>}
    </div>
  </div>
</div>

<style>
  .rm {
    --rm-cyan: #00f2ff;
    --rm-lime: #c9ff5b;
    --rm-ember: #ff6b3d;
    display: grid;
    gap: 18px;
    align-content: start;
  }
  .rm-titulo {
    font: 10px/1 var(--font-mono, ui-monospace, monospace);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #85858f;
  }

  /* ── Tramos ── */
  .rm-tramos {
    position: relative;
    display: grid;
    gap: 0;
  }
  .rm-tramo {
    position: relative;
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    gap: 12px;
    padding-bottom: 18px;
  }
  .rm-tramo:last-of-type {
    padding-bottom: 0;
  }
  /* Conector al siguiente tramo: gris, o cyan cuando el paquete ya pasó. */
  .rm-tramo:not(:last-of-type)::after {
    content: '';
    position: absolute;
    left: 10px;
    top: 24px;
    bottom: 2px;
    width: 2px;
    border-radius: 1px;
    background: rgba(255, 255, 255, 0.09);
    transition: background-color 0.4s;
  }
  .rm-tramo[data-estado='listo']:not(:last-of-type)::after {
    background: linear-gradient(var(--rm-cyan), rgba(0, 242, 255, 0.35));
  }
  /* Listo para salir: el conector del primer tramo late hacia abajo. */
  .rm[data-preparado] .rm-tramo[data-tramo='0']::after {
    background: repeating-linear-gradient(180deg, rgba(0, 242, 255, 0.7) 0 4px, transparent 4px 8px);
    background-size: 2px 16px;
    animation: rm-flujo 0.8s linear infinite;
  }
  @keyframes rm-flujo {
    to { background-position: 0 16px; }
  }

  .rm-nodo {
    position: relative;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1.5px solid rgba(255, 255, 255, 0.18);
    background: #121216;
    color: #0a0a0d;
    transition: background-color 0.35s, border-color 0.35s, box-shadow 0.35s;
  }
  .rm-ok,
  .rm-x {
    position: absolute;
    opacity: 0;
    transform: scale(0.4);
    transition: opacity 0.25s, transform 0.35s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .rm-x {
    font: 600 13px/1 var(--font-mono, ui-monospace, monospace);
  }
  .rm-tramo[data-estado='activo'] .rm-nodo {
    border-color: var(--rm-cyan);
    box-shadow: 0 0 0 4px rgba(0, 242, 255, 0.12);
    animation: rm-late 1.1s ease-in-out infinite;
  }
  @keyframes rm-late {
    50% { box-shadow: 0 0 0 7px rgba(0, 242, 255, 0.05); }
  }
  .rm-tramo[data-estado='listo'] .rm-nodo {
    border-color: var(--rm-cyan);
    background: var(--rm-cyan);
  }
  .rm-tramo[data-estado='listo'] .rm-ok,
  .rm-tramo[data-estado='fallo'] .rm-x {
    opacity: 1;
    transform: none;
  }
  .rm-tramo[data-estado='fallo'] .rm-nodo {
    border-color: var(--rm-ember);
    background: var(--rm-ember);
  }

  .rm-texto {
    display: grid;
    gap: 3px;
    padding-top: 2px;
    min-width: 0;
  }
  .rm-t {
    font-size: 13px;
    color: #c4c4cc;
    transition: color 0.3s;
  }
  .rm-tramo[data-estado='listo'] .rm-t,
  .rm-tramo[data-estado='activo'] .rm-t {
    color: #e7e7ec;
  }
  .rm-d {
    font-size: 12px;
    line-height: 1.45;
    color: #85858f;
  }
  .rm-tramo[data-estado='fallo'] .rm-d {
    color: var(--rm-ember);
  }
  .rm-pips {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-top: 3px;
  }
  .rm-pips i {
    width: 14px;
    height: 3px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.1);
    transition: background-color 0.3s;
  }
  .rm-pips i.ok {
    background: var(--rm-cyan);
  }
  .rm-pips em {
    margin-left: 6px;
    font: 10px/1 var(--font-mono, ui-monospace, monospace);
    font-style: normal;
    color: #85858f;
  }

  /* Paquete: el punto de luz que recorre la ruta al enviar. */
  .rm-paquete {
    position: absolute;
    left: 6px;
    top: 6px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #e7ffff;
    box-shadow: 0 0 0 3px rgba(0, 242, 255, 0.35), 0 0 18px 4px rgba(0, 242, 255, 0.7);
    opacity: 0;
    pointer-events: none;
  }

  /* ── Celular ── */
  .rm-cel {
    justify-self: start;
    width: min(100%, 250px);
    border-radius: 34px;
    padding: 7px;
    background: linear-gradient(160deg, #2e2e3a, #13131a 40%, #24242f);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08), 0 30px 60px -30px rgba(0, 0, 0, 0.9);
  }
  .rm-cel-pantalla {
    position: relative;
    min-height: 300px;
    border-radius: 28px;
    padding: 10px 12px 16px;
    background:
      radial-gradient(120% 70% at 20% 0%, rgba(167, 139, 255, 0.28), transparent 60%),
      radial-gradient(90% 60% at 100% 100%, rgba(0, 242, 255, 0.16), transparent 60%),
      #0a0a0d;
    overflow: hidden;
  }
  .rm-cel-barra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 6px;
    font: 600 10px/1 var(--font-sans, system-ui);
    color: #e7e7ec;
  }
  .rm-cel-isla {
    width: 56px;
    height: 16px;
    border-radius: 999px;
    background: #000;
  }
  .rm-cel-reloj {
    margin-top: 22px;
    text-align: center;
    font: 300 46px/1 var(--font-sans, system-ui);
    letter-spacing: -0.03em;
    color: rgba(231, 231, 236, 0.92);
    font-variant-numeric: tabular-nums;
  }
  .rm-cel-fecha {
    margin-top: 6px;
    text-align: center;
    font-size: 11px;
    color: rgba(231, 231, 236, 0.65);
  }
  .rm-cel-etq {
    margin: 22px 2px 6px;
    font: 9px/1 var(--font-mono, ui-monospace, monospace);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #85858f;
    transition: color 0.3s;
  }
  .rm-cel[data-llego] .rm-cel-etq {
    color: var(--rm-lime);
  }
  .rm-aviso {
    border-radius: 16px;
    padding: 10px 11px;
    background: rgba(231, 231, 236, 0.11);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: opacity 0.35s, background-color 0.35s, box-shadow 0.35s;
  }
  /* Mientras no se envía, el aviso es un borrador: se lee, pero no llegó. */
  .rm-aviso[data-estado='borrador'] {
    background: transparent;
    box-shadow: inset 0 0 0 1px rgba(231, 231, 236, 0.16);
    opacity: 0.72;
  }
  .rm-aviso[data-estado='llego'] {
    background: rgba(231, 231, 236, 0.16);
    box-shadow: 0 10px 24px -12px rgba(0, 0, 0, 0.9);
  }
  .rm-aviso-cab {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 10px;
    color: rgba(231, 231, 236, 0.6);
    margin-bottom: 5px;
  }
  .rm-aviso-app {
    display: flex;
    align-items: center;
    gap: 6px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .rm-aviso-app i {
    width: 14px;
    height: 14px;
    border-radius: 4px;
    background: linear-gradient(135deg, #00f2ff, #007a82);
  }
  .rm-aviso-t {
    font-size: 12px;
    font-weight: 600;
    color: #f2f2f5;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .rm-aviso-c {
    margin-top: 2px;
    font-size: 11px;
    line-height: 1.4;
    color: rgba(231, 231, 236, 0.8);
    white-space: pre-line;
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: anywhere;
  }
  .rm-cel-nota {
    margin-top: 10px;
    font-size: 10px;
    line-height: 1.4;
    color: #85858f;
    text-align: center;
  }

  /* Celular angosto: la ruta en horizontal, cuatro nodos en fila, sin las
     descripciones largas (se leen en la de escritorio y en el estado). */
  @media (max-width: 639px) {
    .rm-tramos {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .rm-tramo {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      gap: 8px;
      padding-bottom: 0;
    }
    .rm-tramo:not(:last-of-type)::after {
      left: calc(50% + 15px);
      right: calc(-50% + 15px);
      top: 10px;
      bottom: auto;
      width: auto;
      height: 2px;
    }
    .rm[data-preparado] .rm-tramo[data-tramo='0']::after {
      background: repeating-linear-gradient(90deg, rgba(0, 242, 255, 0.7) 0 4px, transparent 4px 8px);
      background-size: 16px 2px;
      animation-name: rm-flujo-h;
    }
    .rm-d {
      display: none;
    }
    .rm-tramo[data-estado='fallo'] .rm-d {
      display: block;
      position: absolute;
      top: 100%;
      left: 0;
      width: max-content;
      max-width: 70vw;
      text-align: left;
      margin-top: 4px;
    }
    .rm-t {
      font-size: 11px;
      line-height: 1.3;
    }
    .rm-pips {
      justify-content: center;
    }
    .rm-pips em {
      display: none;
    }
    .rm-cel {
      justify-self: center;
    }
  }
  @keyframes rm-flujo-h {
    to { background-position: 16px 0; }
  }
</style>
