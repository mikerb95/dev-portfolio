  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:carga": "TURSO_DATABASE_URL=http://127.0.0.1:8080 TURSO_DEMO_URL=http://127.0.0.1:8081 astro dev --port 4400 --ignore-lock",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:server": "E2E_DB_MODE=server playwright test",
    "db:up": "docker compose up -d && node scripts/wait-libsql.mjs http://127.0.0.1:8080 http://127.0.0.1:8081",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && npm run db:up",
    "db:seed": "TURSO_DATABASE_URL=http://127.0.0.1:8080 TURSO_DEMO_URL=http://127.0.0.1:8081 node scripts/seed-e2e.mjs",
    "test:mutation": "stryker run",
    "test:contracts": "vitest run tests/contracts.test.ts",
    "seed:demo": "node scripts/seed-demo.mjs",
    "seo:indexnow": "node scripts/submit-indexnow.mjs",
    "og:generate": "node scripts/og/generate.mjs",
    "sustentacion:check": "node scripts/sustentacion-check.mjs",
    "sustentacion:precalentar": "node scripts/precalentar-sustentacion.mjs",
    "bpmn:export": "node scripts/export-bpmn.mjs"
  },
  "dependencies": {
    "@astrojs/vercel": "^11.0.3",
    "@auth/core": "^0.37.4",
    "@fingerprintjs/fingerprintjs": "^5.2.0",
