    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource/instrument-serif": "^5.2.8",
    "@libsql/client": "^0.17.3",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@tailwindcss/vite": "^4.2.4",
    "@vercel/blob": "^2.4.0",
    "astro": "^7.1.3",
    "auth-astro": "^4.2.0",
    "drizzle-orm": "^0.45.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "mermaid": "^11.16.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "reveal.js": "^6.0.1",
    "tailwindcss": "^4.2.4",
    "web-vitals": "^5.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.12.1",
